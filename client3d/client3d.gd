## The base of an edge's wall: a kind building's its pad (_pad_cell), else
## the higher of the cells it stands between.
func _edge_base(key: Vector3i) -> float:
	if _pad_cell.has(key):
		return _elevation(_pad_cell[key])
	var cells := Terrain.edge_cells(key)
	return maxf(_elevation(cells[0]), _elevation(cells[1]))


func _add_wall(key: Vector3i) -> void:
	var wall: Node3D
	if BOX_WALLS:
		wall = _box(Vector3(WALL_THICKNESS, WALL_HEIGHT, 1.0), _stone_opaque)
	else:
		wall = ArtKit.instance("wall.castle.straight")
	wall.name = "Wall_%d_%d_%s" % [key.x, key.y, "e" if key.z == Terrain.EAST else "s"]
	wall.position = _edge_midpoint(key) + Vector3(0.0, _edge_base(key), 0.0)
	wall.rotation.y = _edge_yaw(key)
	_room.add_child(wall)
	_walls[key] = wall


## The walls: each straight run of wall edges of one set and wall height
## (to where it turns, meets another wall, set or wall height, a door, a
## change of ground height, or
## WALL_RUN_MOST edges) is one mesh, its set's wall.<set>.profile swept
## along it, varied as the set's variation says: the body under the
## profile's cap_y rises and falls along the run (sway: a height every
## WALL_SWAY edges, straight between), the cap band on top kept whole; now
## and then an edge's top is broken off (broken), and in a long run,
## rarely, an edge is a breach filled with rubble (gap), low but never a
## way through (the sim keeps the wall); the run leans a little (lean,
## degrees at most), its top sags between its ends (sag, metres) and its
## faces are pushed about (jitter, metres). An edge in _wall_states is
## broken or rubble whatever its set says. Every edge of a run is in
## _walls as the run's node, so the run fades as one (_wall_runs, 188).
func _add_wall_runs(keys: Array[Vector3i]) -> void:
	var lines: Dictionary[Vector2i, Array] = {}
	for key in keys:
		if _unbuilt(key):
			continue  # A building's plot or frame (566): no wall yet.
		var line := _line_of(key)
		if not lines.has(line):
			lines[line] = []
		lines[line].append(key)
	var standing := func(key: Vector3i) -> int:
		return _terrain["edges"].get(key, Terrain.Edge.OPEN) if not (_outdoor and _is_outline(key)) else Terrain.Edge.OPEN
	for line: Vector2i in lines:
		var along: Array = lines[line]
		along.sort_custom(func(a: Vector3i, b: Vector3i) -> bool: return _along(a) < _along(b))
		var run: Array[Vector3i] = []
		for key: Vector3i in along:
			if not run.is_empty():
				var last := run[-1]
				var joined := _along(key) == _along(last) + 1 and _edge_base(key) == _edge_base(last) \
						and _set_of(key) == _set_of(last) and _height_of(key) == _height_of(last) \
						and run.size() < WALL_RUN_MOST and not _needs_post(WallEdge.vertex_at(key, 1 if key.z == Terrain.EAST else 0), standing)
				if not joined:
					_add_wall_run(run)
					run = []
			run.append(key)
		if not run.is_empty():
			_add_wall_run(run)


## Draws the wall runs on the lines of [param edges] again, with their
## posts, after their sets or states changed (_wall_sets, _wall_states):
## buildings sets a town's walls broken or rubble and calls this. The rest
## of the room stays; what hides the player is indexed again. The old runs
## are hidden at once and freed two frames later (a 3D node freed before
## the room's first frame is drawn costs seconds: 296; Godot's
## godotengine/godot#124579).
func rebuild_walls(edges: Array[Vector3i]) -> void:
	_enclosed_changed.append_array(edges)
	if _room == null or BOX_WALLS:
		return
	var lines: Dictionary[Vector2i, bool] = {}
	for key in edges:
		lines[_line_of(key)] = true
	var old: Dictionary[Node3D, bool] = {}
	for key: Vector3i in _walls.keys():
		if lines.has(_line_of(key)):
			old[_walls[key]] = true
			_walls.erase(key)
	_wall_breaches = _wall_breaches.filter(func(key: Vector3i) -> bool: return not lines.has(_line_of(key)))
	var keys: Array[Vector3i] = []
	var vertices: Dictionary[Vector2i, bool] = {}
	# The edges given stand their posts again too, even one now open (a
	# felled cell's: clearing_walls).
	for key in edges:
		for end in 2:
			vertices[WallEdge.vertex_at(key, end)] = true
	var fences := _fence_keys()
	for key: Vector3i in _terrain["edges"]:
		if not lines.has(_line_of(key)) or not _edge_drawn(key, fences):
			continue
		if _terrain["edges"][key] == Terrain.Edge.WALL:
			keys.append(key)
		for end in 2:
			vertices[WallEdge.vertex_at(key, end)] = true
	for vertex in vertices:
		if _posts.has(vertex):
			old[_posts[vertex]] = true
			_posts.erase(vertex)
	for piece in old:
		piece.visible = false
		_faded.erase(piece)
		_hiding.erase(piece)
		_hid_at.erase(piece)
	_free_later(old.keys())
	_add_wall_runs(keys)
	# A plot's edges (566) are none: no post stands on them; nor on a bank of
	# rubble (a ruin's, 649; a town wall's at level 0), low as it is.
	var kind_at := func(key: Vector3i) -> int:
		return Terrain.Edge.OPEN if _wall_states.get(key) in ["plot", "rubble"] or _ruin_edges.has(key) \
				else _terrain["edges"].get(key, Terrain.Edge.OPEN)
	for vertex in vertices:
		var built := WallEdge.edges_at_vertex(vertex).any(func(entry: Array) -> bool:
				return kind_at.call(entry[0]) != Terrain.Edge.OPEN and _edge_drawn(entry[0], fences))
		if built and (_needs_post(vertex, kind_at) or _sets_meet(vertex)):
			_add_post(vertex)
	_occluders_built = false
	_update_fade()


## The walls on [param edges] drawn again after the forest was felled or grew
## back there (591 amended, terrain's side; maps' Level.relay_outline: key ->
## its Terrain.Edge now, OPEN where the outline's wall went): Main calls it
## after clearing_changed, with the terrain's edges already changed. A felled
## row's walls against the land go, and its posts; the forest's new edge is
## the outline, drawn as trees, not walls.
func clearing_walls(edges: Dictionary) -> void:
	var keys: Array[Vector3i] = []
	keys.assign(edges.keys())
	if not keys.is_empty():
		rebuild_walls(keys)


## Frees [param pieces] two frames from now, if a rebuild has not already.
func _free_later(pieces: Array) -> void:
	for frame in 2:
		await get_tree().process_frame
	# Untyped: a room rebuilt meanwhile has freed them, and a freed one
	# cannot even be held in a typed variable.
	for piece in pieces:
		if is_instance_valid(piece):
			(piece as Node).queue_free()


## The line an edge stands on: east edges run along z at x + 0.5, south
## edges along x at y + 0.5.
static func _line_of(key: Vector3i) -> Vector2i:
	return Vector2i(key.z, key.x if key.z == Terrain.EAST else key.y)


## The set a wall edge is drawn in (_wall_sets, else the map's).
func _set_of(key: Vector3i) -> String:
	return _wall_sets.get(key, _walls_set)


## How tall a wall edge stands (_wall_heights, a building's; else
## WALL_HEIGHT).
func _height_of(key: Vector3i) -> float:
	return _wall_heights.get(key, WALL_HEIGHT)


## A set's profile [param points] and [param cap] (its body's top) for a
## wall [param tall] metres high: the body stretched up by the difference
## from the set's [param top], the cap band above it kept as it is.
static func _profile_for(points: PackedVector2Array, cap: float, top: float, tall: float) -> Array:
	var rise := tall - top
	if is_zero_approx(rise):
		return [points, cap]
	var out := PackedVector2Array()
	for p in points:
		out.append(Vector2(p.x, p.y * (cap + rise) / cap if p.y <= cap else p.y + rise))
	return [out, cap + rise]


## The set a floor cell is drawn in: its own (_floor_sets), else the map's
## on its stone ground, else the ground's own look.
func _floor_byte(cell: Vector2i, kind: String) -> int:
	var byte: int = FLOOR_SETS.get(_floor_set(cell, kind), 0)
	return byte + FLOOR_WORN if byte > 0 and _floor_worn.has(cell) else byte


func _floor_set(cell: Vector2i, kind: String) -> String:
	if _floor_sets.has(cell):
		return _floor_sets[cell]
	return _floors_set if kind == "stone" else DEFAULT_SET


## [param set_name] if art-kit has the set (its wall.<set>.profile), else
## DEFAULT_SET.
static func _known_set(set_name: String) -> String:
	if ArtKit.has("wall.%s.profile" % set_name):
		return set_name
	var stand_in := str(SET_STAND_INS.get(set_name, ""))
	return stand_in if not stand_in.is_empty() and ArtKit.has("wall.%s.profile" % stand_in) else DEFAULT_SET


## Where an edge is along its line: its z for an east edge, its x for a
## south one.
static func _along(key: Vector3i) -> int:
	return key.y if key.z == Terrain.EAST else key.x


## One run of wall edges of one set, in order along its line, as one mesh.
func _add_wall_run(run: Array[Vector3i]) -> void:
	var first := run[0]
	var set_name := _set_of(first)
	var wall_set := _wall_set(set_name)
	var variation: Dictionary = wall_set["variation"]
	var east := first.z == Terrain.EAST
	# Built in the run's own frame (x across, y up from its base, z along
	# from its first vertex) and placed by its node: an east run as it is,
	# a south one turned a quarter (the profile is the same either side).
	var line := first.x + 0.5 if east else first.y + 0.5
	var start := _along(first) - 0.5
	var base := _edge_base(first)
	var count := run.size()
	# What each edge is: whole, broken off, or a breach of rubble: as
	# _wall_states says, else as the set's variation rolls.
	var states := PackedInt32Array()
	states.resize(count)
	var gap: float = variation["gap"]
	var broken: float = variation["broken"]
	var sway: float = variation["sway"]
	var sag: float = variation["sag"]
	for i in count:
		match _wall_states.get(run[i], ""):
			"rubble": states[i] = WALL_RUBBLE
			"broken", "low_ruin": states[i] = WALL_TOPLESS
	for i in count:
		var cell := Vector2i(run[i].x, run[i].y)
		if states[i] == WALL_WHOLE and count >= WALL_GAP_RUN and i >= 2 and i <= count - 3 and _roll(cell, 20 + run[i].z) < gap \
				and (i < 3 or states[i - 1] != WALL_RUBBLE and states[i - 2] != WALL_RUBBLE):
			states[i] = WALL_RUBBLE
	for i in count:
		if states[i] == WALL_WHOLE and (_roll(Vector2i(run[i].x, run[i].y), 22 + run[i].z) < broken
				or i > 0 and states[i - 1] == WALL_RUBBLE or i < count - 1 and states[i + 1] == WALL_RUBBLE):
			states[i] = WALL_TOPLESS
	if set_name == CAVE_SET:
		for k in count:
			if states[k] == WALL_RUBBLE:
				_wall_breaches.append(run[k])
		_add_cave_run(run, states)
		return
	# A broken or rubble edge the set has art for is that piece.
	var pieces: Dictionary[int, String] = {}
	for k in count:
		if states[k] == WALL_RUBBLE:
			_wall_breaches.append(run[k])
		var piece := ""
		if states[k] == WALL_RUBBLE:
			piece = "wall.%s.rubble" % set_name
		elif _wall_states.get(run[k]) == "low_ruin":
			piece = RUIN_LOW % set_name
		elif states[k] == WALL_TOPLESS and _wall_states.has(run[k]):
			piece = "wall.%s.straight_ruined" % set_name
		elif states[k] == WALL_WHOLE and _wall_states.get(run[k]) == "window":
			piece = window_slot(set_name, _height_of(run[k]))
		elif states[k] == WALL_WHOLE and _niche_at.has(run[k]) and str(_niche_at[run[k]]["kind"]) != "hidden":
			piece = NICHE_PIECE % _niche_at[run[k]]["kind"]
		if piece != "" and ArtKit.has(piece) and ArtKit.filled_by(piece) != "placeholder":
			pieces[k] = piece
	for k: int in pieces:
		states[k] = WALL_PIECE
	# A building's taller walls (its wall_height): the profile's body
	# stretched to it.
	var shaped := _profile_for(wall_set["points"], wall_set["cap"], wall_set["top"], _height_of(first))
	var points: PackedVector2Array = shaped[0]
	var cap: float = shaped[1]
	var faces: PackedInt32Array = wall_set["faces"]
	var half: float = wall_set["half"]
	# The top's sag between the run's ends, at a vertex s along it.
	var sagged := func(s: int) -> float: return sag * 4.0 * s * (count - s) / float(count * count)
	var mesh := [PackedVector3Array(), PackedVector3Array(), PackedVector2Array(), PackedInt32Array()]
	var i := 0
	while i < count:
		if states[i] == WALL_PIECE:
			i += 1
			continue
		if states[i] != WALL_WHOLE:
			_wall_broken(mesh, i, run, states, cap, half, sway)
			i += 1
			continue
		# A span of whole edges, to the next sway point or broken edge (a
		# sagging set's every edge, for its curve).
		var j := i + 1
		while j < count and states[j] == WALL_WHOLE and sag <= 0.0 and (_along(run[j]) % WALL_SWAY) != 0:
			j += 1
		var low: float = _wall_height(run[i], 0, cap, sway) - sagged.call(i)
		var high: float = _wall_height(run[j - 1], 1, cap, sway) - sagged.call(j)
		for k in points.size():
			var p := points[k]
			var q := points[(k + 1) % points.size()]
			if p.y <= 0.0 and q.y <= 0.0:
				continue  # The bottom, on the ground.
			_wall_quad(mesh, Vector3(p.x, _profile_y(p.y, cap, low), i), Vector3(q.x, _profile_y(q.y, cap, low), i),
					Vector3(q.x, _profile_y(q.y, cap, high), j), Vector3(p.x, _profile_y(p.y, cap, high), j),
					Vector3(q.y - p.y, -(q.x - p.x), 0.0), absf(q.y - p.y) < absf(q.x - p.x))
		# An end that nothing hides: the run's own, or against a broken edge.
		if i == 0 or states[i - 1] != WALL_WHOLE:
			_wall_cap(mesh, i, points, faces, cap, low, -1.0)
		if j == count or states[j] != WALL_WHOLE:
			_wall_cap(mesh, j, points, faces, cap, high, 1.0)
		i = j
	var lean := deg_to_rad((_roll(Vector2i(first.x, first.y), 34 + first.z) - 0.5) * 2.0 * float(variation["lean"]))
	_wall_bend(mesh, tan(lean), float(variation["jitter"]), first)
	var holder := Node3D.new()
	holder.position = Vector3(line, base, start) if east else Vector3(start, base, line)
	holder.rotation.y = 0.0 if east else PI * 0.5
	holder.name = "Wall_%d_%d_%s" % [first.x, first.y, "e" if east else "s"]
	for k: int in pieces:
		var niche: Dictionary = _niche_at.get(run[k], {})
		var variant := int(niche.get("variant", 1))
		if _wall_states.get(run[k]) == "low_ruin":
			variant = 1 + posmod(_edge_hash(run[k]), maxi(1, ArtKit.variant_count(pieces[k])))
		var made := ArtKit.instance(pieces[k], variant)
		made.name = "Piece_%d" % k
		made.position = Vector3(0.0, 0.0, k + 0.5)
		if _wall_states.get(run[k]) == "window":
			_dress_window(made, run[k], pieces[k])
		if not niche.is_empty():
			# Its +x toward the niche's room: the run's +x is east (an east
			# run) or north (a south run, turned a quarter).
			var across := Vector2i(1, 0) if east else Vector2i(0, -1)
			made.rotation.y = 0.0 if (niche["out"] as Vector2i) == across else PI
		holder.add_child(made)
	if _plinths.has(first):
		_add_plinth(holder, run, base, wall_set["half"])
	if mesh[0].is_empty() and holder.get_child_count() == 0:
		holder.free()
		return
	_room.add_child(holder)
	for key in run:
		_walls[key] = holder
	if mesh[0].is_empty():
		return
	var arrays := []
	arrays.resize(Mesh.ARRAY_MAX)
	arrays[Mesh.ARRAY_VERTEX] = mesh[0]
	arrays[Mesh.ARRAY_NORMAL] = mesh[1]
	arrays[Mesh.ARRAY_TEX_UV] = mesh[2]
	arrays[Mesh.ARRAY_INDEX] = mesh[3]
	var array_mesh := ArrayMesh.new()
	array_mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays)
	var drawn := MeshInstance3D.new()
	drawn.name = "Body"
	drawn.mesh = array_mesh
	drawn.material_override = _wall_material(set_name)
	holder.add_child(drawn)


## [param run]'s stone plinth (489 amended) in [param holder] (the run's
## frame: x across, y up from [param base], z along): a band PLINTH_HEIGHT
## over its pad, PLINTH_PROUD wider than the wood's [param half] each side,
## its foot down to the lowest ground beside the run (on a slope, a taller
## footing downhill rather than a gap under the timber), its ends reaching
## half its width on past a corner, not into a door or the next plinth's run.
## A ruin's (649, _ruin_edges) is broken off: by half edges, each its own
## height (RUIN_PLINTH_LOW..HIGH) or gone (RUIN_PLINTH_MISSING), its end
## halves standing (RUIN_PLINTH_CORNER..whole), the wall piece over a gone
## half fallen with it (RUIN_FALL_TIP), a stone spilled off one edge in
## RUIN_SPILL_EVERY; its gaps have none, being no run.
func _add_plinth(holder: Node3D, run: Array[Vector3i], base: float, half: float) -> void:
	var out := half + PLINTH_PROUD
	var low := 0.0
	for key in run:
		for cell in Terrain.edge_cells(key):
			low = minf(low, _elevation(cell) - base)
	low -= PLINTH_PROUD
	var reach := func(key: Vector3i) -> float:
		var kind: int = _terrain["edges"].get(key, Terrain.Edge.OPEN)
		return 0.0 if kind == Terrain.Edge.DOOR or _plinths.has(key) and kind == Terrain.Edge.WALL else out
	var first := run[0]
	var last := run[-1]
	var step := Vector3i(0, 1, 0) if first.z == Terrain.EAST else Vector3i(1, 0, 0)
	var from: float = -reach.call(first - step)
	var to: float = run.size() + reach.call(last + step)
	# Its blocks [from, to, top]: one whole band, or a ruin's broken one.
	var blocks: Array[Vector3] = [Vector3(from, to, PLINTH_HEIGHT)]
	if run.any(func(key: Vector3i) -> bool: return _ruin_edges.has(key)):
		blocks.clear()
		for k in run.size():
			var key := run[k]
			var gone: Array[bool] = [false, false]
			for part in 2:
				var roll := _roll(Vector2i(key.x, key.y), 60 + key.z * 2 + part)
				var end := k == 0 and part == 0 or k == run.size() - 1 and part == 1
				if not end and _roll(Vector2i(key.x, key.y), 70 + key.z * 2 + part) < RUIN_PLINTH_MISSING:
					gone[part] = true
					continue
				var top := PLINTH_HEIGHT * (lerpf(RUIN_PLINTH_CORNER, 1.0, roll) if end else lerpf(RUIN_PLINTH_LOW, RUIN_PLINTH_HIGH, roll))
				blocks.append(Vector3(from if k == 0 and part == 0 else k + part * 0.5,
						to if k == run.size() - 1 and part == 1 else k + 0.5 + part * 0.5, top))
			# The wall piece over a gone half falls with it.
			var piece := holder.get_node_or_null("Piece_%d" % k) as Node3D
			if piece != null and gone[0] and gone[1]:
				piece.position.y -= PLINTH_HEIGHT
			elif piece != null and (gone[0] or gone[1]):
				piece.position.y -= PLINTH_HEIGHT * RUIN_FALL_TIP
				piece.rotation.x = atan2(PLINTH_HEIGHT * RUIN_FALL_TIP * 2.0, 1.0) * (1.0 if gone[1] else -1.0)
			if posmod(_edge_hash(key), RUIN_SPILL_EVERY) == 0 and ArtKit.has("scatter.stone"):
				var stone := ArtKit.instance("scatter.stone")
				var side := 1.0 if _roll(Vector2i(key.x, key.y), 64 + key.z) < 0.5 else -1.0
				stone.position = Vector3(side * (out + RUIN_SPILL_OUT), 0.0, k + _roll(Vector2i(key.x, key.y), 66 + key.z))
				stone.rotation.y = _roll(Vector2i(key.x, key.y), 68 + key.z) * TAU
				stone.name = "Spill_%d" % k
				holder.add_child(stone)
	var mesh := [PackedVector3Array(), PackedVector3Array(), PackedVector2Array(), PackedInt32Array()]
	for block in blocks:
		var top := block.z
		for side: float in [-1.0, 1.0]:
			var x := side * out
			_wall_quad(mesh, Vector3(x, low, block.x), Vector3(x, top, block.x), Vector3(x, top, block.y), Vector3(x, low, block.y),
					Vector3(side, 0.0, 0.0), false)
		_wall_quad(mesh, Vector3(-out, top, block.x), Vector3(out, top, block.x), Vector3(out, top, block.y),
				Vector3(-out, top, block.y), Vector3.UP, true)
		for end: float in [block.x, block.y]:
			_wall_quad(mesh, Vector3(-out, low, end), Vector3(out, low, end), Vector3(out, top, end), Vector3(-out, top, end),
					Vector3(0.0, 0.0, -1.0 if end == block.x else 1.0), false)
	var arrays := []
	arrays.resize(Mesh.ARRAY_MAX)
	arrays[Mesh.ARRAY_VERTEX] = mesh[0]
	arrays[Mesh.ARRAY_NORMAL] = mesh[1]
	arrays[Mesh.ARRAY_TEX_UV] = mesh[2]
	arrays[Mesh.ARRAY_INDEX] = mesh[3]
	var array_mesh := ArrayMesh.new()
	array_mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays)
	var drawn := MeshInstance3D.new()
	drawn.name = "Plinth"
	drawn.mesh = array_mesh
	drawn.material_override = _wall_material("stone")
	holder.add_child(drawn)


## A run of the cave set (286): rock in the run's frame (x across, y up,
## z along), its shape read from where it is in the world, so runs on one
## line meet without a seam: each column along it CAVE_ROWS points up each
## side, the profile's width at that height times a thickness that wanders
## along the line, pushed about; a ragged ridge on top; the run's own ends
## closed. A broken edge stands about half as tall, rubble as rubble does
## (WALL_RUBBLE_LOW to _HIGH). Faceted, coloured as the cliffs.
func _add_cave_run(run: Array[Vector3i], states: PackedInt32Array) -> void:
	var first := run[0]
	var east := first.z == Terrain.EAST
	var line := first.x + 0.5 if east else first.y + 0.5
	var start := _along(first) - 0.5
	var base := _edge_base(first)
	var count := run.size()
	var seed := _line_of(first)
	var wall_set := _wall_set(CAVE_SET)
	var profile: PackedVector2Array = wall_set["points"]
	var tall: float = wall_set["top"]
	var wander := not _outdoor and str(_terrain.get("mass", "")) == "rock"
	# Each column's top and width, and its points: left side up, the ridge,
	# right side down.
	var steps := count * CAVE_ALONG
	var columns: Array[PackedVector3Array] = []
	for step in steps + 1:
		var z := step / float(CAVE_ALONG)
		var along := start + z
		var top := INF
		for i: int in [floori(z - 0.001), floori(z + 0.001)]:
			if i < 0 or i >= count:
				continue
			var whole := lerpf(CAVE_TOP_LOW, CAVE_TOP_HIGH, _cave_noise(along, seed, 0))
			match states[i]:
				WALL_TOPLESS: top = minf(top, whole * 0.55)
				WALL_RUBBLE: top = minf(top, lerpf(WALL_RUBBLE_LOW, WALL_RUBBLE_HIGH, _cave_noise(along, seed, 2)))
				_: top = minf(top, whole)
		var thick := lerpf(CAVE_THICK_LOW, CAVE_THICK_HIGH, _cave_noise(along, seed, 1))
		# With the mass, the line wanders into the rock's side (none where
		# both or neither side is rock), back on its line at the run's ends.
		var shift := 0.0
		if wander:
			var side_a := _cave_rock_side(run[clampi(floori(z - 0.001), 0, count - 1)])
			var side_b := _cave_rock_side(run[clampi(floori(z + 0.001), 0, count - 1)])
			if side_a == side_b:
				shift = side_a * MASS_WANDER * _cave_noise(along, seed, 3) * smoothstep(0.0, 0.75, minf(z, count - z))
		var column := PackedVector3Array()
		for side: float in [-1.0, 1.0]:
			for r in CAVE_ROWS + 1:
				var row := r if side < 0.0 else CAVE_ROWS - r
				var v := row / float(CAVE_ROWS)
				var y := v * top
				var x := side * _profile_half(profile, v * tall) * thick
				if row > 0:
					var bump := _cave_bump(along, y, side, seed)
					x += bump.x * minf(1.0, y)
					y += bump.y if row < CAVE_ROWS else 0.0
				column.append(Vector3(clampf(x, -CAVE_REACH, CAVE_REACH) + shift, y, z))
			if side < 0.0:
				var ridge := _cave_bump(along, top, 0.0, seed)
				column.append(Vector3(clampf(ridge.x, -CAVE_REACH, CAVE_REACH) + shift, top + CAVE_RIDGE * (0.5 + ridge.y / CAVE_BUMP * 0.5), z))
		columns.append(column)
	var mesh := [PackedVector3Array(), PackedVector3Array(), PackedColorArray()]
	var points := columns[0].size()
	for step in steps:
		var a := columns[step]
		var b := columns[step + 1]
		# Up the left side, over the ridge, down the right.
		for k in points - 1:
			var out := Vector3(-1.0 if k <= CAVE_ROWS else 1.0, 0.0, 0.0)
			if k == CAVE_ROWS or k == CAVE_ROWS + 1:
				out = Vector3(out.x * 0.3, 1.0, 0.0)
			_rock_quad(mesh, a[k], b[k], b[k + 1], a[k + 1], out, 0.0, tall)
	# The run's ends: the column as a face.
	for end in 2:
		var column := columns[0 if end == 0 else steps]
		var out := Vector3(0.0, 0.0, -1.0 if end == 0 else 1.0)
		for k in CAVE_ROWS:
			_rock_quad(mesh, column[k], column[k + 1], column[points - 2 - k], column[points - 1 - k], out, 0.0, tall)
		_rock_quad(mesh, column[CAVE_ROWS], column[CAVE_ROWS + 1], column[CAVE_ROWS + 2], column[CAVE_ROWS], out, 0.0, tall)
	# Indoors only: in daylight the rock keeps its flat facets (the game's
	# look, the coordinator).
	if not _outdoor:
		_smooth_normals(mesh)
	var arrays := []
	arrays.resize(Mesh.ARRAY_MAX)
	arrays[Mesh.ARRAY_VERTEX] = mesh[0]
	arrays[Mesh.ARRAY_NORMAL] = mesh[1]
	arrays[Mesh.ARRAY_COLOR] = mesh[2]
	var array_mesh := ArrayMesh.new()
	array_mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays)
	var holder := Node3D.new()
	holder.position = Vector3(line, base, start) if east else Vector3(start, base, line)
	holder.rotation.y = 0.0 if east else PI * 0.5
	holder.name = "Wall_%d_%d_%s" % [first.x, first.y, "e" if east else "s"]
	var drawn := MeshInstance3D.new()
	drawn.name = "Body"
	drawn.mesh = array_mesh
	drawn.material_override = _rock_material()
	holder.add_child(drawn)
	_room.add_child(holder)
	for key in run:
		_walls[key] = holder


## Which side of the cave wall at [param key] is rock (not open land), in its
## run's frame (+1 its +x side, -1 its -x side), or 0 when both or neither are.
## An east edge's +x is the cell east of it; a south edge's run is turned a
## quarter, so its +x is the cell north of it (key's own cell).
func _cave_rock_side(key: Vector3i) -> float:
	var cell := Vector2i(key.x, key.y)
	var plus := cell + Vector2i(1, 0) if key.z == Terrain.EAST else cell
	var minus := cell if key.z == Terrain.EAST else cell + Vector2i(0, 1)
	var plus_rock := not _land.has(plus)
	var minus_rock := not _land.has(minus)
	if plus_rock == minus_rock:
		return 0.0
	return 1.0 if plus_rock else -1.0


## A quad a b c d of rock into [param mesh] ([positions, normals, colours]),
## as two flat facets facing [param out], each its own shade of the cliffs'
## rock, darker toward the foot ([param low] to [param high]).
func _rock_quad(mesh: Array, a: Vector3, b: Vector3, c: Vector3, d: Vector3, out: Vector3, low: float, high: float) -> void:
	for triangle: Array in [[a, b, c], [a, c, d]]:
		var p0: Vector3 = triangle[0]
		var p1: Vector3 = triangle[1]
		var p2: Vector3 = triangle[2]
		var normal := (p1 - p0).cross(p2 - p0)
		if normal.length_squared() < 0.0000001:
			continue
		normal = normal.normalized()
		if normal.dot(out) < 0.0:
			normal = -normal
			var swap := p1
			p1 = p2
			p2 = swap
		var middle := (p0 + p1 + p2) / 3.0
		var shade := lerpf(0.8, 1.15, _roll(Vector2i(roundi(middle.x * 16.0) + roundi(middle.y * 16.0) * 131, roundi(middle.z * 16.0)), 38))
		shade *= lerpf(0.72, 1.0, clampf(inverse_lerp(low, high, middle.y), 0.0, 1.0))
		var colour := Color(swatch(CLIFF_ROCK.x, CLIFF_ROCK.y) * shade, 1.0)
		if not _outdoor:
			colour = Color(colour * CAVE_INDOOR_SHADE * CAVE_INDOOR_TINT, 1.0)
		mesh[0].append_array([p0, p1, p2])
		mesh[1].append_array([normal, normal, normal])
		mesh[2].append_array([colour, colour, colour])


## Every point of [param mesh] ([positions, normals, ...], triangles) lit by
## the mean of its facets' normals there, its own facet's kept at
## CAVE_FACET_KEEP: a lamp on a wall lights it at a graze, and facet normals
## lit one triangle of each bent quad and left the other black; wholly
## smooth, a lamp's rim went one flat pale (the coordinator), so a little of
## each facet's own turn stays (769 amended (7)).
const CAVE_FACET_KEEP := 0.35
## Indoors, the cave rock this much darker and warmer, lamp-lit earth: a
## near lamp washed its rims pale as plaster, snow on a ledge, at the
## cliffs' shade (the coordinator; environment's lamps stay as bright, so
## the floor keeps their light).
const CAVE_INDOOR_SHADE := 0.4
const CAVE_INDOOR_TINT := Color(1.1, 0.92, 0.72)


static func _smooth_normals(mesh: Array) -> void:
	var positions: PackedVector3Array = mesh[0]
	var normals: PackedVector3Array = mesh[1]
	var sums := {}
	for k in positions.size():
		var key := Vector3i((positions[k] * 1000.0).round())
		sums[key] = sums.get(key, Vector3.ZERO) + normals[k]
	for k in positions.size():
		var sum: Vector3 = sums[Vector3i((positions[k] * 1000.0).round())]
		if sum.length_squared() > 0.000001:
			normals[k] = (sum.normalized() + normals[k] * CAVE_FACET_KEEP).normalized()
	mesh[1] = normals


## A lump of the cave's rock at [param vertex] (its post, while wall.cave.end
## has no art): CAVE_LUMP_SIDES round, as wide as the walls are at their
## thickest, as tall as they are there, pushed about as they are.
func _cave_lump(vertex: Vector2i) -> Node3D:
	var wall_set := _wall_set(CAVE_SET)
	var profile: PackedVector2Array = wall_set["points"]
	var tall: float = wall_set["top"]
	var seed := Vector2i(vertex.x * 7, vertex.y * 13)
	var top := lerpf(CAVE_TOP_LOW, CAVE_TOP_HIGH, _cave_noise(vertex.x * 1.7 + vertex.y, seed, 0)) + CAVE_RIDGE
	var rings: Array[PackedVector3Array] = []
	for r in CAVE_ROWS + 1:
		var v := r / float(CAVE_ROWS)
		var ring := PackedVector3Array()
		var radius := minf(_profile_half(profile, v * tall) * CAVE_THICK_HIGH, CAVE_REACH) if r < CAVE_ROWS else 0.08
		for k in CAVE_LUMP_SIDES:
			var angle := TAU * k / CAVE_LUMP_SIDES
			var bump := _cave_bump(angle * 3.0 + vertex.x, v * top, 1.0, seed) if r > 0 else Vector2.ZERO
			var reach := clampf(radius + bump.x, 0.05, CAVE_REACH)
			ring.append(Vector3(cos(angle) * reach, v * top + (bump.y if r > 0 and r < CAVE_ROWS else 0.0), sin(angle) * reach))
		rings.append(ring)
	var mesh := [PackedVector3Array(), PackedVector3Array(), PackedColorArray()]
	for r in CAVE_ROWS:
		for k in CAVE_LUMP_SIDES:
			var next := (k + 1) % CAVE_LUMP_SIDES
			var middle := (rings[r][k] + rings[r][next]) * 0.5
			_rock_quad(mesh, rings[r][k], rings[r][next], rings[r + 1][next], rings[r + 1][k], Vector3(middle.x, 0.2, middle.z), 0.0, top)
	# Its top closed.
	var peak := Vector3(0.0, top + CAVE_RIDGE, 0.0)
	for k in CAVE_LUMP_SIDES:
		_rock_quad(mesh, rings[CAVE_ROWS][k], rings[CAVE_ROWS][(k + 1) % CAVE_LUMP_SIDES], peak, peak, Vector3.UP, 0.0, top)
	var arrays := []
	arrays.resize(Mesh.ARRAY_MAX)
	arrays[Mesh.ARRAY_VERTEX] = mesh[0]
	arrays[Mesh.ARRAY_NORMAL] = mesh[1]
	arrays[Mesh.ARRAY_COLOR] = mesh[2]
	var array_mesh := ArrayMesh.new()
	array_mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays)
	var holder := Node3D.new()
	var drawn := MeshInstance3D.new()
	drawn.name = "Body"
	drawn.mesh = array_mesh
	drawn.material_override = _rock_material()
	holder.add_child(drawn)
	return holder


## How wide [param profile] is either side of its middle at [param y] (the
## widest of where its sides cross that height).
static func _profile_half(profile: PackedVector2Array, y: float) -> float:
	var half := 0.0
	for k in profile.size():
		var p := profile[k]
		var q := profile[(k + 1) % profile.size()]
		if (p.y <= y and q.y >= y or q.y <= y and p.y >= y) and p.y != q.y:
			half = maxf(half, absf(lerpf(p.x, q.x, (y - p.y) / (q.y - p.y))))
		elif is_equal_approx(p.y, y):
			half = maxf(half, absf(p.x))
	return half


## Smooth noise 0..1 along a line of the cave's walls ([param seed] the
## line, [param channel] which wander: 0 the top, 1 the thickness, 2
## rubble's top), the same for every run on the line.
static var _cave_noise_source: FastNoiseLite


static func _cave_noise(along: float, seed: Vector2i, channel: int) -> float:
	if _cave_noise_source == null:
		_cave_noise_source = FastNoiseLite.new()
		_cave_noise_source.noise_type = FastNoiseLite.TYPE_SIMPLEX_SMOOTH
		_cave_noise_source.seed = 286
		_cave_noise_source.frequency = 0.45
	var value := _cave_noise_source.get_noise_2d(along, seed.x * 37.0 + seed.y * 11.3 + channel * 101.0)
	return clampf(value * 0.5 + 0.5, 0.0, 1.0)


## How far a cave wall's point is pushed (across, up), by where it is alone
## (its place along, its height, its side), so the runs that share it push
## it alike.
static func _cave_bump(along: float, y: float, side: float, seed: Vector2i) -> Vector2:
	var key := Vector2i(roundi(along * 64.0) * 3 + roundi(side) + 1, seed.x * 100003 + seed.y)
	var level := roundi(y * 32.0)
	return Vector2((_roll(key, level) - 0.5) * 2.0, (_roll(key, level + 5) - 0.5) * 0.6) * CAVE_BUMP


## The rock's material: the cliffs' (vertex colour, flat facets), made once.
static var _rock: StandardMaterial3D


static func _rock_material() -> StandardMaterial3D:
	if _rock == null:
		_rock = StandardMaterial3D.new()
		_rock.vertex_color_use_as_albedo = true
		_rock.roughness = 1.0
		_rock.cull_mode = BaseMaterial3D.CULL_DISABLED
	return _rock


static var _mass: StandardMaterial3D


## The rock mass's (769 amended (7)): the cliffs' rock unlit, its facets'
## own shades only (MASS_UNLIT).
static func _mass_material() -> StandardMaterial3D:
	if _mass == null:
		_mass = StandardMaterial3D.new()
		_mass.vertex_color_use_as_albedo = true
		_mass.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
		_mass.vertex_color_is_srgb = true
		_mass.cull_mode = BaseMaterial3D.CULL_DISABLED
	return _mass


## A run's mesh leant across by [param shear] (metres across a metre up:
## the base stays on its line) and its points pushed across and up by up to
## [param jitter] metres, the same push wherever a point is shared, so no
## seam opens; the normals turned with the lean.
func _wall_bend(mesh: Array, shear: float, jitter: float, first: Vector3i) -> void:
	if shear == 0.0 and jitter <= 0.0:
		return
	var positions: PackedVector3Array = mesh[0]
	var normals: PackedVector3Array = mesh[1]
	for k in positions.size():
		var p := positions[k]
		if jitter > 0.0 and p.y > 0.001:
			var at := Vector2i(roundi(p.x * 997.0) + roundi(p.y * 991.0) * 31 + first.x * 7 + first.y * 13, roundi(p.z * 983.0))
			p += Vector3(_roll(at, 36) - 0.5, (_roll(at, 37) - 0.5) * 0.5, 0.0) * 2.0 * jitter
		p.x += p.y * shear
		positions[k] = p
		var n := normals[k]
		normals[k] = Vector3(n.x, n.y - n.x * shear, n.z).normalized()
	mesh[0] = positions
	mesh[1] = normals


## How tall the body under the cap stands at [param key]'s end [param end]
## (0 its start, 1 its end): a height at every WALL_SWAY-th vertex along
## the line, up to [param sway] of [param cap] either way, straight
## between, so neighbouring runs on one line agree.
func _wall_height(key: Vector3i, end: int, cap: float, sway_by: float) -> float:
	var at := _along(key) + end
	var before := at - posmod(at, WALL_SWAY)
	var after := before + WALL_SWAY
	var line := Vector2i(key.x if key.z == Terrain.EAST else key.y, key.z)
	var sway := func(along: int) -> float: return (_roll(Vector2i(line.x * 7 + line.y, along), 24) - 0.5) * 2.0 * sway_by
	return cap * (1.0 + lerpf(sway.call(before), sway.call(after), float(at - before) / WALL_SWAY))


## A profile height as drawn: the body (under [param cap]) stretched to
## [param body], the band above it as it is.
static func _profile_y(y: float, cap: float, body: float) -> float:
	return y * body / cap if y <= cap else body + (y - cap)


## A broken or rubble edge [param i] of [param run]: a slab [param wall_half]
## a side with a ragged top (lower, wider and lumpier for rubble), over
## WALL_BROKEN_STEPS steps.
func _wall_broken(mesh: Array, i: int, run: Array[Vector3i], states: PackedInt32Array, cap: float, wall_half: float, sway: float) -> void:
	var key := run[i]
	var rubble := states[i] == WALL_RUBBLE
	var half := wall_half + WALL_RUBBLE_SPREAD if rubble else wall_half
	var heights := PackedFloat32Array()
	var lean := PackedFloat32Array()
	for step in WALL_BROKEN_STEPS + 1:
		var cell := Vector2i(_along(key) * WALL_BROKEN_STEPS + step, key.x + key.y * 7 + key.z * 13)
		var roll := _roll(cell, 26)
		if rubble:
			heights.append(lerpf(WALL_RUBBLE_LOW, WALL_RUBBLE_HIGH, roll))
		elif step == 0 and i > 0 and states[i - 1] == WALL_WHOLE:
			heights.append(_wall_height(key, 0, cap, sway) * 0.85)
		elif step == WALL_BROKEN_STEPS and i < run.size() - 1 and states[i + 1] == WALL_WHOLE:
			heights.append(_wall_height(key, 1, cap, sway) * 0.85)
		else:
			heights.append(cap * lerpf(WALL_BROKEN_LOW, WALL_BROKEN_HIGH, roll))
		lean.append((_roll(cell, 28) - 0.5) * (0.24 if rubble else 0.0))
	for step in WALL_BROKEN_STEPS:
		var s0 := i + step / float(WALL_BROKEN_STEPS)
		var s1 := i + (step + 1) / float(WALL_BROKEN_STEPS)
		var h0 := heights[step]
		var h1 := heights[step + 1]
		var l0 := lean[step]
		var l1 := lean[step + 1]
		for side: float in [-1.0, 1.0]:
			_wall_quad(mesh, Vector3(side * half, 0.0, s0), Vector3(side * half, 0.0, s1),
					Vector3(side * half * 0.8 + l1, h1, s1), Vector3(side * half * 0.8 + l0, h0, s0), Vector3(side, 0.0, 0.0), false)
		_wall_quad(mesh, Vector3(-half * 0.8 + l0, h0, s0), Vector3(half * 0.8 + l0, h0, s0),
				Vector3(half * 0.8 + l1, h1, s1), Vector3(-half * 0.8 + l1, h1, s1), Vector3(0.0, 1.0, 0.0), true)
	# Its ends, where what is beside it is not the same slab.
	for end in 2:
		var other := i - 1 if end == 0 else i + 1
		if other >= 0 and other < run.size() and states[other] == states[i]:
			continue
		var s := float(i + end)
		var h := heights[0 if end == 0 else WALL_BROKEN_STEPS]
		var l := lean[0 if end == 0 else WALL_BROKEN_STEPS]
		_wall_quad(mesh, Vector3(-half, 0.0, s), Vector3(half, 0.0, s), Vector3(half * 0.8 + l, h, s),
				Vector3(-half * 0.8 + l, h, s), Vector3(0.0, 0.0, -1.0 if end == 0 else 1.0), false)


## A whole run's end at [param s]: the profile as a face, [param body] tall,
## facing [param facing] along the run (in the run's frame).
func _wall_cap(mesh: Array, s: float, points: PackedVector2Array, faces: PackedInt32Array, cap: float, body: float, facing: float) -> void:
	var positions: PackedVector3Array = mesh[0]
	var normal := Vector3(0.0, 0.0, facing)
	for t in range(0, faces.size(), 3):
		var a := points[faces[t]]
		var b := points[faces[t + 1]]
		var c := points[faces[t + 2]]
		var first := positions.size()
		var pa := Vector3(a.x, _profile_y(a.y, cap, body), s)
		var pb := Vector3(b.x, _profile_y(b.y, cap, body), s)
		var pc := Vector3(c.x, _profile_y(c.y, cap, body), s)
		if (pc - pa).cross(pb - pa).dot(normal) < 0.0:
			var swap := pb
			pb = pc
			pc = swap
		positions.append(pa)
		positions.append(pb)
		positions.append(pc)
		for k in 3:
			mesh[1].append(normal)
		mesh[2].append(Vector2(pa.x, pa.y) / WALL_TILE)
		mesh[2].append(Vector2(pb.x, pb.y) / WALL_TILE)
		mesh[2].append(Vector2(pc.x, pc.y) / WALL_TILE)
		mesh[3].append(first)
		mesh[3].append(first + 1)
		mesh[3].append(first + 2)
	mesh[0] = positions


## A quad a b c d into [param mesh], in a run's frame (x across, y up, z
## along), facing [param out]; its texture by metres: along and up on a
## side, along and across on a top ([param flat]).
func _wall_quad(mesh: Array, a: Vector3, b: Vector3, c: Vector3, d: Vector3, out: Vector3, flat: bool) -> void:
	if (c - a).cross(b - a).dot(out) < 0.0:
		var swap := b
		b = d
		d = swap
	var face := (c - a).cross(b - a)
	var normal := face.normalized() if face.length_squared() > 0.0000001 else out.normalized()
	var positions: PackedVector3Array = mesh[0]
	var normals: PackedVector3Array = mesh[1]
	var uvs: PackedVector2Array = mesh[2]
	var indices: PackedInt32Array = mesh[3]
	var first := positions.size()
	positions.append(a)
	positions.append(b)
	positions.append(c)
	positions.append(d)
	normals.append(normal)
	normals.append(normal)
	normals.append(normal)
	normals.append(normal)
	if flat:
		uvs.append(Vector2(a.z, a.x) / WALL_TILE)
		uvs.append(Vector2(b.z, b.x) / WALL_TILE)
		uvs.append(Vector2(c.z, c.x) / WALL_TILE)
		uvs.append(Vector2(d.z, d.x) / WALL_TILE)
	else:
		uvs.append(Vector2(a.z, a.y) / WALL_TILE)
		uvs.append(Vector2(b.z, b.y) / WALL_TILE)
		uvs.append(Vector2(c.z, c.y) / WALL_TILE)
		uvs.append(Vector2(d.z, d.y) / WALL_TILE)
	indices.append(first)
	indices.append(first + 1)
	indices.append(first + 2)
	indices.append(first)
	indices.append(first + 2)
	indices.append(first + 3)
	mesh[0] = positions
	mesh[1] = normals
	mesh[2] = uvs
	mesh[3] = indices


## A wall set from the art slots (wall.<set>.profile): its points (x
## across, y up), its cap_y (the top, for the cave's, which has none: all
## body), its face as triangles (indices into the points), its half
## thickness, and its variation (sway, broken, gap, lean, jitter, sag; 0
## where it says none); made once a set.
static var _sets: Dictionary[String, Dictionary] = {}


static func _wall_set(set_name: String) -> Dictionary:
	if not _sets.has(set_name):
		var spec := ArtKit.spec("wall.%s.profile" % set_name)
		var points := PackedVector2Array()
		var top := 0.0
		var half := 0.0
		for each: Array in spec.get("points", [[-0.25, 0.0], [0.25, 0.0], [0.25, 3.0], [-0.25, 3.0]]):
			points.append(Vector2(each[0], each[1]))
			top = maxf(top, float(each[1]))
			half = maxf(half, absf(float(each[0])))
		var given: Dictionary = spec.get("variation", {})
		var variation := {}
		for key: String in ["sway", "broken", "gap", "lean", "jitter", "sag"]:
			variation[key] = float(given.get(key, 0.0))
		_sets[set_name] = {"points": points, "cap": float(spec.get("cap_y", top)), "faces": Geometry2D.triangulate_polygon(points),
				"half": half, "top": top, "variation": variation}
	return _sets[set_name]


## A set's walls' material: material.wall.<set>'s texture if it has one,
## else courses made here (_stone_courses) in its swatch (WALL_LOOKS); a
## plain StandardMaterial3D, so a near run's see-through copy is made as
## any other's (_see_through_of). One a set.
static var _wall_stones: Dictionary[String, StandardMaterial3D] = {}


static func _wall_material(set_name: String) -> StandardMaterial3D:
	if not _wall_stones.has(set_name):
		var look: Array = WALL_LOOKS.get(set_name, WALL_LOOKS[DEFAULT_SET])
		var material := StandardMaterial3D.new()
		var own := ArtKit.texture("material.wall." + set_name)
		material.albedo_texture = own if own != null else _stone_courses(look[1], look[2], look[3], 0 if set_name == DEFAULT_SET else set_name.hash())
		material.albedo_color = Color.WHITE if own != null else swatch(look[0].x, look[0].y)
		material.roughness = 0.9
		material.texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS
		_wall_stones[set_name] = material
	return _wall_stones[set_name]


## Courses of stone blocks (or planks), WALL_TILE metres square, tiling:
## [param rows] rows of blocks [param shortest] to [param longest] of the
## tile long, each its own shade, mortar between; [param salt] for a set's
## own (0: the castle's, as it always was).
static func _stone_courses(rows: int, shortest: float, longest: float, salt: int) -> ImageTexture:
	var size := 128
	var bytes := PackedByteArray()
	bytes.resize(size * size * 3)
	for row in rows:
		var top := row * size / rows
		var bottom := (row + 1) * size / rows
		# The row's joints across, from a shift so rows do not line up.
		var joints: Array[int] = []
		var x := int(_roll(Vector2i(row, 1 + salt), 30) * size * 0.5)
		var end := x + size
		while x < end - size * 0.15:
			joints.append(x % size)
			x += int(lerpf(shortest, longest, _roll(Vector2i(row, x + salt), 31)) * size)
		for y in range(top, bottom):
			for px in size:
				# The block: the last joint at or before px, round the tile.
				var block := joints.size() - 1
				var gap := size
				for k in joints.size():
					var behind := posmod(px - joints[k], size)
					if behind < gap:
						gap = behind
						block = k
				var mortar := y - top < 2 or gap < 2
				var shade := 0.78 if mortar else lerpf(0.9, 1.0, _roll(Vector2i(row, block + salt), 32)) * lerpf(0.97, 1.0, _roll(Vector2i(px, y), 33))
				var value := int(shade * 255.0)
				var at := (y * size + px) * 3
				bytes[at] = value
				bytes[at + 1] = value
				bytes[at + 2] = value
	var image := Image.create_from_data(size, size, false, Image.FORMAT_RGB8, bytes)
	image.generate_mipmaps()
	return ImageTexture.create_from_image(image)


## A door.single on the edge, its leaf (DOOR_LEAF) hinged at the edge's
## start end and swinging with the Door node, and an Area3D over the module
## for picking. Its frame (DOOR_FRAME) fades with its wall's run. With
## [param pair] the next edge along (_double_doors), a door.double over
## both instead (decision 403): each edge's Door still its own, swinging the
## leaf on its half, picked by its own area.
func _add_doorway(key: Vector3i, pair := key) -> void:
	var double := pair != key
	var doorway := Node3D.new()
	doorway.name = "Door_%d_%d_%s" % [key.x, key.y, "e" if key.z == Terrain.EAST else "s"]
	doorway.position = (_edge_midpoint(key) + _edge_midpoint(pair)) * 0.5 + Vector3(0.0, _edge_base(key), 0.0)
	doorway.rotation.y = _edge_yaw(key)
	var variant := int(DOOR_VARIANTS.get(_set_of(key), 1))
	if double and _crypt_doors():
		variant = CRYPT_DOUBLE_VARIANT
	var piece := ArtKit.instance("door.double" if double else "door.single", variant)
	piece.name = "Door"
	piece.set_meta("variant", variant)
	doorway.add_child(piece)
	var keys: Array[Vector3i] = [key]
	if double:
		keys.append(pair)
	# In a wall taller than the frame (a building's wall_height), the wall
	# goes on over it: a lintel of the wall's set, in the frame's Body so it
	# fades with it.
	var tall := _doorway_height(key)
	if tall > WALL_HEIGHT and piece.has_node("Body"):
		var wall_set := _wall_set(_set_of(key))
		var lintel := MeshInstance3D.new()
		lintel.name = "Lintel"
		var block := BoxMesh.new()
		block.size = Vector3(float(wall_set["half"]) * 2.0, tall - WALL_HEIGHT, float(keys.size()))
		lintel.mesh = block
		lintel.material_override = _wall_material(_set_of(key))
		lintel.position.y = (tall + WALL_HEIGHT) * 0.5
		piece.get_node("Body").add_child(lintel)
	for each in keys:
		# Where the edge's half lies along the doorway (its local z).
		var along := (doorway.transform.affine_inverse() * _edge_midpoint(each)).z if double else 0.0
		if not double:
			_door_hinges[each] = [doorway.get_node(DOOR_LEAF), PI * 0.5, true]
		elif along < 0.0:
			_door_hinges[each] = [piece.get_node("leaf_a"), PI * 0.5, true]
		else:
			_door_hinges[each] = [piece.get_node("leaf_b"), -PI * 0.5, false]
		_doorways[each] = doorway
		if _glimpse:
			continue  # Nothing in a glimpse is picked.
		var area := Area3D.new()
		area.name = "Pick" if not double else "Pick_%d_%d" % [each.x, each.y]
		area.set_meta("door", each)
		var shape := CollisionShape3D.new()
		var box := BoxShape3D.new()
		box.size = Vector3(WALL_THICKNESS, WALL_HEIGHT, 1.0)
		shape.shape = box
		shape.position = Vector3(0.0, WALL_HEIGHT * 0.5, along)
		area.add_child(shape)
		doorway.add_child(area)
	_room.add_child(doorway)


## The doorways drawn as one door.double (decision 403): a building's door
## edges side by side on its outline, and in a generated level's halls
## every door edge's (725), two at a time from each run's start
## (Level.door_pairs; a third left a door.single), and in a building's
## inside (Level terrain "interior") every door edge's, as its outline's
## outside (its front door's inside, Jeff: "no door to exit"). First edge
## -> the next along.
func _double_doors() -> Dictionary[Vector3i, Vector3i]:
	var edges: Dictionary = _terrain["edges"]
	var door := func(key: Vector3i) -> bool:
		return edges.get(key, Terrain.Edge.OPEN) == Terrain.Edge.DOOR and not _niche_at.has(key)
	if _generated_doors() or bool(_terrain.get("interior", false)):
		return Level.door_pairs(edges.keys(), door)  # 725: every pair in a generated level's halls; an inside's.
	var out: Dictionary[Vector3i, Vector3i] = {}
	for building: Dictionary in _drawn_buildings():
		out.merge(Level.door_pairs(Level.building_outline(building), door))
	return out


## Whether this map is a generated barrow (725: its regenerate block's
## style "barrow"), its double doors the crypt's.
func _crypt_doors() -> bool:
	var level := str(_terrain.get("level", ""))
	var block: Variant = Level.template_config(level).get("regenerate")
	return block is Dictionary and str((block as Dictionary).get("style", "")) == "barrow"


## Whether this map's doors are all the generator's (725: a regenerating
## level's halls), every pair of them a door.double, not only a building's.
func _generated_doors() -> bool:
	return Level.regenerates(str(_terrain.get("level", "")))


## How tall the wall a doorway stands in is: the tallest of the walls on
## its line either side of it (a building's outline: _wall_heights), else
## WALL_HEIGHT.
func _doorway_height(key: Vector3i) -> float:
	var step := Vector3i(0, 1, 0) if key.z == Terrain.EAST else Vector3i(1, 0, 0)
	var tall := _height_of(key)
	for side: Vector3i in [step, -step]:
		var next := key + side
		while _terrain["edges"].get(next, Terrain.Edge.OPEN) == Terrain.Edge.DOOR:
			next += side
		if _terrain["edges"].get(next, Terrain.Edge.OPEN) == Terrain.Edge.WALL:
			tall = maxf(tall, _height_of(next))
	return tall


## A post where walls meet at an angle, or a wall ends; none along a
## straight run.
static func _needs_post(vertex: Vector2i, kind_at: Callable) -> bool:
	var directions: Array[Vector2] = []
	for entry: Array in WallEdge.edges_at_vertex(vertex):
		var kind: int = kind_at.call(entry[0])
		if kind == Terrain.Edge.OPEN:
			continue
		directions.append(WallEdge.away_from(entry[0], entry[1]))
	if directions.size() != 2:
		return true
	return directions[0].dot(directions[1]) > -0.9


## Whether walls of two sets, or two heights, meet at [param vertex]: a
## post between them, so the step from one to the other is not seen.
func _sets_meet(vertex: Vector2i) -> bool:
	var seen := ""
	for entry: Array in WallEdge.edges_at_vertex(vertex):
		var key: Vector3i = entry[0]
		if _terrain["edges"].get(key, Terrain.Edge.OPEN) != Terrain.Edge.WALL or _outdoor and _is_outline(key):
			continue
		var look := "%s %s" % [_set_of(key), _height_of(key)]
		if seen != "" and look != seen:
			return true
		seen = look
	return false


## The set a post at [param vertex] is in: the thickest of its walls'.
func _post_set(vertex: Vector2i) -> String:
	var out := _walls_set
	var widest := -1.0
	for entry: Array in WallEdge.edges_at_vertex(vertex):
		var key: Vector3i = entry[0]
		if _terrain["edges"].get(key, Terrain.Edge.OPEN) == Terrain.Edge.OPEN:
			continue
		var half: float = _wall_set(_set_of(key))["half"]
		if half > widest:
			widest = half
			out = _set_of(key)
	return out


## A post in its set (_post_set): wall.<set>.post, or .end for a set with
## no post (the cave's); a column of the set's own stone where the slot has
## no art yet.
func _add_post(vertex: Vector2i) -> void:
	var post: Node3D
	var set_name := _post_set(vertex)
	var slot := "wall.%s.post" % set_name if ArtKit.has("wall.%s.post" % set_name) else "wall.%s.end" % set_name
	# A low ruin's pier (827), as art-kit made it.
	var pier := RUIN_LOW_END % set_name
	if _has_art(pier) and WallEdge.edges_at_vertex(vertex).any(func(entry: Array) -> bool: return _wall_states.get(entry[0]) == "low_ruin"):
		var low := ArtKit.instance(pier, 1 + posmod(_cell_hash(vertex), maxi(1, ArtKit.variant_count(pier))))
		low.name = "Post_%d_%d" % [vertex.x, vertex.y]
		var floor_at := 0.0
		for corner: Vector2i in [vertex, vertex - Vector2i(1, 0), vertex - Vector2i(0, 1), vertex - Vector2i(1, 1)]:
			floor_at = maxf(floor_at, _elevation(corner))
		for entry: Array in WallEdge.edges_at_vertex(vertex):
			if _pad_cell.has(entry[0]):
				floor_at = _elevation(_pad_cell[entry[0]])
				break
		low.position = Vector3(vertex.x - 0.5, floor_at, vertex.y - 0.5)
		_room.add_child(low)
		_posts[vertex] = low
		return
	# As tall as the tallest wall at it: the set's _tall piece where it has
	# art, else the post stretched; squeezed where every wall at it is lower
	# than a storey (a lean-to's, decision 489), so it stands no higher.
	var tall := 0.0
	for entry: Array in WallEdge.edges_at_vertex(vertex):
		if _terrain["edges"].get(entry[0], Terrain.Edge.OPEN) != Terrain.Edge.OPEN and not _wall_states.get(entry[0]) in ["plot", "rubble"] \
				and not _ruin_edges.has(entry[0]):
			tall = maxf(tall, _height_of(entry[0]))
	if tall <= 0.0:
		tall = WALL_HEIGHT
	var stretch := 1.0
	if tall > WALL_HEIGHT:
		var tall_slot := slot + "_tall"
		if ArtKit.has(tall_slot) and ArtKit.filled_by(tall_slot) != "placeholder":
			slot = tall_slot
		else:
			stretch = tall / WALL_HEIGHT
	elif tall < WALL_HEIGHT:
		stretch = tall / WALL_HEIGHT
	if BOX_WALLS:
		post = _box(Vector3(POST_SIZE, tall, POST_SIZE), _stone_opaque)
	elif set_name == CAVE_SET and (not ArtKit.has(slot) or ArtKit.filled_by(slot) == "placeholder"):
		post = _cave_lump(vertex)
	elif not ArtKit.has(slot) or ArtKit.filled_by(slot) == "placeholder" and set_name != DEFAULT_SET:
		var wall_set := _wall_set(set_name)
		var side: float = wall_set["half"] * 2.0
		post = _box(Vector3(side, wall_set["top"] + tall - WALL_HEIGHT, side), _wall_material(set_name))
	else:
		post = ArtKit.instance(slot)
		post.scale.y = stretch
	post.name = "Post_%d_%d" % [vertex.x, vertex.y]
	var base := 0.0
	for corner: Vector2i in [vertex, vertex - Vector2i(1, 0), vertex - Vector2i(0, 1), vertex - Vector2i(1, 1)]:
		base = maxf(base, _elevation(corner))
	# A kind building's on its pad (_pad_cell).
	for entry: Array in WallEdge.edges_at_vertex(vertex):
		if _pad_cell.has(entry[0]):
			base = _elevation(_pad_cell[entry[0]])
			break
	post.position = Vector3(vertex.x - 0.5, base, vertex.y - 0.5)
	_room.add_child(post)
	_posts[vertex] = post


## Fire on the ground: a ragged glowing patch (fire.gdshader) wider than
## its cell, so cells of fire side by side run together; one mesh for all.
static var _fire_mesh: PlaneMesh


func _add_fire(cell: Vector2i) -> void:
	torch_cells.append(cell)
	if _fire_mesh == null:
		_fire_mesh = PlaneMesh.new()
		_fire_mesh.size = Vector2(FIRE_SPREAD, FIRE_SPREAD)
		var material := ShaderMaterial.new()
		material.shader = FIRE_SHADER
		material.set_shader_parameter("fire", FIRE)
		_fire_mesh.material = material
	var quad := MeshInstance3D.new()
	quad.name = "Fire_%d_%d" % [cell.x, cell.y]
	quad.mesh = _fire_mesh
	quad.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	quad.position = _tile_position(cell) + Vector3(0.0, ON_FLOOR, 0.0)
	quad.rotation.y = _roll(cell, 6) * TAU
	_room.add_child(quad)
	# Its flames (decision 523), at places in the cell by the cell.
	var flames := FIRE_FLAMES.x + floori(_roll(cell, 143) * (FIRE_FLAMES.y - FIRE_FLAMES.x + 1))
	for n in flames:
		var off := Vector2(_roll(cell, 144 + n * 3), _roll(cell, 145 + n * 3)) - Vector2(0.5, 0.5)
		var size := lerpf(FIRE_FLAME_SIZES.x, FIRE_FLAME_SIZES.y, _roll(cell, 146 + n * 3))
		var flame := Flames.light(quad, Vector3(off.x * 0.6, 0.0, off.y * 0.6), size, hash(Vector3i(cell.x, cell.y, n)))
		flame.name = "Flame%d" % n
	var light := OmniLight3D.new()
	light.light_color = FIRE
	light.light_energy = 1.5
	light.omni_range = 2.5
	light.position = _tile_position(cell) + Vector3(0.0, 0.5, 0.0)
	_room.add_child(light)
	_fire_lights.append([light, light.light_energy, _roll(cell, 147) * TAU, Flames.FIRE_FLICKER])


## Fire's drawn lights each frame (decision 523): each flickers on its own
## phase (Flames.flicker) and, outdoors, fades by day where the sky reaches
## (Flames.day_share). World's light (Fields) is never touched: it stays
## steady for Senses.
func _flicker_fires(delta: float) -> void:
	if _fire_lights.is_empty() and _lamp_lights.is_empty() and _forge_lights.is_empty():
		return
	_fire_time += delta
	for lamp: Array in _lamp_lights:
		var cold := lamp[0] as OmniLight3D
		if is_instance_valid(cold):
			cold.light_energy = float(lamp[1]) * lerpf(LAMP_PULSE_LOW, 1.0, 0.5 + 0.5 * sin(TAU * _fire_time / LAMP_PERIOD + float(lamp[2])))
	var share := Flames.day_share(_look_daylight, _outdoor, World.fields.canopy_shade if World.fields != null else 0.0)
	for fire: Array in _fire_lights:
		var light := fire[0] as OmniLight3D
		if is_instance_valid(light):
			light.light_energy = float(fire[1]) * share * Flames.flicker(_fire_time, float(fire[2]), float(fire[3]))
	_flicker_forges()


# --- The night town (782) --------------------------------------------------------

## The cells of [param cells] in clusters of cells touching (side or
## corner), each cluster in the order its cells were met.
static func fire_clusters(cells: Array[Vector2i]) -> Array[Array]:
	var left: Dictionary[Vector2i, bool] = {}
	for cell in cells:
		left[cell] = true
	var out: Array[Array] = []
	for start in cells:
		if not left.has(start):
			continue
		left.erase(start)
		var cluster: Array[Vector2i] = [start]
		var i := 0
		while i < cluster.size():
			var at := cluster[i]
			i += 1
			for dx in range(-1, 2):
				for dy in range(-1, 2):
					var next := at + Vector2i(dx, dy)
					if left.has(next):
						left.erase(next)
						cluster.append(next)
		out.append(cluster)
	return out


## Outdoors, one warm pool over each cluster of fire cells drawn (782: a
## town's square fire reads across the square at night): FIRE_POOL at the
## cluster's middle, POOL_UP over it, casting shadows while it reaches the
## view (_cast_shadows), flickering and fading by day as any fire's light.
## A cell's own light (_add_fire) stays: the pool is the wide light.
func _add_fire_pools() -> void:
	if not bool(_terrain.get("outdoor", false)):
		return
	var drawn: Array[Vector2i] = []
	for cell: Vector2i in _terrain["fire"]:
		if _grounds.has(cell):
			drawn.append(cell)
	for cluster: Array in fire_clusters(drawn):
		var middle := Vector3.ZERO
		for cell: Vector2i in cluster:
			middle += _tile_position(cell)
		middle /= float(cluster.size())
		var light := OmniLight3D.new()
		light.name = "FirePool_%d_%d" % [cluster[0].x, cluster[0].y]
		light.light_color = FIRE_POOL
		light.light_energy = POOL_ENERGY
		light.omni_range = POOL_RANGE
		light.omni_attenuation = POOL_FALLOFF
		light.position = middle + Vector3(0.0, POOL_UP, 0.0)
		_room.add_child(light)
		_cast_shadows(light)
		_fire_lights.append([light, POOL_ENERGY, _roll(cluster[0], 148) * TAU, Flames.FIRE_FLICKER])


## A shadowless night light (782's lamps and braziers): warm, faded out
## past NIGHT_FADE m from the camera so a far one costs nothing.
static func _night_light(color: Color, energy: float, reach: float) -> OmniLight3D:
	var light := OmniLight3D.new()
	light.light_color = color
	light.light_energy = energy
	light.omni_range = reach
	light.shadow_enabled = false
	light.distance_fade_enabled = true
	light.distance_fade_begin = NIGHT_FADE
	light.distance_fade_length = NIGHT_FADE_LENGTH
	return light


## The building of [param buildings] whose rect holds [param cell], or {}.
static func building_holding(buildings: Array, cell: Vector2i) -> Dictionary:
	for building: Dictionary in buildings:
		if building.get("rect") is Rect2i and (building["rect"] as Rect2i).has_point(cell) and building.has("facing"):
			return building
	return {}


## Where a door lantern hangs (782), from the front cell [param front]'s
## middle [param ground] (its floor's height) and its building's
## [param facing] (out of the door): on the wall beside the door,
## DOOR_LAMP_ASIDE along it, DOOR_LAMP_OUT proud of the door's edge (clear
## of a thick wall), DOOR_LAMP_UP over the ground.
static func door_lamp_at(ground: Vector3, facing: Vector2i) -> Vector3:
	var out := Vector3(facing.x, 0.0, facing.y)
	var along := Vector3(-facing.y, 0.0, facing.x)
	return ground - out * 0.5 + out * DOOR_LAMP_OUT + along * DOOR_LAMP_ASIDE + Vector3(0.0, DOOR_LAMP_UP, 0.0)


## A lantern hung by the door of each building holding a shop's or a
## temple's counter (782; a Chest with props shop or temple), once a
## building; looked at with the window lights (LAMP_CHECK), since the
## counters come with the entities, after the room. Outdoors only.
func _hang_door_lamps() -> void:
	if _room == null or not bool(_terrain.get("outdoor", false)):
		return
	var buildings := _drawn_buildings()
	for entity in World.entities():
		var counter := entity as Chest
		if counter == null or not counter.spawned or not (counter.shop or counter.temple):
			continue
		var building := building_holding(buildings, counter.tile)
		if building.is_empty():
			continue
		var facing: Vector2i = building["facing"]
		var front: Vector2i = building.get("front", Level.front_cell(building["rect"], facing))
		if _door_lamps.has(front) and is_instance_valid(_door_lamps[front]):
			continue
		_door_lamps[front] = _add_door_lamp(front, facing)


## A door lantern (782): art-kit's prop.door_lamp where it is there (489
## amended (4); its light DOOR_LAMP_ART_LIGHT from the flame, off the
## wall, DOOR_LAMP_STONE further out on a stone wall), else a short iron
## arm out from the wall, the hanging lantern under its end, its warm light
## DOOR_LAMP_LIGHT from it. A lived-in house's own lantern at the same door
## gives way to it (a trade's lamp is never picked out: _light_houses).
func _add_door_lamp(front: Vector2i, facing: Vector2i) -> Node3D:
	for at: Vector2i in _house_lights:
		var entry: Array = _house_lights[at]
		if entry.size() > 7 and entry[6] == front:
			if is_instance_valid(entry[7]):
				(entry[7] as Node3D).queue_free()
			entry.resize(4)
	if ArtKit.has(DOOR_LAMP_SLOT):
		var out := Vector3(facing.x, 0.0, facing.y)
		var stone := str(_wall_sets.get(Terrain.edge_key(front, -facing), "")) == "stone"
		var at := _tile_position(front) - out * 0.5 + Vector3(-facing.y, 0.0, facing.x) * DOOR_LAMP_ASIDE + out * (DOOR_LAMP_STONE if stone else 0.0)
		var made := _door_lamp_piece(at, atan2(-float(facing.y), float(facing.x)), DOOR_LAMP_ENERGY, DOOR_LAMP_RANGE)
		made[0].name = "DoorLamp_%d_%d" % [front.x, front.y]
		_fire_lights.append([made[1], DOOR_LAMP_ENERGY, _roll(front, 150) * TAU, LANTERN_FLICKER])
		return made[0]
	var lamp := Node3D.new()
	lamp.name = "DoorLamp_%d_%d" % [front.x, front.y]
	lamp.position = door_lamp_at(_tile_position(front), facing)
	lamp.rotation.y = atan2(float(facing.x), float(facing.y))
	_room.add_child(lamp)
	var arm := _box(Vector3(0.04, 0.04, DOOR_LAMP_OUT + 0.05), _stone_opaque)
	arm.position = Vector3(0.0, -0.02, -(DOOR_LAMP_OUT + 0.05) * 0.5)
	lamp.add_child(arm)
	var lantern := _hanging_lantern()
	lantern.position = Vector3(0.0, -0.2, 0.0)
	lamp.add_child(lantern)
	var light := _night_light(LANTERN, DOOR_LAMP_ENERGY, DOOR_LAMP_RANGE)
	light.position = DOOR_LAMP_LIGHT
	lamp.add_child(light)
	_fire_lights.append([light, DOOR_LAMP_ENERGY, _roll(front, 150) * TAU, LANTERN_FLICKER])
	return lamp


## The level's night places from Main (782; level.json "places"): [param
## posts] the watch posts' brazier cells (771, buildings' "post" places),
## [param stores] [its place's cell, where its lantern post stands (cells)]
## for a store with no building round it (one a building covers, at its
## cell or its post's, is left out: its counter's door lantern). Drawn
## again whole on each call and after a rebuild (Main._on_room_built).
func set_night_places(posts: Array, stores: Array) -> void:
	_night_posts = posts
	_night_stores = stores
	_draw_night_places()


func _draw_night_places() -> void:
	if is_instance_valid(_night_places):
		_night_places.free()
	_night_places = null
	_fire_lights = _fire_lights.filter(func(each: Array) -> bool: return is_instance_valid(each[0]))
	if _room == null or (_night_posts.is_empty() and _night_stores.is_empty()):
		return
	_night_places = Node3D.new()
	_night_places.name = "NightPlaces"
	_room.add_child(_night_places)
	for cell: Vector2i in _night_posts:
		_add_brazier(cell)
	for store: Array in _night_stores:
		var at: Vector2 = store[1]
		if not _building_at.has(store[0]) and not _building_at.has(Vector2i(roundi(at.x), roundi(at.y))):
			_add_store_lamp(at)


## A watch post's brazier (782; 771): art-kit's POST_BRAZIER, its fire at
## the slot's flame socket (Flames), a bright warm light over it so the
## watch reads from the town (POST_ENERGY, POST_RANGE, shadowless); a stone
## stand with the fire on its top until the slot has art.
func _add_brazier(cell: Vector2i) -> void:
	var at := _tile_position(cell)
	var stand: Node3D
	var flame: Node3D
	if ArtKit.has(POST_BRAZIER) and ArtKit.filled_by(POST_BRAZIER) != "placeholder":
		stand = ArtKit.instance(POST_BRAZIER)
		stand.rotation.y = _roll(cell, 151) * TAU
		flame = Flames.at_socket(stand, POST_BRAZIER, hash(cell))
		if flame == null:
			flame = Flames.light(stand, Vector3(0.0, ArtKit.size(POST_BRAZIER).y, 0.0), Flames.size_of(POST_BRAZIER), hash(cell))
	else:
		stand = _box(Vector3(0.5, 0.9, 0.5), _stone_opaque)
		flame = Flames.light(stand, Vector3(0.0, 0.9, 0.0), Flames.size_of(POST_BRAZIER), hash(cell))
	stand.name = "Brazier_%d_%d" % [cell.x, cell.y]
	stand.position = at
	_night_places.add_child(stand)
	var light := _night_light(FIRE_POOL, POST_ENERGY, POST_RANGE)
	light.position = stand.transform * flame.position + Vector3(0.0, Flames.size_of(POST_BRAZIER) * 0.8, 0.0)
	_night_places.add_child(light)
	_fire_lights.append([light, POST_ENERGY, _roll(cell, 152) * TAU, Flames.FIRE_FLICKER])


## A store's lantern on its own post (782), at [param at] (cells, a
## point: the post stands where it is given, not in a cell's middle).
func _add_store_lamp(at: Vector2) -> void:
	var cell := Vector2i(roundi(at.x), roundi(at.y))
	var post := _box(Vector3(0.07, STORE_LAMP_UP + 0.1, 0.07), _stone_opaque)
	post.name = "StoreLamp_%d_%d" % [cell.x, cell.y]
	post.position = Vector3(at.x, _elevation(cell), at.y)
	_night_places.add_child(post)
	var arm := _box(Vector3(0.35, 0.04, 0.04), _stone_opaque)
	arm.position = Vector3(0.16, STORE_LAMP_UP, 0.0)
	post.add_child(arm)
	var lantern := _hanging_lantern()
	lantern.position = Vector3(0.3, STORE_LAMP_UP - 0.2, 0.0)
	post.add_child(lantern)
	var light := _night_light(LANTERN, DOOR_LAMP_ENERGY, DOOR_LAMP_RANGE)
	light.position = Vector3(0.3, STORE_LAMP_UP - 0.1, 0.0)
	post.add_child(light)
	_fire_lights.append([light, DOOR_LAMP_ENERGY, _roll(cell, 153) * TAU, LANTERN_FLICKER])


## Whether a townsperson carries a lantern now (782; the coordinator:
## walkers only): the sun down outdoors ([param night]), awake, out of
## doors, walked within CARRIED_HOLD s ([param since_walked]), its left
## hand free ([param left_hand], its "held"'s second).
static func carries_lantern(night: bool, activity: String, indoors: bool, since_walked: float, left_hand: String) -> bool:
	return night and activity != "sleep" and not indoors and since_walked < CARRIED_HOLD and left_hand.is_empty()


## A townsperson's lantern (782; pc-character's word: the hanging lantern
## from the left hand, upright whatever the hand's turn, CARRIED_HANG
## under its socket): shown as carries_lantern says; the walkers kept in
## _carriers for their lights (_light_carriers).
func _sync_carried(body: Resident, puppet: Node3D, id: int) -> void:
	var hand := (puppet.get_meta("sockets", {}) as Dictionary).get("hand_l") as Node3D
	if hand == null:
		return
	var now := Time.get_ticks_msec()
	if float(puppet.get_meta("speed", 0.0)) > WALKING:
		puppet.set_meta("walked_ms", now)
	var since := (now - int(puppet.get_meta("walked_ms", -(1 << 40)))) / 1000.0
	var held: Array = puppet.get_meta("held", ["", ""])
	var carries := carries_lantern(_night, body.activity, _building_at.has(body.tile), since, str(held[1]) if held.size() > 1 else "")
	var lantern := puppet.get_node_or_null("CarriedLantern") as Node3D
	if carries and lantern == null:
		lantern = _hanging_lantern()
		lantern.name = "CarriedLantern"
		lantern.top_level = true
		puppet.add_child(lantern)
	if lantern == null:
		return
	if lantern.visible != carries:
		lantern.visible = carries
	if carries:
		lantern.global_basis = Basis()
		lantern.global_position = hand.global_position + Vector3(0.0, -CARRIED_HANG, 0.0)
		_carriers[id] = lantern
	else:
		_carriers.erase(id)


## The carried lanterns' lights (782): CARRIED_NEAR lights, kept on the
## carriers nearest the camera's aim (picked again every CARRIED_PICK s),
## CARRIED_UP over the lantern, flickering a little; the rest of the
## carriers' lanterns glow and light nothing. A charm's aura (789,
## _sync_aura) is a carrier too, lit AURA_COLOUR and steady, the followed
## player's own always lit; an aura left out shows its ground glow.
func _light_carriers(delta: float) -> void:
	if _carried_lights.is_empty():
		if _carriers.is_empty():
			return
		for i in CARRIED_NEAR:
			var light := _night_light(LANTERN, CARRIED_ENERGY, CARRIED_RANGE)
			light.name = "CarriedLight%d" % i
			light.visible = false
			add_child(light)
			_carried_lights.append(light)
	_carried_clock += delta
	if _carried_clock >= CARRIED_PICK:
		_carried_clock = 0.0
		var own: Node3D = null
		var player := _local_player()
		if player != null and _carriers.has(player.get_instance_id()):
			own = _carriers[player.get_instance_id()]
		_carried_by = with_own(nearest_carriers(_carriers, Vector2(_camera_target.x, _camera_target.z), CARRIED_NEAR), own, CARRIED_NEAR)
		for carried: Node3D in _carriers.values():
			if carried.has_meta("aura"):
				(carried.get_node("Disc") as Node3D).visible = not carried in _carried_by
	for i in _carried_lights.size():
		var light := _carried_lights[i]
		var lantern: Node3D = _carried_by[i] if i < _carried_by.size() else null
		var lit := lantern != null and is_instance_valid(lantern) and lantern.visible
		if light.visible != lit:
			light.visible = lit
		if not lit:
			continue
		if lantern.has_meta("aura"):
			var glow := aura_glow(float(lantern.get_meta("aura")))
			light.light_color = AURA_COLOUR
			light.omni_range = glow.x
			light.light_energy = glow.y
			light.global_position = lantern.global_position + Vector3(0.0, AURA_UP, 0.0)
		else:
			light.light_color = LANTERN
			light.omni_range = CARRIED_RANGE
			light.global_position = lantern.global_position + Vector3(0.0, CARRIED_UP, 0.0)
			light.light_energy = CARRIED_ENERGY * Flames.flicker(_fire_time, float(i) * 1.7, LANTERN_FLICKER)


## [param near] with [param own] (the followed player's aura, or null) in
## it, first if it had to be put in, the farthest dropped past [param most].
static func with_own(near: Array[Node3D], own: Node3D, most: int) -> Array[Node3D]:
	if own == null or not is_instance_valid(own) or not own.visible or own in near:
		return near
	var out: Array[Node3D] = [own]
	out.append_array(near)
	return out.slice(0, most)


## An aura's light (789): its reach and energy, Vector2(m, energy), from
## AURA_REACH.x and AURA_ENERGY.x at AURA_FROM (and under it) to .y at 1.
static func aura_glow(aura: float) -> Vector2:
	var t := clampf(inverse_lerp(AURA_FROM, 1.0, aura), 0.0, 1.0)
	return Vector2(lerpf(AURA_REACH.x, AURA_REACH.y, t), lerpf(AURA_ENERGY.x, AURA_ENERGY.y, t))


## Whether a wearer's aura shows (789): some aura, and the sun down
## ([param night]) or a roof over it ([param outdoor] false).
static func aura_shows(aura: float, night: bool, outdoor: bool) -> bool:
	return aura > 0.0 and (night or not outdoor)


## How many motes an [param aura] keeps round its wearer (789 amended):
## AURA_MOTES_MOST at 1, as many for less in proportion (5 for a new
## charm's third, 8 at a half), at least one for any; none for none.
static func aura_motes(aura: float) -> int:
	return 0 if aura <= 0.0 else maxi(1, roundi(AURA_MOTES_MOST * minf(aura, 1.0)))


## How bright an aura's motes are (789 amended): AURA_MOTE_GLOW in the dark
## or under a roof; in the open, toward AURA_MOTE_DAY of it as [param day]
## (0 night .. 1 full day) comes up.
static func aura_mote_glow(day: float, outdoor: bool) -> float:
	return AURA_MOTE_GLOW * (lerpf(1.0, AURA_MOTE_DAY, clampf(day, 0.0, 1.0)) if outdoor else 1.0)


var _aura_mote_material: StandardMaterial3D = null


## A wearer's motes (789 amended): an "AuraMotes" child of its body, as many
## as its aura keeps (aura_motes), emitting while it has any and is within
## AURA_MOTE_FAR of the view's aim; their shared colour follows the day.
func _sync_aura_motes(entity: GridEntity, puppet: Node3D) -> void:
	var count := aura_motes(entity.aura)
	var near := Vector2(puppet.global_position.x - _camera_target.x, puppet.global_position.z - _camera_target.z).length() <= AURA_MOTE_FAR
	var motes := puppet.get_node_or_null("AuraMotes") as GPUParticles3D
	if count == 0 or not near:
		if motes != null and motes.visible:
			motes.emitting = false
			motes.visible = false
		return
	if motes == null:
		motes = _make_aura_motes()
		puppet.add_child(motes)
	if motes.amount != count:
		motes.amount = count
	if not motes.visible:
		motes.visible = true
		motes.emitting = true
	var day := clampf(inverse_lerp(DayNight.NIGHT, 1.0, DayNight.light), 0.0, 1.0)
	_aura_mote_material.albedo_color = Color(AURA_COLOUR * aura_mote_glow(day, _outdoor), 1.0)


## The specks round a wearer (789 amended), as a skylight's motes are made
## (_make_motes): following the body, drifting every way and rising a
## little, fading in and out over each life.
func _make_aura_motes() -> GPUParticles3D:
	var motes := GPUParticles3D.new()
	motes.name = "AuraMotes"
	motes.amount = AURA_MOTES_MOST
	motes.lifetime = AURA_MOTE_SECONDS
	motes.preprocess = AURA_MOTE_SECONDS
	motes.randomness = 0.4
	motes.local_coords = true
	motes.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	motes.position.y = (AURA_MOTE_HIGH.x + AURA_MOTE_HIGH.y) * 0.5
	var high := AURA_MOTE_HIGH.y - AURA_MOTE_HIGH.x
	motes.visibility_aabb = AABB(Vector3(-AURA_MOTE_WIDE, -high * 0.5 - 0.5, -AURA_MOTE_WIDE), Vector3(AURA_MOTE_WIDE * 2.0, high + 1.5, AURA_MOTE_WIDE * 2.0))
	var process := ParticleProcessMaterial.new()
	process.emission_shape = ParticleProcessMaterial.EMISSION_SHAPE_BOX
	process.emission_box_extents = Vector3(AURA_MOTE_WIDE * 0.5, high * 0.5, AURA_MOTE_WIDE * 0.5)
	process.direction = Vector3.UP
	process.spread = 180.0
	process.initial_velocity_min = 0.03
	process.initial_velocity_max = 0.12
	process.gravity = Vector3(0.0, 0.05, 0.0)
	process.scale_min = 0.6
	process.scale_max = 1.3
	var fade := Gradient.new()
	fade.set_color(0, Color.BLACK)
	fade.set_color(1, Color.BLACK)
	fade.add_point(0.3, Color.WHITE)
	fade.add_point(0.7, Color.WHITE)
	var fade_texture := GradientTexture1D.new()
	fade_texture.gradient = fade
	process.color_ramp = fade_texture
	motes.process_material = process
	if _aura_mote_material == null:
		_aura_mote_material = StandardMaterial3D.new()
		_aura_mote_material.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
		_aura_mote_material.blend_mode = BaseMaterial3D.BLEND_MODE_ADD
		_aura_mote_material.billboard_mode = BaseMaterial3D.BILLBOARD_PARTICLES
		_aura_mote_material.vertex_color_use_as_albedo = true
		_aura_mote_material.disable_receive_shadows = true
		_aura_mote_material.albedo_color = Color(AURA_COLOUR * AURA_MOTE_GLOW, 1.0)
		# Round and soft, not a square: white at the middle to nothing at the rim.
		var soft := GradientTexture2D.new()
		soft.width = 32
		soft.height = 32
		soft.fill = GradientTexture2D.FILL_RADIAL
		soft.fill_from = Vector2(0.5, 0.5)
		soft.fill_to = Vector2(1.0, 0.5)
		var rim := Gradient.new()
		rim.set_color(0, Color.WHITE)
		rim.set_color(1, Color.BLACK)
		rim.add_point(0.35, Color.WHITE)
		soft.gradient = rim
		_aura_mote_material.albedo_texture = soft
	var speck := QuadMesh.new()
	speck.size = Vector2(AURA_MOTE_SIZE, AURA_MOTE_SIZE)
	speck.material = _aura_mote_material
	motes.draw_pass_1 = speck
	return motes


## A player's or companion's aura (789): an "AuraGlow" marker at its feet,
## kept in _carriers while it shows (_light_carriers lights it), with its
## ground glow "Disc" for when it is not lit.
func _sync_aura(entity: GridEntity, puppet: Node3D, id: int) -> void:
	_sync_aura_motes(entity, puppet)
	var shows := aura_shows(entity.aura, _night, _outdoor)
	var glow := puppet.get_node_or_null("AuraGlow") as Node3D
	if glow == null:
		if not shows:
			return
		glow = _aura_glow()
		puppet.add_child(glow)
	if glow.visible != shows:
		glow.visible = shows
	if not shows:
		if _carriers.get(id) == glow:
			_carriers.erase(id)
		return
	if not is_equal_approx(float(glow.get_meta("aura", -1.0)), entity.aura):
		glow.set_meta("aura", entity.aura)
		var reach := aura_glow(entity.aura)
		var disc := glow.get_node("Disc") as MeshInstance3D
		var across := reach.x * AURA_DISC_SHARE * 2.0
		disc.scale = Vector3(across, 1.0, across)
		(disc.material_override as ShaderMaterial).set_shader_parameter("tint",
				Color(AURA_COLOUR, AURA_DISC * reach.y / AURA_ENERGY.y))
	_carriers[id] = glow


var _aura_shader: Shader


## An aura's marker (789): a Node3D at the body's feet holding its ground
## glow, an unlit additive disc a hair over the floor, hidden until
## _light_carriers leaves it out of the real lights.
func _aura_glow() -> Node3D:
	if _aura_shader == null:
		_aura_shader = Shader.new()
		_aura_shader.code = AURA_DISC_SHADER
	var glow := Node3D.new()
	glow.name = "AuraGlow"
	var disc := MeshInstance3D.new()
	disc.name = "Disc"
	var plane := PlaneMesh.new()
	plane.size = Vector2.ONE
	disc.mesh = plane
	disc.position.y = 0.03
	disc.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	var material := ShaderMaterial.new()
	material.shader = _aura_shader
	disc.material_override = material
	disc.visible = false
	glow.add_child(disc)
	return glow


# --- The cold forge woken (813 amended (7)) ---------------------------------------

## The forges lit (813 amended (7)): their lights, flickered with the fires
## (_flicker_forges); a freed forge's dropped.
var _forge_lights: Array[OmniLight3D] = []
var _spark_material: StandardMaterial3D = null


## Dungeon's cold forge [param forge] (set_cold_forge's holder) lit or not,
## as its smith's cupboard's door is open (_sync_doors): its light and
## sparks under a "ForgeFire" child at the hearth. [param catching] (lit
## from shut as it is drawn, _show_vault's rule) flares it and throws the
## burst; otherwise it is simply burning. Lit twice is lit once.
func _show_forge(forge: Node3D, lit: bool, catching: bool) -> void:
	if forge == null or not is_instance_valid(forge):
		return
	var fire := forge.find_child("ForgeFire", true, false) as Node3D
	if not lit:
		if fire != null:
			var out := fire.get_node("Light") as OmniLight3D
			_forge_lights.erase(out)
			_shadow_lights.erase(out)
			fire.name = "ForgeFireOut"  # Not found as lit while it waits to be freed.
			fire.hide()
			fire.queue_free()
		return
	if fire != null:
		return
	fire = Node3D.new()
	fire.name = "ForgeFire"
	var hearth := forge.find_child("hearth", true, false) as Node3D
	if hearth != null:
		hearth.add_child(fire)
	else:
		fire.position = FORGE_HEARTH
		forge.add_child(fire)
	var light := OmniLight3D.new()
	light.name = "Light"
	light.light_color = FORGE_COLOUR
	light.omni_range = FORGE_RANGE
	light.set_meta(&"phase", randf() * TAU)
	fire.add_child(light)
	_cast_shadows(light)
	_forge_lights.append(light)
	var trickle := _forge_sparks(false)
	trickle.name = "Sparks"
	fire.add_child(trickle)
	if not catching:
		light.set_meta(&"base", FORGE_ENERGY)
		light.light_energy = FORGE_ENERGY
		return
	light.set_meta(&"base", 0.0)
	light.light_energy = 0.0
	var burst := _forge_sparks(true)
	burst.name = "Burst"
	fire.add_child(burst)
	burst.emitting = true
	burst.finished.connect(burst.queue_free)
	var flare := light.create_tween()
	flare.tween_method(func(energy: float) -> void: light.set_meta(&"base", energy), 0.0, FORGE_FLARE, FORGE_CATCH).set_trans(Tween.TRANS_QUAD).set_ease(Tween.EASE_OUT)
	flare.parallel().tween_property(light, "omni_range", FORGE_SWELL, FORGE_CATCH)
	flare.tween_method(func(energy: float) -> void: light.set_meta(&"base", energy), FORGE_FLARE, FORGE_ENERGY, FORGE_SETTLE).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)
	flare.parallel().tween_property(light, "omni_range", FORGE_RANGE, FORGE_SETTLE).set_trans(Tween.TRANS_SINE).set_ease(Tween.EASE_OUT)


## Each lit forge's light at its base (FORGE_ENERGY, or the flare's) with a
## fire's flicker; a forge freed with its room is dropped.
func _flicker_forges() -> void:
	for i in range(_forge_lights.size() - 1, -1, -1):
		var light := _forge_lights[i]
		if not is_instance_valid(light):
			_forge_lights.remove_at(i)
			continue
		light.light_energy = float(light.get_meta(&"base", FORGE_ENERGY)) * Flames.flicker(_fire_time, float(light.get_meta(&"phase", 0.0)), Flames.FIRE_FLICKER)


## A forge's sparks: the [param burst] as it catches (FORGE_BURST at once,
## thrown up and out, falling) or its trickle while it burns
## (FORGE_TRICKLE a second, rising). Orange-white to nothing, unshaded and
## added; indoors only, so off the screen is the only cut (no distance one:
## the ortho camera stands CAMERA_DISTANCE off, past which a range would cut).
func _forge_sparks(burst: bool) -> GPUParticles3D:
	var sparks := GPUParticles3D.new()
	sparks.lifetime = FORGE_SPARK_SECONDS * (0.8 if burst else 1.0)
	sparks.amount = FORGE_BURST if burst else ceili(FORGE_TRICKLE * FORGE_SPARK_SECONDS)
	sparks.one_shot = burst
	sparks.explosiveness = 1.0 if burst else 0.0
	sparks.randomness = 0.5
	sparks.emitting = not burst
	sparks.local_coords = false
	sparks.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	sparks.visibility_aabb = AABB(Vector3(-3.0, -1.0, -3.0), Vector3(6.0, 5.0, 6.0))
	var process := ParticleProcessMaterial.new()
	process.emission_shape = ParticleProcessMaterial.EMISSION_SHAPE_SPHERE
	process.emission_sphere_radius = 0.2
	process.direction = Vector3.UP
	process.spread = 55.0 if burst else 20.0
	process.initial_velocity_min = 2.0 if burst else 0.6
	process.initial_velocity_max = 4.0 if burst else 1.4
	process.gravity = Vector3(0.0, -6.0, 0.0) if burst else Vector3(0.0, 0.4, 0.0)
	process.damping_min = 0.5
	process.damping_max = 1.5
	process.scale_min = 0.5
	process.scale_max = 1.2
	var fade := Gradient.new()
	fade.set_color(0, Color(1.0, 0.95, 0.75))
	fade.set_color(1, Color.BLACK)
	fade.add_point(0.4, FORGE_COLOUR)
	var fade_texture := GradientTexture1D.new()
	fade_texture.gradient = fade
	process.color_ramp = fade_texture
	sparks.process_material = process
	if _spark_material == null:
		_spark_material = StandardMaterial3D.new()
		_spark_material.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
		_spark_material.blend_mode = BaseMaterial3D.BLEND_MODE_ADD
		_spark_material.billboard_mode = BaseMaterial3D.BILLBOARD_PARTICLES
		_spark_material.vertex_color_use_as_albedo = true
		_spark_material.disable_receive_shadows = true
	var speck := QuadMesh.new()
	speck.size = Vector2(FORGE_SPARK_SIZE, FORGE_SPARK_SIZE)
	speck.material = _spark_material
	sparks.draw_pass_1 = speck
	return sparks


## The [param most] of [param carriers]' lanterns (id -> Node3D) nearest
## [param aim] on the ground, nearest first; freed or hidden ones dropped
## from [param carriers].
static func nearest_carriers(carriers: Dictionary, aim: Vector2, most: int) -> Array[Node3D]:
	var out: Array[Node3D] = []
	for id: int in carriers.keys():
		var lantern: Node3D = carriers[id]
		if not is_instance_valid(lantern) or not lantern.visible:
			carriers.erase(id)
			continue
		out.append(lantern)
	out.sort_custom(func(a: Node3D, b: Node3D) -> bool:
		return Vector2(a.global_position.x, a.global_position.z).distance_squared_to(aim) < Vector2(b.global_position.x, b.global_position.z).distance_squared_to(aim))
	return out.slice(0, most)


# --- The mine's light (769 amended (6)) -----------------------------------------------------

## The share of its zone's look a level's light is (769 amended (6)): terrain
## "ambient" over DayNight.base_ambient of its zone, 1 for a level that
## leaves it unset; at most 1 (a level is never lit above its zone).
static func ambient_share(terrain: Dictionary) -> float:
	var base := DayNight.base_ambient(str(terrain.get("zone", "indoors")))
	if base <= 0.0:
		return 1.0
	return clampf(float(terrain.get("ambient", base)) / base, 0.0, 1.0)


## The way out from its wall of the "mine_lamp" decor row on [param cell]
## (its "out"), or ZERO if none hangs there.
static func wall_lamp_out(decor: Array, cell: Vector2i) -> Vector2i:
	for entry: Variant in decor:
		if entry is Dictionary and str(entry.get("kind", "")) == "mine_lamp" and entry.get("cell") == cell:
			return entry.get("out", Vector2i.ZERO)
	return Vector2i.ZERO


## Where a wall lamp's flame burns: the piece placed as _add_decor places
## it (inset from the edge toward -out, its +z along -out, lifted), the
## slot's flame socket in it; [param ground] the ground's height there.
static func wall_lamp_flame(cell: Vector2i, out: Vector2i, ground: float) -> Vector3:
	var row: Dictionary = Level.DECOR_KINDS["mine_lamp"]
	var at := Vector2(cell) + Vector2(out) * (0.5 - float(row.get("inset", 0.0)))
	var spot := Transform3D(Basis(Vector3.UP, atan2(-float(out.x), -float(out.y))), Vector3(at.x, ground + float(row.get("lift", 0.0)), at.y))
	var socket: Variant = Flames.socket_of(WALL_LAMP_SLOT)
	return spot * (socket as Vector3 if socket != null else Vector3(0.0, 0.12, 0.0))


## Where a wall lamp's light stands (769 amended (8)): off its [param flame]
## into the passage (away from the wall, -[param out]) and a little lower.
static func wall_lamp_light(flame: Vector3, out: Vector2i) -> Vector3:
	return flame + Vector3(-float(out.x), 0.0, -float(out.y)) * WALL_LAMP_OFF + Vector3.DOWN * WALL_LAMP_DROP


## The [param most] of [param lights] nearest [param aim] on the ground.
static func nearest_lights(lights: Array[OmniLight3D], aim: Vector2, most: int) -> Array[OmniLight3D]:
	var out := lights.duplicate()
	out.sort_custom(func(a: OmniLight3D, b: OmniLight3D) -> bool:
		return Vector2(a.position.x, a.position.z).distance_squared_to(aim) < Vector2(b.position.x, b.position.z).distance_squared_to(aim))
	return out.slice(0, most)


## Every WALL_LAMP_PICK s: only the nearest WALL_LAMP_NEAR wall lamps lit.
func _light_wall_lamps(delta: float) -> void:
	if _wall_lamps.is_empty():
		return
	_wall_lamp_clock += delta
	if _wall_lamp_clock < WALL_LAMP_PICK:
		return
	_wall_lamp_clock = 0.0
	var lit := nearest_lights(_wall_lamps, Vector2(_camera_target.x, _camera_target.z), WALL_LAMP_NEAR)
	for light: OmniLight3D in _wall_lamps:
		if is_instance_valid(light):
			light.visible = lit.has(light)


# --- Shadows -------------------------------------------------------------------

## [param light] casts shadows while it can reach what the camera shows:
## on until the next frame's _update_shadows (it may not be placed yet).
func _cast_shadows(light: OmniLight3D) -> void:
	_shadow_lights.append(light)
	light.shadow_enabled = true
	_shadow_key = Vector3i(1 << 30, 0, 0)


## How far from the camera's aim, on the ground, the screen reaches: the
## ortho view's half diagonal, its height stretched by the pitch.
func _view_reach() -> float:
	if _camera == null:
		return INF
	if _low:
		return World.NEAR_TILES  # The screen shows further; what is kept up does not (238).
	var screen := get_viewport().get_visible_rect().size
	var half_height := _camera.size * 0.5 / maxf(sin(deg_to_rad(pitch)), 0.1)
	var half_width := _camera.size * 0.5 * screen.x / maxf(screen.y, 1.0)
	return Vector2(half_width, half_height).length()


func _shows_light(light: OmniLight3D, reach: float) -> bool:
	var at := light.global_position
	var away := Vector2(at.x - _camera_target.x, at.z - _camera_target.z).length()
	return away <= reach + light.omni_range + SHADOW_MARGIN


## Shadows on for the lights that reach the view, off for the rest, so a
## big map's many torches and lanterns hold no shadow maps for ground
## nobody is looking at (the camera's culling leaves out most of them
## already; this leaves out the rest).
func _update_shadows() -> void:
	if _camera == null or _shadow_lights.is_empty():
		return
	var reach := _view_reach()
	var key := Vector3i(roundi(_camera_target.x), roundi(_camera_target.z), roundi(reach * 2.0))
	var now := Time.get_ticks_msec() / 1000.0
	if key == _shadow_key and now - _shadow_checked < SHADOW_RECHECK:
		return
	_shadow_key = key
	_shadow_checked = now
	var kept: Array[OmniLight3D] = []
	for light in _shadow_lights:
		if not is_instance_valid(light):
			continue
		kept.append(light)
		var shows := _shows_light(light, reach)
		if light.shadow_enabled != shows:
			light.shadow_enabled = shows
	_shadow_lights = kept


# --- Near and far ----------------------------------------------------------------

func _classify_walls() -> void:
	_update_fade(true)


## Fades what hides the local player or their companion from the camera,
## and only that: what hides them is worked out again whenever the camera or
## they have moved, and a piece that stops hiding them stays faded for
## FADE_HOLD ([param force]: every piece set again).
func _update_fade(force := false) -> void:
	if _camera == null or _room == null or not _camera.is_inside_tree():
		return
	if not _occluders_built:
		_index_occluders()
	var points := _focus_points()
	_show_home_labels(points)
	var roofs_changed := _update_roofs(points)
	var toward := _camera.global_transform.basis.z
	# Outdoors (801) nothing fades for the lines to them: only the near side
	# of a building they are in, its roof off; the camera turns instead.
	var fought := points if _outdoor else points + _fight_points(points)
	var key := "%s %s %s %s" % [toward, _camera.global_position, fought, _line_fade]
	var moved := key != _fade_key or force
	if moved:
		_fade_key = key
		if _outdoor:
			_inside_hiding = _inside_walls(points, toward)
			_hiding = _inside_hiding.duplicate()
			# What stands on the line never fades outdoors (623 amended (5):
			# a house, a wall, a tree, a landmark), even where no turn helps
			# (_line_fade): the hidden body's rim shows through instead
			# (_update_seen_through); only those by the low camera's lens go.
			_lined = _hiding_pieces(points, toward)
		else:
			_hiding = _hiding_pieces(fought, toward)
			_hiding.merge(_inside_walls(points, toward))
			_lined.clear()
			_inside_hiding.clear()
	for piece in _hiding:
		_hid_at[piece] = _fade_clock
	var now: Dictionary[Node3D, bool] = {}
	for piece: Node3D in _hid_at.keys():
		if _fade_clock - _hid_at[piece] <= FADE_HOLD:
			now[piece] = true
		else:
			_hid_at.erase(piece)
	var close := _close_pieces(now)
	if _outdoor:
		# A crown or a stall by the low camera's lens on the line is still
		# hidden (623 amended (2)), held FADE_HOLD as a fade is.
		for piece in _close_pieces(_lined):
			_close_at[piece] = _fade_clock
		for piece: Node3D in _close_at.keys():
			if _fade_clock - _close_at[piece] <= FADE_HOLD:
				close[piece] = true
			else:
				_close_at.erase(piece)
		if moved or close.size() != _faded_close.size():
			_player_hidden = _is_hidden(points, toward, close)
			_companion_hidden = _is_hidden(points, toward, close, FADE_HEIGHTS.size())
	else:
		_close_at.clear()
		_player_hidden = false
		_companion_hidden = false
	if not force and not roofs_changed and now.size() == _faded.size() and now.keys().all(func(piece: Node3D) -> bool: return _faded.has(piece)) 			and close.size() == _faded_close.size() and close.keys().all(func(piece: Node3D) -> bool: return _faded_close.has(piece)):
		return
	for entry in _occluders:
		var piece: Node3D = entry[0]
		var fade := now.has(piece)
		if force and not fade and not close.has(piece) and not _faded.has(piece) and not _faded_close.has(piece) \
				and not piece.has_meta(TOUCHED_META):
			continue  # Never faded nor hidden: as built (TOUCHED_META).
		if fade != _faded.has(piece) or force:
			_set_near(piece, fade)
		if entry[2] and (close.has(piece) != _faded_close.has(piece) or force):
			_set_close(piece, close.has(piece))
	_faded = now
	_faded_close = close
	# A roof off draws nothing but its shadow, so the inside stays shaded.
	for building in _buildings:
		var roof: Node3D = building["roof"]
		if roof == null or not building["off"] or float(building.get("roof_fade", 1.0)) < 1.0:
			continue
		_set_near(roof, false)
		for node in _descendants(roof):
			if node is GeometryInstance3D:
				node.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_SHADOWS_ONLY


## Of [param faded], the trees and tall pieces within NEAR_CLOSE of the
## low camera (none under the ortho one).
func _close_pieces(faded: Dictionary[Node3D, bool]) -> Dictionary[Node3D, bool]:
	var out: Dictionary[Node3D, bool] = {}
	if not _low or faded.is_empty():
		return out
	var eye := _camera.global_position
	for piece: Node3D in faded:
		var index: int = _occluder_of.get(piece, -1)
		if index < 0 or not _occluders[index][2]:
			continue
		var bounds: AABB = _occluders[index][1]
		if eye.clamp(bounds.position, bounds.end).distance_to(eye) <= NEAR_CLOSE:
			out[piece] = true
	return out


## [param piece] hidden ([param close]) or back to its see-through copy.
## Not a lower alpha: a season tree's see-through is its season shader,
## which GeometryInstance3D.transparency never reached, so a crown beside
## the eye stayed at NEAR_ALPHA, a pale fogged peak against the sky.
func _set_close(piece: Node3D, close: bool) -> void:
	if close:
		piece.set_meta(TOUCHED_META, true)
	for node in _descendants(piece):
		if node is GeometryInstance3D:
			(node as GeometryInstance3D).visible = not close


## The walls of the buildings [param points] are inside that face the
## camera ([param toward]), each with its run: the near side of the room,
## faded whether or not it hides them, so a player in a corner of it is
## not hidden by the wall beside them. A side the camera looks along is
## not near.
func _inside_walls(points: Array[Vector3], toward: Vector3) -> Dictionary[Node3D, bool]:
	var out: Dictionary[Node3D, bool] = {}
	if _buildings.is_empty():
		return out
	var flat := Vector2(toward.x, toward.z).normalized()
	var inside: Dictionary[int, bool] = {}
	for point in points:
		var at := to_local(point)
		var cell := Vector2i(roundi(at.x), roundi(at.z))
		if _building_at.has(cell):
			inside[_building_at[cell]] = true
	for index in inside:
		var rect: Rect2i = _buildings[index]["rect"]
		var cells: Dictionary = _buildings[index].get("inside", {})
		for key in _buildings[index].get("outline", Level.outline(rect)):
			if not _runs.has(key):
				continue
			var outward := Vector2(1, 0) if key.z == Terrain.EAST else Vector2(0, 1)
			# Out is toward the edge's second cell when its first is inside.
			var first := Terrain.edge_cells(key)[0]
			if not (cells.has(first) if not cells.is_empty() else rect.has_point(first)):
				outward = -outward
			if outward.dot(flat) > NEAR_SIDE:
				for piece: Node3D in _runs[key]:
					out[piece] = true
		# An art-walled one's (718) wall quarters on the camera's side.
		for quarter: Array in _buildings[index].get("quarters", []):
			if (quarter[1] as Vector2).dot(flat) > NEAR_SIDE:
				out[quarter[0]] = true
	return out


## Which buildings' roofs are off: those the local player or their
## companion ([param points]) is inside, and for FADE_HOLD after they
## leave, each easing out or back over ROOF_FADE (_ease_roof). A roof back
## on is set as the fade has it. The local player's (the first point's)
## space closed in by walls (_enclosed) told by inside_changed when it
## changes. Whether any roof went off or on.
func _update_roofs(points: Array[Vector3]) -> bool:
	var step := (_fade_clock - _roofs_clock) / ROOF_FADE
	_roofs_clock = _fade_clock
	if _enclosed_dirty:
		_find_enclosed()
	elif not _enclosed_changed.is_empty():
		_find_enclosed(_enclosed_changed)
	if not points.is_empty():
		var mine := to_local(points[0])
		_tell_inside(_enclosed.get(Vector2i(roundi(mine.x), roundi(mine.z)), -1))
	if _buildings.is_empty():
		return false
	for point in points:
		var at := to_local(point)
		var cell := Vector2i(roundi(at.x), roundi(at.z))
		if _building_at.has(cell):
			_roofs_off[_building_at[cell]] = _fade_clock
	var changed := false
	for index in _buildings.size():
		var off := _roofs_off.has(index) and _fade_clock - _roofs_off[index] <= FADE_HOLD
		if not off:
			_roofs_off.erase(index)
		var building := _buildings[index]
		if off != building["off"]:
			building["off"] = off
			changed = true
			if not off and building["roof"] != null:
				_set_near(building["roof"], _faded.has(building["roof"]))
		_ease_roof(building, step)
	return changed


## [param space] the local player's space now (-1 none): inside_changed
## if its bounds differ from the last told (spaces are numbered afresh
## each time they are worked out).
func _tell_inside(space: int) -> void:
	var bounds: Rect2i = _enclosed_rects[space] if space >= 0 else Rect2i()
	if bounds == _inside_rect:
		return
	_inside_rect = bounds
	inside_changed.emit(space >= 0, bounds)


## The bounds of the space closed in by walls the local player is in, an
## empty Rect2i if none (as inside_changed last told).
func inside_building() -> Rect2i:
	return _inside_rect


## Whether edge [param key] closes a space (_find_enclosed): a wall (_walled)
## or an opening no wider than ENCLOSED_GAP between walls along one line.
func _closes(key: Vector3i) -> bool:
	if _walled(key):
		return true
	var step := Vector3i(0, 1, 0) if key.z == Terrain.EAST else Vector3i(1, 0, 0)
	for before in ENCLOSED_GAP:
		if not _walled(key - step * (before + 1)):
			continue
		for after in ENCLOSED_GAP - before:
			if _walled(key + step * (after + 1)):
				return true
		return false
	return false


## Whether edge [param key] is a wall or door that closes a space: one the
## terrain has, drawn (not a plot's or a frame's, 566), a ruin's stubs,
## rubble and gaps too (649: its stubs still enclose), never a gone
## building's; nor, outdoors, an edge off the floor (the land's outline,
## drawn none). Reads _floor_lookup (_find_enclosed fills it).
func _walled(key: Vector3i) -> bool:
	if _terrain["edges"].get(key, Terrain.Edge.OPEN) == Terrain.Edge.OPEN:
		return false
	if _outdoor:
		var sides := Terrain.edge_cells(key)
		if not _floor_lookup.has(sides[0]) or not _floor_lookup.has(sides[1]):
			return false
	if _ruin_edges.has(key):
		return not _gone_edge(key)
	return not _unbuilt(key)


## Whether [param key] is a gone building's edge (649): its walls none.
func _gone_edge(key: Vector3i) -> bool:
	for cell in Terrain.edge_cells(key):
		var index: int = _building_at.get(cell, -1)
		if index >= 0 and _buildings[index].get("decline", "") == DECLINE_GONE:
			return true
	return false


## The spaces closed in by walls (_enclosed, _enclosed_rects): the floor
## cells from which no way through edges that do not close (_closes) leads
## off the floor, outdoors, nor reaches more than ENCLOSED_MOST cells (a
## walled town is not a room). Underground every room is one. Outdoors only
## the cells beside a wall are tried, and a way that opens marks all it
## crossed as outside, so the open ground is crossed about once. Worked out
## once per layout; after a wall change ([param changed] edges) only the
## spaces beside them are dropped and the cells beside them and in those
## spaces tried again (a dropped space's bounds left empty).
func _find_enclosed(changed: Array[Vector3i] = []) -> void:
	_enclosed_dirty = false
	_enclosed_changed = []
	if _floor_lookup.is_empty():
		for cell: Vector2i in _terrain.get("floor", []):
			_floor_lookup[cell] = true
	var seeds: Array[Vector2i] = []
	if not changed.is_empty():
		var dropped: Dictionary[int, bool] = {}
		for key in changed:
			for cell in Terrain.edge_cells(key):
				seeds.append(cell)
				if _enclosed.has(cell):
					dropped[_enclosed[cell]] = true
		for cell: Vector2i in _enclosed.keys():
			if dropped.has(_enclosed[cell]):
				seeds.append(cell)
				_enclosed.erase(cell)
		for space in dropped:
			_enclosed_rects[space] = Rect2i()
	else:
		_enclosed.clear()
		_enclosed_rects.clear()
		if _outdoor:
			for key: Vector3i in _terrain["edges"]:
				if _walled(key):
					seeds.append_array(Terrain.edge_cells(key))
		else:
			seeds.assign(_floor_lookup.keys())
	var sides: Array[Vector2i] = [Vector2i(1, 0), Vector2i(-1, 0), Vector2i(0, 1), Vector2i(0, -1)]
	var outside: Dictionary[Vector2i, bool] = {}
	for seed in seeds:
		if not _floor_lookup.has(seed) or outside.has(seed) or _enclosed.has(seed):
			continue
		var seen: Dictionary[Vector2i, bool] = {seed: true}
		var around: Array[Vector2i] = [seed]
		var open := false
		while not around.is_empty() and not open:
			var at: Vector2i = around.pop_back()
			for side in sides:
				var next := at + side
				if seen.has(next) or _closes(Terrain.edge_key(at, side)):
					continue
				if not _floor_lookup.has(next):
					open = _outdoor
					continue
				if outside.has(next) or _outdoor and seen.size() >= ENCLOSED_MOST:
					open = true
					break
				seen[next] = true
				around.append(next)
		if open:
			outside.merge(seen)
			continue
		var space := _enclosed_rects.size()
		var bounds := Rect2i(seed, Vector2i.ONE)
		for cell: Vector2i in seen:
			_enclosed[cell] = space
			bounds = bounds.merge(Rect2i(cell, Vector2i.ONE))
		_enclosed_rects.append(bounds)


## [param building]'s roof eased [param step] (a share of ROOF_FADE) toward
## off (its "off") or on: its meshes' transparency the share gone; all the
## way off, shadow only (the inside stays shaded) and opaque again.
func _ease_roof(building: Dictionary, step: float) -> void:
	var roof: Node3D = building["roof"]
	var gone: float = building.get("roof_fade", 0.0)
	var to := 1.0 if building["off"] else 0.0
	if roof == null or gone == to:
		return
	gone = move_toward(gone, to, maxf(step, 0.0))
	if absf(gone - to) < 0.001:
		gone = to  # The clock's sums fall a hair short.
	building["roof_fade"] = gone
	for node in _descendants(roof):
		if node is GeometryInstance3D:
			var mesh := node as GeometryInstance3D
			mesh.transparency = gone if gone < 1.0 else 0.0
			if gone >= 1.0:
				mesh.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_SHADOWS_ONLY


## The pieces the lines from the camera to [param points] pass through,
## with what fades with them. The camera is orthographic: its line to a
## point runs back from it along [param toward], up to the camera's plane.
## Only the pieces in the squares a line crosses below the highest top are
## tried (_occluder_chunks).
func _hiding_pieces(points: Array[Vector3], toward: Vector3) -> Dictionary[Node3D, bool]:
	var out: Dictionary[Node3D, bool] = {}
	var tried: Dictionary[int, bool] = {}
	for point in points:
		var reach := maxf((_camera.global_position - point).dot(toward), 0.0)
		if toward.y > 0.01:
			reach = minf(reach, maxf(_occluder_top - point.y, 0.0) / toward.y)
		var end := point + toward * reach
		var low := Vector2i(floori(minf(point.x, end.x) / FADE_CHUNK), floori(minf(point.z, end.z) / FADE_CHUNK))
		var high := Vector2i(floori(maxf(point.x, end.x) / FADE_CHUNK), floori(maxf(point.z, end.z) / FADE_CHUNK))
		for x in range(low.x, high.x + 1):
			for z in range(low.y, high.y + 1):
				for index: int in _occluder_chunks.get(Vector2i(x, z), []):
					tried[index] = true
	for index in tried:
		var entry := _occluders[index]
		var bounds: AABB = entry[1]
		for point in points:
			var ahead := bounds.get_center() - point
			var reach := maxf((_camera.global_position - point).dot(toward), 0.0)
			if ahead.x * toward.x + ahead.z * toward.z > 0.0 and bounds.intersects_segment(point, point + toward * reach) != null:
				for piece: Node3D in entry[3]:
					out[piece] = true
				break
	return out


## Outdoors (801): whether the local player (the first FADE_HEIGHTS of
## [param points], _focus_points; their companion's from [param from]) is
## hidden from a camera looking back along [param toward]: their chest and
## their feet or head behind something standing (_point_blocked), not
## counting [param close] (hidden by the lens) nor what is see-through already.
func _is_hidden(points: Array[Vector3], toward: Vector3, close: Dictionary[Node3D, bool], from := 0) -> bool:
	if _local_player() == null or points.size() < from + FADE_HEIGHTS.size():
		return false
	var skip := _see_through_now(close)
	if not _point_blocked(points[from + 1], toward, skip):
		return false
	return _point_blocked(points[from], toward, skip) or _point_blocked(points[from + 2], toward, skip)


## What does not hide them now: a building's near side, they being in it,
## [param close], and the roofs off. Not what fades for the line to them
## (_line_fade): that still hides them, for the turn to clear.
func _see_through_now(close: Dictionary[Node3D, bool]) -> Dictionary[Node3D, bool]:
	var skip := _inside_hiding.duplicate()
	skip.merge(close)
	for building in _buildings:
		if building["off"] and building["roof"] != null:
			skip[building["roof"]] = true
	return skip


## Whether a piece other than [param skip]'s stands between [param point]
## and a camera looking back along [param toward] (_hiding_pieces' test).
func _point_blocked(point: Vector3, toward: Vector3, skip: Dictionary[Node3D, bool]) -> bool:
	var reach := _camera_distance() * 2.0
	if toward.y > 0.01:
		reach = minf(reach, maxf(_occluder_top - point.y, 0.0) / toward.y)
	var end := point + toward * reach
	var low := Vector2i(floori(minf(point.x, end.x) / FADE_CHUNK), floori(minf(point.z, end.z) / FADE_CHUNK))
	var high := Vector2i(floori(maxf(point.x, end.x) / FADE_CHUNK), floori(maxf(point.z, end.z) / FADE_CHUNK))
	for x in range(low.x, high.x + 1):
		for z in range(low.y, high.y + 1):
			for index: int in _occluder_chunks.get(Vector2i(x, z), []):
				var entry := _occluders[index]
				if skip.has(entry[0]):
					continue
				var bounds: AABB = entry[1]
				var ahead := bounds.get_center() - point
				if ahead.x * toward.x + ahead.z * toward.z > 0.0 and bounds.intersects_segment(point, end) != null \
						and (not (entry[3] as Array).is_empty() or shapes_meet(entry[4], point, end)):
					return true
	return false


## [param piece]'s meshes' own triangles, each [MeshInstance3D,
## TriangleMesh]: a landmark's shape (STANDS_IN_VIEW: a barrow's dome, a
## stone) for _point_blocked, nearer than its box, whose corners stand
## empty and whose stakes stretch it (a line over a mound's crest is not
## behind it).
func _shapes_of(piece: Node3D) -> Array:
	var out := []
	for node in _descendants(piece):
		var mesh := node as MeshInstance3D
		if mesh != null and mesh.mesh != null:
			var triangles := mesh.mesh.generate_triangle_mesh()
			if triangles != null:
				out.append([mesh, triangles])
	return out


## Whether the segment [param from] to [param to] meets one of [param
## shapes] (_shapes_of).
static func shapes_meet(shapes: Array, from: Vector3, to: Vector3) -> bool:
	for each: Array in shapes:
		var mesh := each[0] as MeshInstance3D
		if not is_instance_valid(mesh):
			continue
		var back := mesh.global_transform.affine_inverse()
		if not (each[1] as TriangleMesh).intersect_segment(back * from, back * to).is_empty():
			return true
	return false


## The way back to the camera (its basis z) at [param degrees] of yaw and
## the pitch now.
func _toward_at(degrees: float) -> Vector3:
	var saved := yaw
	yaw = degrees
	var offset := _camera_offset()
	yaw = saved
	return offset.normalized()


## Whether the local player is seen whole (none of their FADE_HEIGHTS
## blocked) from the camera at [param degrees] of yaw.
func _clears(degrees: float) -> bool:
	var points := _focus_points()
	if points.size() < FADE_HEIGHTS.size():
		return false
	var toward := _toward_at(degrees)
	var skip := _see_through_now(_faded_close)
	for i in FADE_HEIGHTS.size():
		if _point_blocked(points[i], toward, skip):
			return false
	return true


## The yaw the walk keys go by: during a turn of its own (801), the one it
## set off from, so a held key keeps its way across the screen's turn.
func move_yaw() -> float:
	return _turn_view.move_yaw if _turn_view.turning else yaw


## The player turned the camera (A/D, a middle drag, the overhead key): a
## turn of its own stops, and none starts for CameraTurn's MANUAL_HOLD.
func _turned_by_hand() -> void:
	_turn_view.manual()


## Each frame, outdoors (801): a turn of its own under way goes on; one is
## searched for when they have been hidden long enough (camera_turn.gd);
## what hides them fades when no turn helps (_line_fade).
func _drive_turn(delta: float) -> void:
	var on := Net.camera_turn
	var puppet: Node3D = null
	var player := _local_player()
	if player != null:
		puppet = _puppets.get(player.get_instance_id())
	if puppet != null and delta > 0.0:
		var flat := Vector2(puppet.global_position.x - _walk_from.x, puppet.global_position.z - _walk_from.z)
		if _walk_from.x != INF and flat.length() < 2.0:
			_walk = _walk.lerp(flat / delta, 1.0 - exp(-4.0 * delta))
		_walk_from = puppet.global_position
	var hidden := _outdoor and _player_hidden
	var manual := _turning != 0.0 or _dragging or _peeking or _ease_t < 1.0
	if _turn_view.turning:
		if manual or not _outdoor:
			_turn_view.manual()
		else:
			_set_yaw(_turn_view.advance(delta))
			if not _turn_view.turning:
				_yaw_step = yaw
				Net.camera_yaw = wrapped_yaw(yaw)
				Net.save_view_settings()
	elif _turn_view.step(delta, hidden and not manual, on):
		var target := CameraTurn.choose(yaw, _clears, _walk, _hand_yaw)
		if is_nan(target):
			_turn_view.not_found()
		else:
			_turn_view.start(yaw, target)
	var fade: bool = _turn_view.no_help(hidden, on)
	if fade != _line_fade:
		_line_fade = fade
		_update_fade()


## Where the local player and their companion are, at FADE_HEIGHTS: as
## drawn, or at their tile before they have a puppet.
## A grown forest's cutaway on the local player (else the view's middle),
## its near chunks round the view's middle.
func _update_grown() -> void:
	if _grown == null:
		return
	if _camera != null:
		_grown.set_see(Net.see_through * _camera.size * 0.5)
		_grown.set_close(NEAR_CLOSE if _low else 0.0)
	var points := _focus_points()
	_grown.set_focus(_room.to_local(points[0]) if not points.is_empty() else _camera_target, _camera_target)


func _focus_points() -> Array[Vector3]:
	var out: Array[Vector3] = []
	var hers: Array[Vector3] = []
	for entity in World.get_entities():
		if not entity.spawned:
			continue
		if not (entity is Player and entity.owner_peer == Net.local_id or entity is Companion and entity.keeper_peer == Net.local_id):
			continue
		var puppet: Node3D = _puppets.get(entity.get_instance_id())
		var at := puppet.global_position if puppet != null else to_global(_tile_position(entity.tile))
		# The player's first, whatever order they came in: _update_roofs
		# tells inside_changed from the first point (671 amended (3): a
		# companion spawned first had the view tip as she went in, not him).
		for height in FADE_HEIGHTS:
			(out if entity is Player else hers).append(at + Vector3(0.0, height, 0.0))
	out.append_array(hers)
	return out


## Where the fight's other side is, at FADE_HEIGHTS: each live monster
## drawn within FIGHT_TILES of a point of [param focus] (the player's and
## the companion's, _focus_points). None with no one to fight.
func _fight_points(focus: Array[Vector3]) -> Array[Vector3]:
	var out: Array[Vector3] = []
	if focus.is_empty():
		return out
	var now := Time.get_ticks_msec()
	for entity in World.get_entities():
		if not entity is Monster or not entity.spawned or entity.hp <= 0:
			continue
		var id := entity.get_instance_id()
		var alert: Monster.Alert = (entity as Monster).alert
		if alert != Monster.Alert.FIGHTING and alert != Monster.Alert.HUNTING and now - _combat_at.get(id, -100000) >= COMBAT_SECONDS * 1000.0:
			continue
		var puppet: Node3D = _puppets.get(id)
		if puppet == null or not puppet.visible or _far.has(id):
			continue
		var at := puppet.global_position
		var near := false
		for i in range(0, focus.size(), FADE_HEIGHTS.size()):
			if Vector2(at.x, at.z).distance_to(Vector2(focus[i].x, focus[i].z)) <= FIGHT_TILES:
				near = true
				break
		if near:
			for height in FADE_HEIGHTS:
				out.append(at + Vector3(0.0, height, 0.0))
	return out


func _index_occluders() -> void:
	_occluders.clear()
	var runs := _wall_runs()
	_runs = runs
	# A run of wall is one node for all its edges (_add_wall_runs), but
	# what hides the player is still asked edge by edge, by the edge's own
	# bounds: a run's would reach far past the player either way.
	for key: Vector3i in _walls:
		var bounds := _bounds(_walls[key]) if BOX_WALLS else _edge_bounds(key)
		_occluders.append([_walls[key], bounds, false, runs[key]])
	var framed: Dictionary[Node3D, bool] = {}
	for key: Vector3i in _doorways:
		var frame := _doorways[key].get_node(DOOR_FRAME) as Node3D
		if not framed.has(frame):  # A double door's two edges: one frame.
			framed[frame] = true
			_occluders.append([frame, _bounds(frame), false, runs[key]])
	for post: Node3D in _posts.values():
		_occluders.append([post, _bounds(post), false, [post]])
	for tree: Node3D in _trees.values() + _saplings.values():
		_occluders.append([tree, _bounds(tree), true, [tree]])
	for props: Array in _clearing_props.values():
		for prop: Node3D in props:
			if prop.has_meta(&"fades"):
				_occluders.append([prop, _bounds(prop), true, [prop]])
	# A roof between the camera and a player outside fades as a wall does.
	for building in _buildings:
		if building["roof"] != null:
			_occluders.append([building["roof"], _bounds(building["roof"]), false, [building["roof"]]])
		# An art-walled one's wall quarters (718) fade as walls do.
		for quarter: Array in building.get("quarters", []):
			_occluders.append([quarter[0], _bounds(quarter[0]), false, [quarter[0]]])
		# A tall piece with no walls (a stall, a well, a standing stone) as a
		# tree does (623 amended (2)).
		if building.get("fades", false):
			_occluders.append([building["node"], _bounds(building["node"]), true, [building["node"]]])
		elif building.get("stands", false):
			# A landmark hides the player (the turn, their rim) but never fades: nothing to fade.
			_occluders.append([building["node"], _bounds(building["node"]), true, [], _shapes_of(building["node"])])
	_occluder_chunks.clear()
	_occluder_of.clear()
	_occluder_top = 0.0
	for index in _occluders.size():
		var bounds: AABB = _occluders[index][1]
		_occluder_of[_occluders[index][0]] = index
		_occluder_top = maxf(_occluder_top, bounds.end.y)
		for x in range(floori(bounds.position.x / FADE_CHUNK), floori(bounds.end.x / FADE_CHUNK) + 1):
			for z in range(floori(bounds.position.z / FADE_CHUNK), floori(bounds.end.z / FADE_CHUNK) + 1):
				var chunk := Vector2i(x, z)
				if not _occluder_chunks.has(chunk):
					_occluder_chunks[chunk] = []
				_occluder_chunks[chunk].append(index)
	_occluders_built = true


## For each wall and doorway edge, the pieces of its run: the walls and
## doorway frames in a straight line with it, and the posts along and at
## the ends of that line, up to where it turns, ends or another wall meets
## it (a room's side, not the whole castle's).
func _wall_runs() -> Dictionary[Vector3i, Array]:
	var out: Dictionary[Vector3i, Array] = {}
	var standing := func(key: Vector3i) -> bool: return _walls.has(key) or _doorways.has(key)
	for start: Vector3i in _walls.keys() + _doorways.keys():
		if out.has(start):
			continue
		var edges: Array[Vector3i] = [start]
		var vertices: Array[Vector2i] = []
		for end in 2:
			var key := start
			var at := end
			while true:
				var vertex := WallEdge.vertex_at(key, at)
				vertices.append(vertex)
				var meeting := 0
				for entry: Array in WallEdge.edges_at_vertex(vertex):
					if standing.call(entry[0]):
						meeting += 1
				var along := Vector3i(0, 1 if at == 0 else -1, 0) if key.z == Terrain.EAST else Vector3i(-1 if at == 0 else 1, 0, 0)
				var next := key + along
				if meeting > 2 or not standing.call(next) or next in edges:
					break
				edges.append(next)
				key = next
		var pieces: Array = []
		for key in edges:
			var piece: Node3D = _walls[key] if _walls.has(key) else _doorways[key].get_node(DOOR_FRAME)
			if not pieces.has(piece):
				pieces.append(piece)
			# Its leaves with its frame (864): shut, they are the near wall too,
			# and the player inside was hidden behind them while the rest faded.
			if not _walls.has(key):
				for leaf in _doorways[key].get_node(^"Door").get_children():
					if leaf is Node3D and str(leaf.name).begins_with("leaf") and not pieces.has(leaf):
						pieces.append(leaf)
		for vertex in vertices:
			if _posts.has(vertex) and not pieces.has(_posts[vertex]):
				pieces.append(_posts[vertex])
		for key in edges:
			out[key] = pieces
	return out


## A wall edge's own share of its run: its set's thickness across, the
## edge along, its height (_height_of) up from its base.
func _edge_bounds(key: Vector3i) -> AABB:
	var middle := _edge_midpoint(key) + Vector3(0.0, _edge_base(key), 0.0)
	var across: float = _wall_set(_set_of(key))["half"]
	var half := Vector3(across, 0.0, 0.5) if key.z == Terrain.EAST else Vector3(0.5, 0.0, across)
	return AABB(middle - half, half * 2.0 + Vector3(0.0, _height_of(key), 0.0))


## [param piece]'s meshes' bounds, in the world.
func _bounds(piece: Node3D) -> AABB:
	var out := AABB()
	var first := true
	for node in _descendants(piece):
		var mesh := node as MeshInstance3D
		if mesh == null or mesh.mesh == null:
			continue
		var box := mesh.global_transform * mesh.mesh.get_aabb()
		out = box if first else out.merge(box)
		first = false
	return out


## A near piece (a wall, a door's frame, a post, a tree between the camera
## and the player) is see-through and casts no shadow, so a lantern behind
## it still lights the floor in front; else as modelled. Every material
## under [param piece] is swapped for its see-through copy (_see_through_of):
## an override (a grey box, a flat box) as the mesh's override, kept in its
## OPAQUE_META to go back to; a surface's own as the surface's override.
func _set_near(piece: Node3D, near: bool) -> void:
	if near:
		piece.set_meta(TOUCHED_META, true)
	for node in _descendants(piece):
		var mesh := node as MeshInstance3D
		if mesh == null or mesh.mesh == null:
			continue
		if mesh.material_override != null or mesh.has_meta(OPAQUE_META):
			if not mesh.has_meta(OPAQUE_META):
				mesh.set_meta(OPAQUE_META, mesh.material_override)
			var own: Material = mesh.get_meta(OPAQUE_META)
			mesh.material_override = _see_through_of(own) if near else own
		else:
			# Its own overrides (its season's) kept, and put back after.
			if not mesh.has_meta(OPAQUE_SURFACES_META):
				var kept: Array[Material] = []
				for surface in mesh.mesh.get_surface_count():
					kept.append(mesh.get_surface_override_material(surface))
				mesh.set_meta(OPAQUE_SURFACES_META, kept)
			var opaque: Array[Material] = mesh.get_meta(OPAQUE_SURFACES_META)
			for surface in mesh.mesh.get_surface_count():
				var own: Material = opaque[surface] if opaque[surface] != null else mesh.mesh.surface_get_material(surface)
				mesh.set_surface_override_material(surface, _see_through_of(own) if near and own != null else opaque[surface])
		mesh.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF if near \
				else GeometryInstance3D.SHADOW_CASTING_SETTING_ON


## Under the low camera, [param puppet] drawn or not by whether its body
## is [param within] World.NEAR_TILES: a change eases over REACH_EASE from
## [param now] (ms), its meshes' transparency rising as it leaves and
## falling as it comes, hidden only once gone; a puppet just [param made]
## is simply drawn or not.
func _ease_reach(puppet: Node3D, within: bool, made: bool, now: int) -> void:
	if made or not puppet.has_meta("reach_in"):
		puppet.set_meta("reach_in", within)
		puppet.visible = within
		return
	if bool(puppet.get_meta("reach_in")) != within:
		puppet.set_meta("reach_in", within)
		puppet.set_meta("reach_at", now)
		puppet.visible = true
	if not puppet.has_meta("reach_at"):
		return
	var share := clampf((now - int(puppet.get_meta("reach_at"))) / (reach_ease * 1000.0), 0.0, 1.0)
	if share >= 1.0:
		puppet.remove_meta("reach_at")
		_set_transparency(puppet, 0.0 if within else 1.0)
		puppet.visible = within
		return
	_set_transparency(puppet, 1.0 - share if within else share)


## Every drawn part of [param puppet] (its meshes, its name, its bar) at
## [param transparency] (0 solid, 1 gone).
func _set_transparency(puppet: Node3D, transparency: float) -> void:
	for node in _descendants(puppet):
		if node is GeometryInstance3D:
			(node as GeometryInstance3D).transparency = transparency


# --- Entities ----------------------------------------------------------------

## One puppet per spawned entity, placed where its 2D node is (the grid
## position under the azimuth-0 projection), turned to its shown facing,
## removed when it goes.
func _sync_puppets() -> void:
	var seen: Dictionary[int, bool] = {}
	var now := Time.get_ticks_msec()
	_idle_voices(now)
	var reach := maxf(_view_reach() + PUPPET_MARGIN, Sfx.MAX_DISTANCE) if _camera != null else INF
	var aim := Vector2(_camera_target.x, _camera_target.z)
	var frame := Engine.get_process_frames()
	var far_making := 0
	# World's own list, not a copy: nothing here spawns or despawns.
	for entity in World.entities():
		if not entity.spawned:
			continue
		var id := entity.get_instance_id()
		seen[id] = true
		if (id + frame) % FAR_EVERY != 0 and _far.has(id):
			# Far off when last looked at: looked at again every FAR_EVERY
			# frames (a big map holds thousands of them).
			continue
		var made := not _puppets.has(id)
		if not made and not _far.has(id) and Vector2(entity.tile).distance_to(aim) <= reach 				and _puppets[id].get_meta("body", &"") != body_of(entity):
			# Its body came after it did (a client hears it a moment later).
			if _puppets[id] == _outlined:
				target(null)
			_puppets[id].queue_free()
			made = true
		var far_off := made and Vector2(entity.tile).distance_to(aim) > reach
		if far_off and far_making >= FAR_MAKE_USEC and not _puppets.has(id):
			seen.erase(id)
			continue  # Made in a later frame (FAR_MAKE_USEC).
		var making := Time.get_ticks_usec()
		if made:
			_puppets[id] = _make_puppet(entity)
			if far_off:
				far_making += Time.get_ticks_usec() - making
		var puppet := _puppets[id]
		if not made and Vector2(entity.tile).distance_to(aim) > reach:
			# Far off: unseen and unheard. Its tile and hp are kept, so it
			# makes no footstep for the way it came and its bar shows a
			# fight it had, when it comes near. Its puppet (animation,
			# skeleton) and its entity's drawing are stopped meanwhile: a
			# thousand idle animations a frame were most of a big map's
			# frame.
			if not _far.has(id):
				puppet.process_mode = Node.PROCESS_MODE_DISABLED
				entity.set_process(false)
			_far[id] = true
			_last_tile[id] = entity.tile
			if _last_hp.get(id, entity.hp) != entity.hp:
				_combat_at[id] = now
			_last_hp[id] = entity.hp
			continue
		if _far.has(id):
			_far.erase(id)
			puppet.remove_meta("last_at")  # Not a run from where it was last drawn.
			puppet.process_mode = Node.PROCESS_MODE_INHERIT
			entity.set_process(true)
			entity._display_caught_up()
		if not entity.holds_cell:
			# Gone (573 amended (4), the draugr at rest): not drawn at once;
			# back, he eases in (REACH_EASE) where he stands again.
			puppet.set_meta("reach_in", false)
			puppet.remove_meta("reach_at")
			puppet.visible = false
			_sync_remains(id, entity)
			continue
		if _remains.has(id):
			_drop_remains(id)  # Back: his remains go as he eases in.
		if entity is Seam:
			_sync_seam(puppet, entity as Seam)
		if str(entity.spawn_spec.get("art", "")) == CART_ART:
			_sync_cart(puppet, entity, now)
		if _low or puppet.has_meta("reach_in"):
			# The low camera sees past World.NEAR_TILES: a body out there is
			# not drawn (it would stand still, unthinking, 238); one crossing
			# the edge eases in or out (REACH_EASE), as does one come back.
			_ease_reach(puppet, not _low or Vector2(entity.tile).distance_to(aim) <= World.NEAR_TILES, made, now)
		var grid := Iso.local_to_grid(entity.position)
		var at := Vector3(grid.x, _ground_height(grid), grid.y)
		if puppet.position != at:
			puppet.position = at
		var yaw := _sleeping_yaw(entity, _tending_yaw(entity, _aimed_yaw(entity, -entity.shown_facing().angle())))
		var facing := puppet.get_node_or_null("Facing") as Node3D
		# (Angles kept as float32: compared near enough, not ==.)
		if facing != null:
			if not entity is Monster and not work_word(entity) in ["sleep_side", "sleep"]:  # Asleep, laid down at once.
				yaw = _standing_turn(puppet, facing.rotation.y, yaw)
			if not is_equal_approx(facing.rotation.y, yaw):
				facing.rotation.y = yaw
		if entity is Resident and not Net.is_authority():
			_mirror_hands(entity as Resident)  # Before anything reads its hands: a guard's spear.
		_sync_held(entity, puppet)
		_slide_reach(puppet)
		_sync_worn(entity, puppet)
		_sync_worn_gear(entity, puppet)  # After the armour: a cloak over it, the cape under it.
		if entity is Resident:
			_sync_carried(entity as Resident, puppet, id)
			_sync_addressing(entity as Resident, puppet)
			_sync_bedroll(entity as Resident, puppet)
			_sync_work(entity as Resident, puppet)
		elif entity is Player or entity is Companion:
			_sync_work(entity, puppet)  # Its bandaging (the kneel); a companion's sleep.
			_sync_aura(entity, puppet, id)
			if entity is Companion:
				puppet.set_meta("guide_wait", (entity as Companion).guide_wait)
		_sync_bow(entity, puppet)
		if entity is Player:
			var lantern := puppet.get_node_or_null("Lantern") as Node3D
			if lantern != null and lantern.visible != (entity.emit_light > 0.0):
				lantern.visible = entity.emit_light > 0.0  # Covered (L).
		elif entity is Monster:
			_sync_named(entity as Monster, puppet)
			_sync_alert(entity as Monster, puppet)
			_sync_chatter(entity as Monster, puppet)
		_sync_down(entity, puppet)
		if (entity is Player or entity is Companion) and bool(puppet.get_meta("downed", false)) != World.is_downed(entity):
			puppet.set_meta("downed", World.is_downed(entity))  # Its fall, if it comes, a bleed-out (628).
		_sync_draw(entity, puppet)
		_sync_ailments(entity, puppet)
		_sync_name(entity, puppet, now)
		yaw = _teeter_yaw(entity, puppet, yaw, now)
		puppet.set_meta("teetering", entity.teeter != Vector2i.ZERO)
		puppet.set_meta("crouched", entity is Player and (entity as Player).crouched)
		if puppet.has_meta("rig"):
			var body := puppet.get_node("Body") as Node3D
			_lay(puppet, body, yaw, entity.tile)
			if not is_equal_approx(body.rotation.y, yaw):
				body.rotation.y = yaw
			_teeter_lean(entity, puppet, body, now)
			(puppet.get_meta("rig") as AnimRig).every = _pose_every(puppet)
			_animate(puppet)
			_footfall_sounds(entity, puppet, puppet.get_meta("rig") as AnimRig)
			_stroke_sounds(entity, puppet, puppet.get_meta("rig") as AnimRig)
		elif puppet.has_meta("creature_view"):
			var body := puppet.get_node("Body") as Node3D
			if not is_equal_approx(body.rotation.y, yaw):
				body.rotation.y = yaw
			_teeter_lean(entity, puppet, body, now)
			var view := puppet.get_meta("creature_view") as CreatureView
			if view.rig != null:
				view.rig.every = _pose_every(puppet)
			view.frame(puppet, entity as Monster)
		_sync_bar(entity, puppet, now)
		_step_sound(entity, puppet)
	for id in _puppets.keys():
		if not seen.has(id):
			_entity_went(id)


## A seam worked out (decision 769) is drawn as its rubble
## (SEAM_SPENT_ART in place of its face) till it fills again; squat, while
## the kit has no rubble.
func _sync_seam(puppet: Node3D, seam: Seam) -> void:
	# A sack given (769 amended (4)): its hp back up from a blow, or its last
	# sack taking it to spent; not when it fills again, nor as first seen.
	var was: Variant = puppet.get_meta("seam_was") if puppet.has_meta("seam_was") else null
	puppet.set_meta("seam_was", [seam.hp, seam.spent])
	if was is Array and not bool(was[1]) and (seam.hp > int(was[0]) or seam.spent):
		sfx.play("sfx.ore_sack", puppet.position + Vector3.UP * 0.4)
	if bool(puppet.get_meta("spent", false)) == seam.spent:
		return
	puppet.set_meta("spent", seam.spent)
	var body := puppet.get_node_or_null("Body")
	var face := art_slot_for(seam)
	if body != null and face != "" and ArtKit.has(SEAM_SPENT_ART):
		for child in body.get_children():
			body.remove_child(child)
			child.queue_free()
		body.add_child(ArtKit.instance(SEAM_SPENT_ART if seam.spent else face))
		return
	puppet.scale = Vector3(1.0, SEAM_RUBBLE_HEIGHT, 1.0) if seam.spent else Vector3.ONE


## A pick's blow on a seam (769 amended (9)): a puff of rock dust and grit off its face where the
## point lands (SEAM_DUST_UP up its front, which faces its spawn's art_facing), out from the rock
## and falling, as the strike's sound plays; a worked-out seam's rubble too (the blow rings off it).
const SEAM_DUST_UP := 1.25
const SEAM_DUST_OUT := 0.36
const SEAM_DUST_PUFFS := 14
const SEAM_DUST_SPENT_UP := 0.3
func _seam_dust(puppet: Node3D, seam: Seam) -> void:
	if seam == null or not puppet.is_inside_tree():
		return
	var dust := puppet.get_node_or_null("SeamDust") as GPUParticles3D
	if dust == null:
		dust = _make_slab_dust()
		dust.name = "SeamDust"
		dust.amount = SEAM_DUST_PUFFS
		dust.lifetime = 0.9
		dust.explosiveness = 0.9
		var out: Variant = seam.spawn_spec.get("art_facing")
		var way := Vector3(float(out.x), 0.0, float(out.y)) if out is Vector2i else Vector3(0.0, 0.0, 1.0)
		dust.position = way * SEAM_DUST_OUT + Vector3.UP * SEAM_DUST_UP
		var process := dust.process_material as ParticleProcessMaterial
		process.emission_box_extents = Vector3(0.06, 0.06, 0.06)
		process.direction = way + Vector3.UP * 0.3
		process.spread = 40.0
		process.initial_velocity_min = 0.6
		process.initial_velocity_max = 1.4
		process.gravity = Vector3(0.0, -2.5, 0.0)
		dust.draw_pass_1 = _soft_puff(SLAB_DUST_SIZE * 0.45)
		puppet.add_child(dust)
	# A spent seam's rubble is low (squashed by puppet.scale, or its own art): the puff off its top.
	dust.position.y = (SEAM_DUST_SPENT_UP if seam.spent else SEAM_DUST_UP) / maxf(puppet.scale.y, 0.01)
	dust.restart()


## The mine's cart (769 amended (4)): its roll held (sfx.minecart_roll) from
## the moment its tile moves, steered along with it, and let go with its
## stop (sfx.minecart_stop) once it has not moved for cart_stop_ms; the
## roll pitched by its speed (794, sound's side).
func _sync_cart(puppet: Node3D, cart: GridEntity, now: int) -> void:
	var was: Variant = puppet.get_meta("cart_tile") if puppet.has_meta("cart_tile") else null
	puppet.set_meta("cart_tile", cart.tile)
	var roll: AudioStreamPlayer3D = puppet.get_meta("cart_roll") if puppet.has_meta("cart_roll") else null
	if was is Vector2i and was != cart.tile:
		puppet.set_meta("cart_moved", now)
		if roll == null or not is_instance_valid(roll):
			roll = sfx.hold("sfx.minecart_roll", puppet.position + Vector3.UP * 0.5)
			if roll != null:
				puppet.set_meta("cart_roll", roll)
	if roll == null or not is_instance_valid(roll):
		return
	if now - int(puppet.get_meta("cart_moved", now)) < cart_stop_ms(cart.move_ticks):
		sfx.steer(roll, puppet.position + Vector3.UP * 0.5)
		roll.pitch_scale = cart_roll_pitch(cart.move_ticks)
		return
	roll.queue_free()
	puppet.remove_meta("cart_roll")
	sfx.play("sfx.minecart_stop", puppet.position + Vector3.UP * 0.5)


## How long a cart whose step takes [param move_ticks] (794's replicated
## roll) waits still before its stop is heard: past its step, at least
## CART_STOP_MS.
static func cart_stop_ms(move_ticks: float) -> int:
	return maxi(CART_STOP_MS, roundi(move_ticks * 1000.0 / World.TICK_RATE) + CART_STOP_SLACK_MS)


## A rolling cart's pitch at [param move_ticks] a step: CART_PITCH.x at
## World.cart_stop_speed cells a second .. CART_PITCH.y at cart_top_speed.
static func cart_roll_pitch(move_ticks: float) -> float:
	var speed := World.TICK_RATE / maxf(move_ticks, 0.1)
	var share := inverse_lerp(World.cart_stop_speed, World.cart_top_speed, speed)
	return lerpf(CART_PITCH.x, CART_PITCH.y, clampf(share, 0.0, 1.0))


## Gone at rest (573 amended (4)): the draugr's remains (art-kit's one-cell
## REMAINS_PROP, its front +z) lie on the cell he fell on, pile_at, turned
## pile_facing as the buildings turn theirs (atan2(x, y)). Nothing drawn
## for one with no pile_at, or with no such prop in the kit.
func _sync_remains(id: int, entity: GridEntity) -> void:
	var pile: Variant = entity.get("pile_at")
	var facing: Variant = entity.get("pile_facing")
	if not pile is Vector2i or not facing is Vector2i or not ArtKit.has(REMAINS_PROP):
		return
	var node: Node3D = _remains.get(id)
	if node == null:
		node = ArtKit.instance(REMAINS_PROP)
		if node == null:
			return
		node.name = "Remains%d" % id
		add_child(node)
		_remains[id] = node
	var at := Vector3(pile.x, _ground_height(Vector2(pile)), pile.y)
	if node.position != at:
		node.position = at
	var yaw := atan2(float(facing.x), float(facing.y))
	if not is_equal_approx(node.rotation.y, yaw):
		node.rotation.y = yaw


func _drop_remains(id: int) -> void:
	var node: Node3D = _remains.get(id)
	_remains.erase(id)
	if node != null and is_instance_valid(node):
		node.queue_free()


## The entity of puppet [param id] is gone: it falls if its death has come;
## otherwise it is kept still a moment in case its death is on its way.
func _entity_went(id: int) -> void:
	var puppet: Node3D = _puppets[id]
	_puppets.erase(id)
	_drop_remains(id)
	_stop_creak(puppet)
	if puppet == _outlined:
		target(null)
	_combat_at.erase(id)
	_carriers.erase(id)
	_last_hp.erase(id)
	_last_tile.erase(id)
	_last_step_ms.erase(id)
	_step_pace.erase(id)
	_step_slot.erase(id)
	_far.erase(id)
	var entity_name: String = puppet.get_meta("entity_name", "")
	if _pending_deaths.has(entity_name):
		_fall(puppet, _pending_deaths[entity_name])
		_pending_deaths.erase(entity_name)
	else:
		_departed[entity_name] = {"puppet": puppet, "at": Time.get_ticks_msec()}


func _drop_departed() -> void:
	var now := Time.get_ticks_msec()
	for entity_name: String in _departed.keys():
		if now - int(_departed[entity_name]["at"]) >= DEPARTED_SECONDS * 1000.0:
			(_departed[entity_name]["puppet"] as Node3D).queue_free()
			_departed.erase(entity_name)


## The HP bar: its fill and colour from the hp, and whether it shows: hurt,
## in a fight lately, or Alt held; faded either way.
func _sync_bar(entity: GridEntity, puppet: Node3D, now: int) -> void:
	var bar := puppet.get_node_or_null("HpBar") as MeshInstance3D
	if bar == null:
		return
	var id := entity.get_instance_id()
	if _last_hp.get(id, entity.hp) != entity.hp:
		_combat_at[id] = now
	_last_hp[id] = entity.hp
	var share := clampf(float(entity.hp) / maxf(entity.max_hp, 1.0), 0.0, 1.0)
	var material := bar.material_override as ShaderMaterial
	var wanted := 0.0
	if Net.hp_bars and (show_all_bars or share < 1.0 or now - _combat_at.get(id, -100000) < COMBAT_SECONDS * 1000.0):
		wanted = 1.0
	var alpha := move_toward(float(material.get_shader_parameter("alpha")), wanted, get_process_delta_time() * HP_BAR_FADE)
	material.set_shader_parameter("alpha", alpha)
	material.set_shader_parameter("fill", share)
	material.set_shader_parameter("fill_color", hp_color(share))
	bar.visible = alpha > 0.001


## The bar's colour for [param share] of hp left.
static func hp_color(share: float) -> Color:
	if share < HP_RED:
		return HP_RED_COLOR
	if share < HP_AMBER:
		return HP_AMBER_COLOR
	return HP_GREEN_COLOR


## A footstep when a creature's replicated tile moves on by one.
## Whether a body on [param tile] wades: water, or a ford (decision 505),
## which is waded though it isn't deep water.
static func wades(tile: Vector2i) -> bool:
	return World.is_water(tile) or World.is_ford(tile)


## A body stepping out of the water drips twice, this far apart (505 amended (3)).
const WADE_DRIP_SECONDS := 0.45
## How many bodies have dripped out of the water (view_test).
var drips := 0


func _step_sound(entity: GridEntity, puppet: Node3D) -> void:
	var id := entity.get_instance_id()
	var last: Vector2i = _last_tile.get(id, entity.tile)
	_last_tile[id] = entity.tile
	if entity.is_creature() and last != entity.tile and World.distance(last, entity.tile) == 1:
		# A ford (decision 505) is waded, though it isn't deep water.
		var wet := wades(entity.tile)
		var ground: String = "water" if wet else _ground_kinds.get(entity.tile, "stone")
		var creature := str(entity.spawn_spec.get("kind", "")) if entity is Monster else ""
		_step_slot[id] = SoundKit.footstep(ground, entity.mass, creature)
		if not wet and wades(last):
			# Out of the water (505 amended (3)): a drop off it now, another a moment on.
			var at := puppet.position + Vector3.UP * 0.3
			sfx.play("sfx.wade_drip", at)
			get_tree().create_timer(WADE_DRIP_SECONDS).timeout.connect(sfx.play.bind("sfx.wade_drip", at))
			drips += 1
		# A body already in a gait with footfalls steps on them (_footfall_sounds);
		# otherwise (standing off, or no feet drawn) the cell's step is the footfall.
		var rig := puppet.get_meta("rig") as AnimRig if puppet.has_meta("rig") else null
		var on_feet := rig != null and GAIT_FOOTFALLS.has(rig.base_clip())
		if not on_feet:
			sfx.play(_step_slot[id], puppet.position, 1.0, 0.0, Senses.step_radius(entity))
		var now := Time.get_ticks_msec()
		if rustles(entity.tile, _flattened.get(entity.tile, -FLATTENED_MS), now):
			sfx.play("sfx.grass_rustle", puppet.position, 1.0, 0.0, Senses.step_radius(entity))
		var since := (now - int(_last_step_ms.get(id, -1000000))) / 1000.0
		_last_step_ms[id] = now
		_step_pace[id] = SoundKit.step_pace(since)
		if not on_feet:
			_armour_sound(entity, puppet, _step_pace[id])


## Worn armour heard with a footfall (676 1b; Jeff: worn armour clanks):
## plate's clank or mail's jingle as far as World.armour_noise carries it
## (the server's &"clank" noise, the one prey hear), louder the further it
## carries; leather and robes nothing. [param pace]: its last step's
## (SoundKit.step_pace).
func _armour_sound(entity: GridEntity, puppet: Node3D, pace: float) -> void:
	var worn: Variant = entity.get("worn")
	if not worn is String or (worn as String).is_empty():
		return
	var heard: Dictionary = World.armour_noise(worn, pace)
	var slot := SoundKit.armour_slot(str(heard["kind"]))
	if slot != "":
		sfx.play(slot, puppet.position, 1.0, SoundKit.armour_db(str(heard["kind"]), int(heard["radius"])), int(heard["radius"]))


## The footstep and worn armour at the body's own footfalls (676 1b amended;
## Jeff on the first mixes: "the walking ones are approximately running
## speed"): each frame the gait clip's place is compared with the last, and
## a footfall of GAIT_FOOTFALLS passed over (the clip wrapping too) plays
## the last cell's footstep and the armour's clank together, at that step's
## pace, while the body still moves (a cell within FOOTFALL_MOVING_MS).
## Standing, or a clip with no footfalls, none: _step_sound plays the cell's.
func _footfall_sounds(entity: GridEntity, puppet: Node3D, rig: AnimRig) -> void:
	var clip := rig.base_clip()
	var length := rig.length(clip)
	var falls: Array = GAIT_FOOTFALLS.get(clip, [])
	if falls.is_empty() or length <= 0.0:
		if puppet.has_meta("footfall_at"):
			puppet.remove_meta("footfall_at")
		return
	var at := fposmod(rig.base_position(), length) / length
	var was: Variant = puppet.get_meta("footfall_at") if puppet.has_meta("footfall_at") else null
	puppet.set_meta("footfall_at", [clip, at])
	if not (was is Array and was[0] == clip and footfall_between(float(was[1]), at, falls)):
		return
	var id := entity.get_instance_id()
	if Time.get_ticks_msec() - int(_last_step_ms.get(id, -1000000)) > FOOTFALL_MOVING_MS:
		return
	if _step_slot.has(id):
		sfx.play(_step_slot[id], puppet.position, 1.0, 0.0, Senses.step_radius(entity))
	_armour_sound(entity, puppet, float(_step_pace.get(id, 1.0)))


## A work's strokes heard where the tool meets its work (804 amended (18)):
## each work clip's shares at its blows (tools/humanoid_clips.py's keys: the
## axe in at 0.62 s of Chop's 1.6, the hammer's face at 0.22 of Hammer's 0.7;
## the saw's push and its pull, each half of Saw's 0.8), passed over as the
## clip loops (footfall_between, as the footfalls), at the body's tool hand
## height, while it stands to its work (the clip on its base layer).
const WORK_STROKES: Dictionary[String, Array] = {"Chop": [0.3875], "Saw": [0.0, 0.5], "Hammer": [0.314]}
## A work's stroke sound by its ACTIVITIES word.
const STROKE_SLOTS := {"chop": "sfx.chop_wood", "saw": "sfx.saw_stroke", "hammer": "sfx.hammer_wood"}
## How high over its feet a stroke is heard (the tool at the hands).
const STROKE_UP := 1.0


## The slot [param entity]'s work word [param word] strikes with ("" none).
static func stroke_slot(entity: GridEntity, word: String) -> String:
	return str(STROKE_SLOTS.get(word, ""))


func _stroke_sounds(entity: GridEntity, puppet: Node3D, rig: AnimRig) -> void:
	var word := str(puppet.get_meta("work", ""))
	var work: Dictionary = ACTIVITIES.get(word, {})
	var clip := rig.base_clip()
	var blows: Array = WORK_STROKES.get(clip, [])
	var length := rig.length(clip)
	var slot := stroke_slot(entity, word)
	if slot.is_empty() or blows.is_empty() or length <= 0.0 or str(work.get("clip", "")) != clip:
		if puppet.has_meta("stroke_at"):
			puppet.remove_meta("stroke_at")
		return
	var at := fposmod(rig.base_position(), length) / length
	var was: Variant = puppet.get_meta("stroke_at") if puppet.has_meta("stroke_at") else null
	puppet.set_meta("stroke_at", [clip, at])
	if was is Array and was[0] == clip and footfall_between(float(was[1]), at, blows):
		sfx.play(slot, puppet.position + Vector3.UP * STROKE_UP)


## Whether a share of a clip in [param falls] lies after [param from] and up
## to [param to], going forward (past the clip's end round to its start when
## [param to] is less).
static func footfall_between(from: float, to: float, falls: Array) -> bool:
	for fall: float in falls:
		if (from < fall and fall <= to) if from <= to else (fall > from or fall <= to):
			return true
	return false


## Whether a step into [param tile] rustles: standing tall grass (decision
## 508), or tall grass flattened at [param flattened] (ms) within
## FLATTENED_MS of [param now] (that step's own trampling).
static func rustles(tile: Vector2i, flattened: int, now: int) -> bool:
	return World.cover_at(tile) > 0.0 or World.is_tall_grass(tile) and now - flattened < FLATTENED_MS


## Tall grass trampled ([param flat], flat [x, y, ...]) noted for
## rustles(); a full "grass" message (both empty) notes nothing. Its clumps
## are laid flat, and those [param stood] stood again.
func _on_grass_changed(_level: String, flat: PackedInt32Array, stood: PackedInt32Array) -> void:
	var now := Time.get_ticks_msec()
	var changed: Array[Vector2i] = []
	for i in range(0, flat.size() - 1, 2):
		_flattened[Vector2i(flat[i], flat[i + 1])] = now
		changed.append(Vector2i(flat[i], flat[i + 1]))
	for i in range(0, stood.size() - 1, 2):
		changed.append(Vector2i(stood[i], stood[i + 1]))
	# The drawn tall grass (decision 508, terrain's side): the cells told,
	# or after a full set (both empty) every clump, laid flat or stood.
	_show_trampled(_tall_where.keys() if flat.is_empty() and stood.is_empty() else changed)
	for cell: Vector2i in _flattened.keys():
		if now - _flattened[cell] >= FLATTENED_MS:
			_flattened.erase(cell)


## A wounded animal's blood (764, terrain's side): each level's marked cells,
## level -> {cell: the msec it fades out at}, from World.blood_changed.
var _blood: Dictionary = {}
## The drawn specks of the zone's level (one MultiMesh), and when they next
## need drawing again (a mark fading a step, or going); 0 for none due.
var _blood_drawn: MultiMeshInstance3D
var _blood_due := 0
## Each drawn speck's place and colour, its fade the alpha (a headless
## MultiMesh keeps neither, so tests read them here).
var _blood_specks: Array[Transform3D] = []
var _blood_shades: Array[Color] = []
static var _blood_mesh: Mesh
static var _blood_material: StandardMaterial3D
## Specks a marked cell shows, at least and at most (seeded by the cell).
const BLOOD_SPECKS := Vector2i(3, 6)
## A mark fades out over its last BLOOD_FADE_MS; redrawn every
## BLOOD_STEP_MS while fading.
const BLOOD_FADE_MS := 80000
const BLOOD_STEP_MS := 2000
const BLOOD_COLOR := Color(0.24, 0.015, 0.01)
## On brown ground (dirt, the forest floor, a road) darker red would
## vanish: redder, and a little bigger.
const BLOOD_ON_BROWN := Color(0.46, 0.02, 0.015)
const BLOOD_BROWN_GROW := 1.35
const BLOOD_BROWN: Array[String] = ["dirt", "forest"]


## Blood marked or gone on [param level] (764): [param add] flat [x, y,
## seconds left, ...], [param gone] flat [x, y, ...]; [param full] sets the
## level's whole list (a zone joined). Drawn at once if it is this zone's.
func _on_blood_changed(level: String, add: PackedInt32Array, gone: PackedInt32Array, full := false) -> void:
	var now := Time.get_ticks_msec()
	if full or not _blood.has(level):
		_blood[level] = {}
	var marks: Dictionary = _blood[level]
	for i in range(0, add.size() - 2, 3):
		marks[Vector2i(add[i], add[i + 1])] = now + add[i + 2] * 1000
	for i in range(0, gone.size() - 1, 2):
		marks.erase(Vector2i(gone[i], gone[i + 1]))
	if marks.is_empty():
		_blood.erase(level)
	if World.zone != null and level == World.zone.name:
		_draw_blood()


## Redrawn when a fading mark's step is due (from _process).
func _update_blood() -> void:
	if _blood_due != 0 and Time.get_ticks_msec() >= _blood_due:
		_draw_blood()


## The zone's blood as dark specks on the ground: a few to a cell, seeded
## by the cell, lying on its slope, fading out over their last BLOOD_FADE_MS;
## none on water, none indoors. Marks past their time are dropped here too.
func _draw_blood() -> void:
	_blood_due = 0
	var now := Time.get_ticks_msec()
	var level := World.zone.name if World.zone != null else ""
	var marks: Dictionary = _blood.get(level, {})
	for cell: Vector2i in marks.keys():
		if int(marks[cell]) <= now:
			marks.erase(cell)
	if marks.is_empty():
		_blood.erase(level)
	var specks: Array[Transform3D] = []
	var shades: Array[Color] = []
	if _outdoor and _room != null:
		for cell: Vector2i in marks:
			if _terrain_water_has(cell):
				continue
			var left: int = int(marks[cell]) - now
			var alpha := clampf(float(left) / BLOOD_FADE_MS, 0.0, 1.0)
			if left < BLOOD_FADE_MS:
				var step := now + mini(BLOOD_STEP_MS, left)
				_blood_due = step if _blood_due == 0 else mini(_blood_due, step)
			else:
				var start := now + left - BLOOD_FADE_MS
				_blood_due = start if _blood_due == 0 else mini(_blood_due, start)
			var brown_cell: bool = _ground_kinds.get(cell, "") in BLOOD_BROWN
			var rng := RandomNumberGenerator.new()
			rng.seed = hash(cell)
			for _k in rng.randi_range(BLOOD_SPECKS.x, BLOOD_SPECKS.y):
				var at := Vector2(cell) + Vector2(rng.randf_range(-0.4, 0.4), rng.randf_range(-0.4, 0.4))
				var brown := brown_cell or not _road_curves.is_empty() and _road_near(at).x > 0.0
				var tint := BLOOD_ON_BROWN if brown else BLOOD_COLOR
				var size := rng.randf_range(0.05, 0.16) * (BLOOD_BROWN_GROW if brown else 1.0)
				var y := _height_in(cell, at)
				var up := _ground_up(cell, at)
				var spin := Basis(Vector3.UP, rng.randf() * TAU)
				var tilt := Basis(Quaternion(Vector3.UP, up))
				var shape := Basis.from_scale(Vector3(size * rng.randf_range(1.0, 1.8), 1.0, size))
				specks.append(Transform3D(tilt * spin * shape, Vector3(at.x, y + 0.015, at.y)))
				shades.append(Color(tint, alpha * rng.randf_range(0.75, 1.0)))
	if specks.is_empty():
		_blood_specks = []
		_blood_shades = []
		if is_instance_valid(_blood_drawn):
			_blood_drawn.queue_free()
		_blood_drawn = null
		return
	if not is_instance_valid(_blood_drawn) or _blood_drawn.get_parent() != _room:
		_blood_drawn = MultiMeshInstance3D.new()
		_blood_drawn.name = "Blood"
		_blood_drawn.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		_blood_drawn.material_override = _blood_look()
		_room.add_child(_blood_drawn)
	var multimesh := MultiMesh.new()
	multimesh.transform_format = MultiMesh.TRANSFORM_3D
	multimesh.use_colors = true
	multimesh.mesh = _blood_speck()
	multimesh.instance_count = specks.size()
	for i in specks.size():
		multimesh.set_instance_transform(i, specks[i])
		multimesh.set_instance_color(i, shades[i])
	_blood_drawn.multimesh = multimesh
	_blood_specks = specks
	_blood_shades = shades


## A speck: a flat six-sided disc a metre across (scaled down per speck).
static func _blood_speck() -> Mesh:
	if _blood_mesh == null:
		var disc := CylinderMesh.new()
		disc.top_radius = 0.5
		disc.bottom_radius = 0.5
		disc.height = 0.004
		disc.radial_segments = 6
		disc.rings = 1
		disc.cap_bottom = false
		_blood_mesh = disc
	return _blood_mesh


## Wet and dark, its colour and fade each speck's own.
static func _blood_look() -> StandardMaterial3D:
	if _blood_material == null:
		_blood_material = StandardMaterial3D.new()
		_blood_material.vertex_color_use_as_albedo = true
		_blood_material.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
		_blood_material.roughness = 0.35
		_blood_material.albedo_color = Color.WHITE
	return _blood_material


## The ground's up at [param at] in [param cell] (its slope), for marks
## lying on it (blood, prints).
func _ground_up(cell: Vector2i, at: Vector2) -> Vector3:
	var y := _height_in(cell, at)
	var dx := _height_in(cell, at + Vector2(0.05, 0.0)) - y
	var dz := _height_in(cell, at + Vector2(0.0, 0.05)) - y
	return Vector3(-dx, 0.05, -dz).normalized()


## An apex creature's prints (780 amended (3), terrain's side): each level's
## marked cells, level -> {cell: [the msec it fades out at, facing 0..7
## clockwise from north]}, from World.tracks_changed.
var _tracks: Dictionary = {}
## The drawn prints of the zone's level (one MultiMesh), and when they next
## need drawing again (a print fading a step, or going); 0 for none due.
var _tracks_drawn: MultiMeshInstance3D
var _tracks_due := 0
## Each drawn part's (a pad or a toe) place and colour, its fade the alpha
## (a headless MultiMesh keeps neither, so tests read them here).
var _track_parts: Array[Transform3D] = []
var _track_shades: Array[Color] = []
static var _track_mesh: Mesh
static var _track_material: StandardMaterial3D
## A print fades out over its last TRACK_FADE_MS; redrawn every
## TRACK_STEP_MS while fading (blood's).
const TRACK_FADE_MS := 80000
const TRACK_STEP_MS := 2000
## Pressed earth, darker than the ground; on grass more of it, or the dark
## grass swallows it (the coordinator).
const TRACK_COLOR := Color(0.07, 0.045, 0.025)
const TRACK_ALPHA := 0.6
const TRACK_ON_GRASS := 0.85
## A paw: its pad's size across and along (m), its toes' size, how far
## ahead of the pad's middle they sit, and how far apart the pair's paws are
## across the way walked and along it (the right one ahead).
const TRACK_PAD := Vector2(0.32, 0.24)
const TRACK_TOE := 0.08
const TRACK_TOES_AHEAD := 0.21
const TRACK_PAIR := Vector2(0.44, 0.16)
## No prints on these grounds (and none on a stone road, water or a ford).
const TRACK_HARD: Array[String] = ["stone"]


## Tracks marked or gone on [param level] (780 amended (2)): [param add] flat
## [x, y, seconds left, facing, ...], [param gone] flat [x, y, ...]; [param
## full] sets the level's whole list (a zone joined). Drawn at once if it is
## this zone's.
## Each zone's burning hearths as last heard ({zone: [cell]}, 825).
var _hearths_heard: Dictionary = {}
## Till when the live zone's hearth changes are its arrival's (msec).
var _hearths_settle_at := 0


## [param zone_name]'s hearths changed (World.hearths_changed, 825; beside
## _on_hearths_changed's drawing): a ring
## of the live zone burning now that wasn't is lit, its catch heard there;
## one stoked or still burning, gone cold, or burning on arrival, nothing.
func _hear_hearths(zone_name: String) -> void:
	var now := World.lit_hearths(zone_name)
	var before: Variant = _hearths_heard.get(zone_name)
	_hearths_heard[zone_name] = now
	if before == null or World.zone == null or zone_name != World.zone.name or Time.get_ticks_msec() < _hearths_settle_at:
		return
	for cell: Vector2i in SoundKit.newly_lit(before, now):
		sfx.play(HEARTH_CATCH_SOUND, _tile_position(cell) + Vector3.UP * 0.4)


func _on_tracks_changed(level: String, add: PackedInt32Array, gone: PackedInt32Array, full := false) -> void:
	var now := Time.get_ticks_msec()
	if full or not _tracks.has(level):
		_tracks[level] = {}
	var marks: Dictionary = _tracks[level]
	for i in range(0, add.size() - 3, 4):
		marks[Vector2i(add[i], add[i + 1])] = [now + add[i + 2] * 1000, posmod(add[i + 3], 8)]
	for i in range(0, gone.size() - 1, 2):
		marks.erase(Vector2i(gone[i], gone[i + 1]))
	if marks.is_empty():
		_tracks.erase(level)
	if World.zone != null and level == World.zone.name:
		_draw_tracks()


## Redrawn when a fading print's step is due (from _process).
func _update_tracks() -> void:
	if _tracks_due != 0 and Time.get_ticks_msec() >= _tracks_due:
		_draw_tracks()


## Whether a print can be pressed at [param at] (in [param cell]): not on
## water or a ford, hard ground, or a stone road.
func _takes_print(cell: Vector2i, at: Vector2) -> bool:
	if _terrain_water_has(cell) or str(_ground_kinds.get(cell, "")) in TRACK_HARD:
		return false
	if not _road_curves.is_empty():
		var near := _road_near(at)
		if near.z >= 0.0 and near.x > 0.0 and _road_curves[int(near.z)]["kind"] == "stone":
			return false
	return true


## The zone's prints: a pair of paws a marked cell, pointing the way walked,
## the right one a little ahead, each a broad pad and five toes in an arc,
## lying on the ground's slope, seeded by the cell; fading out over their
## last TRACK_FADE_MS; none indoors. Prints past their time are dropped here.
func _draw_tracks() -> void:
	_tracks_due = 0
	var now := Time.get_ticks_msec()
	var level := World.zone.name if World.zone != null else ""
	var marks: Dictionary = _tracks.get(level, {})
	for cell: Vector2i in marks.keys():
		if int(marks[cell][0]) <= now:
			marks.erase(cell)
	if marks.is_empty():
		_tracks.erase(level)
	var parts: Array[Transform3D] = []
	var shades: Array[Color] = []
	if _outdoor and _room != null:
		for cell: Vector2i in marks:
			var left: int = int(marks[cell][0]) - now
			var fade := clampf(float(left) / TRACK_FADE_MS, 0.0, 1.0)
			if left < TRACK_FADE_MS:
				var step := now + mini(TRACK_STEP_MS, left)
				_tracks_due = step if _tracks_due == 0 else mini(_tracks_due, step)
			else:
				var start := now + left - TRACK_FADE_MS
				_tracks_due = start if _tracks_due == 0 else mini(_tracks_due, start)
			var rng := RandomNumberGenerator.new()
			rng.seed = hash(cell) ^ 780
			var angle := int(marks[cell][1]) * PI / 4.0 + rng.randf_range(-0.12, 0.12)
			var ahead := Vector2(sin(angle), -cos(angle))
			var right := Vector2(-ahead.y, ahead.x)
			var yaw := Basis(Vector3.UP, -angle)
			var middle := Vector2(cell) + Vector2(rng.randf_range(-0.15, 0.15), rng.randf_range(-0.15, 0.15))
			for side: float in [-0.5, 0.5]:
				var paw := middle + right * side * TRACK_PAIR.x + ahead * (side + 0.5) * TRACK_PAIR.y
				var paw_cell := Vector2i(roundi(paw.x), roundi(paw.y))
				if not _takes_print(paw_cell, paw):
					continue
				var tint := TRACK_ON_GRASS if str(_ground_kinds.get(paw_cell, "")) == "grass" else TRACK_ALPHA
				var alpha := tint * fade * rng.randf_range(0.85, 1.0)
				# The pad, then the toes: an arc, the middle ones furthest out.
				var spots: Array[Vector4] = [Vector4(0.0, 0.0, TRACK_PAD.x, TRACK_PAD.y)]
				for toe in 5:
					var across := (toe - 2) * 0.25
					spots.append(Vector4(across * TRACK_PAD.x * 0.9, TRACK_TOES_AHEAD - absf(across) * absf(across) * 0.12, TRACK_TOE, TRACK_TOE * 1.15))
				for spot in spots:
					var at := paw + right * spot.x + ahead * spot.y
					var y := _height_in(paw_cell, at)
					var tilt := Basis(Quaternion(Vector3.UP, _ground_up(paw_cell, at)))
					var shape := Basis.from_scale(Vector3(spot.z, 1.0, spot.w))
					parts.append(Transform3D(tilt * yaw * shape, Vector3(at.x, y + 0.012, at.y)))
					shades.append(Color(TRACK_COLOR, alpha))
	if parts.is_empty():
		_track_parts = []
		_track_shades = []
		if is_instance_valid(_tracks_drawn):
			_tracks_drawn.queue_free()
		_tracks_drawn = null
		return
	if not is_instance_valid(_tracks_drawn) or _tracks_drawn.get_parent() != _room:
		_tracks_drawn = MultiMeshInstance3D.new()
		_tracks_drawn.name = "Tracks"
		_tracks_drawn.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		_tracks_drawn.material_override = _track_look()
		_room.add_child(_tracks_drawn)
	var multimesh := MultiMesh.new()
	multimesh.transform_format = MultiMesh.TRANSFORM_3D
	multimesh.use_colors = true
	multimesh.mesh = _track_part()
	multimesh.instance_count = parts.size()
	for i in parts.size():
		multimesh.set_instance_transform(i, parts[i])
		multimesh.set_instance_color(i, shades[i])
	_tracks_drawn.multimesh = multimesh
	_track_parts = parts
	_track_shades = shades


## A pad or toe: a flat round disc a metre across (scaled down per part).
static func _track_part() -> Mesh:
	if _track_mesh == null:
		var disc := CylinderMesh.new()
		disc.top_radius = 0.5
		disc.bottom_radius = 0.5
		disc.height = 0.004
		disc.radial_segments = 12
		disc.rings = 1
		disc.cap_bottom = false
		_track_mesh = disc
	return _track_mesh


## Matte, its fade each part's own.
static func _track_look() -> StandardMaterial3D:
	if _track_material == null:
		_track_material = StandardMaterial3D.new()
		_track_material.vertex_color_use_as_albedo = true
		_track_material.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
		_track_material.roughness = 1.0
		_track_material.albedo_color = Color.WHITE
	return _track_material


## A blow landed: a thud on flesh for an attack (an impact makes its own
## sound, and fire has none yet). A shot's lands when its arrow gets there
## (_arrows), not when the sim's news does (decision 390).
func _on_struck(_amount: int, cause: StringName, id: int) -> void:
	if cause == &"shot":
		var target := instance_from_id(id) as GridEntity
		var flying := _arrow_to(target.tile) if target != null else {}
		if not flying.is_empty():
			var wait: int = int(flying["arrive"]) - Time.get_ticks_msec()
			if wait > 0:
				get_tree().create_timer(wait / 1000.0).timeout.connect(_on_struck.bind(_amount, cause, id))
				return
	_combat_at[id] = Time.get_ticks_msec()
	var puppet: Node3D = _puppets.get(id)
	if puppet != null and cause != &"impact":
		# An impact is shown by _on_impacted. A blow's flinch waits for the drawn blade to land
		# ("blows you can see" (a)), as its thud does: not as the news comes, before it.
		var flinch := 0.0
		if cause == &"attack" and instance_from_id(id) is GridEntity:
			flinch = (int(_struck_with(instance_from_id(id) as GridEntity)[1]) - AnimRig.now_msec()) / 1000.0
		if flinch > 0.0:
			var ids_flinch := puppet.get_instance_id()
			get_tree().create_timer(flinch).timeout.connect(func() -> void: _flinch(instance_from_id(ids_flinch) as Node3D))
		else:
			_flinch(puppet)
	if puppet != null and cause == &"shot":
		var shot := instance_from_id(id) as GridEntity
		sfx.play("sfx.arrow_hit_flesh", puppet.position + Vector3.UP * 0.8)
		_pain(shot, puppet)
		puppet.set_meta("shot_ms", Time.get_ticks_msec())
		_knockdown_blow(puppet)
	if puppet != null and cause == &"attack" and instance_from_id(id) is Seam:
		# A blow on an ore seam (769 amended (4)): the pick on rock, when the
		# swing lands; no cry and no fight's music.
		var landed := (int(_struck_with(instance_from_id(id) as GridEntity)[1]) - AnimRig.now_msec()) / 1000.0
		var seam := instance_from_id(id) as Seam
		if landed > 0.0:
			_play_later("sfx.pick_strike", puppet.position + Vector3.UP * 0.8, landed)
			var ids_dust := [puppet.get_instance_id(), seam.get_instance_id() if seam != null else 0]
			get_tree().create_timer(landed).timeout.connect(func() -> void:
				var fired_by := instance_from_id(ids_dust[0]) as Node3D
				var fired_seam := instance_from_id(ids_dust[1]) as Seam
				if is_instance_valid(fired_by) and is_instance_valid(fired_seam):
					_seam_dust(fired_by, fired_seam))
		else:
			sfx.play("sfx.pick_strike", puppet.position + Vector3.UP * 0.8)
			_seam_dust(puppet, seam)
		return
	if puppet != null and cause == &"attack":
		var struck := instance_from_id(id) as GridEntity
		var blow := _struck_with(struck)
		if _heard_steadied(struck):
			blow[0] = SoundKit.HIT_STEADIED  # 843: a blow that doesn't rock him lands dull.
		var wait := (int(blow[1]) - AnimRig.now_msec()) / 1000.0
		if wait > 0.0:
			_play_later(str(blow[0]), puppet.position + Vector3.UP * 0.8, wait)
			var ids_hurt := [struck.get_instance_id() if struck != null else 0, puppet.get_instance_id()]
			get_tree().create_timer(wait).timeout.connect(func() -> void:
				var fired_body := instance_from_id(ids_hurt[0]) as GridEntity
				var fired_puppet := instance_from_id(ids_hurt[1]) as Node3D
				if is_instance_valid(fired_body) and is_instance_valid(fired_puppet) and is_instance_valid(sfx) and sfx.is_inside_tree():
					_pain(fired_body, fired_puppet))
		else:
			sfx.play(str(blow[0]), puppet.position + Vector3.UP * 0.8)
			_pain(struck, puppet)
		if music != null and struck != null and sfx.listener != null and _cells_apart(struck.tile, sfx.listener) <= Music.TENSION_NEAR:
			music.fight_near()


## A body struck: its hit clip, a creature's hit.
func _flinch(puppet: Node3D) -> void:
	# Not a corpse: the killing blow's flinch waits for the drawn blade, by then its death plays, and
	# a hit over it left the body standing frozen (Jeff on v0.1.208: "barrows enemies when dying no
	# longer fall to ground they just freeze in place").
	if not is_instance_valid(puppet) or not puppet.is_inside_tree() or puppet.has_meta("corpse"):
		return
	if _held_steady(puppet):
		_steady_rock(puppet)  # Steadied (843): no hit clip, rocked and held.
		return
	_play_once(puppet, _pick_clip(puppet, HIT_CLIPS))
	if puppet.has_meta("creature_view"):
		(puppet.get_meta("creature_view") as CreatureView).hit()


## Pushed [param tiles]: a model is knocked back (_animate), a backpedal or,
## for a toss, a roll, once the slide shows.
func _on_pushed(tiles: int, id: int) -> void:
	_combat_at[id] = Time.get_ticks_msec()
	var puppet: Node3D = _puppets.get(id)
	var entity := instance_from_id(id) as GridEntity
	if entity != null and tiles > 0:
		# Shoved into water: a splash as it lands there.
		get_tree().create_timer(SLIDE_SECONDS).timeout.connect(func() -> void:
			var fired_slid := instance_from_id(id) as GridEntity
			if is_instance_valid(fired_slid) and is_instance_valid(sfx) and sfx.is_inside_tree() and World.is_water(fired_slid.tile):
				sfx.play("sfx.splash", _tile_position(fired_slid.tile)))
	if puppet == null or entity == null or tiles <= 0 or not puppet.has_meta("rig"):
		return
	if puppet.has_meta("knock"):
		var knock: Dictionary = puppet.get_meta("knock")
		if not knock.get("ending", false) and absf(angle_difference(float(knock["yaw"]),
				-(-Vector2(entity.push_direction)).angle())) < 0.01 and Time.get_ticks_msec() - int(knock["since"]) < 500:
			# The same knock, already under way (a guessed shove the server
			# then did otherwise, the same way): it goes on.
			return
	# Facing whence it came, the way the sim says it was pushed, whatever the
	# slide on screen does.
	puppet.set_meta("knock", {"toss": entity.tossed, "impact": false, "since": Time.get_ticks_msec(), "started": -1,
			"yaw": -(-Vector2(entity.push_direction)).angle(), "shown": (puppet.get_node("Body") as Node3D).rotation.y})


## An impact: the sound of what it hit; into a wall or a door (or the
## ground, falling), a model doubles over: at the end of its slide if it is
## knocked back, else now.
func _on_impacted(_amount: int, against: StringName, id: int) -> void:
	_combat_at[id] = Time.get_ticks_msec()
	var puppet: Node3D = _puppets.get(id)
	if puppet == null:
		return
	if against == &"stone" or against == &"wood":
		if puppet.has_meta("knock"):
			(puppet.get_meta("knock") as Dictionary)["impact"] = true
		else:
			_play_once(puppet, CLIP_IMPACT)
	elif against == &"body":
		_play_once(puppet, _pick_clip(puppet, HIT_CLIPS))
	var at := puppet.position + Vector3.UP * 0.6
	match against:
		&"stone":
			sfx.play("sfx.knockback_stone", at)
		&"wood":
			sfx.play("sfx.knockback_wood", at)
		&"body":
			sfx.play("sfx.knockback_body", at)
			sfx.play("sfx.knockback_body_soft", at)


## The server's "death" message: the puppet falls now if its entity has
## gone, or when it goes. A broken thing just breaks.
func on_death(data: Dictionary) -> void:
	var entity_name := str(data.get("entity", ""))
	if str(data.get("kind", "")) == "object":
		var tile: Variant = data.get("tile")
		var at := Vector3(tile[0], 0.4, tile[1]) if tile is Array and tile.size() == 2 else _camera_target
		sfx.play(_break_sounds.get(entity_name, "sfx.break_wood"), at)
		_break_sounds.erase(entity_name)
		return
	if _departed.has(entity_name):
		_fall(_departed[entity_name]["puppet"], data)
		_departed.erase(entity_name)
		return
	for id: int in _puppets:
		if _puppets[id].get_meta("entity_name", "") == entity_name:
			_pending_deaths[entity_name] = data
			return


## A monster's name with how alert it is (Monster.Alert): "?" looking into
## something, "!" after someone, "~" running.
## A shot that knocks its body down (a lob's hit, decision 677) lands
## heavier: a blunt blow over the arrow's, once, while it lies, when the hit
## and the fall come within KNOCKDOWN_BLOW_MS of each other, whichever news
## comes first.
func _knockdown_blow(puppet: Node3D) -> void:
	var shot := int(puppet.get_meta("shot_ms", -1000000))
	var down := int(puppet.get_meta("down_ms", -1000000))
	if bool(puppet.get_meta("lying", false)) and absi(shot - down) <= KNOCKDOWN_BLOW_MS and int(puppet.get_meta("blow_ms", -1)) != maxi(shot, down):
		puppet.set_meta("blow_ms", maxi(shot, down))
		sfx.play("sfx.hit_blunt_flesh", puppet.position + Vector3.UP * 0.6)


## Knocked down (GridEntity.down_until; decision 343): the body tips over
## to lie on the ground, and rises again when it wears off.
func _sync_down(entity: GridEntity, puppet: Node3D) -> void:
	var body := puppet.get_node_or_null("Body") as Node3D
	if body == null:
		return
	var lying := World.tick + World.tick_alpha < entity.down_until
	if lying != bool(puppet.get_meta("lying", false)):
		puppet.set_meta("lying", lying)
		if lying:
			sfx.play("sfx.knockdown", puppet.position + Vector3.UP * 0.3)
			puppet.set_meta("down_ms", Time.get_ticks_msec())
			_knockdown_blow(puppet)
	var want := DOWN_TILT if lying else 0.0
	if not is_equal_approx(body.rotation.x, want):
		body.rotation.x = move_toward(body.rotation.x, want, get_process_delta_time() * ArtKit.feel("client3d.down_tilt_speed", DOWN_TILT_SPEED))


## Burning or bleeding (GridEntity.ailments; decision 375): its name
## tinted, orange for fire, red for blood, white again when it ends.
func _sync_ailments(entity: GridEntity, puppet: Node3D) -> void:
	var label := puppet.get_node_or_null("Name") as Label3D
	if label == null:
		return
	var tint := AIL_BURN if entity.ailments.has("burn") else AIL_BLEED if entity.ailments.has("bleed") else puppet.get_meta("name_tint", Color.WHITE) as Color
	if tint == Color.WHITE and not taker_marks.is_empty() and taker_marks.has(String(entity.get_path())):
		tint = TAKER_NAME
	if label.modulate != tint:
		label.modulate = tint


## Its name under the low camera (NAME_TILES): sized to read at its depth,
## the nearest over the farther, shown past NAME_TILES only for the party,
## a foe or the marked target. Nothing under the ortho camera.
func _sync_name(entity: GridEntity, puppet: Node3D, now: int) -> void:
	if not _low or _camera == null:
		return
	var label := puppet.get_node_or_null("Name") as Label3D
	if label == null:
		return
	var depth := maxf((label.global_position - _camera.global_position).dot(-_camera.global_transform.basis.z), 0.0)
	label.scale = Vector3.ONE * maxf(1.0, depth / maxf(_camera_distance(), 1.0))
	label.render_priority = clampi(100 - roundi(depth), -100, 100)
	label.visible = not label.text.is_empty() and name_shown(entity, puppet, now)


## Whether [param entity]'s name shows under the low camera: within
## NAME_TILES of the local player (or the camera's aim with none); past
## that only the party's, a foe's (as _fight_points counts one) or the
## marked target's.
func name_shown(entity: GridEntity, puppet: Node3D, now: int) -> bool:
	if entity is Player or entity is Companion or puppet == _outlined:
		return true
	var own := _local_player()
	var from := Vector2(_camera_target.x, _camera_target.z)
	if own != null and _puppets.has(own.get_instance_id()):
		var at: Vector3 = _puppets[own.get_instance_id()].global_position
		from = Vector2(at.x, at.z)
	if Vector2(puppet.global_position.x, puppet.global_position.z).distance_to(from) <= NAME_TILES:
		return true
	if entity is Monster:
		var alert: Monster.Alert = (entity as Monster).alert
		if alert == Monster.Alert.FIGHTING or alert == Monster.Alert.HUNTING:
			return true
		if now - _combat_at.get(entity.get_instance_id(), -100000) < COMBAT_SECONDS * 1000.0:
			return true
	return false


## A named one's own name and a boss's look on its nameplate (752, ui's
## side; enemy-ai's replicated Monster.given_name and Monster.boss, which
## may come after the puppet): the caption is its name ("Crake"), and a
## boss's is brass with a skull over it (BossBar.skull_texture, BOSS_MARK
## world units square). Redone only when either changes.
func _sync_named(monster: Monster, puppet: Node3D) -> void:
	var given := BossBar.given_name_of(monster)
	var boss := BossBar.is_boss(monster)
	var key := "%s|%s" % [given, boss]
	if str(puppet.get_meta("named", "|false")) == key:
		return
	puppet.set_meta("named", key)
	var label := puppet.get_node_or_null("Name") as Label3D
	if label == null:
		return
	var caption := given if not given.is_empty() else (monster.label if not monster.label.is_empty() else String(monster.name))
	puppet.set_meta("caption", caption)
	label.text = caption
	puppet.remove_meta("alert")  # Its alert's mark put back after the new name (_sync_alert).
	puppet.set_meta("name_tint", BOSS_NAME if boss else Color.WHITE)
	var mark := label.get_node_or_null("BossMark") as Sprite3D
	if boss and mark == null:
		mark = Sprite3D.new()
		mark.name = "BossMark"
		if _boss_mark == null:
			_boss_mark = BossBar.skull_texture(64, Color.WHITE)
		mark.texture = _boss_mark
		mark.pixel_size = BOSS_MARK / 64.0
		mark.billboard = BaseMaterial3D.BILLBOARD_ENABLED
		mark.no_depth_test = true
		mark.modulate = BOSS_NAME
		mark.render_priority = label.render_priority
		mark.position.y = BOSS_MARK * 1.3  # Clear of the caption under it (the coordinator, on the still).
		label.add_child(mark)
	elif not boss and mark != null:
		label.remove_child(mark)
		mark.queue_free()


func _sync_alert(monster: Monster, puppet: Node3D) -> void:
	var was := int(puppet.get_meta("alert", Monster.Alert.IDLE))
	if was == monster.alert:
		return
	puppet.set_meta("alert", monster.alert)
	if was == Monster.Alert.IDLE and monster.alert == Monster.Alert.SUSPICIOUS:
		# Its head comes up: a deer snorts (the stalker's cue to freeze).
		var slot := SoundKit.cry(str(puppet.get_meta("creature", "")), "suspicious")
		if slot != "":
			sfx.play(slot, puppet.position + Vector3.UP * 0.8)
	var label := puppet.get_node_or_null("Name") as Label3D
	if label == null:
		return
	var marks := {Monster.Alert.SUSPICIOUS: " ?", Monster.Alert.HUNTING: " !", Monster.Alert.FIGHTING: " !",
		Monster.Alert.FLEEING: " ~"}
	label.text = str(puppet.get_meta("caption", label.text)) + str(marks.get(monster.alert, ""))


## A corpse: it tips onto its side with a bounce, flashes, drops its
## lantern, lies a while, sinks into the floor and is gone. Nothing of it
## can be picked; its name and bar go at once.
func _fall(puppet: Node3D, data: Dictionary) -> void:
	puppet.name = "Corpse_" + str(data.get("entity", ""))
	puppet.set_meta("corpse", true)
	for part: String in ["Pick", "HpBar", "Name"]:
		var node := puppet.get_node_or_null(part)
		if node != null:
			puppet.remove_child(node)
			node.queue_free()
	var kind := str(data.get("kind", "monster"))
	var death_slot: String = DEATH_SOUNDS.get(kind, "sfx.goblin_death")
	var person := _person_body(puppet)
	if kind == "monster" and person != &"":
		death_slot = "sfx.death_player"  # A person's fall and cry, as a player's (a grave robber's).
	elif kind == "monster":
		death_slot = SoundKit.death(str(puppet.get_meta("creature", "")))
	# A player or companion who lay downed (Mortally Wounded) and bled out
	# breathes their last (628, Jeff: "the scream on bleed out is not a good
	# fit"); a sudden death keeps the blow and the cry.
	var bled: bool = kind in ["player", "companion"] and bool(puppet.get_meta("downed", false))
	if not bled:
		sfx.play(death_slot, puppet.position + Vector3.UP * 0.5)
	# Their body's voice (decision 388), kept on the puppet: the entity may be gone.
	var voice := "voice.%s_%s" % ["last_breath" if bled else "death", puppet.get_meta("body", "male" if kind == "player" else "female")] if kind in ["player", "companion"] \
			else SoundKit.voice(null, "death", person)
	if voice != "":
		sfx.play(voice, puppet.position + Vector3.UP * 1.5)
	_play_later("sfx.bodyfall", puppet.position, FALL_SECONDS * 0.75)
	var lantern := puppet.get_node_or_null("Lantern") as OmniLight3D
	if lantern != null:
		lantern.reparent(self)
		var drop := create_tween().set_parallel(true)
		drop.tween_property(lantern, "position:y", 0.2, FALL_SECONDS).set_ease(Tween.EASE_IN).set_trans(Tween.TRANS_QUAD)
		drop.tween_property(lantern, "light_energy", 0.0, LANTERN_OUT_SECONDS)
		drop.chain().tween_callback(lantern.queue_free)
	var body := puppet.get_node_or_null("Body") as MeshInstance3D
	if body != null and body.material_override is StandardMaterial3D:
		var material := body.material_override as StandardMaterial3D
		var glow := material.emission
		material.emission = FLASH
		create_tween().tween_property(material, "emission", glow, flash_seconds)
	var line := str(data.get("say", ""))
	if not line.is_empty() and bubbles != null:
		puppet.set_meta("bubble_height", 1.0)
		bubbles.show_line(puppet.get_instance_id(), line)
	# A model plays its death and lies where it fell; the rest go over onto
	# their side, a touch too far, back, and still.
	if puppet.has_meta("knock"):
		puppet.remove_meta("knock")
	var dying := (puppet.get_meta("creature_view") as CreatureView).die() if puppet.has_meta("creature_view") else 0.0
	if dying > 0.0:
		# A creature plays its death and lies where it fell, as a model does.
		var lies := create_tween()
		lies.tween_interval(CORPSE_SECONDS + dying)
		lies.tween_property(puppet, "position:y", -SINK_DEPTH, SINK_SECONDS).set_ease(Tween.EASE_IN)
		lies.tween_callback(puppet.queue_free)
		return
	var death := _pick_clip(puppet, DEATH_CLIPS)
	if _play_once(puppet, death):
		puppet.set_meta("busy_until", 1 << 62)
		var lie := create_tween()
		lie.tween_interval(CORPSE_SECONDS + (puppet.get_meta("rig") as AnimRig).length(death))
		lie.tween_property(puppet, "position:y", -SINK_DEPTH, SINK_SECONDS).set_ease(Tween.EASE_IN)
		lie.tween_callback(puppet.queue_free)
		if kind == "player" and str(data.get("entity", "")) == _local_name:
			_mourn_local()
		return
	var side := PI * 0.5
	var fall := create_tween()
	fall.set_parallel(true)
	fall.tween_property(puppet, "rotation:z", side * 1.08, FALL_SECONDS * 0.75).set_ease(Tween.EASE_IN).set_trans(Tween.TRANS_QUAD)
	fall.tween_property(puppet, "position:y", FALL_LIFT, FALL_SECONDS * 0.75)
	fall.chain().tween_property(puppet, "rotation:z", side * 0.97, FALL_SECONDS * 0.15)
	fall.chain().tween_property(puppet, "rotation:z", side, FALL_SECONDS * 0.1)
	fall.chain().tween_interval(CORPSE_SECONDS)
	fall.chain().tween_property(puppet, "position:y", FALL_LIFT - SINK_DEPTH, SINK_SECONDS).set_ease(Tween.EASE_IN)
	fall.chain().tween_callback(puppet.queue_free)
	if kind == "player" and str(data.get("entity", "")) == _local_name:
		_mourn_local()


## The local player has died: mourning (_update_mourning) and its stinger.
func _mourn_local() -> void:
	_mourning = true
	if music != null:
		music.sting("death")


## Who was heard steadied (843: cried "steady", till "steady_over", or
## STEADY_HEARD_MS if that is lost), by instance id: the msec it lapses.
const STEADY_HEARD_MS := 6000
var _steadied := {}


## Whether [param struck] was heard steadied and isn't over it (843).
func _heard_steadied(struck: GridEntity) -> bool:
	return struck != null and int(_steadied.get(struck.get_instance_id(), 0)) > AnimRig.now_msec()


## What a blow on [param struck] sounds like and when, [slot, msec]: the
## weapon of whoever swung beside it just now (_swings; a person's, whose
## hands are known), else the plain hit, on its flesh or its worn metal
## (SoundKit.hit); heard when that swing's drawn blow lands (its strike's
## contact), now if that has passed or there was no swing.
func _struck_with(struck: GridEntity) -> Array:
	if struck == null:
		return ["sfx.hit_flesh", AnimRig.now_msec()]
	var now := AnimRig.now_msec()
	var armour := SoundKit.armour_look(struck)
	var best := -1
	var best_cells := BLOW_REACH + 1
	for swinger_id: int in _swings:
		var swinger := instance_from_id(swinger_id) as GridEntity
		if swinger == null or swinger == struck or now - int(_swings[swinger_id][0]) > BLOW_AFTER_MS:
			continue
		var cells := _cells_apart(swinger.tile, struck.tile)
		if cells < best_cells:
			best = swinger_id
			best_cells = cells
	var plain := "sfx.hit_blunt_armor" if armour in SoundKit.ARMOUR_STRUCK else "sfx.hit_flesh"
	if best < 0:
		return [plain, now]
	var lands := maxi(int(_swings[best][2]), now)
	var by := instance_from_id(best) as GridEntity
	if not (by is Player or by is Companion):
		return [plain, lands]  # A monster's hands aren't sent to clients.
	return [SoundKit.hit(str(_swings[best][1]), armour), lands]


## The body whose voice a monster drawn as a person (person_words: a grave
## robber) cries with, its look's (male or female); &"" for anything else.
static func _person_body(puppet: Node3D) -> StringName:
	return StringName(puppet.get_meta("person_body")) if puppet.has_meta("person_body") else &""


## [param struck] cries out at a blow: a person's grunt now and then, a
## goblin's yelp, pitched by its kind.
func _pain(struck: GridEntity, puppet: Node3D) -> void:
	var voice := SoundKit.voice(struck, "effort_hurt", _person_body(puppet))
	if voice != "":
		sfx.play(voice, puppet.position + Vector3.UP * 1.5)
		return
	var creature := str(puppet.get_meta("creature", ""))
	if struck is Animal and struck.hp > 0:
		# Game cries out struck (764): a doe's bleat, a stag's bellow, a rabbit's
		# squeal; its herd is alarmed in the sim. A kill sounds its death instead.
		var cry := SoundKit.struck(creature)
		if cry != "":
			sfx.play(cry, puppet.position + Vector3.UP * 0.8)
		return
	if struck is Monster and not struck is Animal and creature in SoundKit.GOBLINS and randi() % PAIN_EVERY == 0:
		sfx.play("sfx.goblin_pain", puppet.position + Vector3.UP * 0.8, float(SoundKit.CREATURE_PITCH.get(creature, 1.0)))


## A goblin standing idle mutters now and then (heard by players only:
## its slot carries no noise).
func _sync_chatter(monster: Monster, puppet: Node3D) -> void:
	if monster is Animal or monster.alert != Monster.Alert.IDLE or str(puppet.get_meta("creature", "")) not in SoundKit.GOBLINS:
		return
	var now := Time.get_ticks_msec()
	if not puppet.has_meta("chatter_at"):
		puppet.set_meta("chatter_at", now + int(randf_range(CHATTER_SECONDS.x, CHATTER_SECONDS.y) * 1000.0))
	elif now >= int(puppet.get_meta("chatter_at")):
		puppet.set_meta("chatter_at", now + int(randf_range(CHATTER_SECONDS.x, CHATTER_SECONDS.y) * 1000.0))
		sfx.play("sfx.goblin_chatter", puppet.position + Vector3.UP * 0.8,
				float(SoundKit.CREATURE_PITCH.get(str(puppet.get_meta("creature", "")), 1.0)))


## [param slot] at [param at] after [param seconds] (a body landing as its
## fall ends).
func _play_later(slot: String, at: Vector3, seconds: float) -> void:
	get_tree().create_timer(seconds).timeout.connect(func() -> void:
		if is_instance_valid(sfx) and sfx.is_inside_tree():
			sfx.play(slot, at))


## A person's bow drawn (raised "draw", replicated for players): the
## creak once as the stance begins, then the bow's creak held while it stays
## drawn, its pitch and level rising with World.draw_of (decision 475).
func _sync_draw(entity: GridEntity, puppet: Node3D) -> void:
	var drawing := entity.raised == "draw"
	var at := puppet.position + Vector3.UP * 1.2
	if drawing != bool(puppet.get_meta("drawing", false)):
		puppet.set_meta("drawing", drawing)
		if drawing:
			sfx.play("sfx.bow_draw", at)
	var creak := puppet.get_meta("creak") as AudioStreamPlayer3D if puppet.has_meta("creak") else null
	if not drawing:
		_stop_creak(puppet)
		return
	if creak == null or not is_instance_valid(creak):
		creak = sfx.hold("sfx.bow_creak", at)
		if creak == null:
			return
		puppet.set_meta("creak", creak)
	var tune := creak_tune(World.draw_of(entity))
	sfx.steer(creak, at, tune.x, tune.y)


## The held creak's pitch (x) and level over its slot's in dB (y) at
## [param draw] (0..1): low and faint as the string comes back, high and
## full at the jaw.
static func creak_tune(draw: float) -> Vector2:
	return Vector2(lerpf(CREAK_PITCH.x, CREAK_PITCH.y, draw), lerpf(CREAK_DB.x, CREAK_DB.y, draw))


## The bow's held creak stopped: loosed, or the draw let down.
func _stop_creak(puppet: Node3D) -> void:
	if not puppet.has_meta("creak"):
		return
	var creak := puppet.get_meta("creak") as AudioStreamPlayer3D
	if creak != null and is_instance_valid(creak):
		creak.queue_free()
	puppet.remove_meta("creak")


## The arrow in flight to [param cell] not yet heard, marked heard now; {}
## for none.
func _arrow_to(cell: Vector2i) -> Dictionary:
	for arrow: Dictionary in _arrows:
		if arrow["end"] == cell and not arrow["heard"]:
			arrow["heard"] = true
			return arrow
	return {}


## What an arrow's end sounds like by what stopped it (the sim's struck,
## decision 583): wood, stone, or, its range spent, the ground or water at
## [param cell]; a body's hit is _on_struck's.
static func _shot_sound(struck: StringName, cell: Vector2i, from := Vector2i(2147483647, 0), trees: Dictionary = {}) -> String:
	match struck:
		&"wood":
			return "sfx.arrow_hit_wood"
		&"stone":
			# A forest's edge is stone to the sim but a tree to the ear (609): _arrow_landed's look past it.
			if from.x != 2147483647 and _arrow_landed(from, cell, trees) == "sfx.arrow_hit_wood":
				return "sfx.arrow_hit_wood"
			return "sfx.arrow_hit_stone"
	return "sfx.arrow_water" if World.is_water(cell) else "sfx.arrow_land"


## What an arrow from [param from] that stopped at [param end] without
## striking anyone sounds like, by what lies past it along the shot
## (World.shot_line's stops): a closed door's or a tree's wood (a cell of
## [param trees], the forest's, by the cell past it), a wall's or higher
## ground's stone, water's plip, else the arrow coming down in the ground at
## its range's end.
static func _arrow_landed(from: Vector2i, end: Vector2i, trees: Dictionary = {}) -> String:
	if World.is_water(end):
		return "sfx.arrow_water"
	var d := end - from
	var longest := maxi(absi(d.x), absi(d.y))
	if longest == 0:
		d = Vector2i(1, 0)
		longest = 1
	var step := Vector2i(roundi(float(d.x) / longest), roundi(float(d.y) / longest))
	var edges: Array[Vector2i] = [step]
	if step.x != 0 and step.y != 0:
		edges = [Vector2i(step.x, 0), Vector2i(0, step.y)]
	var wall := false
	for edge: Vector2i in edges:
		match World.edge_kind(end, edge):
			Terrain.Edge.DOOR:
				var door := World.door_across(end, edge)
				if door != null and not door.is_open():
					return "sfx.arrow_hit_wood"
			Terrain.Edge.WALL:
				wall = true
	var past := end + step
	if not wall and not World.is_walkable(past) and not World.is_water(past):
		for x in range(-1, 2):
			for y in range(-1, 2):
				if trees.has(past + Vector2i(x, y)):
					return "sfx.arrow_hit_wood"
	if wall or World.height_at(past) > World.height_at(from) or not (World.is_walkable(past) or World.is_water(past)):
		return "sfx.arrow_hit_stone"
	return "sfx.arrow_land"


## Cells between [param a] and [param b], Chebyshev (as hearing counts).
static func _cells_apart(a: Vector2i, b: Variant) -> int:
	var to: Vector2i = b
	return maxi(absi(a.x - to.x), absi(a.y - to.y))


## The local player dead: pull back and drain the colour, slowly; back as
## soon as they are.
func _update_mourning(delta: float) -> void:
	if _mourning and _local_player() != null and _puppets.has(_local_player().get_instance_id()):
		_mourning = false
	var target := 1.0 if _mourning else 0.0
	var seconds := mourn_seconds if _mourning else mourn_return_seconds
	var before := _mourn
	_mourn = move_toward(_mourn, target, delta / seconds)
	var downed := _local_player() != null and World.is_downed(_local_player())
	var down_before := _down
	_down = move_toward(_down, 1.0 if downed else 0.0, delta / (mourn_seconds if downed else mourn_return_seconds))
	if is_equal_approx(before, _mourn) and _mourn == 0.0 and is_equal_approx(down_before, _down) and _down == 0.0:
		return
	_environment.adjustment_saturation = lerpf(1.0, MOURN_SATURATION, smoothstep(0.0, 1.0, maxf(_mourn, _down)))
	_apply_size()


## The art slot [param entity] is drawn as (its spawn spec's "art": a crate,
## a chest, a boulder, a cart), once that slot has art of its own; "" while
## it has none, and the entity is its shape, tinted, as before (decision 264).
static func art_slot_for(entity: GridEntity) -> String:
	var slot := str(entity.spawn_spec.get("art", ""))
	if slot == "" or not ArtKit.has(slot) or ArtKit.filled_by(slot) != "own":
		return ""
	return slot


## The creature slot [param entity] is drawn from (decision 359): its kind's
## "art" (Monster.art_of: creature.boar for a boar, the wilds' animals of
## decision 319) once that slot has art of its own, played by a
## CreatureView; "" while it has none, and it is its shape, as before.
static func creature_slot_for(entity: GridEntity) -> String:
	if not entity is Monster:
		return ""
	var slot := Monster.art_of(str(entity.spawn_spec.get("kind", "")))
	if slot == "" or not ArtKit.has(slot) or str(ArtKit.spec(slot).get("kind", "")) != "creature" or ArtKit.filled_by(slot) != "own":
		return ""
	return slot


## The model for [param entity]: HUMAN or HUMAN_F by its look's body for a
## person (a player, a companion, a resident, or a monster whose kind is drawn
## as one: person_words), MODELS' entry for a monster of a kind that has one,
## or {}.
static func model_for(entity: GridEntity) -> Dictionary:
	var kind := str(entity.spawn_spec.get("kind", ""))
	if entity is Resident and MODELS.has(kind):
		# A goblin among the townsfolk (decision 471, Snagfin): its kind's body, at home in
		# town, hooded as every goblin is for now (494 amended (3)).
		var model: Dictionary = MODELS[kind].duplicate()
		model["at_home"] = true
		return model
	if entity is Player or entity is Companion or entity is Resident or not person_words(entity).is_empty():
		return HUMAN_F if look_for(entity).body == &"female" else HUMAN
	if not entity is Monster:
		return {}
	return MODELS.get(str(entity.spawn_spec.get("kind", "")), {})


## The model as the puppet's Body: the scene turned to face +X (as the
## nose does, so Body turns with the facing; MODELS' "faces"), with an AnimationPlayer on
## its root playing its clips through an AnimRig of its own (decision 390),
## kept as the puppet's "rig"; its fight's clips (a model's "moves") as its
## "moves".
static func _make_model(model: Dictionary, puppet: Node3D) -> Node3D:
	var body := Node3D.new()
	body.name = "Body"
	var scene := (load(model["scene"]) as PackedScene).instantiate() as Node3D
	scene.name = "Model"
	scene.rotation.y = float(model.get("faces", 0.0))
	body.add_child(scene)
	scene.scale = Vector3.ONE * float(puppet.get_meta("model_scale", 1.0))
	# A body's fixed parts (belt, boots) on art-kit's palette, as its pieces are.
	for mesh: MeshInstance3D in scene.find_children("*", "MeshInstance3D", true, false):
		for surface in mesh.mesh.get_surface_count():
			var own := mesh.mesh.surface_get_material(surface)
			if own != null and own.resource_name == ArtKit.PALETTE_NAME:
				mesh.set_surface_override_material(surface, load(ArtKit.PALETTE))
			elif own != null and own.resource_name == GHOST_MATERIAL:
				mesh.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	if model.get("parts", false):
		# A person's tunic in their colour; an ally's in its look's, and a monster drawn as a person's
		# (793, pc-character's side: its sprite's tint is its mass's shade, not its clothes, and drew
		# every robber and bandit in the same red).
		var tunic: Color = Color.WHITE if model.has("people") or puppet.get_meta("look_dresses", false) else puppet.get_meta("tint", Color.WHITE)
		_dress(scene, tunic)
		if puppet.has_meta("look"):
			(puppet.get_meta("look") as PersonLook).apply(scene, tunic)
	if model.has("paint"):
		# Its own paint (decision 529): its people's material, its variation as the goblin's is.
		var look := painted_look(str(puppet.get_meta("entity_name", "")))
		puppet.set_meta("painted_look", look)
		scene.scale = Vector3(scene.scale.x * float(look["width"]), scene.scale.y, scene.scale.z * float(look["width"]))
		# (Its own material where this build lacks the paint: no error, as warm_painted.)
		var paint := load(str(model["paint"])) as Material if ResourceLoader.exists(str(model["paint"])) else null
		for mesh: MeshInstance3D in scene.find_children("*", "MeshInstance3D", true, false):
			_paint_skin(mesh, paint)
			mesh.set_instance_shader_parameter("skin", look["skin"])
			mesh.set_instance_shader_parameter("gear", Color(1.0, 1.0, 1.0, 0.0))
			mesh.set_instance_shader_parameter("mark", look["mark"])
	if model.get("goblin", false):
		# Its own goblin (decision 494): the shared material, its variation as instance parameters.
		var look := goblin_look(str(puppet.get_meta("entity_name", "")))
		puppet.set_meta("goblin_look", look)
		scene.scale = Vector3(scene.scale.x * float(look["width"]), scene.scale.y, scene.scale.z * float(look["width"]))
		for mesh: MeshInstance3D in scene.find_children("*", "MeshInstance3D", true, false):
			mesh.material_override = GOBLIN_MATERIAL
			mesh.set_instance_shader_parameter("skin", look["skin"])
			mesh.set_instance_shader_parameter("gear", look["gear"])
			mesh.set_instance_shader_parameter("mark", look["mark"])
			if mesh.name == "Hood":
				mesh.visible = look["hood"]
			var ears := float(look["ears"])
			for key: String in ["Ears_Big", "Ears_Small"]:
				var index := mesh.find_blend_shape_by_name(key)
				if index >= 0:
					mesh.set_blend_shape_value(index, maxf(ears, 0.0) if key == "Ears_Big" else maxf(-ears, 0.0))
	if model.has("tint"):
		_tint(scene, str(model["tint"]), puppet.get_meta("tint", Color.WHITE))
	puppet.set_meta("gaits", model.get("gaits", GAITS))
	puppet.set_meta("backpedal", float(model.get("backpedal", ArtKit.feel("client3d.backpedal_clip_speed", BACKPEDAL_CLIP_SPEED))))
	puppet.set_meta("fidgets", model.get("fidgets", FIDGETS))
	puppet.set_meta("moves", model.get("moves", {}))
	if model.has("idle"):
		puppet.set_meta("idle", str(model["idle"]))
	var rig := AnimRig.make(scene, load(model["clips"]) as AnimationLibrary, ArtKit.feel("client3d.clip_blend", CLIP_BLEND), true,
			puppet.get_meta("rng") if puppet.has_meta("rng") else null)
	rig.loop(_idle_clip(puppet))
	if model.has("sockets"):
		_attach_sockets(scene, model["sockets"], float(puppet.get_meta("model_scale", 1.0)), puppet)
		_wear_hat(scene, puppet)
	if puppet.has_meta("look") and not model.has("paint"):
		# (A painted ally's mesh stands in its concept's stance already: no second hunch.)
		var posture := str(POSTURES.get((puppet.get_meta("look") as PersonLook).posture, ""))
		if posture != "" and rig.has(posture):
			var pose := (load(model["clips"]) as AnimationLibrary).get_animation(posture)
			rig.posture(pose, 1.0)
			puppet.set_meta("posture", pose)  # Faded off lying (_posture_lying).
	puppet.set_meta("rig", rig)
	return body


## [param scene]'s attach points (decision 451): a BoneAttachment3D on its
## skeleton for each socket's bone, the socket a node under it at its place
## in the bone's frame, scaled back by [param model_scale] so what it holds
## keeps its own size; kept as the puppet's "sockets" {name: Node3D}.
static func _attach_sockets(scene: Node3D, sizes: Dictionary, model_scale: float, puppet: Node3D) -> void:
	var skeletons := scene.find_children("*", "Skeleton3D", true, false)
	if skeletons.is_empty():
		return
	var skeleton := skeletons[0] as Skeleton3D
	var made := {}
	var table := _sockets(sizes["hand"], sizes["hip"], sizes["back"], sizes["chest"])
	var shoulder := _shoulder_socket(skeleton, sizes["hand"])
	if not shoulder.is_empty():
		table["shoulder"] = shoulder
	var crown := _head_socket(skeleton) if sizes.get("crown", false) else []
	if not crown.is_empty():
		table["head"] = crown
		for worn: String in WORN_SOCKETS:
			var at := _front_socket(skeleton, worn)
			if not at.is_empty():
				table[worn] = at
	for name: String in table:
		var bone: String = table[name][0]
		if skeleton.find_bone(bone) < 0:
			continue
		var on := BoneAttachment3D.new()
		on.name = "On" + bone
		on.bone_name = bone
		skeleton.add_child(on)
		var socket := Node3D.new()
		socket.name = name
		socket.transform = table[name][1]
		if name == "arm_l" and skeleton.find_bone("LeftHand") >= 0:
			socket.position = skeleton.get_bone_rest(skeleton.find_bone("LeftHand")).origin * 0.5
		socket.scale = Vector3.ONE / maxf(model_scale, 0.01)
		on.add_child(socket)
		made[name] = socket
	puppet.set_meta("sockets", made)
	puppet.set_meta("held", ["", ""])
	if made.has("hand_r") and made.has("hand_l") and skeleton.find_bone("LeftUpperArm") >= 0 and skeleton.find_bone("LeftLowerArm") >= 0:
		# The left hand on a two-handed piece's second grip (451 amended (2), step 4), off till one is held.
		puppet.set_meta("reach", HandReach.make(skeleton, (made["hand_r"] as Node3D).transform, (made["hand_l"] as Node3D).transform))


## What [param entity] holds in each hand drawn at its puppet's hand sockets
## (decision 451): each thing from its art slot (ArtKit: its own art, a
## fill, or a grey box sized as the slot is until it has art), swapped when
## the slot changes, gone when the hand empties. An archer's arrows aren't in
## its hand but in a quiver on its back (decision 462 amended (3)).
## A held weapon (art_style: its length +y, its edge, head or point's
## striking side +x, thin in z) is turned a quarter about its grip
## (HELD_EDGE_TURN): the hand socket puts a piece's +x out of the palm, so
## each edge faced across the body and the flat into the swing (Jeff: "great
## axe ... held sideways by player and draugr"); turned, +x lies along the
## fingers toward the knuckles, the way the hand swings. A shield keeps its
## own turn, the bow none; a work's tool is turned by its clip (GRASP).
const HELD_EDGE_TURN := Basis(Vector3.UP, -PI * 0.5)
## Where a shield's strap is in its own frame (art-kit's "strap" socket:
## the forearm's axis at its middle, behind the back face), SHIELD_STRAP when
## its slot names none.
const SHIELD_STRAP := Vector3(0.0, -0.06, -0.075)
static func _strap_of(art: String) -> Vector3:
	var at: Variant = ArtKit.spec(art).get("sockets", {}).get("strap")
	return Vector3(at[0], at[1], at[2]) if at is Array and at.size() == 3 else SHIELD_STRAP
static func _edge_first(id: String) -> bool:
	var tags: Array = Items.def(id).get("tags", [])
	return "weapon" in tags and not "ranged" in tags and not "shield" in tags
func _sync_held(entity: GridEntity, puppet: Node3D) -> void:
	if not puppet.has_meta("sockets"):
		return
	var held: Array = puppet.get_meta("held")
	var sockets: Dictionary = puppet.get_meta("sockets")
	var ids := held_ids(entity)
	var work := work_of(entity)
	if work.has("right") and ids[0] == "":
		ids[0] = ART_ID + str(work["right"])
	if work.has("left") and ids[1] == "":
		ids[1] = ART_ID + str(work["left"])
	_sync_load(puppet, sockets, str(work.get("shoulder", "")))
	var quiver := ""
	if World.drawn_with(entity) != "" and ARROW_VARIANTS.has(ids[0]):
		quiver = ids[0]
		ids[0] = ""
	if quiver != str(puppet.get_meta("quiver", "")):
		puppet.set_meta("quiver", quiver)
		var old := _quiver_of(sockets)
		if old != null:
			old.get_parent().remove_child(old)
			old.queue_free()
		if quiver != "" and ArtKit.has(QUIVER):
			var piece := ArtKit.instance(QUIVER, int(ARROW_VARIANTS[quiver]))
			piece.name = "Quiver"
			_wear_quiver(sockets, piece)
	var changed := false
	for hand in 2:
		var id: String = ids[hand]
		if id == held[hand]:
			continue
		held[hand] = id
		changed = true
		if hand == 1:
			_let_go_stowed(sockets)
		_hold(sockets, hand, id, work)
	if changed:
		puppet.set_meta("roused_at", Time.get_ticks_msec())  # Taken up: at rest only REST_SECONDS on (662).
	if changed and puppet.has_meta("reach"):
		_sync_reach(puppet.get_meta("reach") as HandReach, sockets, ids)


## [param id] (an item, or ART_ID and a work's own tool) put in [param hand]
## (0 the right, 1 the left) at [param sockets], what was there let go
## (_sync_held's, and the Character Lab's, decision 674).
static func _hold(sockets: Dictionary, hand: int, id: String, work := {}) -> void:
	var socket := sockets.get("hand_r" if hand == 0 else "hand_l") as Node3D
	if socket == null:
		return
	var places: Array = [socket] if hand == 0 or not sockets.has("arm_l") else [socket, sockets["arm_l"]]
	for place: Node3D in places:
		for old in place.get_children():
			# Out of the way now, so the new thing is the one named "Held".
			place.remove_child(old)
			old.queue_free()
	if hand == 0:
		_wear_sheath(sockets, id)
	if id == "":
		return
	var own := id.begins_with(ART_ID)
	var art := id.substr(ART_ID.length()) if own else str(Items.def(id).get("art", "item." + id))
	if ArtKit.has(art):
		var thing := ArtKit.instance(art)
		thing.name = "Held"
		if not own and "shield" in Items.def(id).get("tags", []) and sockets.has("arm_l"):
			# Strapped on the outside of the forearm (451 amended (2); Jeff: "shield
			# should be carried on the outside of arm, not inside"): the arm_l
			# socket's frame is the shield's, so its strap point goes on the
			# forearm's middle.
			socket = sockets["arm_l"]
			thing.position = -_strap_of(art)
			thing.set_meta("strap", _strap_of(art))  # Back on the arm from the back (_sheathe).
		elif not own and "shield" in Items.def(id).get("tags", []):
			# A body with no forearm socket: out of the back of the hand, a quarter
			# turn about its grip's axis (its face +z, art_style).
			thing.basis = Basis(Vector3.UP, PI * 0.5)
		elif not own and _edge_first(id):
			thing.basis = HELD_EDGE_TURN
		if not own:
			_grip_at(thing, art)
		if own and hand == 0:
			_grip(thing, work)
		socket.add_child(thing)


## A held piece in the hand at its own grip (its slot's "grip" socket: up its
## length from its origin, art_style), not at its origin: the Tomb Sledge's
## rear hand off the butt (Jeff: "it shouldn't be held at the very end of the
## shaft thats not how hammers work"). Kept on it ("grip") for _slide_held
## and _sync_reach.
static func _grip_at(thing: Node3D, art: String) -> void:
	var at: Variant = ArtKit.spec(art).get("sockets", {}).get("grip")
	var grip := Vector3(at[0], at[1], at[2]) if at is Array and (at as Array).size() == 3 else Vector3.ZERO
	if grip != Vector3.ZERO:
		thing.set_meta("grip", grip)
		thing.position -= thing.basis * grip


## The left hand brought to the right hand's piece's second grip (HandReach;
## 451 amended (2), step 4) while the left hand is empty, the piece takes two
## hands and its art has one ("grip_2", art-kit's sockets: the giant axe's and
## the battle axe's, 0.45 m up) within REACH_SPAN of its grip: the two-handed
## clips (Axe_Ready, Axe_Overhead) hold the hands humanoid_clips' GREAT_GRIP
## (0.45 m) apart, and farther the left arm can't reach it from them (0.3 m
## short at 0.87), so a wider grip keeps the clip's left hand.
## A work's own tool keeps its clip's hands (humanoid_clips authors both).
const REACH_SPAN := 0.6
static func _sync_reach(reach: HandReach, sockets: Dictionary, ids: Array) -> void:
	var held := (sockets["hand_r"] as Node3D).get_node_or_null("Held") as Node3D
	var id := str(ids[0])
	var second: Variant = null
	if held != null and str(ids[1]) == "" and id != "" and not id.begins_with(ART_ID) and int(Items.def(id).get("hands", 1)) == 2:
		second = ArtKit.spec(str(Items.def(id).get("art", "item." + id))).get("sockets", {}).get("grip_2")
	var grip: Vector3 = held.get_meta("grip", Vector3.ZERO) if held != null else Vector3.ZERO
	if second is Array and (second as Array).size() == 3 and (Vector3(second[0], second[1], second[2]) - grip).length() <= REACH_SPAN:
		reach.reach(true, held.transform, Vector3(second[0], second[1], second[2]))
		reach.set_meta("second", reach.grip)
	else:
		reach.reach(false)


## A two-handed blow whose lead hand slides down the haft toward the rear one
## as it falls, and back up after: HandReach's second grip moved down the
## piece by [[seconds into the clip, metres], ...] (linear between) while the
## strike plays. The Tomb Sledge's (Jeff: "move like it has mass"), as
## Sledge_Attack authors its left hand (humanoid_clips' SLEDGE_*: GREAT_GRIP
## up from the right, down to 0.12 at the contact). The heavy axes' sweep likewise (humanoid_clips'
## SWEEP_*: down to 0.2 for the coil, 0.1 to 0.12 across the front, back up for the guard).
const REACH_SLIDES := {"Axe_Sweep": [[0.0, 0.0], [0.4, 0.25], [0.55, 0.25], [0.68, 0.35], [0.8, 0.33], [1.05, 0.3], [1.2, 0.2], [1.3, 0.0]],
	"Sledge_Attack": [[0.0, 0.0], [0.2, 0.05], [0.45, 0.07], [0.6, 0.07], [0.75, 0.13], [0.84, 0.25],
	[0.9, 0.33], [1.3, 0.33], [1.5, 0.2], [1.7, 0.0]]}
static func _slide_reach(puppet: Node3D) -> void:
	if not puppet.has_meta("reach") or not puppet.has_meta("rig"):
		return
	var reach := puppet.get_meta("reach") as HandReach
	if not reach.active or not reach.has_meta("second"):
		return
	var rig := puppet.get_meta("rig") as AnimRig
	var slide: Array = REACH_SLIDES.get(rig.playing(), []) if rig.striking() else []
	var at: Vector3 = reach.get_meta("second")
	if not slide.is_empty():
		at += Vector3.DOWN * _keyed(slide, rig.position())
	if not at.is_equal_approx(reach.grip):
		reach.grip = at


## [param keys] ([[x, y], ...], x rising) at [param x], linear between, held past either end.
static func _keyed(keys: Array, x: float) -> float:
	if x <= float(keys[0][0]):
		return float(keys[0][1])
	for i in range(1, keys.size()):
		if x <= float(keys[i][0]):
			var a: Array = keys[i - 1]
			var b: Array = keys[i]
			return lerpf(float(a[1]), float(b[1]), (x - float(a[0])) / maxf(float(b[0]) - float(a[0]), 0.0001))
	return float(keys[-1][1])


## The armour [param entity] wears (items' 622; a player's and a
## companion's worn item, a resident's look's worn= word) drawn on its
## body (PersonLook.wear), when it changes.
func _sync_worn(entity: GridEntity, puppet: Node3D) -> void:
	if not puppet.has_meta("look"):
		return
	var look := puppet.get_meta("look") as PersonLook
	var id := str(entity.get("worn")) if "worn" in entity else ""
	var key := id if not id.is_empty() else look.worn
	var model := puppet.get_node_or_null("Body/Model") as Node3D
	if model == null or key == str(model.get_meta("worn", "")):
		return
	model.set_meta("worn", key)  # On the model: a body made again wears it again.
	look.wear(model, id)


## A carried lantern as it hangs at the belt: a small dark frame round a
## warm glow, below the socket.
static var _lantern_parts: Array = []
static func _hanging_lantern() -> Node3D:
	if _lantern_parts.is_empty():
		var frame := BoxMesh.new()
		frame.size = Vector3(0.09, 0.13, 0.09)
		var iron := StandardMaterial3D.new()
		iron.albedo_color = Color(0.16, 0.14, 0.12)
		iron.roughness = 0.8
		var glow := BoxMesh.new()
		glow.size = Vector3(0.1, 0.08, 0.1)
		var flame := StandardMaterial3D.new()
		flame.albedo_color = PLAYER_LIGHT
		flame.emission_enabled = true
		flame.emission = PLAYER_LIGHT
		flame.emission_energy_multiplier = 1.5
		_lantern_parts = [frame, iron, glow, flame]
	var lantern := Node3D.new()
	lantern.name = "LanternBody"
	for i in 2:
		var piece := MeshInstance3D.new()
		piece.mesh = _lantern_parts[i * 2]
		piece.material_override = _lantern_parts[i * 2 + 1]
		piece.position = Vector3(0.0, 0.1, 0.0)
		piece.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF if i == 1 else GeometryInstance3D.SHADOW_CASTING_SETTING_ON
		lantern.add_child(piece)
	return lantern


## The arrows' kinds as their nocked arrow's and their quiver's variants
## (fx.arrow, gear.quiver); an archer's quiver on its back socket (462 amended (3)).
const ARROW_VARIANTS := {"arrows": 1, "arrows_flame": 2, "arrows_barbed": 3}
const QUIVER := "gear.quiver"


## What [param entity] holds as drawn [right hand, left hand]: its hand
## slots, but a bow (World.drawn_slot) always in the left and the other
## hand's thing (its arrows) in the right, as a right-handed archer holds
## them (decision 462).
## A guard's arms as a client sees them (791, npc's: Resident replicates
## hands, [right, left], not its slots): copied into its slots, so whatever
## reads what a body holds (held_ids, World.wielded's swing and strike, the
## ready stance, its rests) sees the spear a guard holds; its worn (the mail)
## and down_until (its lie, downed or knocked down) are read as a player's.
## A mirror only (never the authority: there the slots are World's and
## hands follows them).
static func _mirror_hands(resident: Resident) -> void:
	if resident.hands.is_empty():
		return
	var slots := resident.slots
	if slots.size() < Items.HANDED:
		slots.resize(Items.HANDED)
	var changed := false
	for i in 2:  # hands is [right, left]; the slots number them Items.RIGHT_HAND, LEFT_HAND.
		var slot: int = [Items.RIGHT_HAND, Items.LEFT_HAND][i]
		var id := resident.hands[i] if resident.hands.size() > i else ""
		if slots[slot] != id:
			slots[slot] = id
			changed = true
	if changed:
		resident.slots = slots


static func held_ids(entity: GridEntity) -> Array:
	var right := entity.slots[Items.RIGHT_HAND] if entity.slots.size() > Items.RIGHT_HAND else ""
	var left := entity.slots[Items.LEFT_HAND] if entity.slots.size() > Items.LEFT_HAND else ""
	if World.drawn_slot(entity) == Items.RIGHT_HAND:
		return [left, right]
	return [right, left]


## How far into Bow_Draw [param entity]'s pose is (0 to 1), scrubbed by the
## sim's draw (decision 462): before the draw counts (draw_of 0, until its
## draw_min) the nock, the clip's first BOW_NOCK_END, by the ticks toward
## draw_min; then the pull, the rest of the clip, by World.draw_of from
## where it starts (draw_min over draw_full) to 1. Carried on between ticks
## by World.tick_alpha, so it moves every frame, not ten times a second.
const BOW_NOCK_END := 0.3
static func bow_pull(entity: GridEntity) -> float:
	var verb := Items.verb_of(World.drawn_with(entity))
	if verb.is_empty() or entity.raised != "draw":
		return 0.0
	var quick := World.draw_quick(entity)  # A quick bow's, and the armour's (decision 622, step 2).
	var least := roundi(int(verb.get("draw_min", 0)) * quick)
	var full := World.draw_full_ticks(entity)
	var drawn := World.tick - entity.raised_tick
	var progress := World.draw_of(entity)
	if progress <= 0.0:
		return BOW_NOCK_END * clampf((drawn + World.tick_alpha) / maxf(1.0, least), 0.0, 1.0)
	progress = minf(1.0, progress * (drawn + World.tick_alpha) / maxf(1.0, drawn))
	var start := least / full
	return BOW_NOCK_END + (1.0 - BOW_NOCK_END) * clampf((progress - start) / maxf(0.001, 1.0 - start), 0.0, 1.0)


## A bow's look on its puppet (decision 462), from what the sim replicates
## (items' signals): a bow in hand and nothing raised, Bow_Idle on the upper
## layer; raised "draw", Bow_Draw held at bow_pull (the arm drawing back as
## World.draw_of grows), then Bow_Hold once it reaches 1; the
## shot (_on_shot), Bow_Loose; a draw let go with no shot, back to Bow_Idle. A
## raised shield ("block") holds the guard (Block_Idle) on the upper layer.
## Walking or running with the bow down ("carry", 462 amended (3)) the upper
## layer lets go: both arms swing with the gait, the bow in the left hand.
## Standing with a two-handed piece the left hand is on (HandReach, 451
## amended (2), step 4), its ready stance ("ready", Axe_Ready) on the upper
## layer, both hands before the body on the haft (standing idle only).
## While drawn the drawing hand shows one arrow (fx.arrow, its kind's
## variant) on the bow's string, the string pulled back to that hand.
func _sync_bow(entity: GridEntity, puppet: Node3D) -> void:
	if not puppet.has_meta("rig") or not puppet.has_meta("sockets"):
		return
	var rig := puppet.get_meta("rig") as AnimRig
	var moves: Dictionary = puppet.get_meta("moves", {})
	if moves.is_empty():
		return
	var ids := held_ids(entity)
	var bow := World.drawn_with(entity)
	var state := str(puppet.get_meta("bow_state", ""))
	var now := Time.get_ticks_msec()
	var want := ""
	var calm := _calm(entity, puppet, rig, now)  # Kept by every frame, a draw's too.
	if entity.raised == "block":
		want = "block"
	elif bow != "" and entity.raised == "draw":
		want = "hold" if World.draw_of(entity) >= 1.0 else "draw"
	elif bow != "":
		want = "loose" if state == "loose" and now < int(puppet.get_meta("bow_until", 0)) else "idle"
		if want == "idle" and (puppet.get_meta("gaits", GAITS) as Array).any(
				func(gait: Array) -> bool: return gait[0] == rig.base_clip()):
			want = "carry"
	if want in ["idle", "carry"] and calm:
		want = "stowed"  # On the back (662 amended (d)), the hands free.
	var rest := _rest_of(entity, puppet, ids, rig, now) if want == "" else {}
	if want == "" and rest.is_empty() and calm and sheathes(ids):
		want = "sheathed"  # The blade at the hip, the shield on the back (662 (c)).
	var sockets: Dictionary = puppet.get_meta("sockets")
	var away := _put_away(sockets)
	want = _sheathing(entity, puppet, rig, sockets, ids, want, state, now)
	if not rest.is_empty():
		want = "rest"
		_slide_held(sockets, float(rest.get("grip", 0.0)), true)
		if puppet.has_meta("reach") and (puppet.get_meta("reach") as HandReach).active:
			(puppet.get_meta("reach") as HandReach).reach(false)
	elif state == "rest":
		# Roused: the piece back as it is held, the left hand to its grip_2.
		_slide_held(sockets, 0.0)
		if puppet.has_meta("reach"):
			_sync_reach(puppet.get_meta("reach") as HandReach, sockets, ids)
	if want == "" and puppet.has_meta("reach") and (puppet.get_meta("reach") as HandReach).active and rig.base_clip() == CLIP_IDLE:
		want = "ready"  # Standing only: not over a gait, a lying body or a kneel.
	if (want == "rest") != (state == "rest"):
		_rest_sound(puppet, str(ids[0]), want != "rest")
	if (want == "stowed") != (state == "stowed"):
		_rest_sound(puppet, bow if bow != "" else str(ids[1]), want != "stowed")
	if want == "draw":
		var clip := str(moves.get("bow_draw", ""))
		rig.upper_at(clip, bow_pull(entity) * rig.length(clip))
	elif want != state:
		match want:
			"hold":
				rig.upper(str(moves.get("bow_aim", "")))
			"idle":
				rig.upper(str(moves.get("bow_idle", "")))
			"block":
				rig.upper(str(moves.get("block", "")))
			"ready":
				rig.upper(str(moves.get("ready", "")))
			"rest":
				rig.upper(str(rest["upper"]))
			"", "carry", "stowed", "sheathed":
				rig.upper_off()
	puppet.set_meta("bow_state", want)
	_sky_bow(entity, puppet, rig, moves, want, now)
	if want == "stowed" or state == "stowed":
		_stow_bow(sockets, want == "stowed")
	else:
		_aim_sling(sockets)  # The quiver kept on the back, the bow in hand.
	if want == "sheathed" or (state == "sheathed" and want != "drawing"):
		_sheathe(sockets, want == "sheathed")
	if _put_away(sockets) != away:  # Heard as the blade (else the shield) changes place.
		_rest_sound(puppet, str(ids[0]) if str(ids[0]) != "" else str(ids[1]), away)
	if bow != "":
		_turn_carried(puppet, want == "carry", now)
	_show_nocked(puppet, ids, want in ["draw", "hold"])


## The bow aimed at the sky for a lob (677, pc-character's side): drawn or
## held while GridEntity.lobbing, the upper layer's flat clip has its sky
## clip (HUMANOID_MOVES' bow_*_sky, key for key alike) mixed over it
## (AnimRig.sky), the mix eased toward lobbing over SKY_FADE, so a draw
## turned up or down mid-pull crossfades; the loose keeps the mix it was
## loosed with (the sim clears lobbing as it looses); anything else lets it go.
## Every lob is drawn alike, fully mixed (677 amended (2), the volley: it
## leaves steep whatever its reach): the sky clips aim the arrow's line,
## nock to bow hand, LOB_PITCH degrees up, and the loosed arrow (ui's side)
## leaves on that line.
const SKY_FADE := 0.2
const LOB_PITCH := 70.0
const SKY_CLIPS := {"draw": "bow_draw_sky", "hold": "bow_aim_sky", "loose": "bow_shoot_sky"}


func _sky_bow(entity: GridEntity, puppet: Node3D, rig: AnimRig, moves: Dictionary, want: String, now: int) -> void:
	var amount := rig.sky_amount()
	if want in ["draw", "hold"]:
		var step := (now - int(puppet.get_meta("sky_msec", now))) / 1000.0 / SKY_FADE
		amount = move_toward(amount, 1.0 if entity.lobbing else 0.0, step)
	elif want != "loose":
		amount = 0.0
	puppet.set_meta("sky_msec", now)
	rig.sky(str(moves.get(SKY_CLIPS.get(want, ""), "")), amount)


## The rest [param puppet] stands at (662 (b)): RESTS' row for the piece in
## its right hand ([param ids]), the left hand empty or a shield, once it has
## stood REST_STAND_SECONDS (Idle, Idle_Tired or an armed fidget) and nothing
## has roused it for REST_SECONDS; {} otherwise.
func _rest_of(entity: GridEntity, puppet: Node3D, ids: Array, rig: AnimRig, now: int) -> Dictionary:
	var calm := _calm(entity, puppet, rig, now)
	var standing := rig.base_clip() in [CLIP_IDLE, CLIP_TIRED] or rig.base_clip() in ARMED_FIDGETS
	if not standing:
		puppet.remove_meta("stood_at")
	elif not puppet.has_meta("stood_at"):
		puppet.set_meta("stood_at", now)
	var rest: Dictionary = RESTS.get(str(ids[0]), {})
	if rest.is_empty() or not rig.has(str(rest["upper"])) or not standing:
		return {}
	if str(ids[1]) != "" and "shield" not in Items.def(str(ids[1])).get("tags", []):
		return {}
	if not calm or now - int(puppet.get_meta("stood_at", now)) < int(REST_STAND_SECONDS * 1000.0):
		return {}
	return rest


## Whether [param entity] has been calm REST_SECONDS (662 (b)): nothing raised,
## no blow of its own, nothing rousing it (_roused) and no blow near it
## (_combat_at) that long.
func _calm(entity: GridEntity, puppet: Node3D, rig: AnimRig, now: int) -> bool:
	if entity.raised != "" or rig.striking() or _roused(entity, puppet, now):
		puppet.set_meta("roused_at", now)
	var roused := maxi(int(puppet.get_meta("roused_at", -(1 << 40))), int(_combat_at.get(int(puppet.get_meta("entity_id", 0)), -(1 << 40))))
	return now - roused >= int(REST_SECONDS * 1000.0)


## Whether something rouses [param entity] from its rest: a monster's own
## alert, hunting or fighting; anyone else's a monster so within
## REST_ROUSED_CELLS (looked for twice a second).
func _roused(entity: GridEntity, puppet: Node3D, now: int) -> bool:
	if entity is Monster:
		return (entity as Monster).alert in [Monster.Alert.HUNTING, Monster.Alert.FIGHTING]
	if now < int(puppet.get_meta("roused_look_at", 0)):
		return bool(puppet.get_meta("roused_seen", false))
	puppet.set_meta("roused_look_at", now + 500)
	var seen := false
	for id: int in _puppets:
		var other := instance_from_id(id) as Monster
		if other != null and other.alert in [Monster.Alert.HUNTING, Monster.Alert.FIGHTING] 				and Vector2(other.tile).distance_to(Vector2(entity.tile)) <= REST_ROUSED_CELLS:
			seen = true
			break
	puppet.set_meta("roused_seen", seen)
	return seen


## The right hand's piece slid [param grip] up in the hand along its length
## (0: as it is held).
static func _slide_held(sockets: Dictionary, grip: float, rest := false) -> void:
	var held := (sockets["hand_r"] as Node3D).get_node_or_null("Held") as Node3D
	if held != null:
		# A rest's slide from the piece's origin (the rests were so authored), else from its own grip.
		var at := held.basis * (Vector3(0.0, -grip, 0.0) - (Vector3.ZERO if rest else held.get_meta("grip", Vector3.ZERO) as Vector3))
		if not held.position.is_equal_approx(at):
			held.position = at


## A piece set to rest or taken up again (662; sound's slots by its kind,
## SoundKit.stow_slot: silent till sound's side of 662 is in, looked up
## rather than called by name so this compiles without it).
func _rest_sound(puppet: Node3D, id: String, drawing: bool) -> void:
	if id != "" and _stow_slot_known():
		sfx.play(str((SoundKit as Script).call("stow_slot", id, drawing)), puppet.position + Vector3.UP * 0.8)


static var _has_stow_slot: Variant = null
static func _stow_slot_known() -> bool:
	if _has_stow_slot == null:
		_has_stow_slot = false
		for method: Dictionary in (SoundKit as Script).get_script_method_list():
			if method["name"] == "stow_slot":
				_has_stow_slot = true
	return bool(_has_stow_slot)


## A bow slung on the back out of a fight, and an archer's quiver (662 amended
## (d); Jeff's pick, "bow back 1", of build/bowpick's sheet: "quiver and bow
## wood need to be against back. the string could be over the front of
## chest"): slung across the body, the bow's back out and its belly to the
## body, its wood up the back from the left hip past the right shoulder, the
## string over that shoulder and down the chest to the left hip; the quiver
## flat on the back beside the wood toward the neck, its mouth at the right
## shoulder, whether the bow is slung or in hand. tools/sling_fit.gd fits both
## on the man's and the woman's body standing and writes SLING_FIT: each
## piece's place on UpperChest (the "sling" socket) and, per slice of its
## length, its gap to the skin at the base shape and each shape key's change
## to it. A body's build (its keys, rounded to SLING_STEP) gives each slice's
## gap; the piece is pushed in until its nearest is SLING_CLEAR off the skin,
## and its meshes bent in along their length by the rest, so the wood and the
## quiver lie on the back (sling_fit; the bent meshes cached by build and
## mesh, at most SLING_CACHE_MAX). Slung, the bow is
## turned each frame about its top contact so its foot contact rides out with
## the hip ("sling_hip", Hips) where it would push into it, never in (_aim_sling),
## its own straight string hidden, and the string drawn as rods: from the top
## nock round the shoulder, taut over the chest (the front's upper hull along
## the line), to the left hip's front, round it and down the thigh (riding the
## hips), to the bottom nock. A body the table doesn't
## know (a goblin's) keeps the bow and quiver on the "back" socket as before
## (BOW_BACK_PLAIN: the bow's place, the quiver's offset over it).
const SLING_FIT := "res://client3d/sling.json"
const SLING_CLEAR := 0.004
const SLING_STEP := 0.1
const SLING_CACHE_MAX := 64
## A slice whose skin is farther than this past the piece's nearest is off the body's edge
## and hangs straight (sling_fit). 0.12: the man's quiver top over his shoulder blade (8.3 cm)
## still bends in; its foot, past his waist with only the thigh 20 cm behind, does not.
const SLING_BEND_REACH := 0.12
## How far out from a slice the skin under it is looked for (_sling_lie): a
## slice that deep in is still found.
const SLING_BACK := 0.1
const SLING_STRING_RADIUS := 0.004
const SLING_STRING_LIFT := 0.006
const BOW_IN := Vector3(0, 0, -1)
const QUIVER_IN := Vector3(0, 0, 1)
const BOW_BACK_PLAIN := [Transform3D(Basis(Vector3.UP, PI), Vector3(0.0, -0.1, -0.217)), Vector3(0.0, 0.0, -0.278)]
static var _sling_table: Variant = null
static var _sling_bent := {}
static var _sling_rod: CylinderMesh = null


static func _sling_fits() -> Dictionary:
	if _sling_table == null:
		_sling_table = {}
		var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string(SLING_FIT)) if FileAccess.file_exists(SLING_FIT) else null
		if parsed is Dictionary:
			_sling_table = parsed
	return _sling_table


static func _sling_v(a: Array) -> Vector3:
	return Vector3(float(a[0]), float(a[1]), float(a[2]))


static func _sling_xf(a: Array) -> Transform3D:
	return Transform3D(Basis(_sling_v(a.slice(0, 3)), _sling_v(a.slice(3, 6)), _sling_v(a.slice(6, 9))), _sling_v(a.slice(9, 12)))


## A point of the table at a build: its base ("") plus each key's change times its weight.
static func _sling_point(values: Dictionary, weights: Dictionary) -> Vector3:
	var v := _sling_v(values[""])
	for key: String in weights:
		if values.has(key):
			v += _sling_v(values[key]) * float(weights[key])
	return v


## Points of the table at a build, as _sling_point, each.
static func _sling_points(values: Dictionary, weights: Dictionary) -> PackedVector3Array:
	var out := PackedVector3Array()
	for i in (values[""] as Array).size():
		var v := _sling_v(values[""][i])
		for key: String in weights:
			if values.has(key):
				v += _sling_v(values[key][i]) * float(weights[key])
		out.append(v)
	return out


## A list of the table at a build, as _sling_point (a null base, off the body: INF).
static func _sling_list(values: Dictionary, weights: Dictionary) -> PackedFloat32Array:
	var base: Array = values[""]
	var out := PackedFloat32Array()
	for i in base.size():
		if base[i] == null:
			out.append(INF)
			continue
		var g := float(base[i])
		for key: String in weights:
			if values.has(key):
				g += float(values[key][i]) * float(weights[key])
		out.append(g)
	return out


## The fit of the slung bow and the quiver for the body [param sockets] are
## on, at its build (worked out once, kept on the "sling" socket): {} for a
## body SLING_FIT doesn't know. "bow" and "quiver" their places in the sling
## socket, "bow_bend"/"quiver_bend" each slice's [ys, moves in],
## "bow_points"/"quiver_points" each slice's point as bent and
## "bow_near"/"quiver_near" the skin vertices it may meet, "skin" those
## vertices on their bones at the build (_sling_skin), "string" the chest's points (round the shoulder and down the
## front), "hip_hips" the hip's (its front and round it) on sling_hip, "key"
## the build's cache key. Places are the model's (scaled by
## it); the pieces keep their size.
static func sling_fit(sockets: Dictionary) -> Dictionary:
	var sling := sockets.get("sling") as Node3D
	if sling == null or not sockets.has("sling_hip"):
		return {}
	if sling.has_meta("fit"):
		return sling.get_meta("fit")
	var skeleton := sling.get_parent().get_parent() as Skeleton3D
	var root := skeleton.owner if skeleton != null else null
	var entry: Dictionary = _sling_fits().get(root.scene_file_path if root != null else "", {})
	if entry.is_empty():
		return {}
	var body := skeleton.find_child("Body", true, false) as MeshInstance3D
	var weights := {}
	var key := root.scene_file_path
	if body != null and body.mesh is ArrayMesh:
		var shapes := body.mesh as ArrayMesh
		for k in shapes.get_blend_shape_count():
			var w := snappedf(body.get_blend_shape_value(k), SLING_STEP)
			if w != 0.0:
				weights[String(shapes.get_blend_shape_name(k))] = w
				key += " %s=%.1f" % [shapes.get_blend_shape_name(k), w]
	var s := 1.0 / maxf(sling.scale.x, 0.0001)
	var fit := {"key": key}
	for piece: String in ["bow", "quiver"]:
		var gaps := _sling_list(entry[piece + "_gap"], weights)
		var least := INF
		for g in gaps:
			least = minf(least, g)
		# A slice whose skin is past SLING_BEND_REACH beyond the nearest is off the body's edge:
		# it hangs on straight, not curled round the side to it.
		for i in gaps.size():
			if gaps[i] - least > SLING_BEND_REACH:
				gaps[i] = INF
		if least == INF:
			least = SLING_CLEAR
		var at := _sling_xf(entry[piece])
		var inward := (at.basis * (BOW_IN if piece == "bow" else QUIVER_IN)).normalized()
		at.origin = (at.origin + inward * (least - SLING_CLEAR)) * s
		var ys := PackedFloat32Array()
		var moves := PackedFloat32Array()
		for i in gaps.size():
			if gaps[i] < INF:
				ys.append(float(entry[piece + "_y"][i]))
				moves.append((gaps[i] - least) * s)
		fit[piece] = at
		fit[piece + "_bend"] = [ys, moves]
		# Each slice's point (bent in as worn) and the skin it may meet (_sling_lie).
		var points := PackedVector3Array()
		var near: Array[PackedInt32Array] = []
		for i in (entry[piece + "_pts"] as Array).size():
			if gaps[i] == INF:
				continue  # Over nothing standing, or past the body's edge.
			var v := _sling_v(entry[piece + "_pts"][i])
			points.append(v + (BOW_IN if piece == "bow" else QUIVER_IN) * _sling_move_at(fit[piece + "_bend"], v.y))
			near.append(PackedInt32Array(entry[piece + "_near"][i]))
		fit[piece + "_points"] = points
		fit[piece + "_near"] = near
	# The skin those slices may meet, at this build, on its bones (_sling_skin).
	var proxy: Dictionary = entry["proxy"]
	var bone_of := PackedInt32Array()
	var weight_of := PackedFloat32Array()
	var place_of := PackedVector3Array()
	var starts := PackedInt32Array([0])
	for point: Dictionary in proxy["points"]:
		var v := _sling_v(point["v"])
		for shape_key: String in point["keys"]:
			if weights.has(shape_key):
				v += _sling_v(point["keys"][shape_key]) * float(weights[shape_key])
		for one: Array in point["skin"]:
			var id := skeleton.find_bone(str(one[0]))
			if id < 0:
				continue
			bone_of.append(id)
			weight_of.append(float(one[1]))
			place_of.append(_sling_xf(proxy["binds"][one[0]]) * v)
		starts.append(bone_of.size())
	fit["skin"] = [bone_of, weight_of, place_of, starts]
	fit["skin_tris"] = PackedInt32Array(entry["proxy_tris"])
	var hips_from_chest := _sling_xf(entry["hips_from_chest"])
	hips_from_chest.origin *= s
	# The string over the chest: the shoulder's top, taut over the front, to the hip.
	var front := _sling_v(entry["front"])
	var up := _sling_v(entry["up"])
	var shoulder := _sling_point(entry["shoulder"], weights) * s + up * SLING_STRING_LIFT
	var hip := _sling_point(entry["hip"], weights) * s + front * SLING_STRING_LIFT
	var offsets := _sling_list(entry["string"], weights)
	var length := maxf(shoulder.distance_to(hip), 0.0001)
	var hull: Array[Vector2] = []
	for i in offsets.size():
		var p := Vector2(length * i / float(offsets.size() - 1), offsets[i] * s + SLING_STRING_LIFT)
		while hull.size() >= 2 and (hull[-1] - hull[-2]).cross(p - hull[-2]) >= 0.0:
			hull.pop_back()
		hull.append(p)
	var over := _sling_points(entry["over"], weights)
	var string := PackedVector3Array([over[0] * s, shoulder, over[1] * s])
	for i in range(1, hull.size() - 1):
		string.append(shoulder.lerp(hip, hull[i].x / length) + front * hull[i].y)
	fit["string"] = string
	var round := PackedVector3Array([hips_from_chest * hip])
	for p in _sling_points(entry["round"], weights):
		round.append(hips_from_chest * (p * s))
	fit["hip_hips"] = round
	sling.set_meta("fit", fit)
	return fit


static func _sling_move_at(bend: Array, y: float) -> float:
	var ys: PackedFloat32Array = bend[0]
	var moves: PackedFloat32Array = bend[1]
	if ys.is_empty():
		return 0.0
	if y <= ys[0]:
		return moves[0]
	for i in range(1, ys.size()):
		if y <= ys[i]:
			return lerpf(moves[i - 1], moves[i], (y - ys[i - 1]) / maxf(ys[i] - ys[i - 1], 0.0001))
	return moves[-1]


## [param node]'s place in [param piece]'s frame (through the nodes between).
static func _relative(piece: Node3D, node: Node3D) -> Transform3D:
	var t := Transform3D.IDENTITY
	var at: Node = node
	while at != piece and at is Node3D:
		t = (at as Node3D).transform * t
		at = at.get_parent()
	return t


## [param piece]'s meshes (but [param skip]'s) bent in along [param inward] by
## [param bend] at each point's height (its own frame), the plain ones kept to
## put back (_sling_plain); the bent copies shared by build and mesh.
static func _sling_bend(piece: Node3D, inward: Vector3, bend: Array, key: String, skip: String) -> void:
	for mesh: MeshInstance3D in piece.find_children("*", "MeshInstance3D", true, false):
		if (skip != "" and mesh.name.contains(skip)) or not mesh.mesh is ArrayMesh:
			continue
		var plain := mesh.get_meta("plain", mesh.mesh) as ArrayMesh
		mesh.set_meta("plain", plain)
		var to_piece := _relative(piece, mesh)
		var cache_key := "%s %d %s" % [key, plain.get_instance_id(), to_piece]
		if not _sling_bent.has(cache_key):
			if _sling_bent.size() >= SLING_CACHE_MAX:
				_sling_bent.clear()
			var from_piece := to_piece.affine_inverse()
			var bent := ArrayMesh.new()
			for s in plain.get_surface_count():
				var arrays := plain.surface_get_arrays(s)
				var verts: PackedVector3Array = arrays[Mesh.ARRAY_VERTEX]
				for i in verts.size():
					var p := to_piece * verts[i]
					verts[i] = from_piece * (p + inward * _sling_move_at(bend, p.y))
				arrays[Mesh.ARRAY_VERTEX] = verts
				bent.add_surface_from_arrays(plain.surface_get_primitive_type(s), arrays)
				bent.surface_set_material(s, plain.surface_get_material(s))
			_sling_bent[cache_key] = bent
		mesh.mesh = _sling_bent[cache_key]


## [param piece]'s meshes as they were before _sling_bend.
static func _sling_plain(piece: Node3D) -> void:
	for mesh: MeshInstance3D in piece.find_children("*", "MeshInstance3D", true, false):
		if mesh.has_meta("plain"):
			mesh.mesh = mesh.get_meta("plain")
			mesh.remove_meta("plain")


## A quiver [param piece] worn (_sync_held): laid on the back by the sling's
## fit, or on the "back" socket where the body has none.
static func _wear_quiver(sockets: Dictionary, piece: Node3D) -> void:
	var fit := sling_fit(sockets)
	if fit.is_empty():
		var back := sockets.get("back") as Node3D
		if back != null:
			back.add_child(piece)
			if back.has_node("StowedBow"):
				piece.position = BOW_BACK_PLAIN[1]
		return
	(sockets["sling"] as Node3D).add_child(piece)
	piece.transform = fit["quiver"]
	_sling_bend(piece, QUIVER_IN, fit["quiver_bend"], fit["key"], "")


## The quiver worn, wherever it is (or null).
static func _quiver_of(sockets: Dictionary) -> Node3D:
	for name: String in ["sling", "back"]:
		var on := sockets.get(name) as Node3D
		if on != null and on.has_node("Quiver"):
			return on.get_node("Quiver") as Node3D
	return null


static func _stow_bow(sockets: Dictionary, stowed: bool) -> void:
	var hand := sockets.get("hand_l") as Node3D
	var fit := sling_fit(sockets)
	var on := (sockets.get("back") if fit.is_empty() else sockets.get("sling")) as Node3D
	if hand == null or on == null:
		return
	var from := hand if stowed else on
	var bow := from.get_node_or_null("Held" if stowed else "StowedBow") as Node3D
	if bow != null:
		from.remove_child(bow)
		bow.name = "StowedBow" if stowed else "Held"
		(on if stowed else hand).add_child(bow)
		if fit.is_empty():
			bow.transform = BOW_BACK_PLAIN[0] if stowed else Transform3D.IDENTITY
		elif stowed:
			bow.transform = fit["bow"]
			_sling_bend(bow, BOW_IN, fit["bow_bend"], fit["key"], "string")
		else:
			bow.transform = Transform3D.IDENTITY
			_sling_plain(bow)
		for string: MeshInstance3D in bow.find_children("*string*", "MeshInstance3D", true, false):
			string.visible = fit.is_empty() or not stowed
	if not fit.is_empty():
		var rods := on.get_node_or_null("SlingString")
		if rods != null and not on.has_node("StowedBow"):
			on.remove_child(rods)
			rods.queue_free()
		elif rods == null and on.has_node("StowedBow"):
			_string_rods(on, on.get_node("StowedBow") as Node3D)
		_aim_sling(sockets)
	var quiver := _quiver_of(sockets)
	if quiver != null and fit.is_empty():
		quiver.position = BOW_BACK_PLAIN[1] if on.has_node("StowedBow") else Vector3.ZERO


## The rods the slung string is drawn with, in the bow's own string's
## material; its nocks (the string's ends, in the bow's frame) kept on them.
static func _string_rods(sling: Node3D, bow: Node3D) -> void:
	if _sling_rod == null:
		_sling_rod = CylinderMesh.new()
		_sling_rod.top_radius = SLING_STRING_RADIUS
		_sling_rod.bottom_radius = SLING_STRING_RADIUS
		_sling_rod.height = 1.0
		_sling_rod.radial_segments = 5
		_sling_rod.rings = 1
	var rods := Node3D.new()
	rods.name = "SlingString"
	var material: Material = null
	var nocks := [Vector3(0.0, 0.6, -0.2), Vector3(0.0, -0.56, -0.2)]
	for string: MeshInstance3D in bow.find_children("*string*", "MeshInstance3D", true, false):
		material = string.get_active_material(0)
		var box := _relative(bow, string) * string.get_aabb()
		var mid := box.get_center()
		nocks = [Vector3(mid.x, box.end.y, mid.z), Vector3(mid.x, box.position.y, mid.z)]
	rods.set_meta("nocks", nocks)
	var fit: Dictionary = sling.get_meta("fit")
	for i in (fit["string"] as PackedVector3Array).size() + (fit["hip_hips"] as PackedVector3Array).size() + 1:
		var rod := MeshInstance3D.new()
		rod.mesh = _sling_rod
		if material != null:
			rod.material_override = material
		rods.add_child(rod)
	sling.add_child(rods)


## The slung bow and the quiver kept on the back as the body moves (each
## frame the quiver is worn or the bow slung): each piece tilted along its
## length and moved in or out to follow its slices' skin points (_sling_hug);
## and the string's rods laid along its path.
static func _aim_sling(sockets: Dictionary) -> void:
	var sling := sockets.get("sling") as Node3D
	if sling == null or not sling.has_meta("fit") or not sling.is_inside_tree():
		return
	var fit: Dictionary = sling.get_meta("fit")
	var skeleton := sling.get_parent().get_parent() as Skeleton3D
	var quiver := _quiver_of(sockets)
	var worn := quiver != null and quiver.get_parent() == sling
	if not worn and not sling.has_node("StowedBow"):
		return
	var skin := _sling_skin(fit["skin"], skeleton, sling.global_transform.affine_inverse() * skeleton.global_transform)
	if worn:
		quiver.transform = _sling_lie(fit["quiver"], fit["quiver_points"], fit["quiver_near"], QUIVER_IN, skin, fit["skin_tris"])
	if not sling.has_node("StowedBow"):
		return
	var bow := sling.get_node("StowedBow") as Node3D
	bow.transform = _sling_lie(fit["bow"], fit["bow_points"], fit["bow_near"], BOW_IN, skin, fit["skin_tris"])
	var to_hips := sling.global_transform.affine_inverse() * (sockets["sling_hip"] as Node3D).global_transform
	var rods := sling.get_node_or_null("SlingString") as Node3D
	if rods == null:
		return
	var nocks: Array = rods.get_meta("nocks")
	var path := PackedVector3Array([bow.transform * (nocks[0] as Vector3)])
	path.append_array(fit["string"])
	for p: Vector3 in fit["hip_hips"]:
		path.append(to_hips * p)
	path.append(bow.transform * (nocks[1] as Vector3))
	for i in mini(rods.get_child_count(), path.size() - 1):
		var along := path[i + 1] - path[i]
		var dir := along.normalized()
		var side := dir.cross(Vector3.FORWARD if absf(dir.dot(Vector3.FORWARD)) < 0.9 else Vector3.RIGHT).normalized()
		(rods.get_child(i) as Node3D).transform = Transform3D(Basis(side, along, side.cross(dir)), (path[i] + path[i + 1]) * 0.5)


## The skin [param proxy] (sling_fit's "skin") as the body stands now, in
## the sling's frame ([param to_sling] from the skeleton's).
static func _sling_skin(proxy: Array, skeleton: Skeleton3D, to_sling: Transform3D) -> PackedVector3Array:
	var bone_of: PackedInt32Array = proxy[0]
	var weight_of: PackedFloat32Array = proxy[1]
	var place_of: PackedVector3Array = proxy[2]
	var starts: PackedInt32Array = proxy[3]
	var poses := {}
	var out := PackedVector3Array()
	out.resize(starts.size() - 1)
	for i in starts.size() - 1:
		var at := Vector3.ZERO
		for k in range(starts[i], starts[i + 1]):
			if not poses.has(bone_of[k]):
				poses[bone_of[k]] = skeleton.get_bone_global_pose(bone_of[k])
			at += (poses[bone_of[k]] as Transform3D) * place_of[k] * weight_of[k]
		out[i] = to_sling * at
	return out


## [param at] (a piece's place standing) tilted along its length and moved
## along [param inward] by the line that best lays each slice SLING_CLEAR off
## the skin now under it (its [param near] triangles of [param skin], met
## along its inward line from SLING_BACK out), then out until none is nearer:
## it rides the back, never into it. A slice over nothing is left out.
static func _sling_lie(at: Transform3D, points: PackedVector3Array, near: Array[PackedInt32Array], inward: Vector3, skin: PackedVector3Array, tris: PackedInt32Array) -> Transform3D:
	var into := (at.basis * inward).normalized()
	var along := at.basis.y.normalized()
	var ys := PackedFloat32Array()
	var want := PackedFloat32Array()
	for i in points.size():
		var p := at * points[i]
		var from := p - into * SLING_BACK
		var least := INF
		for t in near[i]:
			var hit: Variant = Geometry3D.ray_intersects_triangle(from, into, skin[tris[t * 3]], skin[tris[t * 3 + 1]], skin[tris[t * 3 + 2]])
			if hit != null:
				least = minf(least, from.distance_to(hit) - SLING_BACK)
		if least < INF:
			ys.append((p - at.origin).dot(along))
			want.append(least - SLING_CLEAR)
	if ys.size() < 2:
		return at
	# Least squares: in by shift + tilt * y.
	var n := float(ys.size())
	var sy := 0.0
	var sw := 0.0
	var syy := 0.0
	var syw := 0.0
	for i in ys.size():
		sy += ys[i]
		sw += want[i]
		syy += ys[i] * ys[i]
		syw += ys[i] * want[i]
	var spread := n * syy - sy * sy
	var tilt := (n * syw - sy * sw) / spread if absf(spread) > 1e-8 else 0.0
	var shift := (sw - tilt * sy) / n
	var over := -INF
	for i in ys.size():
		over = maxf(over, shift + tilt * ys[i] - want[i])
	shift -= over
	var turn := Basis(along.cross(into).normalized(), atan(tilt))
	return Transform3D(turn, at.origin - turn * at.origin + into * shift) * at


## The bow or the shield on the back let go with the left hand's thing (_sync_held).
static func _let_go_stowed(sockets: Dictionary) -> void:
	for socket: String in ["back", "sling"]:
		var on := sockets.get(socket) as Node3D
		if on == null:
			continue
		for name in ["StowedBow", "StowedShield", "SlingString"]:
			var piece := on.get_node_or_null(name)
			if piece != null:
				on.remove_child(piece)
				piece.queue_free()
	var quiver := _quiver_of(sockets)
	if quiver != null and quiver.get_parent() == sockets.get("back"):
		quiver.position = Vector3.ZERO


## The blades sheathed out of a fight (662 (c); Jeff: "sheathing sword,
## definitely not scratching head or anything that sword goes near body"): a
## blade in the right hand wears its sheath (SHEATHS, art-kit's) at the left
## hip's "hip_l" socket, empty while it is drawn; calm (_calm, as the bow on
## the back), the blade goes into it, seated grip first at the sheath's "mouth"
## turned end for end (blade down), and a shield on the left arm goes onto the
## "back" socket (BACK_SHIELD: its face out, its back off the shoulder
## blades). Roused, both are back in hand at once (no draw delay, 662 rules).
## The hip_l socket stands a sheath SHEATH_OUT off the hip's side, SHEATH_UP
## from the Hips bone, tipped SHEATH_TILT, and each sheath its own way farther
## out (SHEATHS' second: the scabbard's length clear of the thigh swinging in a
## sprint, a short sheath of the heaviest build's hip); clear of the five
## builds through the gaits (anim_rig_test; build/sheath/probe.gd swept them).
const SHEATHS := {"sword": ["gear.scabbard", 0.09], "dagger": ["gear.sheath", 0.06], "knife": ["gear.sheath", 0.06]}
const SHEATH_TILT := PI * 25.0 / 180.0
const SHEATH_OUT := 0.03
const SHEATH_UP := 0.02
const SHEATH_MOUTH := Vector3(0.0, 0.16, 0.0)
const BACK_SHIELD := Transform3D(Basis(Vector3.UP, PI), Vector3(0.0, -0.1, -0.08))
static func _mouth_of(art: String) -> Vector3:
	var at: Variant = ArtKit.spec(art).get("sockets", {}).get("mouth")
	return Vector3(at[0], at[1], at[2]) if at is Array and at.size() == 3 else SHEATH_MOUTH


## The sheath for [param id] in the right hand worn at the hip (none for
## anything else), the old one and any blade in it let go.
static func _wear_sheath(sockets: Dictionary, id: String) -> void:
	var hip := sockets.get("hip_l") as Node3D
	if hip == null:
		return
	var old := hip.get_node_or_null("Sheath")
	if old != null:
		hip.remove_child(old)
		old.queue_free()
	var art := str(SHEATHS.get(id, ["", 0.0])[0])
	if art != "" and ArtKit.has(art):
		var sheath := ArtKit.instance(art)
		sheath.name = "Sheath"
		sheath.position = Vector3(0.0, 0.0, float(SHEATHS[id][1]))
		sheath.set_meta("mouth", _mouth_of(art))
		hip.add_child(sheath)


## The right hand's blade into its sheath ([param sheathed]) or out of it
## into the hand, and the left arm's shield onto the back or off it.
static func _sheathe(sockets: Dictionary, sheathed: bool) -> void:
	var hand := sockets.get("hand_r") as Node3D
	var sheath: Node3D = (sockets["hip_l"] as Node3D).get_node_or_null("Sheath") as Node3D if sockets.has("hip_l") else null
	if hand != null and sheath != null:
		var from := hand if sheathed else sheath
		var blade := from.get_node_or_null("Held" if sheathed else "Sheathed") as Node3D
		if blade != null:
			from.remove_child(blade)
			blade.name = "Sheathed" if sheathed else "Held"
			blade.transform = Transform3D(Basis(Vector3(0, 0, 1), PI), sheath.get_meta("mouth")) if sheathed \
				else Transform3D(HELD_EDGE_TURN, Vector3.ZERO)
			(sheath if sheathed else hand).add_child(blade)
	var arm := sockets.get("arm_l") as Node3D
	var back := sockets.get("back") as Node3D
	if arm != null and back != null:
		var from := arm if sheathed else back
		var shield := from.get_node_or_null("Held" if sheathed else "StowedShield") as Node3D
		if shield != null:
			from.remove_child(shield)
			shield.name = "StowedShield" if sheathed else "Held"
			shield.transform = BACK_SHIELD if sheathed else Transform3D(Basis.IDENTITY, -shield.get_meta("strap", Vector3.ZERO))
			(back if sheathed else arm).add_child(shield)


## The blade sheathed and drawn by hand (662 (c)'s clips, humanoid_clips.py's Sheathe and Draw,
## "_Short" for the short sheath; the upper layer, once): calm, a blade in the right hand plays
## its sheath's Sheathe ("sheathing"), the blade (and a shield, to the back) moved at
## SHEATHE_CONTACT, when the hand is at the sheath's mouth, and "sheathed" once it ends; roused
## without a raise or a blow of its own (a monster hunting near, a blow seen near), Draw
## ("drawing"), back in hand at DRAW_GRIP, its hold as before once it ends. A raise or its own
## blow takes it at once, with no clip, and cuts either clip short with the blade in hand (the
## coordinator: no blow waits on a draw). A shield alone, or a rig without the clips, is put away
## and taken up at once as before.
const SHEATHE_CLIPS := {"gear.scabbard": ["Sheathe", "Draw"], "gear.sheath": ["Sheathe_Short", "Draw_Short"]}
const SHEATHE_CONTACT := 0.5
const DRAW_GRIP := 0.25
func _sheathing(entity: GridEntity, puppet: Node3D, rig: AnimRig, sockets: Dictionary, ids: Array, want: String,
		state: String, now: int) -> String:
	var clips := _sheathe_clips(rig, sockets, str(ids[0]))
	var hasty := entity.raised != "" or rig.striking()
	var since := (now - int(puppet.get_meta("sheathe_at", now))) / 1000.0
	if state == "sheathing":
		if want != "sheathed" or clips.is_empty():
			_sheathe(sockets, false)  # Cut short: in hand at once.
			return want
		if since >= SHEATHE_CONTACT:
			_sheathe(sockets, true)
		return "sheathing" if since < rig.length(clips[0]) else "sheathed"
	if state == "drawing":
		if hasty or clips.is_empty() or since >= DRAW_GRIP:
			_sheathe(sockets, false)
		return "drawing" if not hasty and not clips.is_empty() and since < rig.length(clips[1]) else want
	if clips.is_empty():
		return want
	if want == "sheathed" and state != "sheathed":
		puppet.set_meta("sheathe_at", now)
		rig.upper(clips[0], 1.0, true)
		return "sheathing"
	if state == "sheathed" and want == "" and not hasty:
		puppet.set_meta("sheathe_at", now)
		rig.upper(clips[1], 1.0, true)
		return "drawing"
	return want


## The Sheathe and Draw clips for the sheath [param id] wears at the hip, [] when it wears none or
## the rig lacks them.
static func _sheathe_clips(rig: AnimRig, sockets: Dictionary, id: String) -> Array:
	var clips: Array = SHEATHE_CLIPS.get(str(SHEATHS.get(id, ["", 0.0])[0]), [])
	if clips.is_empty() or not sockets.has("hip_l") or not rig.has(clips[0]) or not rig.has(clips[1]):
		return []
	return clips


## Whether a blade is in its sheath or a shield on the back.
static func _put_away(sockets: Dictionary) -> bool:
	var sheath := (sockets["hip_l"] as Node3D).get_node_or_null("Sheath") if sockets.has("hip_l") else null
	return (sheath != null and sheath.has_node("Sheathed")) or (sockets.has("back") and (sockets["back"] as Node3D).has_node("StowedShield"))


## Whether the right hand's [param ids] and the left's put away together out
## of a fight (662 (c)): a sheathed blade or nothing in the right, a shield or
## nothing in the left, not both empty.
static func sheathes(ids: Array) -> bool:
	var right := str(ids[0])
	var left := str(ids[1])
	var shield: bool = left != "" and "shield" in Items.def(left).get("tags", [])
	return (right != "" or left != "") and (right == "" or SHEATHS.has(right)) and (left == "" or shield)


## The bow as it's carried at a walk or run (462 amended (3)): a quarter turn
## in the hand and out from it a little, so its limbs clear the hip and leg as
## the arm swings (no vertex inside the body through the gaits, five builds,
## anim_rig_test); turned to it and back over about BOW_TURN_SECONDS.
const BOW_CARRY := Transform3D(Basis(Vector3.RIGHT, -PI * 0.5), Vector3(0.04, 0.0, 0.0))
const BOW_TURN_SECONDS := 0.2
func _turn_carried(puppet: Node3D, carried: bool, now: int) -> void:
	var bow := ((puppet.get_meta("sockets") as Dictionary)["hand_l"] as Node3D).get_node_or_null("Held") as Node3D
	var then := int(puppet.get_meta("bow_turned_at", now))
	puppet.set_meta("bow_turned_at", now)
	if bow == null:
		return
	var want := BOW_CARRY if carried else Transform3D.IDENTITY
	if bow.transform.is_equal_approx(want):
		return
	var step := 1.0 - exp(-(now - then) / 1000.0 * 5.0 / BOW_TURN_SECONDS)
	bow.transform = bow.transform.interpolate_with(want, clampf(step, 0.0, 1.0))
	if bow.transform.origin.distance_to(want.origin) < 0.002 and bow.basis.get_rotation_quaternion().angle_to(want.basis.get_rotation_quaternion()) < 0.02:
		bow.transform = want


## While drawn, one arrow on the bow's string at its nock, the string pulled
## back toward the drawing hand; let go, the arrow gone and the string
## springing back (bow_string).
const NOCKED_TURN := Basis(Vector3.RIGHT, PI * 0.5)
func _show_nocked(puppet: Node3D, ids: Array, drawn: bool) -> void:
	var sockets: Dictionary = puppet.get_meta("sockets")
	var bow := (sockets["hand_l"] as Node3D).get_node_or_null("Held") as Node3D
	if bow == null:
		return
	var string := bow.find_child("string", true, false) as Node3D
	var arrow := bow.find_child("Nocked", true, false) as Node3D
	if string != null and not string.has_meta("rest"):
		_string_segments(string)
	# The limbs bend only near the camera (BOW_FLEX_RANGE): a raid's far
	# archers keep the rigid bow, their strings still drawn.
	var flex := _camera == null or puppet.global_position.distance_to(_camera_target) <= BOW_FLEX_RANGE
	if not drawn:
		if arrow != null:
			arrow.queue_free()
		if string != null and string.has_meta("pulled"):
			# Let go: the spring from where it was drawn to.
			string.set_meta("loosed", [Time.get_ticks_msec(), float(string.get_meta("pulled"))])
			string.remove_meta("pulled")
		if string != null and string.has_meta("loosed"):
			var loosed: Array = string.get_meta("loosed")
			var at := (Time.get_ticks_msec() - int(loosed[0])) / 1000.0
			var rest: Vector3 = string.get_meta("rest")
			string.position = rest + Vector3(0.0, 0.0, bow_string(float(loosed[1]), at))
			if at >= STRING_SETTLE:
				string.remove_meta("loosed")
			_string_bend(string, flex)
		return
	if arrow == null and ArtKit.has("fx.arrow"):
		arrow = ArtKit.instance("fx.arrow", int(ARROW_VARIANTS.get(str(ids[0]), 1)))
		arrow.name = "Nocked"
		# Its notch at the nock, its head (+y) toward the target (the bow's +z). On the
		# string's parent, kept at the string below, never under the string itself: the art's
		# string box is hidden for the drawn segments (_string_segments), and the arrow went with it
		# (Jeff: "the arrow doesn't load into the bow with drawing").
		arrow.basis = NOCKED_TURN
		var nock := bow.find_child("nock", true, false) as Node3D
		(string.get_parent() if string != null else nock if nock != null else bow).add_child(arrow)
	if string != null:
		# Back toward the drawing hand, never past it nor forward of the brace,
		# nor further than a bow draws (BOW_DRAW_MAX: a pose not yet applied).
		var hand := (string.get_parent() as Node3D).global_transform.affine_inverse() * (sockets["hand_r"] as Node3D).global_position
		var rest: Vector3 = string.get_meta("rest")
		string.position = Vector3(rest.x, rest.y, clampf(hand.z, rest.z - BOW_DRAW_MAX, rest.z))
		string.set_meta("pulled", rest.z - string.position.z)
		if string.has_meta("loosed"):
			string.remove_meta("loosed")
		_string_bend(string, flex)
		if arrow != null:
			arrow.transform = string.transform * Transform3D(NOCKED_TURN, Vector3.ZERO)


## The string's nock point [param seconds] after a draw of [param pulled] m
## was let go, along the bow's z from its brace (+ toward the target): back
## to the brace in STRING_SNAP, a quarter swing; then a damped ring about it
## (STRING_HZ, damped by STRING_DAMPING) whose first swing past the brace is
## STRING_OVERSHOOT of the draw, never more than STRING_OVERSHOOT_MAX; still
## after STRING_SETTLE. A function of the time alone, so a long frame can't
## throw it further than the swing itself goes.
const STRING_SNAP := 0.03
const STRING_HZ := 9.0
const STRING_DAMPING := 0.2
const STRING_OVERSHOOT := 0.12
const STRING_OVERSHOOT_MAX := 0.05
const STRING_SETTLE := 0.4
static func bow_string(pulled: float, seconds: float) -> float:
	if seconds >= STRING_SETTLE or pulled <= 0.0:
		return 0.0
	if seconds < STRING_SNAP:
		return -pulled * cos(PI * 0.5 * seconds / STRING_SNAP)
	var omega := TAU * STRING_HZ
	var t := seconds - STRING_SNAP
	var ring := minf(pulled * STRING_OVERSHOOT, STRING_OVERSHOOT_MAX)
	return ring * exp(-STRING_DAMPING * omega * t) * sin(omega * sqrt(1.0 - STRING_DAMPING * STRING_DAMPING) * t)


## The bow art's "string" part (a straight box tip to tip, its pivot at the
## nock) drawn instead as two thin segments, tip to nock and nock to tip
## (462 amended (3)), so a drawn string bends at the hand: the box hidden,
## the tips read off its bounds, the segments closed boxes of its own
## thickness and material (seen from every side), every corner on the
## string's own swatch (its first vertex's UV). Kept as the string's metas
## "rest", "tips" and "segments"; the bow's own meshes as "limbs" (_bow_limbs).
static var _string_boxes := {}
static func _string_segments(string: Node3D) -> void:
	string.set_meta("rest", string.position)
	var boxes := string.find_children("*", "MeshInstance3D", true, false)
	var box := string as MeshInstance3D if string is MeshInstance3D else (boxes.front() as MeshInstance3D if not boxes.is_empty() else null)
	if box == null:
		return
	var parent := string.get_parent() as Node3D
	var to_parent := parent.global_transform.affine_inverse() * box.global_transform
	var bounds := box.get_aabb()
	var middle := bounds.get_center()
	var top := to_parent * Vector3(middle.x, bounds.end.y, middle.z)
	var bottom := to_parent * Vector3(middle.x, bounds.position.y, middle.z)
	var width := (to_parent.basis * Vector3(minf(bounds.size.x, bounds.size.z), 0.0, 0.0)).length()
	var uv := Vector2.ZERO
	if box.mesh != null and box.mesh.get_surface_count() > 0:
		var uvs: Variant = box.mesh.surface_get_arrays(0)[Mesh.ARRAY_TEX_UV]
		if uvs is PackedVector2Array and not (uvs as PackedVector2Array).is_empty():
			uv = (uvs as PackedVector2Array)[0]
	if not _string_boxes.has(uv):
		var arrays := BoxMesh.new().get_mesh_arrays()
		var flat := PackedVector2Array()
		flat.resize((arrays[Mesh.ARRAY_VERTEX] as PackedVector3Array).size())
		flat.fill(uv)
		arrays[Mesh.ARRAY_TEX_UV] = flat
		var made := ArrayMesh.new()
		made.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays)
		_string_boxes[uv] = made
	var segments: Array[MeshInstance3D] = []
	for i in 2:
		var piece := MeshInstance3D.new()
		piece.name = "StringSegment%d" % i
		piece.mesh = _string_boxes[uv]
		piece.material_override = box.get_active_material(0)
		piece.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		parent.add_child(piece)
		segments.append(piece)
	box.visible = false
	string.set_meta("tips", [top, bottom, maxf(width, 0.002)])
	string.set_meta("segments", segments)
	string.set_meta("limbs", _bow_limbs(parent, string, box, maxf(absf(top.y), absf(bottom.y))))
	_string_bend(string)


## The bow's own meshes (everything under [param bow] but its string), each
## given its own copy of its mesh to bend (462 amended (4)), made once and
## freed with the bow: per surface [the copy, its surface, its vertex buffer
## as the art has it, the buffer's stride and the position's offset in it,
## the vertices that move (beyond the grip), where they are, how far out each
## is (the square, and the cube signed by the side), the bow's -z and -y in
## the mesh's frame]. A bend writes only the moving positions into a copy of
## the buffer, not a new mesh. [param reach]: the limb's length, grip to tip.
static func _bow_limbs(bow: Node3D, string: Node3D, box: MeshInstance3D, reach: float) -> Array:
	var limbs := []
	var grip := reach * BOW_GRIP
	for piece: MeshInstance3D in bow.find_children("*", "MeshInstance3D", true, false):
		if piece == box or string.is_ancestor_of(piece) or piece.name.begins_with("StringSegment") or piece.mesh == null:
			continue
		var to_bow := bow.global_transform.affine_inverse() * piece.global_transform
		var back := to_bow.affine_inverse().basis
		var own := ArrayMesh.new()
		for i in piece.mesh.get_surface_count():
			var arrays := piece.mesh.surface_get_arrays(i)
			own.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays, [], {}, Mesh.ARRAY_FLAG_USE_DYNAMIC_UPDATE)
			own.surface_set_material(i, piece.mesh.surface_get_material(i))
			var data := RenderingServer.mesh_get_surface(own.get_rid(), i)
			var format := int(data["format"])
			var count := int(data["vertex_count"])
			var points: PackedVector3Array = arrays[Mesh.ARRAY_VERTEX]
			var moving := PackedInt32Array()
			var squares := PackedFloat32Array()
			var cubes := PackedFloat32Array()
			for v in points.size():
				var at := to_bow * points[v]
				var out := clampf((absf(at.y) - grip) / maxf(reach - grip, 0.001), 0.0, 1.0)
				if out > 0.0:
					moving.append(v)
					squares.append(out * out)
					cubes.append(signf(at.y) * out * out * out)
			limbs.append([own, i, data["vertex_data"], RenderingServer.mesh_surface_get_format_vertex_stride(format, count),
				RenderingServer.mesh_surface_get_format_offset(format, count, Mesh.ARRAY_VERTEX), moving, points, squares, cubes,
				back * Vector3.BACK, back * Vector3.UP])
		piece.mesh = own
		# Bent, it reaches a little past the art's bounds: not culled for it.
		piece.custom_aabb = own.get_aabb().grow(BOW_BEND * 2.0)
	return limbs


## Where a point of the bow (in its frame: limbs along y from the grip at the
## origin, the target toward +z) is when its limbs are bent [param bend] m at
## the tips toward the string (-z; below 0, forward): nothing within the grip
## (BOW_GRIP of the limb's length), then a curve growing as the square of the
## way out to the tip, its height drawn in so the limb keeps its length.
## [param reach] is the limb's length, grip to tip.
const BOW_BEND := 0.05
const BOW_GRIP := 0.12
const BOW_DRAW := 0.45
const BOW_DRAW_MAX := 0.75
## The least change of the bend written again (m): half a millimetre.
const BOW_BEND_STEP := 0.0005
## How near the camera's mark an archer's limbs bend (m).
const BOW_FLEX_RANGE := 14.0
static func bent(point: Vector3, bend: float, reach: float) -> Vector3:
	var grip := reach * BOW_GRIP
	var out := clampf((absf(point.y) - grip) / maxf(reach - grip, 0.001), 0.0, 1.0)
	if out <= 0.0 or is_zero_approx(bend):
		return point
	var shorter := 2.0 * bend * bend / (3.0 * maxf(reach - grip, 0.001))
	return point + Vector3(0.0, -signf(point.y) * shorter * out * out * out, -bend * out * out)


## The limbs bent as the string is drawn: BOW_BEND at the tips at a draw of
## BOW_DRAW m (no more past it), none at rest, a little forward as the string
## rings past the brace; the art's own positions again once it's still. Only
## the moving positions written, into a copy of the buffer (bent's sums, in
## the mesh's frame).
static func _bend_limbs(string: Node3D, bend: float, reach: float) -> void:
	var was := float(string.get_meta("bent", 0.0))
	# Not again for less than BOW_BEND_STEP, but always back to straight.
	if absf(bend - was) < BOW_BEND_STEP and not (bend == 0.0 and was != 0.0):
		return
	string.set_meta("bent", bend)
	var grip := reach * BOW_GRIP
	var shorter := 2.0 * bend * bend / (3.0 * maxf(reach - grip, 0.001))
	for limb: Array in string.get_meta("limbs", []):
		var buffer: PackedByteArray = (limb[2] as PackedByteArray).duplicate()
		var stride: int = limb[3]
		var offset: int = limb[4]
		var moving: PackedInt32Array = limb[5]
		var points: PackedVector3Array = limb[6]
		var squares: PackedFloat32Array = limb[7]
		var cubes: PackedFloat32Array = limb[8]
		var toward: Vector3 = limb[9]
		var up: Vector3 = limb[10]
		if not is_zero_approx(bend):
			for k in moving.size():
				var v := moving[k]
				var at := points[v] - toward * (bend * squares[k]) - up * (shorter * cubes[k])
				var byte := v * stride + offset
				buffer.encode_float(byte, at.x)
				buffer.encode_float(byte + 4, at.y)
				buffer.encode_float(byte + 8, at.z)
		RenderingServer.mesh_surface_update_vertex_region((limb[0] as ArrayMesh).get_rid(), limb[1], 0, buffer)


## The two segments from the tips to the string's nock as it is now, the
## limbs bent by how far the nock is back of its brace (462 amended (4));
## kept straight unless [param flex].
static func _string_bend(string: Node3D, flex := true) -> void:
	if not string.has_meta("segments"):
		return
	var tips: Array = string.get_meta("tips")
	var nock := string.position
	var segments: Array = string.get_meta("segments")
	var width: float = tips[2]
	var rest: Vector3 = string.get_meta("rest", nock)
	var reach := maxf(absf((tips[0] as Vector3).y), absf((tips[1] as Vector3).y))
	var bend := BOW_BEND * clampf((rest.z - nock.z) / BOW_DRAW, -0.3, 1.0) if flex else 0.0
	_bend_limbs(string, bend, reach)
	for i in 2:
		var tip: Vector3 = bent(tips[i], bend, reach)
		var along := tip - nock
		var length := maxf(along.length(), 0.001)
		var up := along / length
		var side := up.cross(Vector3.FORWARD if absf(up.z) < 0.9 else Vector3.RIGHT).normalized()
		(segments[i] as MeshInstance3D).transform = Transform3D(
			Basis(side * width, up * length, side.cross(up).normalized() * width), (nock + tip) * 0.5)


## A human body's meshes in HUMAN_MATERIAL, each part in its own colour (its
## mesh's extras, as tools/body_build.py wrote them), the tunic in
## [param tunic] unless that is white (no colour of its own).
static func _dress(scene: Node3D, tunic: Color) -> void:
	for mesh: MeshInstance3D in scene.find_children("*", "MeshInstance3D", true, false):
		mesh.material_override = HUMAN_MATERIAL
		var own: Dictionary = mesh.get_meta("extras", {})
		for part: String in HUMAN_PARTS:
			if own.has(part):
				mesh.set_instance_shader_parameter(part, Color(str(own[part])))
		if tunic != Color.WHITE:
			mesh.set_instance_shader_parameter("tunic", tunic)


## Each surface of [param scene]'s meshes whose material is named
## [param material] drawn in [param colour] instead (a copy of it).
static func _tint(scene: Node3D, material: String, colour: Color) -> void:
	for mesh: MeshInstance3D in scene.find_children("*", "MeshInstance3D", true, false):
		for surface in mesh.mesh.get_surface_count():
			var own := mesh.mesh.surface_get_material(surface) as BaseMaterial3D
			if own != null and own.resource_name == material:
				var tinted := own.duplicate() as BaseMaterial3D
				tinted.albedo_color = colour
				mesh.set_surface_override_material(surface, tinted)


## Two goblins for the warm-up (warm_ups, decision 495; 494 amended): one in
## GOBLIN_MATERIAL, one in its hover outline's stencil twin, skinned and
## casting shadows as in play, so the first hover on a goblin does not stall
## a frame compiling the twin (20.6 ms, cold, before).
static func warm_goblin() -> Node3D:
	var piece := Node3D.new()
	var twin := GOBLIN_MATERIAL.duplicate() as ShaderMaterial
	twin.shader = GOBLIN_MARKING_SHADER
	for material: Material in [GOBLIN_MATERIAL, twin]:
		var scene := (load(MODELS["imp"]["scene"]) as PackedScene).instantiate() as Node3D
		for mesh: MeshInstance3D in scene.find_children("*", "MeshInstance3D", true, false):
			mesh.material_override = material
		piece.add_child(scene)
	return piece


## The painted allies for the warm-up (warm_ups; decision 529): each MODELS
## "paint" in its material and its hover outline's stencil twin, skinned, as
## warm_goblin does the goblin's.
## A model whose paint or scene this build lacks (a pck without the art, terrain's bench on
## 11a3f6af: "Cannot call method 'duplicate' on a null value") is passed over, not warmed.
static func warm_painted(models: Dictionary = MODELS) -> Node3D:
	var piece := Node3D.new()
	# The materials held by the piece itself till its children are gone (a twin held by its
	# surfaces alone was freed before them as the piece was: the renderer's "material is null").
	var held: Array[Material] = []
	piece.set_meta("materials", held)
	for kind: String in models:
		if not models[kind].has("paint"):
			continue
		var paint_path := str(models[kind]["paint"])
		var scene_path := str(models[kind]["scene"])
		if not ResourceLoader.exists(paint_path) or not ResourceLoader.exists(scene_path):
			continue
		var paint := load(paint_path) as ShaderMaterial
		var made := load(scene_path) as PackedScene
		if paint == null or made == null:
			continue
		var twin := paint.duplicate() as ShaderMaterial
		twin.shader = GOBLIN_MARKING_SHADER
		held.append_array([paint, twin])
		for material: Material in [paint, twin]:
			var scene := made.instantiate() as Node3D
			for mesh: MeshInstance3D in scene.find_children("*", "MeshInstance3D", true, false):
				_paint_skin(mesh, material)
			piece.add_child(scene)
	return piece


## [param mesh]'s skin in [param paint]: every surface but those on art-kit's palette (a
## hand-made body's plate, chain and belt), which are drawn in the palette (decision 529 amended).
static func _paint_skin(mesh: MeshInstance3D, paint: Material) -> void:
	if paint == null:
		return  # Its own material where this build lacks the paint.
	for surface in mesh.mesh.get_surface_count():
		var own := mesh.mesh.surface_get_material(surface)
		var palette := own != null and own.resource_name == ArtKit.PALETTE_NAME
		mesh.set_surface_override_material(surface, load(ArtKit.PALETTE) if palette else paint)


## A painted ally's look by its name (decision 529), the same on every peer
## (goblin_look's hash): {width, skin (hue shift, saturation, value: within
## PAINTED_SKIN_*), mark (one of GOBLIN_MARKS, one-hot, or none:
## PAINTED_UNMARKED of the time; body_marks.py's chest scar, arm stripes and
## red hand), words}.
static func painted_look(ally_name: String) -> Dictionary:
	var h := 2166136261
	for byte in ally_name.to_utf8_buffer():
		h = ((h ^ byte) * 16777619) & 0xffffffff
	var rng := RandomNumberGenerator.new()
	rng.seed = h
	var width := rng.randf_range(PAINTED_WIDTH.x, PAINTED_WIDTH.y)
	var skin := Vector3(rng.randf_range(PAINTED_SKIN_HUE.x, PAINTED_SKIN_HUE.y), rng.randf_range(PAINTED_SKIN_SAT.x, PAINTED_SKIN_SAT.y),
		rng.randf_range(PAINTED_SKIN_VALUE.x, PAINTED_SKIN_VALUE.y))
	var marked := rng.randf() >= PAINTED_UNMARKED
	var mark_index := rng.randi() % GOBLIN_MARKS.size()
	var mark := Vector3.ZERO
	if marked:
		mark[mark_index] = 1.0
	var words: Array[String] = []
	if width < 0.97:
		words.append("build=lean")
	elif width > 1.03:
		words.append("build=stocky")
	if skin.z < 0.92:
		words.append("skin=dark")
	elif skin.z > 1.06:
		words.append("skin=pale")
	if marked:
		words.append("mark=" + GOBLIN_MARKS[mark_index])
	return {"width": width, "skin": skin, "mark": mark, "words": " ".join(words)}


## A goblin's look by its name (decision 494), the same on every peer (a
## hash of the name's bytes, not the engine's String.hash): {width, skin
## (Vector3: hue shift, saturation, value), gear (Color, its amount in .a),
## mark (Vector3, one-hot or none), words}, its words for what a voice might
## call it ("build=lean skin=dark gear=red mark=scarred", a word only where
## it stands out).
static func goblin_look(goblin_name: String) -> Dictionary:
	var h := 2166136261
	for byte in goblin_name.to_utf8_buffer():
		h = ((h ^ byte) * 16777619) & 0xffffffff
	var rng := RandomNumberGenerator.new()
	rng.seed = h
	var width := rng.randf_range(GOBLIN_WIDTH.x, GOBLIN_WIDTH.y)
	var skin := Vector3(rng.randf_range(GOBLIN_SKIN_HUE.x, GOBLIN_SKIN_HUE.y), rng.randf_range(GOBLIN_SKIN_SAT.x, GOBLIN_SKIN_SAT.y),
		rng.randf_range(GOBLIN_SKIN_VALUE.x, GOBLIN_SKIN_VALUE.y))
	var own := rng.randf() < GOBLIN_OWN_GEAR
	var gear_name: String = GOBLIN_GEAR.keys()[rng.randi() % GOBLIN_GEAR.size()]
	var gear := Color(GOBLIN_GEAR[gear_name])
	gear.a = 0.0 if own else 0.85
	var marked := rng.randf() >= GOBLIN_UNMARKED
	var mark_index := rng.randi() % GOBLIN_MARKS.size()
	var mark := Vector3.ZERO
	if marked:
		mark[mark_index] = 1.0
	var words: Array[String] = []
	if width < 0.95:
		words.append("build=lean")
	elif width > 1.05:
		words.append("build=stocky")
	if skin.z < 0.9:
		words.append("skin=dark")
	elif skin.z > 1.07:
		words.append("skin=pale")
	elif skin.x < -0.03:
		words.append("skin=yellowish")
	elif skin.x > 0.03:
		words.append("skin=bluish")
	if not own:
		words.append("gear=" + gear_name)
	if marked:
		words.append("mark=" + GOBLIN_MARKS[mark_index])
	# Drawn after the rest, so a goblin keeps the look it had before (494 amended).
	var hood := rng.randf() < GOBLIN_HOOD_UP
	var ears := rng.randf_range(-1.0, 1.0)
	if not hood:
		words.append("hood=down")
	if absf(ears) > GOBLIN_EARS_SAID:
		words.append("ears=" + ("big" if ears > 0.0 else "small"))
	return {"width": width, "skin": skin, "gear": gear, "mark": mark, "hood": hood, "ears": ears, "words": " ".join(words)}


## [param entity]'s own look and manner (see MODEL_MASS), on its puppet:
## "model_scale", "pace" (its gaits' paces over the model's), "tempo" and
## "rng", which picks its blows and flinches. A model not sized "by_mass"
## varies its size a little all the same.
static func _vary(entity: GridEntity, puppet: Node3D, model: Dictionary) -> void:
	var rng := RandomNumberGenerator.new()
	rng.seed = hash(String(entity.name))
	var size := 1.0
	if model.get("by_mass", true):
		size = clampf(pow(entity.mass / MODEL_MASS, 1.0 / 3.0), MODEL_SCALE_MIN, MODEL_SCALE_MAX)
	size *= 1.0 + rng.randf_range(-MODEL_SCALE_SPREAD, MODEL_SCALE_SPREAD)
	if model.get("parts", false) or model.has("people"):
		# A person: their look's stature (its pace with it: longer legs, longer strides); a
		# painted ally its stature only (decision 529).
		var look := look_for(entity)
		puppet.set_meta("look", look)
		if not person_words(entity).is_empty():
			puppet.set_meta("person_body", look.body)  # Its voice a person's (_person_body).
		size = look.scale
	puppet.set_meta("model_scale", size)
	puppet.set_meta("pace", size * (1.0 + rng.randf_range(-PACE_SPREAD, PACE_SPREAD)))
	puppet.set_meta("tempo", 1.0 + rng.randf_range(-TEMPO_SPREAD, TEMPO_SPREAD))
	puppet.set_meta("rng", rng)
	var fidget_rng := RandomNumberGenerator.new()
	fidget_rng.seed = hash(String(entity.name)) ^ _session_seed
	puppet.set_meta("fidget_rng", fidget_rng)
	puppet.set_meta("fidget_at", Time.get_ticks_msec() + int(fidget_rng.randf_range(2.0, FIDGET_SECONDS_MAX) * 1000.0))


## One of [param clips], at random, not [param puppet]'s last of them (the
## one there is, when there is one: decision 390's).
static func _pick_clip(puppet: Node3D, clips: Array[String]) -> String:
	var rng: RandomNumberGenerator = puppet.get_meta("rng") if puppet.has_meta("rng") else null
	if rng == null:
		return clips[0]
	var key := "last_" + clips[0]
	var last := str(puppet.get_meta(key, ""))
	var choices := clips.filter(func(clip: String) -> bool: return clip != last)
	if choices.is_empty():
		choices = clips
	var clip: String = choices[rng.randi() % choices.size()]
	puppet.set_meta(key, clip)
	return clip


## One of FIDGETS for [param puppet], by weight, not its last (any with no
## clip in [param rig] left out); "" for none.
static func _pick_fidget(puppet: Node3D, rig: AnimRig) -> String:
	var rng: RandomNumberGenerator = puppet.get_meta("fidget_rng", puppet.get_meta("rng", null))
	var last := str(puppet.get_meta("last_fidget", ""))
	var fidgets: Dictionary = puppet.get_meta("fidgets", FIDGETS)
	var held := in_hand(puppet)
	var total := 0
	for clip: String in fidgets:
		if clip != last and rig.has(clip) and fidget_with(clip, held):
			total += int(fidgets[clip])
	if total == 0:
		return ""
	var roll := rng.randi_range(1, total) if rng != null else 1
	for clip: String in fidgets:
		if clip == last or not rig.has(clip) or not fidget_with(clip, held):
			continue
		roll -= int(fidgets[clip])
		if roll <= 0:
			puppet.set_meta("last_fidget", clip)
			return clip
	return ""


## Whether [param clip] may be fidgeted holding [param held] (the ids in each
## hand, "" empty; a work's piece "art:<slot>"): any with both hands empty,
## else only ARMED_FIDGETS, less the held kinds' ARMED_NOT (662).
## What [param puppet]'s hands hold now: its "held", but a bow on its back
## (662 amended (d)) out of the left, and a sheathed blade and a shield on the
## back (662 (c)) out of both.
static func in_hand(puppet: Node3D) -> Array:
	var held: Array = puppet.get_meta("held", [])
	if str(puppet.get_meta("bow_state", "")) == "stowed" and held.size() == 2:
		return [held[0], ""]
	if str(puppet.get_meta("bow_state", "")) == "sheathed" and held.size() == 2:
		return ["", ""]
	return held


## A guide's beckon (companions' guide_wait, replicated on the Companion: 0 walking or not
## guiding, 1 a look back, 2 waiting at a corner, a door or an exit till he catches up): at 2,
## Beckon_R, or Beckon_L when the right hand holds something; neither with both hands full. Her
## turn to him is the server's facing (shown on a standing body), so at 1 she only turns.
const BECKON_EVERY := 1.6
static func beckon_clip(puppet: Node3D, rig: AnimRig) -> String:
	if int(puppet.get_meta("guide_wait", 0)) != 2:
		return ""
	var held := in_hand(puppet)
	for side: Array in [["Beckon_R", 0], ["Beckon_L", 1]]:
		if (held.size() <= side[1] or str(held[side[1]]) == "") and rig.has(side[0]):
			return side[0]
	return ""


static func fidget_with(clip: String, held: Array) -> bool:
	if held.all(func(id: Variant) -> bool: return str(id) == ""):
		return true
	if clip not in ARMED_FIDGETS:
		return false
	for id: Variant in held:
		if clip in ARMED_NOT.get(str(id), []):
			return false
	return true


## Whether [param puppet]'s monster is sitting (Monster.Pose.SIT).
static func _sitting(puppet: Node3D) -> bool:
	var entity := instance_from_id(int(puppet.get_meta("entity_id", 0))) as Monster
	return entity != null and entity.pose == Monster.Pose.SIT


## Visible work (566, pc-character's side; Jeff: "town people need to be doing
## activities to better the town, chopping wood, going hunting, building a half
## constructed building, sleeping at night"): npc's Resident.activity, a word,
## as the body shows it: the clip it plays standing at the work ("clip"; walking,
## its gait), the tool in its right hand while that hand is empty ("right", an
## art slot: art-kit's tool.*) and in its left ("left": a hunter's bow), the
## load on its shoulder ("shoulder": carry.*),
## an upper-layer clip over its walk and stand ("upper"), lying ("lying"), the
## tool slid down the hand by "grip" metres along its length (its +y; the axe's
## origin is its butt: two-handed, the right hand holds it up the haft and the
## butt is in the left, humanoid_clips.py's CHOP_GRIP and a little over).
