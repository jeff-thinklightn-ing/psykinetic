	"sit": {"clips": ["Sitting_Idle", "Sitting_Idle02", "Sitting_Idle03"], "seat": true,
		"asides": ["Sitting_Idle", "Sitting_Idle02", "Sitting_Idle03"]},
	"sit_talk": {"clip": "Sitting_Talking", "seat": true, "asides": ["Sitting_Idle02", "Sitting_Idle03"]},
