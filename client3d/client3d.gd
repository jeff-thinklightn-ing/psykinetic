	for entry: Dictionary in _terrain.get("lit_candles", []):
		var at: Vector2 = entry["at"]
		var cell := Vector2i(roundi(at.x), roundi(at.y))
		var top := _height_in(cell, at) + float(entry.get("top", 0.0))
