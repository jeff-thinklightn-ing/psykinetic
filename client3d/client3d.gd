## A telegraph [param id] shown on [param cells] (combat's Telegraph.cells:
## the cells that will be hit), from [param from_tick] to [param
## lands_tick] (world ticks); shown again replaces it.
func telegraph_show(id: String, cells: Array, from_tick: int, lands_tick: int, shape: Dictionary = {}) -> void:
	telegraph_drop(id)
	if _cell_quad == null:
		_cell_quad = _flat_mesh([PackedVector2Array([Vector2(-0.5, -0.5), Vector2(0.5, -0.5), Vector2(0.5, 0.5), Vector2(-0.5, 0.5)])])
	var quads: Array[MeshInstance3D] = []
	var struck: Array[Vector2i] = []
	for each: Variant in cells:
		var cell := Vector2i(each) if each is Vector2i or each is Vector2 else (Vector2i(int(each[0]), int(each[1])) if each is Array and each.size() >= 2 else Vector2i(-100000, -100000))
		if cell.x <= -100000:
			continue
		struck.append(cell)
	var outline := telegraph_outline(shape)
	var curtain: MeshInstance3D = null
	if outline.is_empty() or struck.is_empty():
		for cell in struck:
			var quad := _make_flat(_cell_quad, Color(UiTheme.color("danger_ground"), telegraph_strengths(_outdoor, DayNight.light).x))
			_lay_on_ground(quad, cell, ON_FLOOR * 1.5)
			add_child(quad)
			quads.append(quad)
	else:
		# 602 amended (3) (the coordinator's: a warning never understates): the struck cells whole at
		# the fill's alpha, every point a centre is struck from (699), and a soft band fading
		# outside them (telegraph_band_polygons), so no hard red edge reads as a block.
		var fill := _make_flat(_telegraph_ground_mesh(struck), Color(UiTheme.color("danger_ground"), telegraph_strengths(_outdoor, DayNight.light).x))
		(fill.material_override as StandardMaterial3D).vertex_color_use_as_albedo = true
		add_child(fill)
		quads.append(fill)
		# 602 amended (Jeff: "the ground swipe effect shows a 3d block, that looks amateur"): no
		# curtain stands on the edge any more; the fill on the ground is the whole tell.
	_telegraphs[id] = {"quads": quads, "curtain": curtain, "cells": struck, "from": from_tick, "lands": lands_tick, "landed_at": -1}


## Combat's Telegraph.outline for [param shape]: the drawn shape as a
## polygon about the origin cell's centre, in cells, in order round it;
## [] without the class (found by name, so this parses before combat's
## side lands) or a shape that does not read.
static func telegraph_outline(shape: Dictionary) -> PackedVector2Array:
	if shape.is_empty() or not shape.has("origin"):
		return PackedVector2Array()
	for entry: Dictionary in ProjectSettings.get_global_class_list():
		if str(entry.get("class", "")) == "Telegraph":
			var script: Variant = load(str(entry.get("path", "")))
			if script is GDScript and (script as GDScript).has_method("outline"):
				var out: Variant = (script as GDScript).call("outline", shape)
				return out if out is PackedVector2Array else PackedVector2Array()
	return PackedVector2Array()


## The fill: [param outline] (about [param origin], the origin cell) cut to
## each of the [param struck] cells' squares, as polygons in grid units.
## Nothing outside the cells the blow lands on (a wall's clip).
static func telegraph_fill_polygons(outline: PackedVector2Array, origin: Vector2, struck: Array[Vector2i]) -> Array[PackedVector2Array]:
	var out: Array[PackedVector2Array] = []
	for cell in struck:
		var at := Vector2(cell) - origin
		var square := PackedVector2Array([at + Vector2(-0.5, -0.5), at + Vector2(0.5, -0.5), at + Vector2(0.5, 0.5), at + Vector2(-0.5, 0.5)])
		for piece: PackedVector2Array in Geometry2D.intersect_polygons(outline, square):
			if piece.size() < 3 or Geometry2D.is_polygon_clockwise(piece):
				continue
			var shifted := PackedVector2Array()
			for point in piece:
				shifted.append(point + origin)
			out.append(shifted)
	return out


## The curtain's pieces: each segment of [param outline] (closed) whose
## middle lies in a [param struck] cell, as [a, b] in grid units; a full
## ring's two seam segments (between its rims at one angle) are left out.
## A segment of the outer rim (both ends at the outline's longest reach)
## whose middle lies in a cell past the reach (its centre further out than
## the rim, so never struck) stands when the cell half a cell in from it is
## struck: the rim runs at length + Telegraph.REACH_SLACK, through cells
## beyond the struck ones (603 amended (7)'s disc showed two breaks there),
## while a cell within reach that a wall leaves out still cuts it.
static func telegraph_curtain_segments(outline: PackedVector2Array, origin: Vector2, struck: Array[Vector2i]) -> Array[PackedVector2Array]:
	var out: Array[PackedVector2Array] = []
	if outline.size() < 2:
		return out
	var rim := 0.0
	for point in outline:
		rim = maxf(rim, point.length())
	for i in outline.size():
		var a := outline[i]
		var b := outline[(i + 1) % outline.size()]
		if a.is_equal_approx(b):
			continue
		if a.length() > 0.01 and b.length() > 0.01 and absf(angle_difference(a.angle(), b.angle())) < 0.0001 and absf(a.length() - b.length()) > 0.01:
			continue  # A seam between a ring's rims.
		var middle := (a + b) * 0.5 + origin
		var inside := false
		for cell in struck:
			if absf(middle.x - cell.x) <= 0.51 and absf(middle.y - cell.y) <= 0.51:
				inside = true
				break
		if not inside and absf(a.length() - rim) < 0.01 and absf(b.length() - rim) < 0.01 				and (Vector2(Vector2i(middle.round())) - origin).length() > rim:
			# The outer rim over a cell past the reach: it bounds the cell
			# inside it, half a cell in, if that one is struck.
			inside = struck.has(Vector2i((origin + (middle - origin) * (1.0 - 0.5 / rim)).round()))
		if inside:
			out.append(PackedVector2Array([a + origin, b + origin]))
	return out


## [param polygons] (grid units) as one mesh on the ground, each vertex at
## the ground's height under it plus a hair.
## [param struck] closed (602 amended (4), the coordinator's rule: every
## struck cell covered whole, no unstruck cell's centre covered): in each
## unstruck cell beside them that [param floor_ok] calls floor, at each
## corner where the cells straight across both its edges there are struck
## and [param passable] lets through both edges (a wall or the drop never
## bridged), the corner's quarter outside the cell's inscribed circle. A
## cell struck all round (a hole) is skipped: it stays open. A convex
## corner is never rounded (a block of cells keeps its square corners).
## [{cell, polygon}], grid units, anticlockwise.
static func telegraph_fillets(struck: Array[Vector2i], floor_ok: Callable, passable: Callable) -> Array[Dictionary]:
	var hit := {}
	for cell in struck:
		hit[cell] = true
	var sides: Array[Vector2i] = [Vector2i(1, 0), Vector2i(-1, 0), Vector2i(0, 1), Vector2i(0, -1)]
	var out: Array[Dictionary] = []
	var seen := {}
	for each in struck:
		for way in sides:
			var near := each + way
			if hit.has(near) or seen.has(near):
				continue
			seen[near] = true
			if not bool(floor_ok.call(near)):
				continue
			var round_it := 0
			for side in sides:
				if hit.has(near + side):
					round_it += 1
			if round_it == 4:
				continue  # A hole: closing skips it.
			for corner: Vector2i in [Vector2i(1, 1), Vector2i(1, -1), Vector2i(-1, 1), Vector2i(-1, -1)]:
				var across_x := Vector2i(corner.x, 0)
				var across_y := Vector2i(0, corner.y)
				if hit.has(near + across_x) and hit.has(near + across_y) \
						and bool(passable.call(near, across_x)) and bool(passable.call(near, across_y)):
					out.append({"cell": near, "polygon": _fillet(near, corner)})
	return out


## [param cell]'s [param corner] (a diagonal) outside its inscribed circle:
## the corner, the two edges' midpoints and the arc between, anticlockwise.
static func _fillet(cell: Vector2i, corner: Vector2i) -> PackedVector2Array:
	var centre := Vector2(cell)
	var from := Vector2(corner.x, 0.0).angle()
	var to := Vector2(0.0, corner.y).angle()
	var points := PackedVector2Array([centre + Vector2(corner) * 0.5])
	for i in TELEGRAPH_ARC_STEPS + 1:
		points.append(centre + Vector2.from_angle(lerp_angle(from, to, float(i) / TELEGRAPH_ARC_STEPS)) * 0.5)
	if Geometry2D.is_polygon_clockwise(points):
		points.reverse()
	return points


## How far [param point] lies from the closed mark (602 amended (4)): 0 on
## a struck cell's square or a fillet, else the nearest of them.
static func telegraph_closed_distance(point: Vector2, struck: Array[Vector2i], fillets: Array[Dictionary] = []) -> float:
	var nearest := INF
	for cell in struck:
		var off := ((point - Vector2(cell)).abs() - Vector2(0.5, 0.5)).max(Vector2.ZERO)
		nearest = minf(nearest, off.length())
	for fillet: Dictionary in fillets:
		var polygon: PackedVector2Array = fillet["polygon"]
		if nearest <= 0.0:
			break
		if (Vector2(Vector2i(fillet["cell"])) - point).length() > 1.0 + nearest:
			continue
		if Geometry2D.is_point_in_polygon(point, polygon):
			return 0.0
		for i in polygon.size():
			var on := Geometry2D.get_closest_point_to_segment(point, polygon[i], polygon[(i + 1) % polygon.size()])
			nearest = minf(nearest, (on - point).length())
	return nearest


## The feathered band outside [param struck] (602 amended (3)): in each
## cell beside them that [param floor_ok] (a cell) calls floor, the part
## within [param feather] of a struck cell's square that reaches it
## straight across an edge [param passable] (a cell and a way) lets
## through, or across a corner with floor on both sides, each part once
## (no two overlapping, so the fade never doubles). With [param fillets]
## (602 amended (4)), the cell's own fillets are its sources too, and none
## of the band lies on them. [{cell, polygon}], in grid units.
static func telegraph_band_polygons(struck: Array[Vector2i], feather: float, floor_ok: Callable, passable: Callable,
		fillets: Array[Dictionary] = []) -> Array[Dictionary]:
	var own := {}
	for fillet: Dictionary in fillets:
		var at := Vector2i(fillet["cell"])
		if not own.has(at):
			own[at] = []
		own[at].append(fillet["polygon"])
	var hit := {}
	for cell in struck:
		hit[cell] = true
	var out: Array[Dictionary] = []
	var seen := {}
	for each in struck:
		for dy in [-1, 0, 1]:
			for dx in [-1, 0, 1]:
				var near := each + Vector2i(dx, dy)
				if hit.has(near) or seen.has(near):
					continue
				seen[near] = true
				if not bool(floor_ok.call(near)):
					continue
				var square := _cell_square(near)
				var pieces: Array[PackedVector2Array] = []
				var grown_before: Array[PackedVector2Array] = []
				for way: Vector2i in [Vector2i(1, 0), Vector2i(-1, 0), Vector2i(0, 1), Vector2i(0, -1),
						Vector2i(1, 1), Vector2i(1, -1), Vector2i(-1, 1), Vector2i(-1, -1)]:
					var from := near + way
					if not hit.has(from):
						continue
					if way.x != 0 and way.y != 0:
						if not (bool(floor_ok.call(near + Vector2i(way.x, 0))) and bool(floor_ok.call(near + Vector2i(0, way.y)))):
							continue
					elif not bool(passable.call(near, way)):
						continue
					var grown: PackedVector2Array = Geometry2D.offset_polygon(_cell_square(from), feather, Geometry2D.JOIN_ROUND)[0]
					var parts: Array[PackedVector2Array] = []
					for part: PackedVector2Array in Geometry2D.intersect_polygons(square, grown):
						if part.size() >= 3 and not Geometry2D.is_polygon_clockwise(part):
							parts.append(part)
					for earlier in grown_before:
						var left: Array[PackedVector2Array] = []
						for part in parts:
							for rest: PackedVector2Array in Geometry2D.clip_polygons(part, earlier):
								if rest.size() >= 3 and not Geometry2D.is_polygon_clockwise(rest):
									left.append(rest)
						parts = left
					pieces.append_array(parts)
					grown_before.append(grown)
				for filled: PackedVector2Array in own.get(near, []):
					# Its own fillet's band (602 amended (4)), then nothing on a fillet.
					var grown: PackedVector2Array = Geometry2D.offset_polygon(filled, feather, Geometry2D.JOIN_ROUND)[0]
					var parts: Array[PackedVector2Array] = []
					for part: PackedVector2Array in Geometry2D.intersect_polygons(square, grown):
						if part.size() >= 3 and not Geometry2D.is_polygon_clockwise(part):
							parts.append(part)
					for earlier in grown_before:
						var left: Array[PackedVector2Array] = []
						for part in parts:
							for rest: PackedVector2Array in Geometry2D.clip_polygons(part, earlier):
								if rest.size() >= 3 and not Geometry2D.is_polygon_clockwise(rest):
									left.append(rest)
						parts = left
					pieces.append_array(parts)
					grown_before.append(grown)
				for filled: PackedVector2Array in own.get(near, []):
					var left: Array[PackedVector2Array] = []
					for piece in pieces:
						for rest: PackedVector2Array in Geometry2D.clip_polygons(piece, filled):
							if rest.size() >= 3 and not Geometry2D.is_polygon_clockwise(rest):
								left.append(rest)
					pieces = left
				for piece in pieces:
					out.append({"cell": near, "polygon": piece})
	return out


## [param cell]'s square, in grid units, anticlockwise.
static func _cell_square(cell: Vector2i) -> PackedVector2Array:
	var at := Vector2(cell)
	return PackedVector2Array([at + Vector2(-0.5, -0.5), at + Vector2(0.5, -0.5), at + Vector2(0.5, 0.5), at + Vector2(-0.5, 0.5)])


## A point's alpha in the band (602 amended (3)): 1 on a struck cell's
## square (or a fillet, 602 amended (4)), falling to 0 at [param feather]
## from the nearest.
static func telegraph_band_alpha(point: Vector2, struck: Array[Vector2i], feather: float, fillets: Array[Dictionary] = []) -> float:
	var nearest := telegraph_closed_distance(point, struck, fillets)
	return clampf(1.0 - nearest / feather, 0.0, 1.0) if feather > 0.0 else (1.0 if nearest <= 0.0 else 0.0)


## A telegraph's ground (602 amended (3)): [param struck]'s squares whole,
## alpha 1 in the vertex colour, closed (602 amended (4): telegraph_fillets,
## alpha 1 too), and the band outside them fading to 0
## (telegraph_band_polygons, the floor and the edges as World has them),
## each piece at its own cell's height.
func _telegraph_ground_mesh(struck: Array[Vector2i]) -> ArrayMesh:
	var surface := SurfaceTool.new()
	surface.begin(Mesh.PRIMITIVE_TRIANGLES)
	var floor_ok := func(cell: Vector2i) -> bool: return World.is_walkable(cell)
	var passable := func(cell: Vector2i, way: Vector2i) -> bool: return not World.edge_blocks(cell, way)
	var fillets := telegraph_fillets(struck, floor_ok, passable)
	var pieces: Array[Dictionary] = []
	for cell in struck:
		pieces.append({"cell": cell, "polygon": _cell_square(cell)})
	pieces.append_array(fillets)
	pieces.append_array(telegraph_band_polygons(struck, TELEGRAPH_FEATHER, floor_ok, passable, fillets))
	for piece: Dictionary in pieces:
		var polygon: PackedVector2Array = piece["polygon"]
		var cell: Vector2i = piece["cell"]
		for index in Geometry2D.triangulate_polygon(polygon):
			var point := polygon[index]
			surface.set_color(Color(1.0, 1.0, 1.0, telegraph_band_alpha(point, struck, TELEGRAPH_FEATHER, fillets)))
			surface.set_normal(Vector3.UP)
			surface.add_vertex(Vector3(point.x, _height_in(cell, point) + ON_FLOOR * 1.5, point.y))
	return surface.commit()


func _ground_polygons_mesh(polygons: Array[PackedVector2Array]) -> ArrayMesh:
	var surface := SurfaceTool.new()
	surface.begin(Mesh.PRIMITIVE_TRIANGLES)
	for polygon in polygons:
		var indices := Geometry2D.triangulate_polygon(polygon)
		for index in indices:
			var point := polygon[index]
			surface.set_normal(Vector3.UP)
			surface.add_vertex(Vector3(point.x, _height_in(Vector2i(point.round()), point) + ON_FLOOR * 1.5, point.y))
	return surface.commit()


## [param segments] ([a, b] each, grid units) as a curtain TELEGRAPH_CURTAIN
## tall standing on the ground along them.
func _curtain_mesh(segments: Array[PackedVector2Array]) -> ArrayMesh:
	var surface := SurfaceTool.new()
	surface.begin(Mesh.PRIMITIVE_TRIANGLES)
	for segment in segments:
		var a := segment[0]
		var b := segment[1]
		var foot_a := Vector3(a.x, _height_in(Vector2i(a.round()), a) + ON_FLOOR * 1.5, a.y)
		var foot_b := Vector3(b.x, _height_in(Vector2i(b.round()), b) + ON_FLOOR * 1.5, b.y)
		var quad: Array[Vector3] = [foot_a, foot_b, foot_b + Vector3.UP * TELEGRAPH_CURTAIN, foot_a + Vector3.UP * TELEGRAPH_CURTAIN]
		for j: int in [0, 1, 2, 0, 2, 3]:
			surface.set_normal(Vector3.UP)
			surface.add_vertex(quad[j])
	return surface.commit()


## Telegraph [param id] ended: [param landed] true flashes it and lets it
## go; false (called off) takes it away at once.
## A telegraph begun by a creature drawn through a CreatureView (780 amended (6): the great
## bear's swipe, slam and charge): its tell, landing on the telegraph's lands tick. [param data]
## is the "telegraph" message's {source, kind, lands_tick}.
func creature_tell(id: int, data: Dictionary) -> void:
	var source := get_node_or_null(NodePath(str(data.get("source", "")))) if str(data.get("source", "")) != "" else null
	if source == null:
		return
	var puppet: Node3D = _puppets.get(source.get_instance_id())
	if puppet == null or not puppet.has_meta("creature_view"):
		return
	var lands_in := (int(data.get("lands_tick", World.tick)) - World.tick) * World.TICK_DT
	if (puppet.get_meta("creature_view") as CreatureView).tell(str(data.get("kind", "")), lands_in, id):
		_tells[id] = puppet


## Telegraph [param id] over: the tell it began ends (cut short when it did not land).
func creature_tell_over(id: int, landed: bool) -> void:
	var puppet: Node3D = _tells.get(id)
	_tells.erase(id)
	if puppet != null and is_instance_valid(puppet) and puppet.has_meta("creature_view"):
		(puppet.get_meta("creature_view") as CreatureView).tell_over(id, landed)


func telegraph_land(id: String, landed: bool) -> void:
	if not _telegraphs.has(id):
		return
	if landed:
		_telegraphs[id]["landed_at"] = Time.get_ticks_msec()
	else:
		telegraph_drop(id)


func telegraph_drop(id: String) -> void:
	if not _telegraphs.has(id):
		return
	for quad: MeshInstance3D in _telegraphs[id]["quads"]:
		quad.queue_free()
	var curtain: MeshInstance3D = _telegraphs[id].get("curtain")
	if curtain != null:
		curtain.queue_free()
	_telegraphs.erase(id)


## Each frame at world [param tick]: every telegraph's fill, the flash of
## one landed, gone after TELEGRAPH_FLASH_MSEC.
func telegraph_tick(tick: int) -> void:
	var now := Time.get_ticks_msec()
	for id: String in _telegraphs.keys():
		var entry: Dictionary = _telegraphs[id]
		var alpha: float
		if int(entry["landed_at"]) >= 0:
			if now - int(entry["landed_at"]) > telegraph_flash_msec:
				telegraph_drop(id)
				continue
			alpha = telegraph_flash
		else:
			var strengths := telegraph_strengths(_outdoor, DayNight.light)
			alpha = lerpf(strengths.x, strengths.y, telegraph_fill(int(entry["from"]), int(entry["lands"]), tick))
		for quad: MeshInstance3D in entry["quads"]:
			var material := quad.material_override as StandardMaterial3D
			if material != null:
				material.albedo_color = Color(UiTheme.color("danger_ground"), alpha)
		var curtain: MeshInstance3D = entry.get("curtain")
		if curtain != null and curtain.material_override is StandardMaterial3D:
			(curtain.material_override as StandardMaterial3D).albedo_color = Color(UiTheme.color("danger_ground"), curtain_alpha(alpha))


## The curtain's alpha for the fill's [param alpha]: TELEGRAPH_CURTAIN_ALPHA
## times it, TELEGRAPH_LOW_BOOST more under a pitch below TELEGRAPH_LOW_PITCH.
func curtain_alpha(alpha: float) -> float:
	return clampf(alpha * TELEGRAPH_CURTAIN_ALPHA * (TELEGRAPH_LOW_BOOST if pitch < TELEGRAPH_LOW_PITCH else 1.0), 0.0, 1.0)


## A telegraph fill's faint and full alpha (x, y) (602 amended (3)):
## indoors TELEGRAPH_INDOORS; out of doors from TELEGRAPH_NIGHT to
## TELEGRAPH_DAY as [param light] (DayNight.light, the open sky's: NIGHT to
## 1) rises.
static func telegraph_strengths(outdoor: bool, light: float) -> Vector2:
	if not outdoor:
		return TELEGRAPH_INDOORS
	return TELEGRAPH_NIGHT.lerp(TELEGRAPH_DAY, clampf(inverse_lerp(DayNight.NIGHT, 1.0, light), 0.0, 1.0))


## How far a telegraph has run (0 to 1) from [param from_tick] to [param
## lands_tick] at [param tick]; 1 when the window is empty.
static func telegraph_fill(from_tick: int, lands_tick: int, tick: int) -> float:
	return 1.0 if lands_tick <= from_tick else clampf(float(tick - from_tick) / float(lands_tick - from_tick), 0.0, 1.0)


## The telegraphs shown (tests).
func telegraphs_shown() -> int:
	return _telegraphs.size()


## The aim lead on or off: [param way] the aim's direction on the grid
## (unit), the target AIM_LEAD_CELLS that way while [param on].
func aim_lead(way: Vector2, on: bool) -> void:
	_aim_lead_to = Vector3(way.x, 0.0, way.y) * aim_lead_cells if on and way.length() > 0.0 else Vector3.ZERO


## The view's offset from the archer: the WASD lean plus the aim lead, the
## two together held to AIM_LEAD_CELLS once the lead is on (the lean alone
## as ever when it is not).
static func lead_offset(lean: Vector2, aim: Vector3, most := AIM_LEAD_CELLS) -> Vector3:
	var lean3 := Vector3(lean.x, 0.0, lean.y)
	if aim == Vector3.ZERO:
		return lean3
	return (lean3 + aim).limit_length(most)


## The bow's aim while drawn: the arc round [param origin] (the archer's
## grid point), its middle at [param angle] (radians on the grid, x as 0),
## at [param radius] cells; the marker on it at the angle; [param pips]
## beside the marker, across the aim; all at [param alpha] (the fade-in);
## [param show] false hides it all. With [param spread] (the sim's
## half-angle, radians; below 0 for none) the arc is the far end of the
## cone of flight, a wedge from the archer that long and that wide, its
## drawn half-angle eased toward the sim's over a tick.
func aim_arc(origin: Vector2, angle: float, radius: float, alpha: float, pips: int, show: bool, spread := -1.0,
		full := -1.0) -> void:
	_aim_arc.visible = show and radius > 0.0
	_aim_mark.visible = _aim_arc.visible
	_aim_full_mark.visible = _aim_arc.visible and full > 0.0 and full < radius
	for i in _aim_pips.size():
		_aim_pips[i].visible = _aim_arc.visible and i < pips
	var cone := _aim_arc.visible and spread >= 0.0
	_aim_cone.visible = cone
	_aim_cone_rim.visible = cone
	if not _aim_arc.visible:
		_aim_cone_shown = -1.0
		return
	_aim_cone_shown = eased_spread(_aim_cone_shown, spread, get_process_delta_time(), aim_cone_ease_ticks) if cone else -1.0
	var span := _aim_cone_shown if cone else PI * 0.5
	var lift := edge_lift()
	var moved := absf(radius - _aim_arc_radius) > 0.01 or absf(angle - _aim_arc_angle) > 0.002 or absf(span - _aim_arc_span) > 0.0005 \
			or absf(lift - _aim_arc_lift) > 0.001
	var cell := Vector2i(origin.round())
	var base := _height_in(cell, origin)
	var centre := Vector3(origin.x, base + ON_FLOOR * 2.0, origin.y)
	if moved or origin != _aim_arc_origin:
		_aim_arc_radius = radius
		_aim_arc_angle = angle
		_aim_arc_span = span
		_aim_arc_lift = lift
		_aim_arc_origin = origin
		_aim_arc.mesh = _ground_arc_mesh(origin, radius, AIM_LINE, angle, span, base)
	_aim_arc.position = centre + Vector3.UP * lift
	_aim_arc.rotation = Vector3.ZERO  # The mesh carries the angle (_make_arc).
	_tint_aim(_aim_arc, alpha * 0.8)
	if cone:
		if moved or _aim_cone.position != centre:
			_aim_cone.mesh = _cone_mesh(origin, angle, radius, span, base)
			_aim_cone_rim.mesh = _cone_rim_mesh(origin, angle, radius, span, base, lift)
		_aim_cone.position = centre
		_aim_cone_rim.position = centre
		_tint_aim(_aim_cone, alpha * (AIM_CONE_FILL_LOW if lift > 0.0 else AIM_CONE_FILL))
		_tint_aim(_aim_cone_rim, alpha * 0.8)
	var way := Vector2.from_angle(angle)
	var point := origin + way * radius
	var at := Vector3(point.x, _height_in(Vector2i(point.round()), point) + ON_FLOOR * 3.0, point.y)
	_aim_mark.position = at
	_tint_aim(_aim_mark, alpha * 0.95)
	if _aim_full_mark.visible:
		var edge := origin + way * full
		_aim_full_mark.position = Vector3(edge.x, _height_in(Vector2i(edge.round()), edge) + ON_FLOOR * 3.0, edge.y)
		_tint_aim(_aim_full_mark, alpha * 0.8)
	# The pips in a row across the aim, just past the marker, centred on it.
	var across := Vector2(-way.y, way.x)
	for i in pips:
		if i >= _aim_pips.size():
			break
		var offset := across * ((i - (pips - 1) * 0.5) * AIM_PIP_GAP) + way * (AIM_MARK + AIM_PIP_GAP)
		var p := point + offset
		_aim_pips[i].position = Vector3(p.x, _height_in(Vector2i(p.round()), p) + ON_FLOOR * 3.0, p.y)
		_tint_aim(_aim_pips[i], alpha * 0.95)


## How far the cone's edges stand off the ground: AIM_EDGE_LIFT under a
## camera pitched below AIM_LOW_PITCH, else none.
func edge_lift() -> float:
	return AIM_EDGE_LIFT if pitch < AIM_LOW_PITCH else 0.0


## The drawn half-angle this frame: [param target] at once from none
## ([param shown] below 0), else [param shown] eased toward it over
## AIM_CONE_EASE_TICKS of the sim's ticks ([param delta] seconds this frame).
static func eased_spread(shown: float, target: float, delta: float, ticks := AIM_CONE_EASE_TICKS) -> float:
	if shown < 0.0 or target < 0.0:
		return target
	return shown + (target - shown) * clampf(delta / (World.TICK_DT * ticks), 0.0, 1.0)


## The cone's far end: AIM_SEGMENTS + 1 grid points at [param radius] from
## [param origin], from [param angle] - [param half] to [param angle] +
## [param half].
static func cone_points(origin: Vector2, angle: float, radius: float, half: float) -> PackedVector2Array:
	var out := PackedVector2Array()
	for i in AIM_SEGMENTS + 1:
		out.append(origin + Vector2.from_angle(angle - half + 2.0 * half * i / AIM_SEGMENTS) * radius)
	return out


## A grid point of the cone as a vertex relative to the archer's cell at
## [param base] height: on the ground under it (a wedge over a slope follows it).
func _cone_vertex(origin: Vector2, point: Vector2, base: float, lift: float) -> Vector3:
	return Vector3(point.x - origin.x, _height_in(Vector2i(point.round()), point) - base + lift, point.y - origin.y)


## How many pieces an arc [param length] cells long is drawn in: AIM_STRIP
## a piece, AIM_SEGMENTS at least.
static func arc_pieces(length: float) -> int:
	return maxi(AIM_SEGMENTS, ceili(length / AIM_STRIP))


## The aim's ring on the ground: the band [param radius] to its middle and
## [param line] wide, [param span] either side of [param angle], as a strip
## of quads AIM_STRIP long at most, each corner on the ground under it,
## relative to the archer's cell at [param base] (_cone_vertex). The node
## carries the floor bias and the low camera's lift (aim_arc).
func _ground_arc_mesh(origin: Vector2, radius: float, line: float, angle: float, span: float, base: float) -> ArrayMesh:
	var surface := SurfaceTool.new()
	surface.begin(Mesh.PRIMITIVE_TRIANGLES)
	var inner := radius - line * 0.5
	var outer := radius + line * 0.5
	var pieces := arc_pieces(2.0 * span * radius)
	for i in pieces:
		var a0 := angle - span + 2.0 * span * i / pieces
		var a1 := angle - span + 2.0 * span * (i + 1) / pieces
		var quad: Array[Vector3] = [_cone_vertex(origin, origin + Vector2.from_angle(a0) * inner, base, 0.0),
			_cone_vertex(origin, origin + Vector2.from_angle(a0) * outer, base, 0.0),
			_cone_vertex(origin, origin + Vector2.from_angle(a1) * outer, base, 0.0),
			_cone_vertex(origin, origin + Vector2.from_angle(a1) * inner, base, 0.0)]
		for j: int in [0, 1, 2, 0, 2, 3]:
			surface.set_normal(Vector3.UP)
			surface.add_vertex(quad[j])
	return surface.commit()


## The cone's fill: rings AIM_STRIP apart from the archer to its far end,
## each ring's points AIM_STRIP apart at most, every vertex on the ground
## under it, so the wedge lies on whatever ground rises or falls between.
func _cone_mesh(origin: Vector2, angle: float, radius: float, half: float, base: float) -> ArrayMesh:
	var surface := SurfaceTool.new()
	surface.begin(Mesh.PRIMITIVE_TRIANGLES)
	var rings := maxi(ceili(radius / AIM_STRIP), 1)
	var pieces := arc_pieces(2.0 * half * radius)
	var apex := Vector3(0.0, ON_FLOOR, 0.0)
	var last: Array[Vector3] = []
	for r in range(1, rings + 1):
		var ring: Array[Vector3] = []
		for i in pieces + 1:
			var point := origin + Vector2.from_angle(angle - half + 2.0 * half * i / pieces) * (radius * r / rings)
			ring.append(_cone_vertex(origin, point, base, ON_FLOOR))
		for i in pieces:
			var corners: Array[Vector3] = []
			if r == 1:
				corners.assign([apex, ring[i], ring[i + 1]])
			else:
				corners.assign([last[i], ring[i], ring[i + 1], last[i], ring[i + 1], last[i + 1]])
			for vertex in corners:
				surface.set_normal(Vector3.UP)
				surface.add_vertex(vertex)
		last = ring
	return surface.commit()


## The cone's two sides as lines AIM_LINE wide from the archer to the far
## end's corners, a piece AIM_STRIP long so each follows the ground,
## [param lift] above it.
func _cone_rim_mesh(origin: Vector2, angle: float, radius: float, half: float, base: float, lift := 0.0) -> ArrayMesh:
	var surface := SurfaceTool.new()
	surface.begin(Mesh.PRIMITIVE_TRIANGLES)
	var pieces := maxi(ceili(radius / AIM_STRIP), 1)
	for side: float in [-1.0, 1.0]:
		var way := Vector2.from_angle(angle + side * half)
		var across := Vector2(-way.y, way.x) * AIM_LINE * 0.5
		for i in pieces:
			var a := origin + way * (radius * i / pieces)
			var b := origin + way * (radius * (i + 1) / pieces)
			var quad: Array[Vector3] = [_cone_vertex(origin, a - across, base, ON_FLOOR * 1.5 + lift), _cone_vertex(origin, b - across, base, ON_FLOOR * 1.5 + lift),
				_cone_vertex(origin, b + across, base, ON_FLOOR * 1.5 + lift), _cone_vertex(origin, a + across, base, ON_FLOOR * 1.5 + lift)]
			for j: int in [0, 1, 2, 0, 2, 3]:
				surface.set_normal(Vector3.UP)
				surface.add_vertex(quad[j])
	return surface.commit()


func _tint_aim(flat: MeshInstance3D, alpha: float) -> void:
	var material := flat.material_override as StandardMaterial3D
	if material != null:
		material.albedo_color = Color(UiTheme.color("brass_bright"), clampf(alpha, 0.0, 1.0))


## A bow's draw read in the world (decision 475, ui's): the hover ring and
## the outline tighten and brighten as [param fraction] (World.draw_of, 0 to
## 1) completes: the ring half again as wide and dim at the start, the
## cell's own size in brass_bright at a full draw; the outline's passes
## nudged wider and paler at the start, their own width and brass at the
## end. [param fraction] below 0: the plain look (no draw).
func draw_look(fraction: float) -> void:
	var drawing := fraction >= 0.0
	var k := 1.0 if not drawing else 1.0 + 0.6 * (1.0 - clampf(fraction, 0.0, 1.0))
	_hover.scale = Vector3(k, 1.0, k)
	var ring_material := _hover.material_override as StandardMaterial3D
	if ring_material != null:
		var brass := UiTheme.color("brass_bright")
		ring_material.albedo_color = HOVER if not drawing else HOVER.lerp(Color(brass, 0.9), clampf(fraction, 0.0, 1.0))
	var pass_ := _outline
	while pass_ != null:
		var nudge: Vector2 = pass_.get_shader_parameter("nudge")
		if nudge.length() > 0.0:
			pass_.set_shader_parameter("nudge", nudge.normalized() * TARGET_PIXELS * k)
		pass_.set_shader_parameter("colour", TARGET_OUTLINE if not drawing
				else TARGET_OUTLINE.lerp(UiTheme.color("brass_bright"), clampf(fraction, 0.0, 1.0)))
		pass_ = pass_.next_pass as ShaderMaterial


## Outlines [param entity] as the one the next click attacks, and nothing
## else (null: none).
func target(entity: GridEntity) -> void:
	var puppet: Node3D = _puppets.get(entity.get_instance_id()) if entity != null else null
	if puppet == _outlined:
		return
	_show_outline(_outlined, false)
	_outlined = puppet
	_show_outline(puppet, true)


## [param puppet]'s outline shown or hidden: its body's meshes with the
## outline's passes over them and marking the stencil, or as they were.
func _show_outline(puppet: Node3D, show: bool, rim: ShaderMaterial = null) -> void:
	if puppet == null or not is_instance_valid(puppet):
		return
	var body := puppet.get_node_or_null("Body") as Node3D
	if body == null:
		return
	var meshes := body.find_children("*", "MeshInstance3D", true, false)
	if body is MeshInstance3D:
		meshes.append(body)
	# The wet overlay (775) passes on to the outline, so neither takes the other's place.
	var outline: Material = (rim if rim != null else _outline) if show else null
	puppet.set_meta("outline", outline)
	for source: MeshInstance3D in meshes:
		source.material_overlay = WetLook.overlay(puppet, outline, puppet.get_meta("wet_on", false))
		_mark_stencil(source, show)


## A hidden body's passes drawn through what hides it (THROUGH_PLAYER):
## first the fill over its hidden part ([param core], its pixels marked),
## then the rim's eight nudged copies ([param rim]) round it only.
func _through_passes(core: Shader, rim: Shader, colours: Array[Color]) -> ShaderMaterial:
	var after: ShaderMaterial = null
	for way: Vector2i in World.DIRECTIONS:
		var pass_ := ShaderMaterial.new()
		pass_.shader = rim
		pass_.set_shader_parameter("colour", colours[1])
		pass_.set_shader_parameter("nudge", Vector2(way).normalized() * TARGET_PIXELS)
		pass_.set_shader_parameter("nearer", OUTLINE_NEARER)
		pass_.next_pass = after
		after = pass_
	var fill := ShaderMaterial.new()
	fill.shader = core
	fill.set_shader_parameter("colour", colours[0])
	fill.set_shader_parameter("nearer", OUTLINE_NEARER)
	fill.next_pass = after
	return fill


## Each frame: the foes seen through what hides them (SEEN_OUTLINE). The
## marked target keeps its own rim, drawn through what hides it outdoors
## (623 amended (5): nothing there fades for it), red (THROUGH_TARGET); the
## player and their companion hidden outdoors theirs (THROUGH_PLAYER).
func _update_seen_through() -> void:
	if _camera == null:
		return
	var now := Time.get_ticks_msec()
	for id: int in _puppets:
		var puppet := _puppets[id]
		var had := puppet.has_meta("seen_through")
		if puppet == _outlined:
			if had:
				puppet.remove_meta("seen_through")  # Its target's rim is on it now (target()).
			var rim := _target_through if _outdoor and puppet.visible and _body_hidden(puppet) else _outline
			if puppet.get_meta("outline", null) != rim:
				_show_outline(puppet, true, rim)
			continue
		var entity := instance_from_id(id) as GridEntity
		var seen := false
		var rim := _seen_through
		if entity is Monster and entity.spawned and entity.hp > 0 and not _far.has(id) and puppet.visible:
			var alert: Monster.Alert = (entity as Monster).alert
			var fights: bool = alert == Monster.Alert.FIGHTING or alert == Monster.Alert.HUNTING \
					or now - _combat_at.get(id, -100000) < COMBAT_SECONDS * 1000.0
			seen = in_telegraph(entity.tile) or (fights and hidden_by_body(puppet, id))
		elif entity is Player and entity.owner_peer == Net.local_id and puppet.visible:
			# The player hidden outdoors (801): what hides them stays as it
			# is (a landmark never fades, Level.FADES_ON_LINE), their rim
			# shows through it until the camera's turn brings them back.
			seen = _outdoor and _player_hidden
			rim = _player_through
		elif entity is Companion and entity.keeper_peer == Net.local_id and puppet.visible:
			seen = _outdoor and _companion_hidden  # Their companion as they are (623 amended (5)).
			rim = _companion_through
		if seen != had:
			if seen:
				puppet.set_meta("seen_through", true)
			else:
				puppet.remove_meta("seen_through")
			_show_outline(puppet, seen, rim)


## Outdoors: whether something standing (_point_blocked) hides [param
## puppet]'s chest from the camera, not counting what is see-through now.
func _body_hidden(puppet: Node3D) -> bool:
	var chest := puppet.global_position + Vector3.UP * (float(puppet.get_meta("pick_height", 1.0)) * 0.6)
	return _point_blocked(chest, _camera.global_transform.basis.z, _see_through_now(_faded_close))


## Whether a body (a pick shape with an entity, not [param id]'s own)
## stands between the camera and [param puppet]'s chest. Walls, doors and
## the ground are not asked: a wall that hides a foe fades instead.
func hidden_by_body(puppet: Node3D, id: int) -> bool:
	var chest := puppet.global_position + Vector3.UP * (float(puppet.get_meta("pick_height", 1.0)) * 0.6)
	var ahead := -_camera.global_transform.basis.z
	var origin := _camera.global_position if _camera.projection == Camera3D.PROJECTION_PERSPECTIVE else chest - ahead * CAMERA_DISTANCE * 3.0
	var query := PhysicsRayQueryParameters3D.create(origin, chest)
	query.collide_with_areas = true
	query.collide_with_bodies = false
	var space := get_world_3d().direct_space_state
	var exclude: Array[RID] = []
	for i in PICK_DEPTH:
		query.exclude = exclude
		var hit := space.intersect_ray(query)
		if hit.is_empty():
			return false
		var area: Area3D = hit["collider"]
		if area.has_meta("entity"):
			var other := int(area.get_meta("entity"))
			if other == id:
				return false
			var body := instance_from_id(other) as GridEntity
			if body != null and body.spawned:
				return true
		exclude.append(hit["rid"])
	return false


## Whether [param tile] lies in an active telegraph (shown, not yet landed).
func in_telegraph(tile: Vector2i) -> bool:
	for entry: Dictionary in _telegraphs.values():
		if int(entry["landed_at"]) < 0 and tile in entry["cells"]:
			return true
	return false


## [param source] drawn with its materials' copies that mark the stencil
## (OUTLINE_STENCIL) where it draws, or ([param mark] false) with its own
## again, its surfaces' own overrides too (a painted ally's paint, the
## palette: put back, not cleared, or a body unmarked, as one is when it
## dies, went white). The copies look the same.
func _mark_stencil(source: MeshInstance3D, mark: bool) -> void:
	if not mark:
		if source.has_meta("own_override"):
			source.material_override = source.get_meta("own_override")
			source.remove_meta("own_override")
			var own_surfaces: Array = source.get_meta("own_surfaces", [])
			for surface in source.get_surface_override_material_count():
				source.set_surface_override_material(surface, own_surfaces[surface] if surface < own_surfaces.size() else null)
			source.remove_meta("own_surfaces")
		return
	if source.has_meta("own_override"):
		return
	source.set_meta("own_override", source.material_override)
	var kept: Array[Material] = []
	for surface in source.get_surface_override_material_count():
		kept.append(source.get_surface_override_material(surface))
	source.set_meta("own_surfaces", kept)
	if source.material_override != null:
		source.material_override = _marking_copy(source.material_override)
		return
	for surface in source.get_surface_override_material_count():
		var own := source.get_active_material(surface)
		if own != null:
			source.set_surface_override_material(surface, _marking_copy(own))


## [param material]'s copy that marks the stencil as it draws (cached).
func _marking_copy(material: Material) -> Material:
	if not _marking.has(material):
		var copy := material.duplicate() as Material
		if copy is BaseMaterial3D:
			copy.stencil_mode = BaseMaterial3D.STENCIL_MODE_CUSTOM
			copy.stencil_flags = BaseMaterial3D.STENCIL_FLAG_WRITE
			copy.stencil_compare = BaseMaterial3D.STENCIL_COMPARE_ALWAYS
			copy.stencil_reference = OUTLINE_STENCIL
		elif copy is ShaderMaterial and (material as ShaderMaterial).shader != null:
			(copy as ShaderMaterial).shader = _marking_shader((material as ShaderMaterial).shader)
		_marking[material] = copy
	return _marking[material]


## [param shader]'s twin that marks the stencil as it draws (cached): the
## goblin's own file, else its code with the stencil's line put in after
## its first (the human body's, Jeff on v0.1.187: "mousing over or left
## clicking an enemy causes their whole model to go white translucent": a
## robber's body marked nothing, so the outline's passes drew over all of
## it, not round it). A shader that sets its own stencil, or is not a
## spatial one, is kept.
func _marking_shader(shader: Shader) -> Shader:
	if shader == GOBLIN_MATERIAL.shader:
		return GOBLIN_MARKING_SHADER
	if not _marking_shaders.has(shader):
		var code := shader.code
		var marked := shader
		if code.begins_with("shader_type spatial;") and not "stencil_mode" in code:
			marked = Shader.new()
			marked.code = code.replace("shader_type spatial;", "shader_type spatial;
stencil_mode write, compare_always, %d;" % OUTLINE_STENCIL)
		_marking_shaders[shader] = marked
	return _marking_shaders[shader]


## The toss aim during a right drag: an arrow on the floor from
## [param target] the way it will go; hidden for ZERO or no target.
## Sound slot [param slot] from where [param entity] is drawn (Sfx).
## [param slot] played from [param cell], heard from its direction and
## distance (a night watch's wave coming, 771).
func play_cell(slot: String, cell: Vector2i) -> void:
	sfx.play(slot, _tile_position(cell) + Vector3.UP * 1.0)


func play_at(slot: String, entity: GridEntity) -> void:
	var puppet: Node3D = _puppets.get(entity.get_instance_id())
	sfx.play(slot,(puppet.position if puppet != null else _tile_position(entity.tile)) + Vector3.UP * 0.5)


## A cry heard from out of sight (780, the server's "far_cry"): a
## [param creature] kind's [param cry] (SoundKit.cry), pitched as its own
## cries are, from [param cell], where the creature is but isn't drawn.
## False if the kind has no slot for it.
func far_cry(creature: String, cry: String, cell: Vector2i) -> bool:
	var slot := SoundKit.cry(creature, cry)
	if slot == "":
		return false
	sfx.play(slot, _tile_position(cell) + Vector3.UP * 1.0, float(SoundKit.CREATURE_PITCH.get(creature, 1.0)))
	return true


func toss_aim(target: GridEntity, direction: Vector2i) -> void:
	_toss.visible = direction != Vector2i.ZERO and is_instance_valid(target)
	if not _toss.visible:
		return
	var puppet: Node3D = _puppets.get(target.get_instance_id())
	var at := puppet.position if puppet != null else _tile_position(target.tile)
	_toss.position = Vector3(at.x, _ground_height(Vector2(at.x, at.z)) + ON_FLOOR * 3.0, at.z)
	_toss.rotation.y = -Vector2(direction).angle()


## Where a speech bubble of [param key] points on screen: just above the
## name of the entity with that instance id, or over a corpse puppet with
## that one; null when there is none or it is behind the camera.
func bubble_anchor(key: int) -> Variant:
	var puppet: Node3D = _puppets.get(key)
	if puppet == null:
		puppet = instance_from_id(key) as Node3D
	if puppet == null or not puppet.is_inside_tree() or _camera == null:
		return null
	var at := puppet.global_position + Vector3.UP * float(puppet.get_meta("bubble_height", 1.0))
	if _camera.is_position_behind(at) or (_low and not puppet.visible):
		return null
	return _camera.unproject_position(at)


## Screen px per tile now: the ortho size is the view's height in units.
func tile_px() -> float:
	if _camera == null or _camera.size <= 0.0:
		return SpeechBubbles.REFERENCE_TILE_PX
	return get_viewport().get_visible_rect().size.y / _camera.size


## The click ripple: a ring that grows from a few px to the cell and fades
## over RIPPLE_SECONDS, then is gone.
func ripple(tile: Vector2i) -> void:
	var ring := _make_ring_instance(RIPPLE)
	_lay_on_ground(ring, tile, ON_FLOOR * 2.0)
	add_child(ring)
	var material := ring.material_override as StandardMaterial3D
	ring.scale = Vector3(0.2, 1.0, 0.2)
	var tween := create_tween().set_parallel(true)
	tween.tween_property(ring, "scale", Vector3(1.4, 1.0, 1.4), RIPPLE_SECONDS)
	tween.tween_property(material, "albedo_color:a", 0.0, RIPPLE_SECONDS)
	tween.chain().tween_callback(ring.queue_free)


# --- Room ----------------------------------------------------------------------

## A cell's centre on its ground, at its height (on a slope, as drawn).
func _tile_position(tile: Vector2i) -> Vector3:
	return Vector3(tile.x, _height_in(tile, Vector2(tile)), tile.y)


## This view's terrain, not the World's: the room is built before the World
## has its terrain, and a client's World mirrors the same map anyway.
func _height(cell: Vector2i) -> int:
	return int(_terrain.get("heights", {}).get(cell, 0))


func _stair(cell: Vector2i) -> Vector2i:
	return _terrain.get("stairs", {}).get(cell, Vector2i.ZERO)


## The room drawn afresh for [param terrain] (a map loaded live), all in
## this frame; [param over_frames] (Main's crossings, decision 660) builds
## it a builder a frame, [member building_room] true till the last. A
## rebuild started while one is still building ends the first: its next
## phase finds a newer generation and stops, what it made freed with its room.
func rebuild(terrain: Dictionary, centre: Vector2i, over_frames := false) -> void:
	_build_generation += 1
	_end_fields_task()
	_stamped = {}
	_shades_seeded = false
	_fill_jobs.clear()
	_fill_ground = {}
	_fill_cliffs = {}
	ground_filling = false
	_ground_drawn.clear()
	_cliffs_drawn.clear()
	_terrain = terrain
	_centre = centre
	_set_plane()
	if over_frames and str(terrain.get("canopy_kind", "")) != "":
		# Read on a worker while the first phases go round (822, packed grown trees).
		GrownTrees.start_reading(str(terrain.get("level", "")))
	if over_frames and bool(terrain.get("outdoor", false)):
		_start_glimpse_reads(str(terrain.get("level", "")))  # The same (822 amended (5)).
	if _room != null and over_frames:
		# Freed a slice a frame once the new room is up (0.2 s at once on the wilds).
		_room.visible = false
		_room.process_mode = Node.PROCESS_MODE_DISABLED
		_room.name = "OldRoom_%d" % _build_generation
		_old_rooms.append(_room)
	elif _room != null:
		_room.free()
	if not over_frames:
		for old in _old_rooms:
			if is_instance_valid(old):
				old.free()
		_old_rooms.clear()
	_pile_nodes.clear()
	_walls.clear()
	_wall_breaches.clear()
	_scattered.clear()
	_scatter_due.clear()
	_scatter_jobs.clear()
	_scatter_aim = Vector2i(1 << 30, 0)
	_posts.clear()
	_doorways.clear()
	_door_hinges.clear()
	_door_states.clear()
	_doors_due.clear()
	_grounds.clear()
	_ground_kinds.clear()
	torch_cells.clear()
	_ground_shades.clear()
	_shade_all = true
	_trees.clear()
	_saplings.clear()
	_eye_cut_buckets.clear()
	_eye_cut_on.clear()
	_eye_cut_at = Vector3.INF
	_clearing_props.clear()
	_skirt = null
	_far_root = null
	_shafts = null  # Under the room (822), freed with it.
	_far_marks.clear()
	_scatter_nodes.clear()
	_border = null
	_grown = null
	_grown_trunks.clear()
	_glimpses.clear()
	_buildings.clear()
	_home_labels.clear()
	_building_at.clear()
	_banked_plot.clear()
	_stand_at.clear()
	_roofs_off.clear()
	_enclosed_dirty = true
	_floor_lookup.clear()
	_runs.clear()
	_water_bodies.clear()
	_stream_ribbons.clear()
	_fall_feet.clear()
	_mists.clear()
	_occluders.clear()
	_occluders_built = false
	_faded.clear()
	_faded_close.clear()
	_occluder_of.clear()
	_hiding.clear()
	_hid_at.clear()
	_fade_key = ""
	if _neighbour:
		_outdoor = bool(_terrain.get("outdoor", false))  # Lit by the live view's sky (822).
	else:
		_apply_sky()
	_camera_target = _tile_position(_centre)
	# A new map: the view starts on the player.
	pan = Vector3.ZERO
	_pan_home = false
	if over_frames:
		_build_room_over_frames(_build_generation)
	else:
		_build_room()
		_room_built()
		# Whatever waited on a build over frames this one ended goes on.
		fields_done.emit()
		room_filled.emit()


## What a rebuild does once its room is whole.
func _room_built() -> void:
	_classify_walls()
	if not _neighbour:
		_apply_camera_mode()  # Outdoors or under stone now (623).
		_start_warm_ups()
	building_room = false
	room_built.emit()


# --- The held neighbour (decision 822, P1) ------------------------------------------

## Fields of the view itself, kept by its instance through swap_room: the
## camera, input, puppets, aim, sound, the sky and the build's own state.
## Every other script var is the room's (ROOM_FIELDS), traded by swap_room;
## view_test fails on a var in neither.
const RoomFields := preload("res://client3d/room_fields.gd")


## A neighbour's whole view (822): this Client3D, not the live one, builds
## [param terrain] (another zone's) as a room with no camera, sky, puppets
## or warm-ups of its own, lit by the live view's [param sky_floor], over
## frames when [param over_frames]. Its caller places it on the world plane
## and turns its _process off.
func build_neighbour(terrain: Dictionary, centre: Vector2i, sky_floor: float, over_frames := false, plane_at := Vector3.ZERO) -> void:
	_neighbour = true
	_plane_at = plane_at  # Where it lies on the plane: the live view's place and their offset.
	_sky_floor = sky_floor
	rebuild(terrain, centre, over_frames)
	_set_sky_floor(sky_floor)


## Whether this view's room is whole: not building, its ground filled and
## no old room left to free (swap_room trades only whole rooms).
func room_whole() -> bool:
	return _room != null and not building_room and not ground_filling and _fill_jobs.is_empty() and _old_rooms.is_empty()


## The live view and the held neighbour [param other] trade rooms (822): every
## ROOM field, nothing built. Each room node stays under the view that
## built it (moving one between views takes every node out of the tree and
## back in: 50 to 80 ms; placing it, about 3 ms): this one's new room is
## put where this view is (the origin) and the other's past it, so the
## rooms keep their places to one another and the camera its place among
## them (all of it shifted together by the change of origin, nothing moved
## on screen); the shaders' plane_origin follows (_plane_at, a ROOM field).
## The other view's own position no longer says where its room is.
## The room it gives up is left as built (no piece faded, every roof on).
## Both must be whole. A particle already in the air (world space) is left
## where it was: it jumps once, by the change of origin.
func swap_room(other: Client3D) -> void:
	assert(room_whole() and other.room_whole(), "swap_room: a room still building")
	_leave_as_built()
	var shift := (_room.global_position if _room != null else global_position) \
			- (other._room.global_position if other._room != null else other.global_position)
	for field: StringName in RoomFields.ROOM:
		var mine: Variant = get(field)
		set(field, other.get(field))
		other.set(field, mine)
	if _room != null:
		_room.global_position = global_position
	if other._room != null:
		other._room.global_position = global_position + shift
	for node: Node3D in [_camera]:
		if node != null:
			node.position += shift
	_camera_target += shift
	pan = Vector3.ZERO
	_shadow_checked = 0.0
	_set_sky_floor(_sky_floor)
	other._set_sky_floor(_sky_floor)
	_give_plane()
	_publish_floor_shade()
	if _environment != null:
		_apply_sky()
		_apply_camera_mode()
	if not _neighbour:
		# The live zone's doors and piles on its new room, as _phase_doors sets them.
		for door in World.get_doors():
			_doors_due[door.key] = true
		_show_piles()
		if not World.hearths_changed.is_connected(_on_hearths_changed):
			World.hearths_changed.connect(_on_hearths_changed)
		_draw_hearths()
		if not World.hearths_changed.is_connected(_hear_hearths):
			World.hearths_changed.connect(_hear_hearths)
		if World.zone != null:
			_hearths_heard[World.zone.name] = World.lit_hearths(World.zone.name)
		_hearths_settle_at = Time.get_ticks_msec() + HEARTH_SETTLE_MSEC


## A held neighbour let go (822): its room and any older ones freed
## (wherever they hang: a room stays under the view that built it), every
## ROOM field back to a new view's, so what it held (a few hundred MB for
## the forest) goes with it. The view is left empty; Main frees it, or
## keeps it while the live room it once built still hangs under it.
func release_room() -> void:
	_end_fields_task()
	for old in _old_rooms:
		if is_instance_valid(old):
			old.queue_free()
	if is_instance_valid(_room):
		_room.queue_free()
	var fresh := Client3D.new()
	for field: StringName in RoomFields.ROOM:
		set(field, fresh.get(field))
	fresh.free()


## Every glimpse shown but the one toward [param zone] (822): a held
## neighbour's own room stands where its glimpse would; "" shows them all.
func hide_glimpse_to(zone: String) -> void:
	for view in _glimpses:
		if is_instance_valid(view):
			view.visible = zone.is_empty() or str(view.get_meta("to", "")) != zone


## This room's place on the world plane (_plane_at), from its terrain's
## level, when on_plane; then the live view gives it to the shaders. A
## neighbour keeps the place its caller gave it (beside the live view's, by
## their offset, so the two always agree).
func _set_plane() -> void:
	if _neighbour:
		return
	_plane_at = Vector3.ZERO
	if on_plane:
		var zones: Dictionary = Level.world_plane().get("zones", {})
		var zone: Dictionary = zones.get(str(_terrain.get("level", "")), {})
		if zone.has("origin"):
			var origin: Vector2i = zone["origin"]
			_plane_at = Vector3(origin.x, float(zone.get("height", 0.0)), origin.y)
	_give_plane()


## The live view's place on the world plane given to the shaders (822):
## world positions plus plane_origin are places on the plane.
func _give_plane() -> void:
	if not _neighbour and not _glimpse:
		plane_given = _plane_at
		RenderingServer.global_shader_parameter_set("plane_origin", Vector4(_plane_at.x, _plane_at.y, _plane_at.z, 0.0))


## Every faded piece shown again, every roof put back and the live zone's
## heaps taken off: what a room looks like with no player in it (a
## neighbour's, 822).
func _leave_as_built() -> void:
	for piece: Node3D in _faded:
		if is_instance_valid(piece):
			_set_near(piece, false)
	for piece: Node3D in _faded_close:
		if is_instance_valid(piece):
			_set_close(piece, false)
	_faded.clear()
	_faded_close.clear()
	_hiding.clear()
	_hid_at.clear()
	_lined.clear()
	_close_at.clear()
	_inside_hiding.clear()
	_fade_key = ""
	_roofs_off.clear()
	# The live zone's heaps (World's piles) go with it: a neighbour shows none.
	for heap: Node3D in _pile_nodes.values():
		if is_instance_valid(heap):
			heap.free()
	_pile_nodes.clear()
	_pile_ids.clear()
	for building: Dictionary in _buildings:
		if building.get("off", false):
			building["off"] = false
			_ease_roof(building, 1.0)
			if building["roof"] != null:
				_set_near(building["roof"], false)  # Its shadow cast again, as _update_fade does.


## The room's builders a frame apart (decision 660), each whole but the
## ground's and the cliffs': the ground's fields on a worker while frames go
## round, then those chunks the camera sees under the card, the rest after it
## lifts (_fill_step). Stopped by a newer rebuild (another
## [member _build_generation]).
func _build_room_over_frames(generation: int) -> void:
	building_room = true
	if not _neighbour:
		# The view where the card will lift: what it sees is built first.
		_apply_camera_mode()
		_place_camera()
	# 660 amended (7): the next phase runs in the same frame while the time
	# this frame has spent and its last cost fit CARD_BUDGET_USEC; a small
	# room's twenty phase frames were 450 ms at 60 fps on a tavern stair.
	var frame_started := Time.get_ticks_usec()
	for phase: Callable in _room_phases():
		var phase_started := Time.get_ticks_usec()
		if phase == _phase_ground:
			if not await _phase_ground_over_frames(generation):
				return
		elif phase == _phase_edges:
			if not await _phase_edges_over_frames(generation):
				return
		elif phase == _add_cliffs:
			_fill_cliffs = _cliffs_start()
			for chunk: Vector2i in _fill_cliffs["chunks"]:
				_fill_jobs.append(["cliff", chunk])
		else:
			if phase == _phase_land:
				# The grown trees and the glimpses' levels it reads, on their
				# workers till then (822, 822 amended (5)).
				var level := str(_terrain.get("level", ""))
				while not GrownTrees.ready_for(level) or not _glimpse_reads_ready():
					await get_tree().process_frame
					if generation != _build_generation or not is_inside_tree():
						return
					frame_started = Time.get_ticks_usec()
					phase_started = frame_started
			phase.call()
			if phase == _phase_land:
				_start_curves()
		var phase_name := phase.get_method()
		if phase_name != &"_phase_ground" and phase_name != &"_phase_edges":
			# Those two wait frames of their own: their cost is not one frame's.
			_phase_usec[phase_name] = Time.get_ticks_usec() - phase_started
		var next: StringName = &"_index_occluders"
		var phases := _room_phases()
		var at := phases.find(phase)
		if at >= 0 and at + 1 < phases.size():
			next = phases[at + 1].get_method()
		if _phase_fits(frame_started, next):
			continue
		await get_tree().process_frame
		frame_started = Time.get_ticks_usec()
		if generation != _build_generation or not is_inside_tree():
			return
	# What fades, indexed a frame of its own under the card, not in the
	# lift's (perf: 33-39 ms on the wilds' 5228 occluders).
	if not _occluders_built:
		var index_started := Time.get_ticks_usec()
		_index_occluders()
		_phase_usec[&"_index_occluders"] = Time.get_ticks_usec() - index_started
		if not _phase_fits(frame_started, &"_find_enclosed"):
			await get_tree().process_frame
			frame_started = Time.get_ticks_usec()
			if generation != _build_generation or not is_inside_tree():
				return
	# And the spaces walls close in (_update_roofs' first read, 33-35 ms).
	if _enclosed_dirty:
		var enclosed_started := Time.get_ticks_usec()
		_find_enclosed()
		_phase_usec[&"_find_enclosed"] = Time.get_ticks_usec() - enclosed_started
		await get_tree().process_frame
		if generation != _build_generation or not is_inside_tree():
			return
	# Everything the camera sees, under the card.
	while _fill_step(_card_budget(), true):
		await get_tree().process_frame
		if generation != _build_generation or not is_inside_tree():
			return
	_room_built()
	# The rest at a few ms a frame, in sight and nearest first, dithering in.
	while _fill_step(FILL_BUDGET_USEC, false):
		await get_tree().process_frame
		if generation != _build_generation or not is_inside_tree():
			return
	_fill_finished()


## Each room phase's cost the last time it ran over frames, in µs, by its
## method's name (660 amended (7)); a phase never seen counts as nothing, so a
## first build runs as much in a frame as fits.
var _phase_usec := {}


## Whether the phase [param next] may run in the frame begun at
## [param frame_started]: the frame's time so far and its last cost within
## CARD_BUDGET_USEC (660 amended (7)).
func _phase_fits(frame_started: int, next: StringName) -> bool:
	var spent := Time.get_ticks_usec() - frame_started
	return spent + int(_phase_usec.get(next, 0)) < _card_budget()


## A frame's time for the room's phases and its first chunks: under the
## card, CARD_BUDGET_USEC; a held neighbour's, built while the player walks
## (decision 822), NEIGHBOUR_BUDGET_USEC.
func _card_budget() -> int:
	return NEIGHBOUR_BUDGET_USEC if _neighbour else CARD_BUDGET_USEC


## The ground over frames (decision 660): its fields on a worker while the
## frames go round, put in place, its fires; its chunks queued. False when a
## newer rebuild took over.
func _phase_ground_over_frames(generation: int) -> bool:
	var input := _ground_input(_terrain.get("kinds", {}))
	if input.is_empty():
		return true
	var key := _fields_key()
	var fields := _kept_fields(key)
	if fields.is_empty():
		var result := {}
		var task := WorkerThreadPool.add_task(func() -> void: result["fields"] = _ground_fields(input), true, "ground fields")
		_fields_task = task
		while _fields_task == task and not WorkerThreadPool.is_task_completed(task):
			await get_tree().process_frame
		if _fields_task != task:
			return false  # A newer rebuild waited for it and took over.
		WorkerThreadPool.wait_for_task_completion(task)
		_fields_task = -1
		if generation != _build_generation or not is_inside_tree():
			return false
		fields = result["fields"]
		_keep_fields(key, fields)
	else:
		# Kept: the input and the fields' laying are a frame apart, as when
		# the worker comes between (the terrain they read waits the frame).
		_fields_held = true
		await get_tree().process_frame
		if generation != _build_generation or not is_inside_tree():
			return false
		_fields_held = false
	_apply_ground_fields(fields)
	fields_done.emit()
	_fill_ground = _ground_meshes_start(fields)
	# The shades a frame on (80 ms on the wilds); after the start, which
	# makes the indoor shade image.
	await get_tree().process_frame
	if generation != _build_generation or not is_inside_tree():
		return false
	_seed_shades()
	for chunk: Vector2i in fields["chunks"]:
		_fill_jobs.append(["ground", chunk])
	ground_filling = true  # The shade waits from here: the lights' phase asks for it.
	_fire_lights.clear()
	_lamp_lights.clear()
	var fire: Array[Vector2i] = _terrain["fire"]
	for cell: Vector2i in fire:
		if _grounds.has(cell):
			_add_fire(cell)
	_add_fire_pools()
	return true


## A zone's ground fields kept for its next arrival (decision 660 (a)), by
## _fields_key: the zone's terrain hashed whole, so any change to it at all
## (a woodcut, regrowth, a plot, a ruin, a regenerate, a builder's edit)
## misses and works them out afresh. FIELDS_KEPT zones, the least recently
## arrived at dropped; each [key, fields], the latest last.
const FIELDS_KEPT := 3
var _fields_kept: Array[Array] = []
## How many arrivals found their fields kept (tests, benches).
var fields_hits := 0


## The key the ground's fields are kept by: the level, a glimpse or not, and
## the terrain's hash (8 ms on the wilds).
func _fields_key() -> String:
	return "%s|%s|%d" % [_terrain.get("level", ""), _glimpse, _terrain.hash()]


## The fields kept under [param key], a copy of them (the build makes its
## members of them and changes those after), else {}.
func _kept_fields(key: String) -> Dictionary:
	for i in _fields_kept.size():
		if _fields_kept[i][0] == key:
			var kept: Array = _fields_kept.pop_at(i)
			_fields_kept.append(kept)
			fields_hits += 1
			return _fields_copy(kept[1])
	return {}


## [param fields] kept under [param key] (a copy), the oldest dropped past
## FIELDS_KEPT.
func _keep_fields(key: String, fields: Dictionary) -> void:
	for i in _fields_kept.size():
		if _fields_kept[i][0] == key:
			_fields_kept.remove_at(i)
			break
	_fields_kept.append([key, _fields_copy(fields)])
	while _fields_kept.size() > FIELDS_KEPT:
		_fields_kept.pop_front()


## [param fields] copied all through, its images too.
static func _fields_copy(fields: Dictionary) -> Dictionary:
	var copy := fields.duplicate(true)
	for name: Variant in copy:
		if copy[name] is Image:
			copy[name] = (copy[name] as Image).duplicate()
	return copy


## Waits for a running fields task (a rebuild, the view leaving): it reads
## the members the next build remakes.
func _end_fields_task() -> void:
	_fields_held = false
	if _curves_task != -1:
		WorkerThreadPool.wait_for_group_task_completion(_curves_task)
		_curves_task = -1
	if _fields_task != -1:
		WorkerThreadPool.wait_for_task_completion(_fields_task)
		_fields_task = -1


## Whether the curves or the ground's fields are being worked out on a
## worker, or kept fields wait a frame to be laid: the terrain they read
## waits (Main holds a clearing till fields_done).
func fields_running() -> bool:
	return _fields_task != -1 or _curves_task != -1 or _fields_held


func _exit_tree() -> void:
	_end_fields_task()


## Builds chunks for up to [param budget] µs, those the camera sees first and
## then the nearest; [param seen_only]: only those it sees (under the card).
## True while there is more to do this way. A chunk built in sight after the
## card has lifted dithers in; earlier rooms are freed a slice a frame after.
func _fill_step(budget: int, seen_only: bool) -> bool:
	var started := Time.get_ticks_usec()
	if _fill_jobs.is_empty():
		return _free_old_rooms(started, budget)
	var frustum: Array[Plane] = []
	if _camera != null:
		frustum = _camera.get_frustum()  # A neighbour has none (822): every chunk counts as seen.
	var aim := Vector2(_camera_target.x, _camera_target.z)
	var order: Array[Array] = []
	for job: Array in _fill_jobs:
		var seen := _chunk_seen(job[1], frustum)
		if seen_only and not seen:
			continue
		var middle := Vector2(job[1] * FLOOR_CHUNK) + Vector2.ONE * (FLOOR_CHUNK * 0.5)
		order.append([0 if seen else 1, middle.distance_squared_to(aim), job, seen])
	if order.is_empty():
		return false
	order.sort_custom(func(a: Array, b: Array) -> bool: return a[0] < b[0] or a[0] == b[0] and a[1] < b[1])
	for each: Array in order:
		if Time.get_ticks_usec() - started >= budget:
			break
		var job: Array = each[2]
		_fill_jobs.erase(job)
		if job[0] == "ground":
			_ground_mesh_chunk(_fill_ground, job[1])
		else:
			_cliff_chunk(_fill_cliffs, job[1])
		if each[3] and not building_room:
			_appear(job[0], job[1])
	return true


## Whether the camera sees [param chunk] (its column CHUNK_LOW to CHUNK_HIGH
## against [param frustum]'s planes, Camera3D.get_frustum: out is +normal).
func _chunk_seen(chunk: Vector2i, frustum: Array) -> bool:
	if frustum.is_empty():
		return true
	var low := Vector3(chunk.x * FLOOR_CHUNK - 0.5, CHUNK_LOW, chunk.y * FLOOR_CHUNK - 0.5)
	var high := low + Vector3(FLOOR_CHUNK, CHUNK_HIGH - CHUNK_LOW, FLOOR_CHUNK)
	for plane: Plane in frustum:
		# The box's corner furthest inside: outside the plane, the box is too.
		var inner := Vector3(low.x if plane.normal.x > 0.0 else high.x, low.y if plane.normal.y > 0.0 else high.y,
				low.z if plane.normal.z > 0.0 else high.z)
		if plane.is_point_over(inner):
			return false
	return true


## [param kind]'s chunk [param chunk], just built in sight, dithering in over
## APPEAR_SECONDS (decision 660): the ground through its SIGHT variant (which
## reads appear) till it is whole, then its own material again.
func _appear(kind: String, chunk: Vector2i) -> void:
	var drawn: MeshInstance3D = (_ground_drawn if kind == "ground" else _cliffs_drawn).get(chunk)
	if drawn == null:
		return
	if kind == "ground":
		if _ground_appear == null or _ground_appear.get_meta("look", null) != _ground_look:
			_ground_appear = _ground_look.duplicate() as ShaderMaterial
			_ground_appear.shader = GROUND_SIGHT_SHADER
			_ground_appear.set_meta("look", _ground_look)
		drawn.material_override = _ground_appear
	drawn.set_instance_shader_parameter("appear", 0.0)
	var tween := drawn.create_tween()
	tween.tween_method(func(v: float) -> void: drawn.set_instance_shader_parameter("appear", v), 0.0, 1.0, APPEAR_SECONDS)
	if kind == "ground":
		tween.tween_callback(func() -> void: drawn.material_override = _ground_look)


## Frees what is left of earlier builds' rooms within [param budget] µs
## from [param started]; true while some are left. Each piece is queued
## (queue_free), deleted at the frame's end, its cost counted as
## FREE_USEC_PER_NODE a node: a free() in place met a piece still locked
## mid-signal under a suite's load ("Object is locked and can't be freed",
## view_test after a rebuild mid-build), and the pieces stay in the tree
## till then (taken out, the shadows' pass read a light's place off-tree).
func _free_old_rooms(started: int, budget: int) -> bool:
	var queued := 0
	while not _old_rooms.is_empty():
		var old := _old_rooms[0]
		if not is_instance_valid(old) or old.is_queued_for_deletion():
			_old_rooms.pop_front()
			continue
		var piece: Node = null
		for i in range(old.get_child_count() - 1, -1, -1):
			if not old.get_child(i).is_queued_for_deletion():
				piece = old.get_child(i)
				break
		if piece == null:
			_old_rooms.pop_front()
			old.queue_free()
			continue
		if Time.get_ticks_usec() - started + queued * FREE_USEC_PER_NODE >= budget:
			return true
		queued += _node_count(piece)
		piece.queue_free()
	return false


## What deleting a room's node costs, about (perf: 2 µs headless, more with
## the meshes' render state), for _free_old_rooms' budget.
const FREE_USEC_PER_NODE := 5


static func _node_count(node: Node) -> int:
	var count := 1
	for child in node.get_children():
		count += _node_count(child)
	return count


## The ground's and cliffs' chunks all built (decision 660): the shade's
## pairs gathered, the shade worked out afresh, told.
func _fill_finished() -> void:
	if not _fill_ground.is_empty():
		_ground_meshes_finish(_fill_ground)
	_fill_ground = {}
	_fill_cliffs = {}
	ground_filling = false
	_shade_all = true
	_shade_due = false
	_on_fields_changed()
	room_filled.emit()


## The depth pass every near material draws first (_make_near).
static var _near_depth: ShaderMaterial


func _stone(alpha: float) -> StandardMaterial3D:
	var material := StandardMaterial3D.new()
	material.albedo_color = Color(STONE, alpha)
	material.roughness = 0.9
	if alpha < 1.0:
		_make_near(material)
	return material


## [param material] as a near piece is drawn: see-through, its nearest
## surface only (NEAR_DEPTH_SHADER first, as its next pass).
static func _make_near(material: BaseMaterial3D) -> void:
	material.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	material.render_priority = NEAR_PRIORITY
	material.next_pass = _near_depth_pass()


## The depth pass a see-through copy draws after itself, made once.
static func _near_depth_pass() -> ShaderMaterial:
	if _near_depth == null:
		var shader := Shader.new()
		shader.code = NEAR_DEPTH_SHADER
		_near_depth = ShaderMaterial.new()
		_near_depth.shader = shader
		_near_depth.render_priority = NEAR_DEPTH_PRIORITY
	return _near_depth


## Each material as the season draws it, by [its id, leaf]: [the season's,
## the material] (held, so its id is never another's).
static var _season_materials: Dictionary = {}


## [param material] (a BaseMaterial3D: the palette, a fill's, a flat colour,
## vertex colours) drawn in season (season.gdshader): its own look, then
## snow on what faces up, and with [param leaf] its foliage dried out of
## season and turned in autumn. Kept and shared by material and leaf
## unless not [param shared] (a material made for one build). Its
## see-through copy beside it (SEASON_NEAR_META), for the near fade.
## [param shader]: another season shader for the material itself (the
## border canopy's eye cut, 326 amended), else season.gdshader.
static func season_material(material: Material, leaf: bool, shared := true, shader: Shader = null) -> Material:
	var base := material as BaseMaterial3D
	if base == null:
		return material
	var key := [base.get_instance_id(), leaf]
	if shared and _season_materials.has(key):
		return _season_materials[key][0]
	var made := _season_copy(shader if shader != null else SEASON_SHADER, base, leaf)
	var near := _season_copy(SEASON_NEAR_SHADER, base, leaf)
	near.set_shader_parameter("alpha", NEAR_ALPHA)
	near.render_priority = NEAR_PRIORITY
	near.next_pass = _near_depth_pass()
	made.set_meta(SEASON_NEAR_META, near)
	if shared:
		_season_materials[key] = [made, base]
	return made


## The eye-cut copies of season materials (eye_cut_material): the season
## material's id to [the copy, the season material, its see-through copy's
## copy if it has one]; a season see-through copy's id to its cut copy; and
## the cut they are set to now (set_tree_eye_cut). Each copy holds what it
## was copied from (EYE_CUT_OF_META).
static var _eye_cut_copies: Dictionary = {}
static var _eye_cut_near: Dictionary = {}
static var _eye_cut_now := 0.0
const EYE_CUT_OF_META := &"eye_cut_of"
## Near only (326 amended (2)): a tree, sapling or near stand takes its cut
## copy only while its foot stands within CANOPY_EYE_CUT + EYE_CUT_REACH of
## the low camera (a crown's spread from its foot, a stand's footprint, and
## the camera's move between two looks), looked at again each EYE_CUT_STEP
## the camera moves, through buckets EYE_CUT_BUCKET across. Every tree in
## its cut copy cost 1.2 ms a frame on the Atlas: its discard, paid by all.
const EYE_CUT_REACH := 6.0
const EYE_CUT_STEP := 1.0
const EYE_CUT_BUCKET := 8.0


## [param material] (a season_material) as its eye-cut copy (326 amended (2)):
## not drawn within eye_cut of the camera, dithered over
## CANOPY_EYE_CUT_BAND; its see-through copy (SEASON_NEAR_META) cut alike.
## Kept and shared by material; set to the cut now. Any other material as
## it is.
static func eye_cut_material(material: Material) -> Material:
	var made := material as ShaderMaterial
	if made == null or made.shader != SEASON_SHADER:
		return material
	var key := made.get_instance_id()
	if _eye_cut_copies.has(key):
		return _eye_cut_copies[key][0]
	var cut := made.duplicate() as ShaderMaterial
	cut.shader = EYE_CUT_SHADER
	cut.set_meta(EYE_CUT_OF_META, made)
	var entry: Array = [cut, made]
	if made.has_meta(SEASON_NEAR_META):
		var season_near := made.get_meta(SEASON_NEAR_META) as ShaderMaterial
		var near := season_near.duplicate() as ShaderMaterial
		near.shader = EYE_CUT_NEAR_SHADER
		near.set_meta(EYE_CUT_OF_META, season_near)
		cut.set_meta(SEASON_NEAR_META, near)
		entry.append(near)
		_eye_cut_near[season_near.get_instance_id()] = near
	for each: ShaderMaterial in [cut] + entry.slice(2):
		each.set_shader_parameter("eye_cut", _eye_cut_now)
		each.set_shader_parameter("eye_cut_band", CANOPY_EYE_CUT_BAND)
	_eye_cut_copies[key] = entry
	return cut


## [param material] as its eye-cut copy ([param on]: eye_cut_material; a
## season see-through copy as its cut one) or as the material it was copied
## from. Any other material as it is.
static func eye_cut_swap(material: Material, on: bool) -> Material:
	if material == null:
		return null
	if not on:
		return material.get_meta(EYE_CUT_OF_META) if material.has_meta(EYE_CUT_OF_META) else material
	if material.has_meta(EYE_CUT_OF_META):
		return material
	var near_key := material.get_instance_id()
	if _eye_cut_near.has(near_key):
		return _eye_cut_near[near_key]
	return eye_cut_material(material)


## [param piece]'s meshes in their eye-cut copies ([param on]) or their
## season materials: the drawn ones, and those the near fade keeps to put
## back (OPAQUE_META, OPAQUE_SURFACES_META), the kept first, so a faded
## piece's see-through copy finds its cut one.
func _set_eye_cut_piece(piece: Node3D, on: bool) -> void:
	for node in _descendants(piece):
		var mesh := node as MeshInstance3D
		if mesh == null or mesh.mesh == null:
			continue
		if mesh.has_meta(OPAQUE_META):
			mesh.set_meta(OPAQUE_META, eye_cut_swap(mesh.get_meta(OPAQUE_META), on))
		if mesh.material_override != null:
			mesh.material_override = eye_cut_swap(mesh.material_override, on)
			continue
		if mesh.has_meta(OPAQUE_SURFACES_META):
			var kept: Array[Material] = mesh.get_meta(OPAQUE_SURFACES_META)
			for surface in kept.size():
				var base: Material = kept[surface] if kept[surface] != null else mesh.mesh.surface_get_material(surface)
				kept[surface] = eye_cut_swap(base, on)
			mesh.set_meta(OPAQUE_SURFACES_META, kept)
		for surface in mesh.mesh.get_surface_count():
			var own := mesh.get_surface_override_material(surface)
			if own == null:
				own = mesh.mesh.surface_get_material(surface)
			if own != null:
				mesh.set_surface_override_material(surface, eye_cut_swap(own, on))


## [param piece] (a tree, a sapling, a near stand, a child of the room)
## among those the near-only cut looks at.
func _eye_cut_register(piece: Node3D) -> void:
	var key := Vector2i(floori(piece.position.x / EYE_CUT_BUCKET), floori(piece.position.z / EYE_CUT_BUCKET))
	if not _eye_cut_buckets.has(key):
		_eye_cut_buckets[key] = []
	_eye_cut_buckets[key].append(piece)
	_eye_cut_at = Vector3.INF


## The near-only cut: under the low camera the registered pieces whose foot
## is within CANOPY_EYE_CUT + EYE_CUT_REACH of the camera in their cut
## copies and the rest in their season materials; none under the high one.
## Looked at again once the camera has moved EYE_CUT_STEP ([param force]:
## now).
func _update_eye_cut(force := false) -> void:
	var want: Dictionary[Node3D, bool] = {}
	if _low and _camera != null and _room != null and _room.is_inside_tree() and _camera.is_inside_tree():
		var eye := _camera.global_position - _room.global_position
		if not force and Vector2(eye.x - _eye_cut_at.x, eye.z - _eye_cut_at.z).length() < EYE_CUT_STEP:
			return
		_eye_cut_at = eye
		var reach := CANOPY_EYE_CUT + EYE_CUT_REACH
		var low_bucket := Vector2i(floori((eye.x - reach) / EYE_CUT_BUCKET), floori((eye.z - reach) / EYE_CUT_BUCKET))
		var high_bucket := Vector2i(floori((eye.x + reach) / EYE_CUT_BUCKET), floori((eye.z + reach) / EYE_CUT_BUCKET))
		for bucket_x in range(low_bucket.x, high_bucket.x + 1):
			for bucket_z in range(low_bucket.y, high_bucket.y + 1):
				for piece: Node3D in _eye_cut_buckets.get(Vector2i(bucket_x, bucket_z), []):
					if is_instance_valid(piece) and Vector2(piece.position.x - eye.x, piece.position.z - eye.z).length() <= reach:
						want[piece] = true
	elif _eye_cut_on.is_empty():
		return
	else:
		_eye_cut_at = Vector3.INF
	for piece: Node3D in _eye_cut_on.keys():
		if not want.has(piece):
			if is_instance_valid(piece):
				_set_eye_cut_piece(piece, false)
			_eye_cut_on.erase(piece)
	for piece: Node3D in want:
		if not _eye_cut_on.has(piece):
			_set_eye_cut_piece(piece, true)
			_eye_cut_on[piece] = true


## Every eye-cut copy's cut, metres (0: off): CANOPY_EYE_CUT under the low
## camera (_apply_camera_mode), as the border canopy's.
static func set_tree_eye_cut(metres: float) -> void:
	_eye_cut_now = metres
	for entry: Array in _eye_cut_copies.values():
		for each: ShaderMaterial in [entry[0]] + entry.slice(2):
			each.set_shader_parameter("eye_cut", metres)


static func _season_copy(shader: Shader, base: BaseMaterial3D, leaf: bool) -> ShaderMaterial:
	var made := ShaderMaterial.new()
	made.shader = shader
	made.set_shader_parameter("albedo_color", base.albedo_color)
	made.set_shader_parameter("use_texture", base.albedo_texture != null)
	if base.albedo_texture != null:
		made.set_shader_parameter("albedo_texture", base.albedo_texture)
	made.set_shader_parameter("use_vertex_color", base.vertex_color_use_as_albedo)
	made.set_shader_parameter("vertex_srgb", base.vertex_color_is_srgb)
	made.set_shader_parameter("roughness", base.roughness)
	made.set_shader_parameter("leaf", leaf)
	return made


## [param node]'s meshes drawn in season (season_material): their
## overrides, else their surfaces' materials, as overrides.
static func season_dress(node: Node, leaf: bool) -> void:
	var walk: Array[Node] = [node]
	while not walk.is_empty():
		var next := walk.pop_back() as Node
		walk.append_array(next.get_children())
		var mesh := next as MeshInstance3D
		if mesh == null or mesh.mesh == null:
			continue
		if mesh.material_override != null:
			mesh.material_override = season_material(mesh.material_override, leaf)
			continue
		for surface in mesh.mesh.get_surface_count():
			var own := mesh.get_surface_override_material(surface)
			if own == null:
				own = mesh.mesh.surface_get_material(surface)
			if own != null:
				mesh.set_surface_override_material(surface, season_material(own, leaf))


func _descendants(node: Node) -> Array[Node]:
	var out: Array[Node] = [node]
	for child in node.get_children():
		out.append_array(_descendants(child))
	return out


## The room's builders in order (decision 660): run in one go by
## _build_room, a frame apart by _build_room_over_frames.
func _room_phases() -> Array[Callable]:
	return [_phase_sets, _phase_land, _phase_reach, _phase_edges, _phase_ground, _build_water, _add_cliffs, _phase_lights,
		_add_walls, _add_decor, _add_plates, _phase_stands, _phase_forest, _phase_forest_edge, _phase_forest_band, _phase_grown, _phase_border, _phase_mass, _phase_glimpses,
		_add_buildings, _phase_roofs, _phase_doors]


func _build_room() -> void:
	for phase: Callable in _room_phases():
		phase.call()


func _phase_sets() -> void:
	_room = Node3D.new()
	_room.name = "Room"
	add_child(_room)
	_door_lamps.clear()  # Hung again in the new room (782).
	_wall_lamps.clear()  # And the mine's (769 amended (6)).
	_house_lights.clear()  # And the houses' (489 amended (3)), freed with the old room.
	_house_seats.clear()  # Their pieces too (489 amended (4)).
	_night_places = null
	_stone_opaque = _stone(1.0)
	# The map's sets; a building's walls and inside in its slot's sets
	# (decision 285): the last map's buildings' out, this one's in, what
	# else is in the sets left as it is.
	# A well's water is drawn as the ground round it, under its rim.
	_walls_set = _known_set(str(_terrain.get("walls", DEFAULT_SET)))
	_floors_set = _known_set(str(_terrain.get("floors", DEFAULT_SET)))
	for key in _building_walls:
		_wall_sets.erase(key)
		_wall_heights.erase(key)
	_building_walls.clear()
	_pad_cell.clear()
	_plinths.clear()
	_ruin_edges.clear()
	_floor_worn.clear()
	# A damaged building's and a town wall's looks: the last map's out.
	for key in _state_walls:
		_wall_states.erase(key)
	_state_walls.clear()
	_window_flipped.clear()
	_window_code.clear()
	_sill_lamps.clear()
	_glows.clear()
	for key in _town_wall_sets:
		_wall_sets.erase(key)
	_town_wall_sets.clear()
	_town_walls.clear()
	for cell in _building_floors:
		_floor_sets.erase(cell)
	_building_floors.clear()
	for cell in _building_dry:
		_dry_water.erase(cell)
	_building_dry.clear()
	for building: Dictionary in _drawn_buildings():
		_building_sets(building)
	_warm_art()


func _phase_land() -> void:
	_clearing.assign(_terrain.get("clearing", {}))
	_grown_back.clear()
	# A new set each build, never changed after: the border's worker reads it.
	_land = {}
	for cell: Vector2i in _terrain["floor"] + _terrain.get("water", []):
		_land[cell] = true
	# Rocks (decision 513, terrain's side) are the land's too: ground under a
	# rock, where the void's would be a tree.
	_rocks.clear()
	for cell: Vector2i in _terrain.get("rocks", []):
		_rocks[cell] = true
		_land[cell] = true
	# A solid building's cells (decision 550) are land under its mesh, no tree.
	_solid_cells.clear()
	for cell: Vector2i in _terrain.get("solid", []):
		_land[cell] = true
		_solid_cells[cell] = true
	_glimpse_plans.clear()
	_glimpse_ground.clear()
	if _outdoor:
		_glimpse_plans = _plan_glimpses()
	_wooded = _land
	if not _glimpse_plans.is_empty():
		_wooded = _land.duplicate()
		for plan: Dictionary in _glimpse_plans:
			for cell: Vector2i in plan["cells"]:
				_wooded[cell] = true
	_grown_data = {}
	if _outdoor and str(_terrain.get("canopy_kind", "")) != "":
		_grown_data = GrownTrees.data_for(str(_terrain.get("level", "")))
		_grown_trunks = GrownTrees.trunk_cells(_grown_data, _land)
		if not _grown_trunks.is_empty():
			_wooded = _wooded.duplicate()
			_wooded.merge(_grown_trunks)


## The forest's reach from the land (660: the land's phase in three, each
## a frame of its own under the card).
func _phase_reach() -> void:
	_forest_distance.clear()
	if _outdoor:
		_forest_distance = _measure_forest()


## The forest's edge as curves, then what reads the land's whole.
func _phase_edges() -> void:
	_read_edges()
	_edges_read()


## Over frames (decision 660), from the land's phase on: on two workers
## while the reach's phase and the frames go round, the edge's curves round
## the wooded land, and the waters' and roads' near maps for the ground's
## phase (_stamped); each into its own of [member _curves_result].
func _start_curves() -> void:
	# Untyped: indoors none (a typed var took {} as an error, and the room
	# never drew: 660 amended (4)'s indoor zones).
	var wooded: Dictionary = {}
	if _outdoor:
		wooded = _wooded
	var waters: Array = [] if _glimpse else _terrain.get("waters", [])
	var roads: Array = [] if _glimpse else _terrain.get("roads", [])
	var results: Array[Dictionary] = [{}, {}]
	_curves_result = results
	var work := func(i: int) -> void:
		if i == 0:
			results[0]["edges"] = _edges_of(wooded) if not wooded.is_empty() else {}
		else:
			results[1]["stamps"] = _stamps_of(waters, roads)
	_curves_task = WorkerThreadPool.add_group_task(work, 2, 2, true, "curves")


## _phase_edges over frames: the curves _start_curves began, waited for while
## the frames go round. False when a newer rebuild took over.
func _phase_edges_over_frames(generation: int) -> bool:
	var task := _curves_task
	if task == -1:
		_phase_edges()  # The workers never started: here, at once.
		return true
	while _curves_task == task and not WorkerThreadPool.is_group_task_completed(task):
		await get_tree().process_frame
	if _curves_task != task:
		return false  # A newer rebuild waited for it and took over.
	WorkerThreadPool.wait_for_group_task_completion(task)
	_curves_task = -1
	if generation != _build_generation or not is_inside_tree():
		return false
	_set_edges(_curves_result[0]["edges"] if _edges_wanted() else {})
	_stamped = _curves_result[1]["stamps"]
	_curves_result = []
	_edges_read()
	return true


## The waters' and roads' near maps, stamped as _read_curves and _read_roads
## stamp them (each curve of two points or more, in order): {waters: [near,
## also], roads: [near, also]}. Reads nothing but its arguments (a worker's).
func _stamps_of(waters: Array, roads: Array) -> Dictionary:
	var water_near: Dictionary[Vector2i, Vector2i] = {}
	var water_also: Dictionary[Vector2i, Array] = {}
	var index := 0
	for water: Dictionary in waters:
		var curve: Dictionary = water["curve"]
		if (curve["points"] as PackedVector2Array).size() < 2:
			continue
		var closed := bool(water.get("closed", false))
		_stamp_near(curve, closed, index, water_near, water_also, not closed)
		index += 1
	var road_near: Dictionary[Vector2i, Vector2i] = {}
	var road_also: Dictionary[Vector2i, Array] = {}
	index = 0
	for road: Dictionary in roads:
		var curve: Dictionary = road["curve"]
		if (curve["points"] as PackedVector2Array).size() < 2:
			continue
		_stamp_near(curve, false, index, road_near, road_also)
		index += 1
	return {"waters": [water_near, water_also], "roads": [road_near, road_also]}


