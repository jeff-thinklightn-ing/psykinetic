## A hand's id that names an art slot, not an item (a work's tool).
const ART_ID := "art:"


## [param tool] in its socket as [param work] holds it (its "grip").
static func _grip(tool: Node3D, work: Dictionary) -> void:
	tool.position = Vector3(0.0, -float(work.get("grip", 0.0)), 0.0)


## [param entity]'s work as ACTIVITIES has it ({} for none): a resident's
## activity, anyone's bandaging (tending).
static func work_of(entity: GridEntity) -> Dictionary:
	return ACTIVITIES.get(work_word(entity), {})


## The ACTIVITIES word of [param entity]'s work: a resident's activity,
## "sleep_side" for a companion asleep, "bandage" while it tends; "" for none.
static func work_word(entity: GridEntity) -> String:
	if entity is Resident and ACTIVITIES.has((entity as Resident).activity):
		return (entity as Resident).activity
	if entity is Companion and (entity as Companion).asleep:
		return "sleep_side"
	return "bandage" if not entity.tending.is_empty() else ""


## A bandager's facing (the bandage kneel): toward the body it tends;
## [param yaw] while it tends none, or itself.
static func _tending_yaw(entity: GridEntity, yaw: float) -> float:
	if entity.tending.is_empty() or entity.tending == String(entity.name):
		return yaw
	for other in World.get_entities():
		if String(other.name) == entity.tending:
			var way := Vector2(other.tile - entity.tile)
			return yaw if way == Vector2.ZERO else -way.angle()
	return yaw


## How far a sleeper's front is turned from its facing: Sleep_Side lies on its
## left side, its front where its left hand was (the model's +X), and _lay
## turns a lying model round (faces + PI), which puts that front on the body's
## +Z, a quarter turn clockwise of its facing seen from above.
const SLEEP_FRONT := -PI / 2.0
## How far round a sleeper a fire is looked for: Companion's watch rule
## (rules' fire_cells, 2).
const SLEEP_FIRE_REACH := 2


## A companion asleep (621 amended): her facing laid so her front is to the
## nearest fire within SLEEP_FIRE_REACH cells; [param yaw] while awake or with
## no fire found.
static func _sleeping_yaw(entity: GridEntity, yaw: float) -> float:
	if not entity is Companion or not (entity as Companion).asleep:
		return yaw
	var best := Vector2i.ZERO
	var found := false
	for dy in range(-SLEEP_FIRE_REACH, SLEEP_FIRE_REACH + 1):
		for dx in range(-SLEEP_FIRE_REACH, SLEEP_FIRE_REACH + 1):
			var way := Vector2i(dx, dy)
			if way != Vector2i.ZERO and World.is_fire(entity.tile + way) and (not found or Vector2(way).length() < Vector2(best).length()):
				best = way
				found = true
	return -Vector2(best).angle() - SLEEP_FRONT if found else yaw


## The work kept on the puppet ("work", read by _animate and _lay), and its
## upper layer: the work's, else let go of if it was a work's.
func _sync_work(entity: GridEntity, puppet: Node3D) -> void:
	var work := work_of(entity)
	puppet.set_meta("work", work_word(entity) if not work.is_empty() else "")
	if not puppet.has_meta("laid"):
		puppet.set_meta("laid", work.has("down"))  # First seen asleep: already down (_lying_down).
	if not puppet.has_meta("rig"):
		return
	var rig := puppet.get_meta("rig") as AnimRig
	var upper := str(work.get("upper", ""))
	if upper != "" and rig.upper_clip() != upper and rig.has(upper):
		rig.upper(upper)
	elif upper == "" and rig.upper_clip() != "" and ACTIVITIES.values().any(func(w: Dictionary) -> bool: return str(w.get("upper", "")) == rig.upper_clip()):
		rig.upper_off()


## The shoulder's load: [param slot]'s piece on the "shoulder" socket, gone
## when it's "" (kept as the puppet's "load"); held level with the body
## (SHOULDER_LEVEL in the skeleton's frame), not tipped with the chest the gait
## leans (the walk's 25°, its back end up into the head).
func _sync_load(puppet: Node3D, sockets: Dictionary, slot: String) -> void:
	if slot == str(puppet.get_meta("load", "")):
		_level_load(sockets)
		return
	puppet.set_meta("load", slot)
	var shoulder := sockets.get("shoulder") as Node3D
	if shoulder == null:
		return
	var old := shoulder.get_node_or_null("Load")
	if old != null:
		shoulder.remove_child(old)
		old.queue_free()
	if slot != "" and ArtKit.has(slot):
		var piece := ArtKit.instance(slot)
		piece.name = "Load"
		shoulder.add_child(piece)


## The load on [param sockets]' shoulder, if any, level with the skeleton
## (the socket's BoneAttachment3D's parent), however the chest leans.
static func _level_load(sockets: Dictionary) -> void:
	var shoulder := sockets.get("shoulder") as Node3D
	var carried := shoulder.get_node_or_null("Load") as Node3D if shoulder != null else null
	if carried != null:
		carried.global_basis = (shoulder.get_parent().get_parent() as Node3D).global_basis * SHOULDER_LEVEL


## The "shoulder" socket (566): on the upper chest over the right shoulder,
## out past its joint (SHOULDER_OUT of the way from the chest's middle to it,
## so a log's thickness clears the head: in from it, art-kit's 0.27 m log went
## through the crown), +y up off the shoulder's top and +x forward along the
## body, level in the body's own frame, not the chest bone's (its rest leans
## forward: the log's back end rose to the head) (a carried log lies fore and
## aft, art-kit's carry.*: its origin where it rests, its length along x);
## measured off [param skeleton]'s rest, so every body has it where its own
## shoulder is. [] without the bones.
const SHOULDER_OUT := 1.4
const SHOULDER_UP := 0.09
## The "head" socket (the bard's hat; npc's look word hat=<word>): on the Head
## bone at the top of the skull, its Body's highest vertex within HEAD_LINE of
## the bone's centre line at rest (ears and hair aside), the skull's middle
## front to back (HEAD_BAND below that), +x forward and +y up,
## level in the body's frame (SHOULDER_LEVEL), as art-kit's gear.hat is made:
## its origin at the cap's inside crown. Measured once per body mesh, so the
## woman's head (0.216 m above the bone) and the man's (0.228) each get theirs.
## People only (their sockets' "crown"); [] without the bone or the Body.
const HEAD_LINE := 0.05
const HEAD_BAND := 0.08
static var _crowns := {}
static func _head_socket(skeleton: Skeleton3D) -> Array:
	var head := skeleton.find_bone("Head")
	var body := skeleton.get_node_or_null("Body") as MeshInstance3D
	if head < 0 or body == null or body.mesh == null:
		return []
	var rest := skeleton.get_bone_global_rest(head)
	if not _crowns.has(body.mesh):
		var vertices: PackedVector3Array = body.mesh.surface_get_arrays(0)[Mesh.ARRAY_VERTEX]
		var top := rest.origin.y
		for v in vertices:
			if absf(v.x - rest.origin.x) < HEAD_LINE:
				top = maxf(top, v.y)
		# Front to back, the skull's middle within HEAD_BAND of its top (the top vertex is forward
		# of it: a cap there stood off the brow and the back of the head came through its band).
		var front := -INF
		var back := INF
		for v in vertices:
			if v.y > top - HEAD_BAND and v.y > rest.origin.y:
				front = maxf(front, v.z)
				back = minf(back, v.z)
		_crowns[body.mesh] = Vector3(rest.origin.x, top, (front + back) * 0.5 if front > back else rest.origin.z)
	return ["Head", Transform3D(rest.basis.orthonormalized().inverse() * SHOULDER_LEVEL, rest.affine_inverse() * (_crowns[body.mesh] as Vector3))]


## Worn gear's sockets on a person's front (788's worn slots; the coordinator's
## approval), level in the body's frame as "head" is (+x forward, +y up):
## "neck", the amulet's, on UpperChest where the cord lies at the collarbone
## notch (the Body's front at the Neck bone's height, on the middle line);
## "belt_c", a charm's, on Hips at the belt's front, BELT_C_LEFT to the left of
## the buckle (between the sheath's hip_l and the lantern's belt_r), BELT_C_UP
## over the hips' bone. Each [bone it rides, height bone, height, across],
## measured once per body mesh off its rest; [] without the bones or the Body.
const WORN_SOCKETS := {"neck": ["UpperChest", "Neck", 0.0, 0.0], "belt_c": ["Hips", "Hips", 0.075, 0.07]}
## How near the height and the line across a vertex counts, and how far out
## from the front the socket stands (the cord's or the thong's thickness).
const FRONT_BAND := 0.025
const FRONT_OUT := 0.004
static var _fronts := {}
static func _front_socket(skeleton: Skeleton3D, name: String) -> Array:
	var spec: Array = WORN_SOCKETS[name]
	var ride := skeleton.find_bone(spec[0])
	var level := skeleton.find_bone(spec[1])
	var body := skeleton.get_node_or_null("Body") as MeshInstance3D
	if ride < 0 or level < 0 or body == null or body.mesh == null:
		return []
	var key := [body.mesh, name]
	if not _fronts.has(key):
		var height := skeleton.get_bone_global_rest(level).origin.y + float(spec[2])
		var across := float(spec[3])
		var front := -INF
		var vertices: PackedVector3Array = body.mesh.surface_get_arrays(0)[Mesh.ARRAY_VERTEX]
		for v in vertices:
			if absf(v.y - height) < FRONT_BAND and absf(v.x - across) < FRONT_BAND:
				front = maxf(front, v.z)
		if front == -INF:
			return []
		_fronts[key] = Vector3(across, height, front + FRONT_OUT)
	var rest := skeleton.get_bone_global_rest(ride)
	return [spec[0], Transform3D(rest.basis.orthonormalized().inverse() * SHOULDER_LEVEL, rest.affine_inverse() * (_fronts[key] as Vector3))]


## Worn gear drawn on a person (788's worn slots; the coordinator's approval):
## what a player or a companion has in its head, back, feet, neck and charm
## slots. A row whose worn "look" (Items.worn_of) names a body part shows
## that part (WORN_PARTS: body_gen's Worn_*), tinted its item's colour as
## armour is; a hood hides the hair and any headwear under it, a cloak the
## garb's cape. A row without one hangs its art on its slot's socket
## (WORN_SOCKET_OF): art-kit's worn.<id> if made, else its item.<id> (the
## bear's-claw charm hangs from its own loop); a hat hides the look's own
## headwear. Rings draw nothing. Off, the look's own parts again. A body
## without the part or the socket (an ally's) wears nothing new.
const WORN_PARTS := {"hood": "Worn_Hood", "cloak": "Worn_Cloak", "boots_soft": "Worn_Boots"}
const WORN_SOCKET_OF := {Items.HEAD: "head", Items.NECK: "neck", Items.CHARM: "belt_c"}
const WORN_DRAWN: Array[int] = [Items.HEAD, Items.BACK, Items.FEET, Items.NECK, Items.CHARM]
const HAIR_MESHES: Array[String] = ["Hair_Cropped", "Hair_Bound", "Hair_Long"]
func _sync_worn_gear(entity: GridEntity, puppet: Node3D) -> void:
	if not (entity is Player or entity is Companion) or not puppet.has_meta("look"):
		return
	var model := puppet.get_node_or_null("Body/Model") as Node3D
	if model == null:
		return
	var ids: Array[String] = []
	for slot in WORN_DRAWN:
		ids.append(entity.slots[slot] if slot < entity.slots.size() else "")
	var key := "|".join(ids) + "|" + str(model.get_meta("worn", ""))
	if key == str(model.get_meta("worn_gear", "")):
		return
	model.set_meta("worn_gear", key)
	var look := puppet.get_meta("look") as PersonLook
	var sockets: Dictionary = puppet.get_meta("sockets", {})
	var shown := {}  # Worn_* part -> its item.
	var hats := false
	for i in WORN_DRAWN.size():
		var id := ids[i]
		var slot := WORN_DRAWN[i]
		var word := str(Items.worn_of(id).get("look", "")) if not id.is_empty() else ""
		if WORN_PARTS.has(word):
			shown[WORN_PARTS[word]] = id
		var socket := sockets.get(str(WORN_SOCKET_OF.get(slot, ""))) as Node3D
		if socket == null:
			continue
		var old := socket.get_node_or_null("Worn")
		if old != null:
			socket.remove_child(old)
			old.queue_free()
		if id.is_empty() or not word.is_empty():
			continue
		var art := "worn." + id if ArtKit.has("worn." + id) else str(Items.def(id).get("art", "item." + id))
		if not ArtKit.has(art):
			continue
		var piece := ArtKit.instance(art)
		piece.name = "Worn"
		socket.add_child(piece)
		hats = hats or slot == Items.HEAD
	var armoured := false
	for mesh: MeshInstance3D in model.find_children("Armour_*", "MeshInstance3D", true, false):
		armoured = armoured or mesh.visible
	var hooded := shown.has("Worn_Hood") and model.find_child("Worn_Hood", true, false) != null
	var cloaked := shown.has("Worn_Cloak") and model.find_child("Worn_Cloak", true, false) != null
	for mesh: MeshInstance3D in model.find_children("*", "MeshInstance3D", true, false):
		var name := String(mesh.name)
		if name.begins_with("Worn_"):
			mesh.visible = shown.has(name)
			if mesh.visible:
				mesh.set_instance_shader_parameter("tunic", Items.color_of(shown[name]))
		elif name in HAIR_MESHES:
			# Under a worn hat, the look's own hair even where its own hood had hidden it.
			var own_hair := hats and name == str(PersonLook.HAIR_PARTS.get(look.hair, ""))
			mesh.visible = (name in look.parts or own_hair) and not hooded
		elif name in HEADWEAR_MESHES:
			mesh.visible = name in look.parts and not hooded and not hats
		elif name == "Cape":
			mesh.visible = name in look.parts and not cloaked and not armoured


## A hat by its look word (npc's look_spec "hat=<word>"; the bard's): HATS'
## art slot and variant on the "head" socket, the look's own headwear (hood,
## brimmed hat, cap) put away under it. A word not in HATS, or a build
## without the piece, wears nothing new (as an old client does).
const HATS := {"bard": ["gear.hat", 1]}
const HEADWEAR_MESHES: Array[String] = ["Hood", "Hat_Brimmed", "Cap_Soft"]
static func _wear_hat(scene: Node3D, puppet: Node3D) -> void:
	var look := puppet.get_meta("look") as PersonLook if puppet.has_meta("look") else null
	var head := (puppet.get_meta("sockets", {}) as Dictionary).get("head") as Node3D
	if look == null or head == null:
		return
	var hat: Array = HATS.get(str(look.words.get("hat", "")), [])
	if hat.is_empty() or not ArtKit.has(hat[0]):
		return
	var piece := ArtKit.instance(hat[0], int(hat[1]))
	piece.name = "Hat"
	head.add_child(piece)
	for mesh: MeshInstance3D in scene.find_children("*", "MeshInstance3D", true, false):
		if String(mesh.name) in HEADWEAR_MESHES:
			mesh.visible = false


## A load on the shoulder, in the skeleton's frame: +x the body's front, +y up.
const SHOULDER_LEVEL := Basis(Vector3(0, 0, 1), Vector3.UP, Vector3(-1, 0, 0))
static func _shoulder_socket(skeleton: Skeleton3D, hand: float) -> Array:
	var chest := skeleton.find_bone("UpperChest")
	var arm := skeleton.find_bone("RightUpperArm")
	if chest < 0 or arm < 0:
		return []
	var rest := skeleton.get_bone_global_rest(chest)
	var joint := skeleton.get_bone_global_rest(arm).origin
	var at := Vector3(lerpf(rest.origin.x, joint.x, SHOULDER_OUT), joint.y + SHOULDER_UP * hand, joint.z)
	return ["UpperChest", Transform3D(rest.basis.orthonormalized().inverse() * SHOULDER_LEVEL, rest.affine_inverse() * at)]


## Where on [param cell] a body stands in [param slot]'s piece over [param
## rect], turned by [param yaw] (580 step 3): its "stand" point less the
## cell's middle; none (zero) without one.
static func stand_offset(slot: String, rect: Rect2i, yaw: float, cell: Vector2i) -> Vector3:
	var stand: Variant = ArtKit.spec(slot).get("stand")
	if not stand is Array or (stand as Array).size() != 3:
		return Vector3.ZERO
	var middle := Vector2(rect.position) + Vector2(rect.size - Vector2i.ONE) * 0.5
	var point := Basis(Vector3.UP, yaw) * Vector3(float(stand[0]), float(stand[1]), float(stand[2]))
	return Vector3(middle.x - cell.x, 0.0, middle.y - cell.y) + point


## A townsman asleep (decision 751, npc's side (3)): out of doors (its cell in
## no drawn building) on prop.bedroll, laid from its cell one back, its head
## (the prop's -z) the facing's way, as a house's beds are (add_beds); on a
## drawn bed's head cell, that bed. The puppet's "bed_height" is what the
## body lies on (LIE_HEIGHT, art-kit's measures; pc-character's _lay lifts it),
## 0 when up or on the floor. Kept as the puppet's "bedroll" key while the
## same: its cell and facing.
const BEDROLL := "prop.bedroll"
const LIE_HEIGHT := {"prop.bed": 0.37, "prop.bed_straw": 0.37, "prop.bedroll": 0.09}
func _sync_bedroll(body: Resident, puppet: Node3D) -> void:
	var want := "%s|%s" % [body.tile, body.facing] if body.activity == "sleep" else ""
	if want == str(puppet.get_meta("bedroll", "")):
		return
	puppet.set_meta("bedroll", want)
	var old := puppet.get_node_or_null("Bedroll")
	if old != null:
		puppet.remove_child(old)
		old.queue_free()
	puppet.remove_meta("lie_at")
	var height := 0.0
	if not want.is_empty():
		var bed := _bed_under(body.tile)
		var furnished := _furnished_bed_lie(body.tile) if bed.is_empty() else {}
		if not furnished.is_empty():
			# Beside a furnished (solid) bed (751 amended (4)): drawn on it, its head on the pillow.
			puppet.set_meta("lie_at", furnished["at"])
			height = float(furnished["height"])
		elif bed.is_empty() and not _indoors(body.tile) and ArtKit.has(BEDROLL):
			var way := Vector2(body.facing)
			var piece := ArtKit.instance(BEDROLL)
			piece.name = "Bedroll"
			piece.transform = Transform3D(Basis(Vector3.UP, atan2(-way.x, -way.y)), Vector3(-way.x, 0.0, -way.y) * 0.5)
			puppet.add_child(piece)
			height = float(LIE_HEIGHT[BEDROLL])
		elif not bed.is_empty() and not bool(bed.get("solid", false)):
			height = float(LIE_HEIGHT.get(str(bed.get("prop", "")), 0.0))
	puppet.set_meta("bed_height", height)


## A sleeper on [param cell] beside a drawn furnished bed (751 amended (4);
## the coordinator, from Jeff's playtest: "hob was sleeping on a bedroll
## instead of his own bed"): the turf house's bed is "solid" (Level's
## FURNISHED_BED, its cells out of the floor), so the sim lays its sleeper on
## the walkable cell beside its head (Main._bed_in), and the client draws him
## on the bed itself. {at: the bed's head end (its pillow edge, on its centre
## line) from [param cell]'s ground point, in the puppet's frame (x, z), as
## _lay's offset is; height: the bed's top (LIE_HEIGHT) over that ground},
## from the bed art_dress drew (the building's parts/Bed, prop.bed_straw, its
## head art-kit's -z); {} for none beside, or none drawn.
func _furnished_bed_lie(cell: Vector2i) -> Dictionary:
	for building: Variant in _drawn_buildings():
		if not building is Dictionary:
			continue
		for bed: Variant in (building as Dictionary).get("beds", []):
			if not bed is Dictionary or not bool((bed as Dictionary).get("solid", false)) or ((bed as Dictionary).get("cells", []) as Array).is_empty():
				continue
			var head_cell: Vector2i = (bed as Dictionary)["cells"][0]
			if absi(head_cell.x - cell.x) + absi(head_cell.y - cell.y) != 1:
				continue
			for drawn: Dictionary in _buildings:
				var node: Variant = drawn.get("node")
				if not (drawn.get("rect", Rect2i()) as Rect2i).has_point(head_cell) or not is_instance_valid(node):
					continue
				var piece := (node as Node3D).get_node_or_null("parts/Bed") as Node3D
				if piece == null:
					continue
				var parts := piece.get_parent() as Node3D
				var placed := (node as Node3D).transform * parts.transform * piece.transform
				var prop := str((bed as Dictionary).get("prop", "prop.bed_straw"))
				var size: Array = ArtKit.spec(prop).get("size", [0.85, 0.5, 1.8]) if ArtKit.has(prop) else [0.85, 0.5, 1.8]
				var head := placed * Vector3(0.0, 0.0, -float(size[2]) * 0.5)
				var ground := Vector3(cell.x, _ground_height(Vector2(cell)), cell.y)
				return {"at": Vector2(head.x - ground.x, head.z - ground.z),
					"height": placed.origin.y + float(LIE_HEIGHT.get(prop, 0.37)) - ground.y}
	return {}


## The drawn bed whose head cell is [param cell] ({} for none).
func _bed_under(cell: Vector2i) -> Dictionary:
	for building: Variant in _drawn_buildings():
		if building is Dictionary:
			for bed: Variant in (building as Dictionary).get("beds", []):
				if bed is Dictionary and not (bed["cells"] as Array).is_empty() and (bed["cells"] as Array)[0] == cell:
					return bed
	return {}


## Whether [param cell] lies in a drawn building's rect.
func _indoors(cell: Vector2i) -> bool:
	for building: Variant in _drawn_buildings():
		if building is Dictionary and (building as Dictionary).get("rect") is Rect2i and ((building as Dictionary)["rect"] as Rect2i).has_point(cell):
			return true
	return false


## A sleeper lies on its bed cell (566): the Lie clip falls back from the feet,
## its head behind them, so the model turns half round to put the head toward
## the facing (the sim's: to the wall) and the body moves back by the lying
## body's middle (LIE_MIDDLE, measured: the head 1.14 m behind the feet' 0.23
## ahead) so it lies on the cell, not beside it. Else as it stands. [param yaw]
## the facing's, turned by the caller. Standing on a cell whose piece has a
## stand point (_stand_at: the draugr on his throne, 580 step 3), the body
## stands there, until step 4's seated idle replaces it.
const LIE_MIDDLE := 0.46
## A sleeper curled on its side (751) lies farther back: its head at the
## tile's forward end, its middle half a cell behind the tile, on the bed or
## bedroll there (npc's: the bed's head cell is the tile, the facing the way
## the head points); measured on the strip (build/sleep/strip.gd).
const SLEEP_MIDDLE := 0.81
## On a furnished bed (751 amended (4); pc-character's measure): the curled
## body's root this far behind the pillow end (the bedroll's pillow end is
## 0.46 ahead of the tile, the root SLEEP_MIDDLE behind it), so the head lies
## on the pillow whatever the bed's length; _furnished_bed_lie's "at" is the
## pillow end.
const SLEEP_HEAD_BACK := SLEEP_MIDDLE + 0.46
## The curl reaches 0.50 m before the root (the knees) and 0.27 behind (the back): slid back by
## half the difference so it lies across the bed's middle (build/sleep/fit.gd, 751 amended (4)).
const SLEEP_ASIDE := 0.11
func _lay(puppet: Node3D, body: Node3D, yaw: float, cell := Vector2i(-1, -1)) -> void:
	var work: Dictionary = ACTIVITIES.get(str(puppet.get_meta("work", "")), {})
	var lying := bool(work.get("lying", false)) or Time.get_ticks_msec() < int(puppet.get_meta("rising_until", 0))
	_posture_lying(puppet, lying)
	var offset: Vector3 = _stand_at.get(cell, Vector3.ZERO)
	if work.has("toward") and float(puppet.get_meta("speed", 0.0)) <= WALKING:
		# Leant in to its work (the bandage kneel), only while it is still: walking, as it stands.
		offset += Vector3(cos(yaw), 0.0, -sin(yaw)) * float(work["toward"]) * float(puppet.get_meta("model_scale", 1.0))
	var seated := _seated_share(puppet, Time.get_ticks_msec())
	if seated > 0.0:
		# Sat (or sitting down, or got up): its hips over the seat under its cell (SEAT_TOWARD).
		offset += Vector3(cos(yaw), 0.0, -sin(yaw)) * SEAT_TOWARD * seated * float(puppet.get_meta("model_scale", 1.0))
	if lying:
		var ahead := Vector3(cos(yaw), 0.0, -sin(yaw))
		offset = -ahead * (SLEEP_MIDDLE if work.has("down") else LIE_MIDDLE) * float(puppet.get_meta("model_scale", 1.0))
		if work.has("down") and puppet.has_meta("lie_at"):
			# On a furnished bed beside its cell (751 amended (4)): the head on its pillow end.
			var pillow: Vector2 = puppet.get_meta("lie_at")
			offset = Vector3(pillow.x, 0.0, pillow.y) - ahead * SLEEP_HEAD_BACK * float(puppet.get_meta("model_scale", 1.0))
		if work.has("down"):
			# Across the bed's or bedroll's middle, its knees not over the edge (SLEEP_ASIDE).
			offset -= Vector3(-ahead.z, 0.0, ahead.x) * SLEEP_ASIDE * float(puppet.get_meta("model_scale", 1.0))
		# On a bed or bedroll drawn under it (npc's and buildings' side, 751): its height.
		offset.y = float(puppet.get_meta("bed_height", 0.0))
	if body.position != offset:
		body.position = offset
	var model := body.get_node_or_null("Model") as Node3D
	if model == null:
		return
	if not puppet.has_meta("faces"):
		puppet.set_meta("faces", model.rotation.y)
	# Plus a steadied person's twist (843: Client3D._steady's, eased by its tween).
	var want := float(puppet.get_meta("faces")) + (PI if lying else 0.0) + float(puppet.get_meta("steady_twist", 0.0))
	if not is_equal_approx(model.rotation.y, want):
		model.rotation.y = want



## A person's posture (the old's stoop, a slouch: POSTURES, added on its AnimRig) is a
## standing body's: added to a sleeper's curl it lifted the trunk 7 cm off the bed, the legs
## on it (751 amended (5); Hob, the healer, stooped with age). Lying, lying down and rising
## ([param lying], _lay's), it fades off over POSTURE_FADE; standing, back on. Seen first
## lying, it is off at once.
const POSTURE_FADE := 0.6
func _posture_lying(puppet: Node3D, lying: bool) -> void:
	if not puppet.has_meta("posture"):
		return
	var now := Time.get_ticks_msec()
	var want := 0.0 if lying else 1.0
	var weight := want
	if puppet.has_meta("posture_ms"):
		var step := float(now - int(puppet.get_meta("posture_ms"))) / 1000.0 / POSTURE_FADE
		weight = move_toward(float(puppet.get_meta("posture_weight", 1.0)), want, step)
	puppet.set_meta("posture_ms", now)
	if puppet.has_meta("posture_weight") and is_equal_approx(float(puppet.get_meta("posture_weight")), weight):
		return
	puppet.set_meta("posture_weight", weight)
	(puppet.get_meta("rig") as AnimRig).posture(puppet.get_meta("posture") as Animation, weight)


## While the local player draws (decision 583), its body turns to ui's aim,
## Main.aim_angle (radians on the grid, as the sim's), not its eight-way
## facing, so the bow points at the marker; [param yaw] otherwise. Read by
## name: before ui's aim it is the facing, as before.
func _aimed_yaw(entity: GridEntity, yaw: float) -> float:
	if String(entity.name) != _local_name or entity.raised != "draw":
		return yaw
	var main := get_parent()
	if main == null or main.get("aim_drawn") != true:
		return yaw
	return -float(main.get("aim_angle"))


## A body standing still turns slower than it walks round (560, pc-character's
## side; Jeff: a resident clicked "stop, turn to face the player"): when its
## facing swings by more than STAND_TURN_MIN while it stands, the puppet turns
## at STAND_TURN_SPEED (a half turn in about 0.4 s), its feet shuffling
## (shuffle_until, the walk at STAND_SHUFFLE_PACE), not spun on the spot in a
## tenth of a second as the shown facing eases; moving, it follows the facing.
## People only (residents, companions, players): a monster still turns at
## once, its threat read from its facing. The yaw to show from [param shown] toward [param yaw].
const STAND_TURN_MIN := PI / 4.0
const STAND_TURN_SPEED := PI / 0.4
const STAND_SHUFFLE_PACE := 0.6
const CLIP_TALKING := "Idle_Talking"
func _standing_turn(puppet: Node3D, shown: float, yaw: float) -> float:
	var now := Time.get_ticks_msec()
	var then := int(puppet.get_meta("turned_ms", -1))
	puppet.set_meta("turned_ms", now)
	var left := angle_difference(shown, yaw)
	var turning: bool = puppet.get_meta("turning", false)
	if then < 0 or float(puppet.get_meta("speed", 0.0)) > WALKING or not turning and absf(left) <= STAND_TURN_MIN:
		puppet.set_meta("turning", false)
		return yaw
	var step := STAND_TURN_SPEED * clampf((now - then) / 1000.0, 0.0, 0.1)
	if absf(left) <= step:
		puppet.set_meta("turning", false)
		return yaw
	puppet.set_meta("turning", true)
	puppet.set_meta("shuffle_until", now + 120)
	return shown + signf(left) * step


## Teetering on a rim (783 amended; the coordinator's design): while a body's
## replicated teeter (the way the drop lies) is not ZERO its model turns to
## face the drop over about TEETER_TURN (the sim's facing untouched), and back
## to its own facing after; it rocks toward the drop, pivoting at its feet, a
## jolt of TEETER_JOLT first and then TEETER_RATE swings a second about a lean
## of TEETER_LEAN, growing from TEETER_SWING_FROM to TEETER_SWING_TO degrees
## over TEETER_SECONDS (the sim's teeter_ticks), settled upright over
## TEETER_SETTLE when it ends; a person plays CLIP_TEETER (a creature,
## CreatureView's). The local player pressing a way (or walking) keeps their
## own facing: the turn never takes the controls. Gone over, the push's knock
## (592) has it, the rocking dropped at once.
const TEETER_TURN := 0.1
const TEETER_JOLT := 10.0
const TEETER_LEAN := 4.0
const TEETER_RATE := 2.2
const TEETER_SWING_FROM := 6.0
const TEETER_SWING_TO := 14.0
const TEETER_SECONDS := 1.2
const TEETER_SETTLE := 0.25
const CLIP_TEETER := "Teeter"
func _teeter_yaw(entity: GridEntity, puppet: Node3D, yaw: float, now: int) -> float:
	if _steering(entity):
		puppet.remove_meta("teeter_turned_until")  # Theirs at once, not eased back.
		return yaw
	var teetering := entity.teeter != Vector2i.ZERO
	if teetering:
		puppet.set_meta("teeter_turned_until", now + int((TEETER_TURN + TEETER_SETTLE) * 1000.0))
	elif now >= int(puppet.get_meta("teeter_turned_until", 0)):
		return yaw
	var body := puppet.get_node_or_null("Body") as Node3D
	if body == null:
		return yaw
	var to := -Vector2(entity.teeter).angle() if teetering else yaw
	return lerp_angle(body.rotation.y, to, clampf(get_process_delta_time() / TEETER_TURN, 0.0, 1.0))


## Whether [param entity] is the local player steering (a walk key held, or
## walking): its facing is theirs, teetering or not.
func _steering(entity: GridEntity) -> bool:
	if not entity is Player or entity != _local_player():
		return false
	var main := get_parent()
	return entity.stepping or main != null and main.has_method("_held_key_names") and str(main.call("_held_key_names")) != ""


## The rock on a rim: [param body] tipped toward the drop by the lean for now
## (degrees; negative rocks it back), about its feet, whichever way it faces.
func _teeter_lean(entity: GridEntity, puppet: Node3D, body: Node3D, now: int) -> void:
	var settle := 1.0
	if entity.teeter != Vector2i.ZERO and not _sliding(puppet, entity):
		if not puppet.has_meta("teeter_ms"):
			puppet.set_meta("teeter_ms", now)
		var t := (now - int(puppet.get_meta("teeter_ms"))) / 1000.0
		var swing := lerpf(TEETER_SWING_FROM, TEETER_SWING_TO, clampf(t / TEETER_SECONDS, 0.0, 1.0)) * sin(TAU * TEETER_RATE * t)
		var jolt := TEETER_JOLT * sin(PI * clampf(t / 0.2, 0.0, 1.0))
		puppet.set_meta("teeter_lean", TEETER_LEAN * clampf(t / 0.1, 0.0, 1.0) + jolt + swing)
		puppet.set_meta("teeter_way", Vector2(entity.teeter).normalized())
		puppet.remove_meta("teeter_end")
	elif not puppet.has_meta("teeter_lean"):
		return
	else:
		puppet.remove_meta("teeter_ms")
		if puppet.has_meta("knock"):
			puppet.set_meta("teeter_end", 0)  # Gone over: the rock dropped at once.
		elif not puppet.has_meta("teeter_end"):
			puppet.set_meta("teeter_end", now)
		var u := (now - int(puppet.get_meta("teeter_end"))) / 1000.0 / TEETER_SETTLE
		if u >= 1.0:
			for key in ["teeter_lean", "teeter_way", "teeter_end"]:
				puppet.remove_meta(key)
			body.rotation.x = 0.0
			body.rotation.z = 0.0
			return
		settle = 1.0 - u
	var way: Vector2 = puppet.get_meta("teeter_way")
	# The drop in the body's own frame (turned by its yaw only): a lean toward its +Z is a turn
	# about X, toward its +X one about -Z.
	var local := Basis(Vector3.UP, -body.rotation.y) * Vector3(way.x, 0.0, way.y)
	var lean := deg_to_rad(float(puppet.get_meta("teeter_lean")) * settle)
	body.rotation.x = lean * local.z
	body.rotation.z = -lean * local.x


## Whether [param puppet]'s push slide (592's knock) is still on screen.
static func _sliding(puppet: Node3D, entity: GridEntity) -> bool:
	return puppet.has_meta("knock") and entity.push_shown in [GridEntity.PushShown.SLIDING, GridEntity.PushShown.WAITING]


## A resident addressing someone (Resident.addressing, npc's, 560) looks at
## them: its head turned toward theirs by a LookAtModifier3D on its skeleton
## (made the first time, its limits a neck's: LOOK_LIMIT across, LOOK_LIMIT_UP
## up and down), eased in and out over LOOK_EASE; and while it stands it plays
## CLIP_TALKING (_animate). The target is a marker kept at their eyes
## (_eyes_of).
const LOOK_LIMIT := deg_to_rad(70.0)
const LOOK_LIMIT_UP := deg_to_rad(35.0)
const LOOK_EASE := 0.3
const LOOK_EYES := 1.6
func _sync_addressing(resident: Resident, puppet: Node3D) -> void:
	var whom := resident.get_node_or_null(NodePath(resident.addressing)) as GridEntity if resident.addressing != "" else null
	var body: Node3D = _puppets.get(whom.get_instance_id()) if whom != null else null
	puppet.set_meta("addressing", resident.addressing if body != null else "")
	var look := puppet.get_node_or_null("Look") as Node3D
	if body == null and look == null:
		return
	if look == null:
		var skeletons := puppet.find_children("*", "Skeleton3D", true, false)
		if skeletons.is_empty():
			return
		var skeleton := skeletons[0] as Skeleton3D
		var head := skeleton.find_bone("Head")
		if head < 0:
			return
		look = Node3D.new()
		look.name = "Look"
		puppet.add_child(look)
		var turn := LookAtModifier3D.new()
		turn.name = "LookAt"
		turn.bone_name = "Head"
		turn.forward_axis = _bone_axis(skeleton.get_bone_global_rest(head).basis.inverse() * Vector3.BACK)
		turn.use_angle_limitation = true
		turn.symmetry_limitation = true
		turn.primary_limit_angle = LOOK_LIMIT
		turn.secondary_limit_angle = LOOK_LIMIT_UP
		turn.duration = LOOK_EASE
		turn.influence = 0.0
		skeleton.add_child(turn)
		turn.target_node = turn.get_path_to(look)
		look.set_meta("turn", turn)
	var turn := look.get_meta("turn") as LookAtModifier3D
	var wanted := 1.0 if body != null else 0.0
	if body != null:
		look.global_position = _eyes_of(body)
	var step := clampf((Time.get_ticks_msec() - int(look.get_meta("eased_ms", Time.get_ticks_msec()))) / 1000.0 / LOOK_EASE, 0.0, 1.0)
	look.set_meta("eased_ms", Time.get_ticks_msec())
	turn.influence = move_toward(turn.influence, wanted, step)


## Where [param body]'s eyes are: its head bone as posed, else LOOK_EYES m up.
static func _eyes_of(body: Node3D) -> Vector3:
	var skeletons := body.find_children("*", "Skeleton3D", true, false)
	if not skeletons.is_empty():
		var skeleton := skeletons[0] as Skeleton3D
		var head := skeleton.find_bone("Head")
		if head >= 0:
			return skeleton.global_transform * skeleton.get_bone_global_pose(head).origin
	return body.global_position + Vector3.UP * LOOK_EYES


## The bone axis (SkeletonModifier3D.BoneAxis) nearest [param along], a
## direction in the bone's own frame.
static func _bone_axis(along: Vector3) -> SkeletonModifier3D.BoneAxis:
	var axis := along.abs().max_axis_index()
	var plus := along[axis] >= 0.0
	match axis:
		Vector3.AXIS_X:
			return SkeletonModifier3D.BONE_AXIS_PLUS_X if plus else SkeletonModifier3D.BONE_AXIS_MINUS_X
		Vector3.AXIS_Y:
			return SkeletonModifier3D.BONE_AXIS_PLUS_Y if plus else SkeletonModifier3D.BONE_AXIS_MINUS_Y
	return SkeletonModifier3D.BONE_AXIS_PLUS_Z if plus else SkeletonModifier3D.BONE_AXIS_MINUS_Z


## Standing: tired when hurt or winded, else idle (a model's own, its "idle").
static func _idle_clip(puppet: Node3D) -> String:
	var entity := instance_from_id(int(puppet.get_meta("entity_id", 0))) as GridEntity
	if entity != null and entity.max_hp > 0 and (float(entity.hp) / entity.max_hp < TIRED_BELOW
			or entity.max_stamina > 0 and entity.stamina_fraction() < GridEntity.WINDED_BELOW):
		return CLIP_TIRED
	return str(puppet.get_meta("idle", CLIP_IDLE))


## A model's clip for what it is doing: a one-off (an attack, a flinch, a
## death) plays out; otherwise it walks while it moves, at its pace, and
## stands idle when it does not.
func _animate(puppet: Node3D) -> void:
	var rig := puppet.get_meta("rig") as AnimRig
	var now := Time.get_ticks_msec()
	var last: Vector3 = puppet.get_meta("last_at", puppet.position)
	var seconds := (now - int(puppet.get_meta("last_ms", now))) / 1000.0
	puppet.set_meta("last_at", puppet.position)
	puppet.set_meta("last_ms", now)
	var speed: float = puppet.get_meta("speed", 0.0)
	var step := Vector2(puppet.position.x - last.x, puppet.position.z - last.z)
	if seconds > 0.0:
		speed = lerpf(speed, step.length() / seconds, clampf(seconds * 12.0, 0.0, 1.0))
	puppet.set_meta("speed", speed)
	var entity := instance_from_id(int(puppet.get_meta("entity_id", 0))) as GridEntity
	if puppet.get_meta("teetering", false) and rig.has(CLIP_TEETER) and entity != null and not _sliding(puppet, entity):
		# On a rim (783 amended): arms wheeling, once its push's slide has shown; the knock it
		# stopped short is over, with no doubling over.
		if puppet.has_meta("knock"):
			puppet.remove_meta("knock")
		puppet.set_meta("busy_until", 0)
		puppet.set_meta("fidgeting", false)
		rig.loop(CLIP_TEETER, 1.0)
		return
	if puppet.has_meta("knock") and _knocked(puppet, rig, speed, now):
		return
	var calm := now - int(_combat_at.get(int(puppet.get_meta("entity_id", 0)), -(1 << 40))) > int(FIDGET_CALM_SECONDS * 1000.0)
	var work: Dictionary = ACTIVITIES.get(str(puppet.get_meta("work", "")), {})
	var crouched: bool = puppet.get_meta("crouched", false) and rig.has(CLIP_CROUCH)
	var aside := str(puppet.get_meta("aside_of", ""))
	if aside != "" and (aside != str(puppet.get_meta("work", "")) or speed > WALKING or not calm):
		puppet.set_meta("aside_of", "")  # A work's aside (its show, its give) goes with the work.
		puppet.set_meta("fidgeting", false)
		puppet.set_meta("busy_until", 0)
	elif aside == "" and puppet.get_meta("fidgeting", false) and (speed > WALKING or not calm or _work_clip(puppet, work) != "" or crouched):
		# A fidget (or sitting down, or getting up) is no reason to stand
		# still, nor to put off a work begun (a bandage's kneel, items' (3)):
		# it goes.
		puppet.set_meta("fidgeting", false)
		puppet.set_meta("busy_until", 0)
	if speed > WALKING and puppet.get_meta("seated", false):
		puppet.set_meta("seated", false)
		puppet.set_meta("busy_until", 0)
	if speed > WALKING and now < int(puppet.get_meta("unseat_until", 0)):
		# Walked off while getting up from a seat or stepping back from a counter (_seat, _work_enter):
		# it goes, before the busy wait below would slide it along in the pose.
		puppet.set_meta("unseat_until", now)
		puppet.set_meta("busy_until", 0)
	# A strike while it steps ("blows you can see", 2): the legs walk its gait under the blow,
	# faded in and out over LEGS_FADE, so a step taken in a strike is not slid in its pose.
	var stepping := rig.striking() and speed > WALKING
	var legs_to := 1.0 if stepping else 0.0
	if rig.legs_amount() != legs_to:
		rig.legs_walk(move_toward(rig.legs_amount(), legs_to, seconds / ArtKit.feel("client3d.legs_fade", LEGS_FADE)))
	if stepping and now < int(puppet.get_meta("busy_until", 0)):
		_gait(puppet, rig, speed)
		return
	if now < int(puppet.get_meta("busy_until", 0)):
		return
	puppet.set_meta("fidgeting", false)
	var pace: float = puppet.get_meta("pace", 1.0)
	var tempo: float = puppet.get_meta("tempo", 1.0)
	if speed <= WALKING and rig.has(CLIP_SITTING):
		var sitting := _sitting(puppet)
		var seated: bool = puppet.get_meta("seated", false)
		if sitting and not seated:
			_play_fidget(puppet, rig, CLIP_SIT_DOWN, now, tempo)
			puppet.set_meta("seated", true)
			return
		if sitting:
			rig.loop(CLIP_SITTING, tempo)
			return
		if seated:
			_play_fidget(puppet, rig, CLIP_SIT_UP, now, tempo)
			puppet.set_meta("seated", false)
			return
	if _lying_down(puppet, rig, work, speed, now, tempo):
		return
	if _seat(puppet, rig, work, speed, now, tempo):
		return
	if _work_enter(puppet, rig, work, speed, now, tempo):
		return
	if crouched:
		# Crouched (784 amended (2)): it creeps when it moves, at the creep's stride, else crouches.
		if speed > WALKING and rig.has(CLIP_CREEP):
			var walk := float(paced(puppet.get_meta("gaits", GAITS))[0][1])
			rig.loop(CLIP_CREEP, clampf(speed / (walk * ArtKit.feel("client3d.creep_stride", CREEP_STRIDE) * pace)
					* ArtKit.feel("client3d.gait_rate", GAIT_RATE), 0.3, CREEP_FASTEST))
		else:
			rig.loop(CLIP_CROUCH, tempo)
		return
	if speed > WALKING and wading(puppet, rig):
		# In water over WADE_DEPTH (775): the high-stepping wade, paced as a gait.
		rig.loop(CLIP_WADE, clampf(speed / (ArtKit.feel("client3d.gait." + CLIP_WADE, WADE_PACE) * pace)
				* ArtKit.feel("client3d.gait_rate", GAIT_RATE), 0.3, 3.0))
		return
	if speed > WALKING:
		_gait(puppet, rig, speed)
		return
	if entity != null and not entity.fishing.is_empty():
		if _fishing_pose(puppet, rig, entity, now):
			return
	elif puppet.has_meta("fish_state"):
		puppet.remove_meta("fish_state")  # Reeled in: the next cast is cast again.
	var at_work := _work_clip(puppet, work)
	if speed <= WALKING and at_work != "" and rig.has(at_work):
		# At its work (566): the work's clip, looped; now and then one of its asides (a keeper's show).
		if _work_aside(puppet, rig, work, now, tempo):
			return
		rig.loop(at_work, tempo)
		return
	if now < int(puppet.get_meta("shuffle_until", 0)) and rig.has(CLIP_WALK):
		# Turning where it stands (_standing_turn): its feet shuffle round.
		rig.loop(CLIP_WALK, STAND_SHUFFLE_PACE)
		return
	var beckon := beckon_clip(puppet, rig)
	if beckon != "" and now >= int(puppet.get_meta("beckon_at", 0)):
		# A guide waiting for the one she leads (companions' guide_wait 2, the server turning her to
		# him): she beckons him on, again every BECKON_EVERY while she waits.
		puppet.set_meta("beckon_at", now + int(BECKON_EVERY * 1000.0))
		_play_fidget(puppet, rig, beckon, now, tempo)
		return
	if str(puppet.get_meta("addressing", "")) != "" and rig.has(CLIP_TALKING) and fidget_with(CLIP_TALKING, in_hand(puppet)):
		# Addressing someone (560): it talks to them (with a thing in hand,
		# no gestures: it stands, 662).
		rig.loop(CLIP_TALKING, tempo)
		return
	var idle := _idle_clip(puppet)
	var both_hands := puppet.has_meta("reach") and (puppet.get_meta("reach") as HandReach).active  # Ready with a two-hander: no fidgets.
	if idle == CLIP_IDLE and calm and not both_hands and puppet.has_meta("rng") and now >= int(puppet.get_meta("fidget_at", 0)):
		var rng: RandomNumberGenerator = puppet.get_meta("fidget_rng", puppet.get_meta("rng"))
		puppet.set_meta("fidget_at", now + int(rng.randf_range(FIDGET_SECONDS_MIN, FIDGET_SECONDS_MAX) * 1000.0))
		var fidget := _pick_fidget(puppet, rig)
		if not fidget.is_empty():
			_play_fidget(puppet, rig, fidget, now, tempo)
			return
	rig.loop(idle, tempo)


## Its gait for [param speed] (m/s), looped at the stride's rate.
func _gait(puppet: Node3D, rig: AnimRig, speed: float) -> void:
	var pace: float = puppet.get_meta("pace", 1.0)
	var gaits := paced(puppet.get_meta("gaits", GAITS))
	var gait: Array = gaits[gait_for(rig.base_clip(), speed / pace, gaits)]
	rig.loop(gait[0], clampf(speed / (float(gait[1]) * pace) * ArtKit.feel("client3d.gait_rate", GAIT_RATE), 0.3, 3.0))


## [param work]'s clip for [param puppet]: its "clip", else one of its "clips" by the body
## (each the same every time it is seen, its neighbour likely another); "" for none.
static func _work_clip(puppet: Node3D, work: Dictionary) -> String:
	if work.has("clip"):
		return str(work["clip"])
	var clips: Array = work.get("clips", [])
	if clips.is_empty():
		return ""
	return str(clips[absi(int(puppet.get_meta("entity_id", 0))) % clips.size()])


## A work on a seat (its "seat": npc's "sit" spots) is sat down to once (SEAT_DOWN), its clip
## looped after; ended, its body gets up (SEAT_UP), cut short if it walks off first. A body first
## seen at it is already sat. True while one of them plays this frame.
func _seat(puppet: Node3D, rig: AnimRig, work: Dictionary, speed: float, now: int, tempo: float) -> bool:
	if not puppet.has_meta("sat"):
		puppet.set_meta("sat", work.has("seat"))
		puppet.set_meta("seat_at", now - int(SEAT_EASE * 1000.0) if work.has("seat") else 0)
		return false
	var sat: bool = puppet.get_meta("sat")
	if work.has("seat") and not sat and speed <= WALKING and rig.has(SEAT_DOWN):
		puppet.set_meta("sat", true)
		puppet.set_meta("seat_at", now)
		puppet.set_meta("busy_until", now + int(rig.once(SEAT_DOWN, tempo) * 1000.0))
		return true
	if sat and not work.has("seat"):
		puppet.set_meta("sat", false)
		if rig.has(SEAT_UP) and speed <= WALKING:
			var until := now + int(rig.once(SEAT_UP, tempo) * 1000.0)
			puppet.set_meta("busy_until", until)
			puppet.set_meta("unseat_until", until)
			return true
		puppet.set_meta("unseat_until", now)
	if speed > WALKING and now < int(puppet.get_meta("unseat_until", 0)):
		puppet.set_meta("unseat_until", now)  # Walked off while getting up: it goes.
		puppet.set_meta("busy_until", 0)
	return false


## A work stepped up to (its "enter": a keeper at its counter) plays that once as it begins, once
## stood, and its "exit" once as it ends, cut short if it walks off (_animate's "unseat_until"). A
## body first seen at it is already there. True while one of them plays this frame.
func _work_enter(puppet: Node3D, rig: AnimRig, work: Dictionary, speed: float, now: int, tempo: float) -> bool:
	var word := str(puppet.get_meta("work", ""))
	if not puppet.has_meta("entered"):
		puppet.set_meta("entered", word if work.has("enter") else "")
		return false
	var entered := str(puppet.get_meta("entered"))
	if entered == word:
		return false
	if not entered.is_empty():
		puppet.set_meta("entered", "")
		var exit := str(ACTIVITIES.get(entered, {}).get("exit", ""))
		if exit != "" and rig.has(exit) and speed <= WALKING:
			var until := now + int(rig.once(exit, tempo) * 1000.0)
			puppet.set_meta("busy_until", until)
			puppet.set_meta("unseat_until", until)
			return true
	if work.has("enter") and speed <= WALKING and rig.has(str(work["enter"])):
		puppet.set_meta("entered", word)
		puppet.set_meta("busy_until", now + int(rig.once(str(work["enter"]), tempo) * 1000.0))
		return true
	return false


## At a work with "asides" (a keeper's show and give, a sitter's other idles), one of them now and
## then, every FIDGET_SECONDS_MIN to MAX by its fidget_rng, never the one before nor the body's own
## clip at the work; true as one starts.
func _work_aside(puppet: Node3D, rig: AnimRig, work: Dictionary, now: int, tempo: float) -> bool:
	var asides: Array = work.get("asides", [])
	if asides.is_empty() or not puppet.has_meta("rng"):
		return false
	var rng: RandomNumberGenerator = puppet.get_meta("fidget_rng", puppet.get_meta("rng"))
	if not puppet.has_meta("aside_at"):
		puppet.set_meta("aside_at", now + int(rng.randf_range(2.0, FIDGET_SECONDS_MAX) * 1000.0))
	if now < int(puppet.get_meta("aside_at")):
		return false
	puppet.set_meta("aside_at", now + int(rng.randf_range(FIDGET_SECONDS_MIN, FIDGET_SECONDS_MAX) * 1000.0))
	var choices: Array = asides.filter(func(clip: String) -> bool:
		return rig.has(clip) and clip != _work_clip(puppet, work) and (asides.size() == 1 or clip != str(puppet.get_meta("aside_clip", ""))))
	if choices.is_empty():
		return false
	var clip: String = choices[rng.randi_range(0, choices.size() - 1)]
	puppet.set_meta("aside_clip", clip)
	_play_fidget(puppet, rig, clip, now, tempo)
	puppet.set_meta("aside_of", str(puppet.get_meta("work", "")))
	return true


## How far [param puppet] is drawn toward its seat's place (0 to 1): eased in over SEAT_EASE as
## it sits (_seat's "seat_at"), held while sat and while it gets up, eased out after.
static func _seated_share(puppet: Node3D, now: int) -> float:
	if bool(puppet.get_meta("sat", false)):
		return clampf((now - int(puppet.get_meta("seat_at", 0))) / (SEAT_EASE * 1000.0), 0.0, 1.0)
	var since := now - int(puppet.get_meta("unseat_until", -(1 << 40)))
	return clampf(1.0 - since / (SEAT_EASE * 1000.0), 0.0, 1.0)


## A work lain down to (its "down", 751: a sleeper) is lain down to once, its
## clip looped after; ended, its body gets up again (CLIP_SLEEP_UP), still
## turned as it lay till it stands (_lay's "rising_until"). A body first seen
## at it is already down. True while one of them plays this frame.
func _lying_down(puppet: Node3D, rig: AnimRig, work: Dictionary, speed: float, now: int, tempo: float) -> bool:
	if not puppet.has_meta("laid"):
		puppet.set_meta("laid", work.has("down"))
		return false
	var laid: bool = puppet.get_meta("laid")
	if work.has("down") and not laid and speed <= WALKING and rig.has(str(work["down"])):
		puppet.set_meta("laid", true)
		puppet.set_meta("busy_until", now + int(rig.once(str(work["down"]), tempo) * 1000.0))
		return true
	if laid and not work.has("down"):
		puppet.set_meta("laid", false)
		if rig.has(CLIP_SLEEP_UP):
			var until := now + int(rig.once(CLIP_SLEEP_UP, tempo) * 1000.0)
			puppet.set_meta("busy_until", until)
			puppet.set_meta("rising_until", until)
			return true
	return false


## [param clip] once through from its start, at [param tempo], blended in,
## the model busy with it till it ends (a fidget: dropped if it moves or a
## fight comes to it).
## Fishing (805 amended (6); items' GridEntity.fishing): each state's clip
## (tools/humanoid_clips.py), the rod in the right hand. The cast (as long as
## World.FISH_CAST_TICKS), the reel when it is landed and the sag when it is
## missed play once as the state begins (busy_until holds them, as a fidget's,
## but nothing cuts them short); waiting and the bite loop. A state whose
## once is over and not yet followed holds the rod out (FISH_HOLD). False
## (it stands or works as before) when the rig lacks the clip.
const FISH_CLIPS := {"cast": "Fish_Cast", "wait": "Fish_Hold", "bite": "Fish_Bite", "landed": "Fish_Reel", "missed": "Fish_Miss"}
const FISH_ONCE: Array[String] = ["cast", "landed", "missed"]
const FISH_HOLD := "Fish_Hold"
## The bite cut in this fast (s), so its first tug lands on the bite's first moment.
const FISH_BITE_FADE := 0.05
func _fishing_pose(puppet: Node3D, rig: AnimRig, entity: GridEntity, now: int) -> bool:
	var state := str(entity.fishing.get("state", ""))
	var was := str(puppet.get_meta("fish_state", ""))
	var clip := str(FISH_CLIPS.get(state, ""))
	if clip.is_empty() or not rig.has(clip):
		return false
	puppet.set_meta("fish_state", state)
	if state in FISH_ONCE and state != was:
		var seconds := rig.once(clip, 1.0, ArtKit.feel("client3d.clip_blend", CLIP_BLEND))
		puppet.set_meta("busy_until", now + int(seconds * 1000.0))
		return true
	if state == "bite" and was != "bite":
		# The bite's first tug is its first moment (805 amended (18): a viewer names the second the bite
		# starts, silent), with items' float going under: from the clip's start, cut in quickly.
		rig.loop(clip, 1.0, FISH_BITE_FADE, true)
		return true
	rig.loop(FISH_HOLD if state in FISH_ONCE else clip, 1.0)
	return true


## The fishing rod's tip in the world, on [param puppet] (a Client3D puppet:
## FishingView's line leaves it): the held rod's "tip" socket (art-kit's
## item.fishing_rod), else ROD_TIP up its length from the hold; null with no
## rod in either hand drawn.
const ROD_TIP := Vector3(0.0, 1.55, 0.0)
static func rod_tip(puppet: Node3D) -> Variant:
	if puppet == null or not puppet.has_meta("sockets") or not puppet.has_meta("held"):
		return null
	var held: Array = puppet.get_meta("held")
	var sockets: Dictionary = puppet.get_meta("sockets")
	for hand in 2:
		var id := str(held[hand])
		if id.is_empty() or id.begins_with(ART_ID) or str(Items.def(id).get("use", "")) != "fish":
			continue
		var socket := sockets.get("hand_r" if hand == 0 else "hand_l") as Node3D
		var rod := socket.get_node_or_null("Held") as Node3D if socket != null else null
		if rod == null or not rod.is_inside_tree():
			continue
		var tip: Variant = (ArtKit.spec(str(Items.def(id).get("art", "item." + id))).get("sockets", {}) as Dictionary).get("tip")
		var local := Vector3(float(tip[0]), float(tip[1]), float(tip[2])) if tip is Array and (tip as Array).size() == 3 else ROD_TIP
		return rod.global_transform * local
	return null


static func _play_fidget(puppet: Node3D, rig: AnimRig, clip: String, now: int, tempo: float) -> void:
	var seconds := rig.once(clip, tempo, ArtKit.feel("client3d.clip_blend", CLIP_BLEND) * 2.0)
	puppet.set_meta("fidgeting", true)
	puppet.set_meta("busy_until", now + int(seconds * 1000.0))


## A knocked-back model's frame (see CLIP_BACKPEDAL): true while the knock
## has the model, false once it is over (or before its slide shows, so the
## blow's own clip plays on). The sim says which slide is the push's
## (GridEntity.push_shown), so a slide cut short or drawn in pieces on a
## client, or one never drawn, is still known for what it is.
func _knocked(puppet: Node3D, rig: AnimRig, speed: float, now: int) -> bool:
	var knock: Dictionary = puppet.get_meta("knock")
	var toss: bool = knock["toss"]
	var started: int = knock["started"]
	var entity := instance_from_id(int(puppet.get_meta("entity_id", 0))) as GridEntity
	var shown := entity.push_shown if entity != null else GridEntity.PushShown.OVER
	var walking := entity != null and entity.stepping
	if started < 0:
		var waited := now - int(knock["since"]) >= int(KNOCK_WAIT_SECONDS * 1000.0)
		if walking and waited:
			# It walked off before its slide ever showed: no knock to show.
			puppet.remove_meta("knock")
			return false
		if (walking or shown == GridEntity.PushShown.WAITING) and not waited:
			# Not on screen yet (or the step before it still is).
			return false
		started = now
		knock["started"] = now
		if toss:
			rig.cancel_strike()
			puppet.set_meta("busy_until", now + int(rig.once(CLIP_ROLL, -ArtKit.feel("client3d.roll_speed", ROLL_SPEED)) * 1000.0))
		else:
			rig.cancel_strike()
			rig.loop(CLIP_BACKPEDAL, 1.0, -1.0, true)
	if not walking:
		# Turned to it as the sim turns a body, not snapped round.
		knock["shown"] = lerp_angle(knock["shown"], knock["yaw"],
				1.0 - exp(-GridEntity.TURN_RATE * get_process_delta_time()))
		(puppet.get_node("Body") as Node3D).rotation.y = knock["shown"]
		if knock.get("ending", false):
			# Doubling over (or landing), still facing whence it came.
			if now < int(puppet.get_meta("busy_until", 0)):
				return true
		else:
			if not toss:
				rig.set_speed(clampf(speed / (float(puppet.get_meta("backpedal", ArtKit.feel("client3d.backpedal_clip_speed", BACKPEDAL_CLIP_SPEED))) * float(puppet.get_meta("pace", 1.0))), 1.0, 4.0))
			var held := now < int(puppet.get_meta("busy_until", 0)) if toss else now - started < int(KNOCK_MIN_SECONDS * 1000.0)
			# It doubles over when it gets there: a push back always, a toss
			# if a wall or a door stopped it. One knocked where it stands holds.
			var slid: bool = knock.get("slid", false) or shown == GridEntity.PushShown.SLIDING
			knock["slid"] = slid
			var arrived := shown != GridEntity.PushShown.SLIDING and shown != GridEntity.PushShown.WAITING
			if shown == GridEntity.PushShown.SLIDING or held and not (arrived and (knock["impact"] or slid and not toss)):
				return true
			_play_once(puppet, CLIP_IMPACT if knock["impact"] or not toss else CLIP_LAND)
			knock["ending"] = true
			return true
	puppet.remove_meta("knock")
	puppet.set_meta("busy_until", 0)
	if entity != null:
		# Back to its facing from where the knock left it, turning.
		entity.turn_shown_from(-float(knock["shown"]))
	if walking:
		# Off on its own: the walk takes over now, from where it faces.
		(puppet.get_node("Body") as Node3D).rotation.y = knock["shown"]
	return false


## How often [param puppet]'s body is posed (AnimRig.every, decision 390):
## every frame near what the camera looks at (POSE_NEAR, on the ground: the
## view is orthographic, so nearer the camera is nothing), every other
## within POSE_MID, every POSE_FAR_EVERY beyond, every POSE_UNSEEN_EVERY out
## of the frame.
func _pose_every(puppet: Node3D) -> int:
	if _camera == null:
		return 1
	var at := puppet.global_position + Vector3.UP
	if not _camera.is_position_in_frustum(at):
		return POSE_UNSEEN_EVERY
	var away := Vector2(at.x - _camera_target.x, at.z - _camera_target.z).length_squared()
	if away <= POSE_NEAR * POSE_NEAR:
		return 1
	return 2 if away <= POSE_MID * POSE_MID else POSE_FAR_EVERY


## The index in [param gaits] (GAITS, or a model's own) for moving at
## [param speed] (tiles a second) from the clip playing, [param current]: a
## gait already reached holds till a little below its change.
static func gait_for(current: String, speed: float, gaits: Array = GAITS) -> int:
	var at := 0
	for i in gaits.size():
		if gaits[i][0] == current:
			at = i
	var index := 0
	for i in range(1, gaits.size()):
		var change := sqrt(float(gaits[i - 1][1]) * float(gaits[i][1]))
		if speed > change * (1.0 / GAIT_HYSTERESIS if at >= i else GAIT_HYSTERESIS):
			index = i
	return index


## [param gaits] with their paces as feel.json has them (674 step 3; the
## Character Lab's "Use measured", the tuning panel's Animation rows): the
## people's (HUMAN_GAITS, which the barrow's dead share, and HUMAN_F_GAITS)
## by "client3d.gait.<clip>" and "client3d.gait_f.<clip>", the constants'
## paces when feel.json lacks one (tuning_test: untouched, the same); any
## other table as it is. Worked out again only when the feel changes.
static var _paced := {}
static var _paced_serial := -1
static func paced(gaits: Array) -> Array:
	var prefix := "client3d.gait." if gaits == HUMAN_GAITS else "client3d.gait_f." if gaits == HUMAN_F_GAITS else ""
	if prefix.is_empty():
		return gaits
	if _paced_serial != ArtKit.feel_serial:
		_paced_serial = ArtKit.feel_serial
		_paced.clear()
	if not _paced.has(prefix):
		var own := []
		for gait: Array in gaits:
			own.append([gait[0], ArtKit.feel(prefix + str(gait[0]), float(gait[1]))])
		_paced[prefix] = own
	return _paced[prefix]


## Whether [param puppet] wades (775): in water deeper than WADE_DEPTH at its feet, with a wade to play.
func wading(puppet: Node3D, rig: AnimRig) -> bool:
	return rig.has(CLIP_WADE) and WetLook.depth_at(self, puppet) > WADE_DEPTH


## True if [param clip] is one of GAITS' or the wade (775).
static func is_gait(clip: String) -> bool:
	return clip == CLIP_WADE or GAITS.any(func(gait: Array) -> bool: return gait[0] == clip)


## Plays [param clip] once on [param puppet]'s model, if it has one, and
## holds it till done (a blow it was striking cut short: a flinch, a fall
## take it). False if there is no model.
func _play_once(puppet: Node3D, clip: String) -> bool:
	if not puppet.has_meta("rig"):
		return false
	var rig := puppet.get_meta("rig") as AnimRig
	if not rig.has(clip):
		return false
	puppet.set_meta("fidgeting", false)
	rig.cancel_strike()
	puppet.set_meta("busy_until", Time.get_ticks_msec() + int(rig.once(clip) * 1000.0))
	return true


## [param puppet]'s blow for [param swinger] holding [param weapon]: one of
## its model's strikes for that weapon (HUMANOID_MOVES' "strikes"; bare
## hands' if it has none for it), not the last one, played so its contact
## lands when the drawn body's blow does (STRIKE_LANDS_IN: bodies are drawn
## that far behind the sim, the local player's own at once) and recovered
## by its next: the rest of the time between blows after the lead it took
## (AnimRig.lead_of; it was the clip's contact, the lead at speed 1, and so
## a swing whose lead ran fast recovered fast too, 338 amended). A wound-up
## blow ([param wound] seconds to its landing, WOUND_STRIKES) lands then
## instead, its lead played over the wind-up. A model with no strikes plays
## one of ATTACK_CLIPS. False if there is no model.
func _strike(puppet: Node3D, swinger: GridEntity, weapon: String, wound := 0.0, lead := false) -> bool:
	var strikes: Dictionary = (puppet.get_meta("moves", {}) as Dictionary).get("strikes", {})
	var choices: Array = strikes.get(weapon, strikes.get("", []))
	var drawn := drawn_strikes(puppet, swinger, weapon, lead)
	if not drawn.is_empty():
		choices = drawn
	if choices.is_empty() or not puppet.has_meta("rig"):
		return _play_once(puppet, _pick_clip(puppet, ATTACK_CLIPS))
	var names: Array[String] = []
	for choice: Array in choices:
		names.append(str(choice[0]))
	var clip := _pick_clip(puppet, names)
	var contact := float(choices[names.find(clip)][1])
	var own := swinger is Player and (swinger as Player).owner_peer == Net.local_id
	var lands_in := wound if wound > 0.0 else (0.0 if own else STRIKE_LANDS_IN)
	# A lead weapon's swing at nothing (World.try_swing: no wind-up, nothing in reach) still
	# takes its lead, as a wound-up blow of it would: at once, the slash's lead ran at the cap
	# and read as a thrust (338 amended (3)). Its heavy wound-up kin keep their own way.
	if wound <= 0.0 and weapon in WOUND_STRIKES and swinger != null \
			and int(World.blow_verb(swinger).get("windup", 0)) <= 0:
		lands_in = maxf(lands_in, World.windup_ticks(swinger) * World.TICK_DT)
	var between := World.attack_ticks_of(swinger) * World.TICK_DT if swinger != null else 1.0
	var rig := puppet.get_meta("rig") as AnimRig
	puppet.set_meta("fidgeting", false)
	var recover := maxf(between - AnimRig.lead_of(contact, lands_in), 0.2)
	# A blow with a recovery of its own (combat's World.recover_ticks): the drag back up ends as the swinger is free.
	var own_recover := World.recover_ticks(swinger) if swinger != null else 0
	if own_recover > 0:
		recover = own_recover * World.TICK_DT
	# A body still drawn sliding into the cell it strikes from ("blows you can see" (c)): its
	# wind-up waits till it stands, the contact where it was, the lead cut only by the slide
	# left and never past the strike's fastest (AnimRig's speed cap).
	var hold := 0.0
	if swinger != null and not own:
		var fastest := contact / ArtKit.feel("anim_rig.strike_speed_max", AnimRig.STRIKE_SPEED_MAX)
		hold = clampf(swinger.arriving_in(), 0.0, maxf(lands_in - fastest, 0.0))
	# A quick clip with a long wind-up to fill (a goblin's jab, 0.17 s to its contact, for the
	# brute's 0.75 s): slowed only to AnimRig's slowest, it would land early; it waits the rest.
	var slowest := contact / ArtKit.feel("anim_rig.strike_speed_min", AnimRig.STRIKE_SPEED_MIN)
	hold = maxf(hold, lands_in - slowest)
	var now := Time.get_ticks_msec()
	# On the rigs' clock (AnimRig.now_msec, 390 amended): a reel's frames, else the wall.
	puppet.set_meta("contact_msec", AnimRig.now_msec() + int((hold + AnimRig.lead_of(contact, lands_in - hold)) * 1000.0))
	var token := int(puppet.get_meta("strike_token", 0)) + 1
	puppet.set_meta("strike_token", token)
	if hold > STRIKE_HOLD_LEAST:
		# Till then its gait goes on (_animate): not busy. A blow given up meanwhile (_on_winding's
		# 0 ticks) or another begun stops it (its token).
		var ids_held := [puppet.get_instance_id(), rig.get_instance_id()]
		get_tree().create_timer(hold).timeout.connect(func() -> void:
			var fired_body := instance_from_id(ids_held[0]) as Node3D
			var fired_rig := instance_from_id(ids_held[1]) as AnimRig
			if is_instance_valid(fired_body) and is_instance_valid(fired_rig) and int(fired_body.get_meta("strike_token", 0)) == token \
					and not fired_body.has_meta("corpse"):  # Killed while it held its wind-up: its death stays.
				var late := fired_rig.strike(clip, contact, lands_in - hold, recover)
				fired_body.set_meta("busy_until", Time.get_ticks_msec() + int(late * 1000.0)))
		return true
	var seconds := rig.strike(clip, contact, lands_in, recover)
	puppet.set_meta("busy_until", now + int(seconds * 1000.0))
	return true


## Whether a winding of [param ticks] by [param swinger] is a plain blow's lead (338 amended
## (4)): a monster's, no longer than its lead_ticks, with no heavy wind-up in its verb (a
## brute's HEAVY tactic winds longer; a heavy weapon has its own).
static func is_lead(swinger: GridEntity, ticks: int) -> bool:
	if not swinger is Monster or ticks <= 0 or int(World.blow_verb(swinger).get("windup", 0)) > 0:
		return false
	# Its kind's row (a client never tempers a monster: its lead_ticks stays the default there).
	var kind := str(swinger.spawn_spec.get("kind", ""))
	return ticks <= int(Monster.fight_for(kind).get("lead_ticks", Monster.LEAD_TICKS))


## A monster's led blow's strikes gathered first (HUMANOID_MOVES "drawn"; 338 amended (4),
## animation's side): for a [param lead] (is_lead), the drawn clips for [param weapon] (its
## bare hands' where its plain strikes are its bare hands') its rig has; else none.
static func drawn_strikes(puppet: Node3D, swinger: GridEntity, weapon: String, lead: bool) -> Array:
	if not lead or not swinger is Monster or not puppet.has_meta("rig"):
		return []
	var moves := puppet.get_meta("moves", {}) as Dictionary
	var strikes: Dictionary = moves.get("strikes", {})
	var drawn: Dictionary = moves.get("drawn", {})
	var choices: Array = drawn.get(weapon if strikes.has(weapon) else "", [])
	var rig := puppet.get_meta("rig") as AnimRig
	return choices.filter(func(choice: Array) -> bool: return rig.has(str(choice[0])))


static func _hook(sig: Signal, callable: Callable) -> void:
	if not sig.is_connected(callable):
		sig.connect(callable)


## A person's look (decision 419): their spawn spec's "look" (a resident's
## from npc's card, a companion's from hers, a player's as they chose it in
## the options panel's Character section, decision 439; as Main writes them),
## seeded by their name where it names no seed; a player's (and anyone's that
## names none) body is their "body"; a player wears no headwear or apron. A
## monster of an allied people (MODELS' "people") is drawn as one of them
## (decision 478).
static func look_for(entity: GridEntity) -> PersonLook:
	var look := str(entity.spawn_spec.get("look", ""))
	if not look.begins_with("seed=") and not " seed=" in look:
		look = ("seed=%d " % absi(hash(String(entity.name)))) + look
	if entity is Player:
		look += " headwear=none apron=no garb=none"
	if entity is Monster:
		var people := str(MODELS.get(str(entity.spawn_spec.get("kind", "")), {}).get("people", ""))
		if people != "":
			look += " people=" + people
		var words := person_words(entity)
		if not words.is_empty():
			look += " " + words
	return PersonLook.make(look, body_of(entity))


## A monster kind drawn as a person (Jeff: "have the grave robbers use the
## character body type"): its row's "person" in monsters.json, look words
## laid over its seed's (e.g. "headwear=hood garb=none"), puts it in the
## human body with a build and a look, as townsfolk are: their sockets (its
## row's "wields" in its hands, the head socket), their gaits and clips. ""
## for a kind drawn its own way, and for anything not a monster.
static func person_words(entity: GridEntity) -> String:
	if not entity is Monster:
		return ""
	var row: Variant = Monster.kinds().get(str(entity.spawn_spec.get("kind", "")), {})
	return str((row as Dictionary).get("person", "")) if row is Dictionary else ""


## [param entity]'s body (decision 388), &"" if it wears none.
static func body_of(entity: GridEntity) -> StringName:
	var body: Variant = entity.get("body")
	return StringName(body) if body != null else &""


func _make_puppet(entity: GridEntity) -> Node3D:
	var puppet := Node3D.new()
	puppet.name = entity.name
	puppet.set_meta("body", body_of(entity))
	puppet.set_meta("entity_name", String(entity.name))
	puppet.set_meta("entity_id", entity.get_instance_id())
	var shape := EntityFactory.shape_name_for(entity.spawn_spec)
	var model := model_for(entity)
	if not model.is_empty():
		_vary(entity, puppet, model)
	var art := art_slot_for(entity)
	var creature := creature_slot_for(entity) if model.is_empty() else ""
	if creature != "":
		art = ""
	var height: float = float(model["height"]) * float(puppet.get_meta("model_scale", 1.0)) if not model.is_empty() 			else ArtKit.size(creature).y if creature != "" else ArtKit.size(art).y if art != "" else Iso.HEIGHTS[shape]
	var material := StandardMaterial3D.new()
	var sprite := entity.get_node_or_null("Sprite") as Sprite2D
	material.albedo_color = sprite.modulate if sprite != null else Color.WHITE
	puppet.set_meta("tint", material.albedo_color)  # A model's "tint" material.
	if not person_words(entity).is_empty():
		puppet.set_meta("look_dresses", true)  # Its look's clothes, not its sprite's tint (_make_model).
	material.roughness = 0.8
	# A touch of glow so a body reads in the dark away from any light.
	material.emission_enabled = true
	material.emission = material.albedo_color * 0.12
	var area := Area3D.new()
	area.name = "Pick"
	area.set_meta("entity", entity.get_instance_id())
	puppet.set_meta("pick_height", height)
	var collision := CollisionShape3D.new()
	collision.position.y = height * 0.5
	area.add_child(collision)
	if creature != "":
		# Its creature slot's rigged art (decision 359): Body turns to its
		# facing (+X ahead, as the nose), Pose turns the art's front (+Z)
		# there and is what the view's stand-in tweens tip and push.
		var drawn := Node3D.new()
		drawn.name = "Body"
		var pose := Node3D.new()
		pose.name = "Pose"
		pose.rotation.y = PI * 0.5
		var instance := ArtKit.instance(creature)
		pose.add_child(instance)
		drawn.add_child(pose)
		puppet.add_child(drawn)
		var view := CreatureView.new(creature, instance, pose)
		puppet.add_child(view)
		puppet.set_meta("creature_view", view)
		# The pick shape turns with nothing: a cylinder round its middle,
		# whichever way it faces.
		var cylinder := CylinderShape3D.new()
		var size := ArtKit.size(creature)
		cylinder.radius = maxf(size.x, size.z) * 0.4
		cylinder.height = size.y
		collision.shape = cylinder
	elif art != "":
		# Its slot's own art, standing on the tile; the pick shape its size.
		var drawn := Node3D.new()
		drawn.name = "Body"
		drawn.add_child(ArtKit.instance(art))
		# Its front (+z) turned the way level.json says (769: the mine's cart
		# along its track), as the buildings turn theirs.
		var art_facing: Variant = entity.spawn_spec.get("art_facing")
		if art_facing is Vector2i:
			drawn.rotation.y = atan2(float(art_facing.x), float(art_facing.y))
		puppet.add_child(drawn)
		var box := BoxShape3D.new()
		box.size = ArtKit.size(art)
		collision.shape = box
	elif model.is_empty():
		var body := MeshInstance3D.new()
		body.name = "Body"
		body.mesh = (_shapes[shape] as Callable).call()
		body.position.y = height * 0.5
		body.material_override = material
		puppet.add_child(body)
		# The pick shape: the body's own.
		collision.shape = _pick_shape(shape, body.mesh)
	else:
		puppet.add_child(_make_model(model, puppet))
		var capsule := CapsuleShape3D.new()
		capsule.radius = MODEL_RADIUS
		capsule.height = height
		collision.shape = capsule
	puppet.add_child(area)
	if entity.is_creature():
		var caption: String = entity.label if not entity.label.is_empty() else entity.name
		puppet.add_child(_label("Name", caption, Color.WHITE, height + 0.35))
		puppet.set_meta("caption", caption)
		puppet.set_meta("bubble_height", height + BUBBLE_OVER_HEAD)
		# The nose: which way it faces, turned each frame (see _sync_puppets).
		# A model turns itself instead.
		var pivot := Node3D.new()
		pivot.name = "Facing"
		if model.is_empty() and creature == "":
			var nose := MeshInstance3D.new()
			var nose_mesh := BoxMesh.new()
			nose_mesh.size = Vector3(0.18, 0.1, 0.14)
			nose.mesh = nose_mesh
			nose.material_override = material
			nose.position = Vector3(0.3, height * 0.72, 0.0)
			pivot.add_child(nose)
		puppet.add_child(pivot)
		var id := entity.get_instance_id()
		# Hooked once: a puppet made again (a body that came late) finds them hooked.
		_hook(entity.swung, _on_swung.bind(id))
		_hook(entity.shot, _on_shot.bind(id))
		_hook(entity.lobbed, _on_lobbed.bind(id))
		_hook(entity.winding, _on_winding.bind(id))
		_hook(entity.guarded, _on_guarded.bind(id))
		_hook(entity.bashed, _on_bashed.bind(id))
		_hook(entity.stunned, _on_stunned.bind(id))
		if entity is Player or entity is Companion:
			puppet.set_meta("body", str(entity.get("body")))
		_hook(entity.struck, _on_struck.bind(id))
		_hook(entity.impacted, _on_impacted.bind(id))
		_hook(entity.pushed, _on_pushed.bind(id))
		if entity is Monster:
			_hook((entity as Monster).cried, _on_cried.bind(id))
			puppet.set_meta("creature", str(entity.spawn_spec.get("kind", "")))
		if entity.max_hp > 0:
			puppet.add_child(_make_bar(entity.max_hp, height + HP_BAR_ABOVE))
	elif entity.is_breakable():
		# Hooked once: a zone entered again builds its breakables' puppets again.
		_hook(entity.impacted, _on_impacted.bind(entity.get_instance_id()))
		_break_sounds[String(entity.name)] = SoundKit.breaking(entity)
	if entity is Player or entity is Companion:
		var light := OmniLight3D.new()
		light.name = "Lantern"
		light.light_color = PLAYER_LIGHT
		_size_lantern(light)
		_cast_shadows(light)
		# Above the head: inside the body it would light the body from within
		# and leave its outside in its own shadow.
		light.position.y = height + 0.6
		puppet.add_child(light)
		# The lantern itself hangs at the belt (decision 451), the light above.
		var belt: Node3D = (puppet.get_meta("sockets", {}) as Dictionary).get("belt_r")
		if belt != null:
			belt.add_child(_hanging_lantern())
	add_child(puppet)
	return puppet


## An HP bar [param max_hp] long, [param height] up.
func _make_bar(max_hp: int, height: float) -> MeshInstance3D:
	var bar := MeshInstance3D.new()
	bar.name = "HpBar"
	var quad := QuadMesh.new()
	quad.size = Vector2(HP_BAR_PER_HP * max_hp, HP_BAR_HEIGHT)
	bar.mesh = quad
	var material := ShaderMaterial.new()
	material.shader = _hp_bar_shader
	material.set_shader_parameter("alpha", 0.0)
	material.render_priority = 10
	bar.material_override = material
	bar.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	bar.position.y = height
	bar.visible = false
	return bar


## A swing: the body goes out toward the blow and back, with a whoosh
## pitched by the swinger's weight.
func _on_swung(direction: Vector2i, id: int) -> void:
	var puppet: Node3D = _puppets.get(id)
	if puppet == null:
		return
	_combat_at[id] = Time.get_ticks_msec()
	var swinger := instance_from_id(id) as GridEntity
	if swinger != null:
		swinger.settle_for_blow()  # Still drawn coming: it slows into the cell it strikes from.
	var heft := clampf(inverse_lerp(20.0, 100.0, swinger.mass if swinger != null else 50.0), 0.0, 1.0)
	var weapon := World.wielded(swinger) if swinger != null else ""
	var now := AnimRig.now_msec()  # _swings on the rigs' clock (390 amended): a reel's frames, else the wall.
	_swings[id] = [now, weapon, now]
	sfx.play(SoundKit.swing(weapon), puppet.position + Vector3.UP * 0.8, lerpf(SWING_PITCH_LIGHT, SWING_PITCH_HEAVY, heft))
	var effort := SoundKit.voice(swinger, "effort_swing", _person_body(puppet))
	if effort != "" and randi() % EFFORT_EVERY == 0:
		sfx.play(effort, puppet.position + Vector3.UP * 1.5)
	if Time.get_ticks_msec() > int(puppet.get_meta("wound_until", 0)):
		_strike(puppet, swinger, weapon)
		# Its blow heard as the drawn blade lands (_struck_with), not as it sets off.
		var rig := puppet.get_meta("rig") as AnimRig if puppet.has_meta("rig") else null
		if rig != null and int(puppet.get_meta("contact_msec", -1)) >= now:
			_swings[id][2] = int(puppet.get_meta("contact_msec"))
		if puppet.has_meta("creature_view"):
			(puppet.get_meta("creature_view") as CreatureView).swing()
	var body := puppet.get_node("Body") as Node3D
	var rest := Vector3(0.0, body.position.y, 0.0)
	var out := rest + Vector3(direction.x, 0.0, direction.y).normalized() * LUNGE
	# Leading the drawn blow ("blows you can see" (b)), not its news: back at rest as it lands,
	# where each clip's contact is placed (a pick's point at the seam's face, 769 amended (9)).
	var reach := LUNGE_SECONDS * 0.4
	var landing := (int(_swings[id][2]) - now) / 1000.0
	var tween := create_tween()
	if landing > LUNGE_SECONDS:
		tween.tween_interval(landing - LUNGE_SECONDS)
	tween.tween_property(body, "position", out, reach).set_ease(Tween.EASE_OUT)
	tween.tween_property(body, "position", rest, LUNGE_SECONDS * 0.6).set_ease(Tween.EASE_IN)


## A blow taken on a guard (World._meet_guard): a knock on wood; one
## that [param broken] it, wood splitting and a stagger.
func _on_guarded(broken: bool, id: int) -> void:
	var puppet: Node3D = _puppets.get(id)
	if puppet == null:
		return
	_combat_at[id] = Time.get_ticks_msec()
	var holder_now := instance_from_id(id) as GridEntity
	if holder_now != null:
		_arrow_to(holder_now.tile)  # An arrow taken on a guard: not a miss.
	var guard := ""
	var holder := instance_from_id(id) as GridEntity
	if holder != null and World.holds_in_hands(holder):
		for slot in [Items.LEFT_HAND, Items.RIGHT_HAND]:
			var held := holder.slots[slot] if slot < holder.slots.size() else ""
			if held != "" and str(Items.verb_of(held).get("kind", "")) == "block":
				guard = held if guard == "" or Items.has_tag(held, "shield") else guard
	# A guard broken: the same knock, harder. Heard as the drawn blow meets the
	# guard (_struck_with, the sparks' moment), decided at the frame's end so
	# a recoil off this shield (the attacker's stunned, right after, 340
	# amended, sound's side) can take it SoundKit.RECOIL_DUCK_DB down.
	var lands := int(_struck_with(holder)[1]) if holder != null else AnimRig.now_msec()
	_play_block.call_deferred(SoundKit.block(guard), puppet, lands, 4.0 if broken else 0.0)
	if broken:
		_play_once(puppet, _pick_clip(puppet, HIT_CLIPS))
	elif holder != null and guard != "" and Items.has_tag(guard, "shield"):
		# Sparks off the shield as the drawn blow meets it (340 amended, animation's side).
		var wait := (int(_struck_with(holder)[1]) - AnimRig.now_msec()) / 1000.0
		if wait > 0.0:
			var ids_spark := [puppet.get_instance_id(), holder.get_instance_id() if holder != null else 0]
			get_tree().create_timer(wait).timeout.connect(func() -> void:
				var fired_puppet := instance_from_id(ids_spark[0]) as Node3D
				var fired_holder := instance_from_id(ids_spark[1]) as GridEntity
				if is_instance_valid(fired_puppet) and fired_puppet.is_inside_tree() and is_instance_valid(fired_holder):
					_spark(fired_puppet, fired_holder))
		else:
			_spark(puppet, holder)


## The frame a blow was last thrown back off a raised shield (_on_stunned).
var _recoil_frame := -1


## A block's knock (from _on_guarded, deferred to the frame's end) at
## [param puppet] at [param lands] (msec, the drawn blow's landing), quieter
## by SoundKit.RECOIL_DUCK_DB in a frame a recoil was heard (340 amended).
func _play_block(slot: String, puppet: Node3D, lands: int, gain_db: float) -> void:
	var gain := gain_db - (SoundKit.RECOIL_DUCK_DB if _recoil_frame == Engine.get_process_frames() else 0.0)
	var wait := (lands - AnimRig.now_msec()) / 1000.0
	if wait <= 0.0:
		if is_instance_valid(puppet):
			sfx.play(slot, puppet.position + Vector3.UP * 0.9, 1.0, gain)
		return
	var ids_block := puppet.get_instance_id()
	get_tree().create_timer(wait).timeout.connect(func() -> void:
		var fired_puppet := instance_from_id(ids_block) as Node3D
		if is_instance_valid(fired_puppet) and fired_puppet.is_inside_tree():
			sfx.play(slot, fired_puppet.position + Vector3.UP * 0.9, 1.0, gain))


## The side of a body facing [param facing] that a blow from [param from] meets (a grid direction
## from the body toward the blow, y down): "front", "back", "left" or "right" (HUMANOID_MOVES' "hits").
static func hit_side(facing: Vector2, from: Vector2) -> String:
	if from.length() < 0.001 or facing.length() < 0.001:
		return "front"
	var f := facing.normalized()
	var d := from.normalized()
	var ahead := f.dot(d)
	if ahead > 0.5:
		return "front"
	if ahead < -0.5:
		return "back"
	# On the grid (y down) the facing turned a quarter clockwise, cross > 0, is the body's right.
	return "right" if f.x * d.y - f.y * d.x > 0.0 else "left"


## [param puppet]'s hit for a blow from [param from] (grid): its moves' "hits" for that side where it
## has them, else one of HIT_CLIPS; a creature its view's hit. False if there is no model.
func _hit_from(puppet: Node3D, entity: GridEntity, from: Vector2) -> bool:
	if puppet.has_meta("corpse"):
		return true  # A delayed blow on the dead: its death stays (as _flinch).
	if puppet.has_meta("creature_view"):
		(puppet.get_meta("creature_view") as CreatureView).hit()
		return true
	if _held_steady(puppet):
		_steady_rock(puppet)  # Steadied (843): no hit clip, rocked and held.
		return true
	var hits: Dictionary = (puppet.get_meta("moves", {}) as Dictionary).get("hits", {})
	var names: Array[String] = []
	for clip: String in hits.get(hit_side(Vector2(entity.facing), from), []):
		if puppet.has_meta("rig") and (puppet.get_meta("rig") as AnimRig).has(clip):
			names.append(clip)
	return _play_once(puppet, _pick_clip(puppet, names if not names.is_empty() else HIT_CLIPS))


## A person steadied (cried "steady", 843): out of a stagger a chief plants and shakes it off (its
## Model dipped, _lay keeping Body's place; Body's shoulders rolled about its front, +X; the clips
## play on), then holds braced till _steady_over, a blow rocking it with no hit clip
## (_steady_rock). Its STEADY_CAP if the "steady_over" is lost.
func _steady(puppet: Node3D) -> void:
	if puppet.has_meta("corpse") or not puppet.has_meta("rig") or not puppet.has_node("Body/Model"):
		return
	var body := puppet.get_node("Body") as Node3D
	var model := body.get_node("Model") as Node3D
	var rest_y := float(puppet.get_meta("steady_rest_y", model.position.y))
	var token := int(puppet.get_meta("steady_token", 0)) + 1
	var cap := ArtKit.feel("client3d.steady_cap", STEADY_CAP)
	puppet.set_meta("steady_rest_y", rest_y)
	puppet.set_meta("steady_token", token)
	puppet.set_meta("steady_until", AnimRig.now_msec() + int(cap * 1000.0))
	var dip := ArtKit.feel("client3d.steady_dip", STEADY_DIP)
	var roll := ArtKit.feel("client3d.steady_roll", STEADY_ROLL)
	var twist := ArtKit.feel("client3d.steady_twist", STEADY_TWIST)
	var hunch := ArtKit.feel("client3d.steady_hunch", STEADY_HUNCH)
	var lift := ArtKit.feel("client3d.steady_lift", STEADY_LIFT)
	var beat := ArtKit.feel("client3d.steady_seconds", STEADY_SECONDS)
	var tween := body.create_tween().set_parallel(true)
	puppet.set_meta("steady_tween", tween)
	# The twist through _lay (which sets Model's yaw each frame): its "steady_twist", the puppet found
	# by its id (836).
	var id_twist := puppet.get_instance_id()
	var twisted := func(angle: float) -> void:
		var fired_puppet := instance_from_id(id_twist) as Node3D
		if is_instance_valid(fired_puppet):
			fired_puppet.set_meta("steady_twist", angle)
	# Planted: hunched into the dip, the first roll and twist with it.
	tween.tween_property(model, "position:y", rest_y - dip, beat * 0.25).set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_SINE)
	tween.tween_property(body, "rotation:z", -hunch, beat * 0.25).set_ease(Tween.EASE_OUT)
	tween.tween_property(body, "rotation:x", roll, beat * 0.25).set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_SINE)
	tween.tween_method(twisted, 0.0, twist, beat * 0.25).set_ease(Tween.EASE_OUT).set_trans(Tween.TRANS_SINE)
	tween.chain().tween_property(body, "rotation:x", -roll, beat * 0.25).set_trans(Tween.TRANS_SINE)
	tween.parallel().tween_method(twisted, twist, -twist, beat * 0.25).set_trans(Tween.TRANS_SINE)
	# Shaken off: the last of the shake as it comes up, chest and head raised.
	tween.chain().tween_property(body, "rotation:x", roll * 0.4, beat * 0.2).set_trans(Tween.TRANS_SINE)
	tween.parallel().tween_method(twisted, -twist, twist * 0.4, beat * 0.2).set_trans(Tween.TRANS_SINE)
	tween.parallel().tween_property(body, "rotation:z", lift, beat * 0.2).set_ease(Tween.EASE_OUT)
	tween.chain().tween_property(body, "rotation:x", 0.0, beat * 0.3).set_ease(Tween.EASE_OUT)
	tween.parallel().tween_method(twisted, twist * 0.4, 0.0, beat * 0.3).set_ease(Tween.EASE_OUT)
	tween.parallel().tween_property(body, "rotation:z", 0.0, beat * 0.3).set_ease(Tween.EASE_IN_OUT)
	# Braced: part way up again, held so.
	tween.parallel().tween_property(model, "position:y", rest_y - dip * STEADY_HOLD, beat * 0.3).set_ease(Tween.EASE_IN_OUT)
	# Its cap (by ids, 836): a lost "steady_over" leaves it braced no longer than this.
	var ids_steady := [puppet.get_instance_id(), token]
	get_tree().create_timer(cap).timeout.connect(func() -> void:
		var fired_puppet := instance_from_id(ids_steady[0]) as Node3D
		if is_instance_valid(fired_puppet) and int(fired_puppet.get_meta("steady_token", 0)) == ids_steady[1]:
			_steady_over(fired_puppet))


## Whether [param puppet], a person, stands steadied now (843; a creature's: CreatureView.steadied).
func _held_steady(puppet: Node3D) -> bool:
	return not puppet.has_meta("creature_view") and int(puppet.get_meta("steady_until", 0)) > AnimRig.now_msec()


## A person steadied no more (cried "steady_over", or its cap): up from the brace.
func _steady_over(puppet: Node3D) -> void:
	if not puppet.has_meta("steady_until"):
		return
	puppet.remove_meta("steady_until")
	puppet.set_meta("steady_token", int(puppet.get_meta("steady_token", 0)) + 1)
	var old: Variant = puppet.get_meta("steady_tween", null)
	if old is Tween and (old as Tween).is_valid():
		(old as Tween).kill()
	puppet.remove_meta("steady_tween")
	var rest_y := float(puppet.get_meta("steady_rest_y", 0.0))
	puppet.remove_meta("steady_rest_y")
	if not puppet.has_node("Body/Model"):
		return
	var body := puppet.get_node("Body") as Node3D
	var model := body.get_node("Model") as Node3D
	puppet.remove_meta("steady_twist")
	if puppet.has_meta("corpse"):
		model.position.y = rest_y  # Killed braced: its fall is its own, the brace just gone.
		body.rotation.x = 0.0
		body.rotation.z = 0.0
		return
	var tween := body.create_tween().set_parallel(true)
	tween.tween_property(model, "position:y", rest_y, STEADY_SETTLE).set_ease(Tween.EASE_IN_OUT)
	tween.tween_property(body, "rotation:x", 0.0, STEADY_SETTLE).set_ease(Tween.EASE_IN_OUT)
	tween.tween_property(body, "rotation:z", 0.0, STEADY_SETTLE).set_ease(Tween.EASE_IN_OUT)


## A blow on a steadied person: rocked back (its Body off its front) and home, no hit clip.
func _steady_rock(puppet: Node3D) -> void:
	if not puppet.has_node("Body"):
		return
	var body := puppet.get_node("Body") as Node3D
	var rest := body.position  # Where _lay keeps it (as _bash_taken's jolt).
	var back := -body.transform.basis.x.normalized() * ArtKit.feel("client3d.steady_rock", STEADY_ROCK)
	var tween := body.create_tween()
	tween.tween_property(body, "position", rest + back, STEADY_ROCK_SECONDS * 0.3).set_ease(Tween.EASE_OUT)
	tween.tween_property(body, "position", rest, STEADY_ROCK_SECONDS * 0.7).set_ease(Tween.EASE_IN_OUT)


## Shield-bashed (379 amended, animation's side): the basher (at [param by]) drives its shield in,
## Shield_Bash's contact on its swing's drawn landing (_swings: it swung as it bashed); the bashed
## body takes it then from the basher's side, and, not moved ([param direction] ZERO: a guard met
## it), jolts back and home.
func _on_bashed(direction: Vector2i, by: NodePath, id: int) -> void:
	var puppet: Node3D = _puppets.get(id)
	var target := instance_from_id(id) as GridEntity
	if puppet == null or target == null:
		return
	_combat_at[id] = Time.get_ticks_msec()
	var basher := get_node_or_null(by) as GridEntity if not by.is_empty() else null
	var from := Vector2(-direction)
	var lands := 0.0
	if basher != null:
		from = Vector2(basher.tile - target.tile)
		var swung: Array = _swings.get(basher.get_instance_id(), [])
		if not swung.is_empty():
			lands = maxf((int(swung[2]) - AnimRig.now_msec()) / 1000.0, 0.0)
		var swinger: Node3D = _puppets.get(basher.get_instance_id())
		if swinger != null and swinger.has_meta("rig") and (swinger.get_meta("rig") as AnimRig).has(CLIP_SHIELD_BASH):
			var rig := swinger.get_meta("rig") as AnimRig
			swinger.set_meta("fidgeting", false)
			swinger.set_meta("strike_token", int(swinger.get_meta("strike_token", 0)) + 1)  # Its swing's strike gives way.
			var seconds := rig.strike(CLIP_SHIELD_BASH, SHIELD_BASH_CONTACT, maxf(lands, 0.05),
					maxf(rig.length(CLIP_SHIELD_BASH) - SHIELD_BASH_CONTACT, 0.1))
			swinger.set_meta("busy_until", Time.get_ticks_msec() + int(seconds * 1000.0))
	if lands > 0.0:
		var ids_bash := [puppet.get_instance_id(), target.get_instance_id() if target != null else 0]
		get_tree().create_timer(lands).timeout.connect(func() -> void:
			var fired_puppet := instance_from_id(ids_bash[0]) as Node3D
			var fired_target := instance_from_id(ids_bash[1]) as GridEntity
			if is_instance_valid(fired_puppet) and fired_puppet.is_inside_tree() and is_instance_valid(fired_target):
				_bash_taken(fired_puppet, fired_target, direction, from))
	else:
		_bash_taken(puppet, target, direction, from)


## The bashed body's side of a bash, as the shield meets it (_on_bashed).
func _bash_taken(puppet: Node3D, target: GridEntity, direction: Vector2i, from: Vector2) -> void:
	_hit_from(puppet, target, from)
	if direction != Vector2i.ZERO or not puppet.has_node("Body") or from.length() < 0.001:
		return
	var body := puppet.get_node("Body") as Node3D
	var rest := body.position
	var away := -Vector3(from.x, 0.0, from.y).normalized() * BASH_JOLT
	var tween := body.create_tween()
	tween.tween_property(body, "position", rest + away, BASH_JOLT_SECONDS * 0.3).set_ease(Tween.EASE_OUT)
	tween.tween_property(body, "position", rest, BASH_JOLT_SECONDS * 0.7).set_ease(Tween.EASE_IN_OUT)


## Stunned (379 amended) for [param cause]: thrown back off a raised shield (&"guarded"), a person
## plays CLIP_RECOIL and a creature its hit, as its drawn blow lands (_swings); the other causes'
## stagger as before (_reel_until).
func _on_stunned(ticks: int, cause: StringName, id: int) -> void:
	var puppet: Node3D = _puppets.get(id)
	if puppet == null:
		return
	if cause == &"crash" and puppet.has_meta("creature_view"):
		# The boar king's charge into the terrain: dazed through the stun (its slot's clip).
		(puppet.get_meta("creature_view") as CreatureView).daze(ticks * World.TICK_DT)
		# And heard: a heavy dull thud at him, at his pitch (780 amended (16), sound's side).
		var creature := str(puppet.get_meta("creature", ""))
		var thud := SoundKit.crash(cause, creature)
		if thud != "":
			sfx.play(thud, puppet.position + Vector3.UP * 0.6, float(SoundKit.CREATURE_PITCH.get(creature, 1.0)))
		return
	if cause != &"guarded":
		return
	_combat_at[id] = Time.get_ticks_msec()
	_recoil_frame = Engine.get_process_frames()  # The holder's knock ducks under the boom (sound's side).
	var swung: Array = _swings.get(id, [])
	var wait := (int(swung[2]) - AnimRig.now_msec()) / 1000.0 if not swung.is_empty() else 0.0
	if wait > 0.0:
		var ids_recoil := puppet.get_instance_id()
		get_tree().create_timer(wait).timeout.connect(func() -> void:
			var fired_puppet := instance_from_id(ids_recoil) as Node3D
			if is_instance_valid(fired_puppet) and fired_puppet.is_inside_tree():
				_recoil(fired_puppet)
				_recoil_heard(fired_puppet, cause))
	else:
		_recoil(puppet)
		_recoil_heard(puppet, cause)


## The boom of a blow thrown back off a raised shield (340 amended, sound's
## side: SoundKit.recoil, sfx.shield_recoil) at [param puppet], the attacker.
func _recoil_heard(puppet: Node3D, cause: StringName) -> void:
	var slot := SoundKit.recoil(cause)
	if slot != "":
		sfx.play(slot, puppet.position + Vector3.UP * 0.9)


## [param puppet] thrown back off a shield: CLIP_RECOIL where its model has it, else a hit.
func _recoil(puppet: Node3D) -> void:
	if puppet.has_meta("corpse"):
		return  # Killed before its blow met the guard: its death stays (as _flinch).
	if puppet.has_meta("creature_view"):
		(puppet.get_meta("creature_view") as CreatureView).hit()
	elif not _play_once(puppet, CLIP_RECOIL):
		_play_once(puppet, _pick_clip(puppet, HIT_CLIPS))


## Sparks off [param puppet]'s shield (a blow [param holder] took on it): SPARK_COUNT streaks
## flying out of its face toward the blow over SPARK_SECONDS, then gone. At the held shield where it
## has one (_hold's strapped "Held"), else chest high a little ahead.
func _spark(puppet: Node3D, holder: GridEntity) -> void:
	var ahead := Vector3(holder.facing.x, 0.0, holder.facing.y).normalized()
	if ahead.is_zero_approx():
		ahead = Vector3.FORWARD
	var at := puppet.global_position + Vector3.UP * SPARK_CHEST * float(puppet.get_meta("model_scale", 1.0)) + ahead * 0.3
	for held: Node in puppet.find_children("Held", "Node3D", true, false):
		if held.has_meta("strap") and (held as Node3D).is_inside_tree():
			at = (held as Node3D).global_position + ahead * 0.1
	var spark := MeshInstance3D.new()
	spark.name = "Spark"
	spark.mesh = spark_mesh()
	spark.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	add_child(spark)
	spark.global_position = at
	spark.look_at(at + ahead, Vector3.UP)  # Its streaks fly along -Z: toward the blow.
	spark.scale = Vector3.ONE * SPARK_REACH * 0.3
	var tween := spark.create_tween().set_parallel(true)
	tween.tween_property(spark, "scale", Vector3.ONE * SPARK_REACH, SPARK_SECONDS).set_ease(Tween.EASE_OUT)
	tween.tween_property(spark, "transparency", 1.0, SPARK_SECONDS).set_ease(Tween.EASE_IN)
	tween.chain().tween_callback(spark.queue_free)


## The sparks' one mesh: SPARK_COUNT thin triangles from near the middle out along -Z in a cone, a
## metre long at most (scaled by _spark), unshaded, added light, seen from both sides.
static func spark_mesh() -> ArrayMesh:
	if _spark_mesh != null:
		return _spark_mesh
	var rng := RandomNumberGenerator.new()
	rng.seed = 379
	var verts := PackedVector3Array()
	for i in SPARK_COUNT:
		var way := Vector3(rng.randf_range(-0.8, 0.8), rng.randf_range(-0.5, 0.9), -1.0).normalized()
		var side := way.cross(Vector3.UP).normalized() * 0.03
		var near := way * rng.randf_range(0.1, 0.35)
		var far := way * rng.randf_range(0.7, 1.0)
		verts.append_array([near - side, near + side, far])
	var arrays := []
	arrays.resize(Mesh.ARRAY_MAX)
	arrays[Mesh.ARRAY_VERTEX] = verts
	var mesh := ArrayMesh.new()
	mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays)
	var material := StandardMaterial3D.new()
	material.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	material.blend_mode = BaseMaterial3D.BLEND_MODE_ADD
	material.cull_mode = BaseMaterial3D.CULL_DISABLED
	material.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	material.albedo_color = Color(1.0, 0.85, 0.45)
	mesh.surface_set_material(0, material)
	_spark_mesh = mesh
	return _spark_mesh


## A shot (World.shoot) stopped at [param point] (cells), [param struck]
## stopping it (decision 583): the bow's twang, and the arrow flies from the
## bow to there (its landing below). As it arrives, a body there is heard
## struck (_on_struck) or guarding (_on_guarded); else what stopped it
## (_shot_sound).
func _on_shot(point: Vector2, struck: StringName, id: int) -> void:
	var to := Vector2i(point.round())  # The cell it stopped in.
	var puppet: Node3D = _puppets.get(id)
	if puppet == null or puppet.get_parent() == null:
		return
	_combat_at[id] = Time.get_ticks_msec()
	_bow_loosed(puppet)
	var shooter := instance_from_id(id) as GridEntity
	var from := _bow_tip(puppet)
	var hit := World.get_entity_at(to) if struck == &"body" else null
	var body: Node3D = _puppets.get(hit.get_instance_id()) if hit != null and hit != shooter else null
	var landed := _shot_sound(struck, to, shooter.tile if shooter != null else to, _trees)
	# Where it stops (decision 583, the sim's point): abreast of the body struck, chest high; at the
	# face of the wall or closed door it met; else its range's end. Flown level at the bow's height.
	var stop := Vector3(point.x, from.y, point.y)
	var along := Vector3(stop.x - from.x, 0.0, stop.z - from.z).normalized()
	if along.is_zero_approx():
		along = Vector3.FORWARD
	if body != null:
		stop.y = body.position.y + ARROW_CHEST * float(body.get_meta("model_scale", 1.0))
	_stop_creak(puppet)
	sfx.play("sfx.bow_loose", from)
	var shot_speed := ArtKit.feel("client3d.shot_speed", SHOT_SPEED)
	var flight := 0.0 if from.distance_to(stop) < 0.1 else maxf(0.06, from.distance_to(stop) / shot_speed)
	# Nothing struck short of a wall: on past the end into a short fall (Jeff: "after the full range
	# it sags down and lands in ground, not hitting ground at its target like it does now").
	var sags := body == null and landed in ["sfx.arrow_land", "sfx.arrow_water"]
	var down := stop + along * ARROW_SAG
	down.y = _ground_height(Vector2(down.x, down.z))
	var falling := ARROW_SAG / shot_speed * ARROW_SAG_SLOW if sags else 0.0
	var end := down if sags else stop
	var flying := {"end": to, "arrive": Time.get_ticks_msec() + roundi((flight + falling) * 1000.0), "heard": false}
	_arrows.append(flying)
	# The hit, sent with the shot, comes first; whatever is left by the
	# arrow's arrival is a friend spared or a miss.
	get_tree().create_timer(maxf(flight + falling, 0.05)).timeout.connect(func() -> void:
		_arrows.erase(flying)
		if not flying["heard"] and is_instance_valid(sfx) and sfx.is_inside_tree():
			var met := World.get_entity_at(to)
			# A friend on the line (decision 456): it sticks in them, softly.
			var by := instance_from_id(id) as GridEntity  # By id: the shooter may be gone by now.
			var spared := met != null and by != null and World.spares(by, met)
			sfx.play("sfx.arrow_spared" if spared else landed, end))
	if flight <= 0.0:
		return
	_whistle(from, end, flight + falling)
	var arrow := _flying_arrow(shooter)
	arrow.name = "ShotArrow"
	puppet.get_parent().add_child(arrow, true)
	_fly_arrow(arrow)
	_head_arrow(arrow, from, stop - from)
	var tween := create_tween()
	if sags:
		# Its range spent: one arc, level then dipping ever steeper over the last ARROW_DIP of it,
		# to stand in the ground past its reach, nose first, at its angle; into water it's gone.
		var flat := Vector3(down.x, from.y, down.z)
		var drop := from.y - down.y
		tween.tween_method(func(t: float) -> void: _head_arrow(arrow, arc_at(from, flat, drop, t), arc_heading(from, flat, drop, t)),
			0.0, 1.0, flight + falling)
		tween.tween_callback(_rest_arrow.bind(arrow))
		if landed == "sfx.arrow_land":
			var nose := arc_heading(from, flat, drop, 1.0)
			tween.tween_callback(func() -> void: _head_arrow(arrow, down + nose.normalized() * ARROW_BURY, nose))
			tween.tween_interval(SHOT_STUCK_SECONDS)
		tween.tween_callback(func() -> void:
			if is_instance_valid(arrow):
				arrow.queue_free())
		return
	tween.tween_method(func(t: float) -> void: _head_arrow(arrow, from.lerp(stop, t), stop - from), 0.0, 1.0, flight)
	tween.tween_callback(_rest_arrow.bind(arrow))
	if body != null and shooter != null and World.spares(shooter, hit):
		# A friend on the line (decision 456): it sticks in them a while,
		# moving with them.
		tween.tween_callback(func() -> void:
			if is_instance_valid(body) and is_instance_valid(arrow):
				arrow.reparent(body))
		tween.tween_interval(SHOT_STUCK_SECONDS)
	elif body != null:
		pass  # Into the body struck: gone with the hit.
	elif landed == "sfx.arrow_hit_wood":
		# Into the wood at its angle, its head in a little.
		tween.tween_callback(func() -> void: _head_arrow(arrow, stop + along * ARROW_BURY, stop - from))
		tween.tween_interval(SHOT_STUCK_SECONDS)
	elif landed == "sfx.arrow_hit_stone":
		# Off the stone: back a little, turning over, and down to lie on the ground below it.
		var rest := stop - along * ARROW_GLANCE
		rest.y = _ground_height(Vector2(rest.x, rest.z)) + 0.02
		var lying := along.rotated(Vector3.UP, ARROW_GLANCE_TURN)
		tween.tween_method(func(t: float) -> void:
			_head_arrow(arrow, stop.lerp(rest, t) + Vector3.UP * sin(PI * t) * ARROW_GLANCE_UP,
				(-along).slerp(lying, t) + Vector3.UP * (1.0 - 2.0 * t) * 0.5), 0.0, 1.0, ARROW_GLANCE_SECONDS)
		tween.tween_callback(func() -> void: _head_arrow(arrow, rest, lying))
		tween.tween_interval(SHOT_STUCK_SECONDS)
	tween.tween_callback(func() -> void:
		if is_instance_valid(arrow):
			arrow.queue_free())


## Where a spent arrow is [param t] of its way along its arc (ARROW_DIP) from
## [param from] to [param flat] (its landing at the bow's height), falling
## [param drop] metres by the end: level at first, then dipping ever steeper.
static func arc_at(from: Vector3, flat: Vector3, drop: float, t: float) -> Vector3:
	var u := maxf(0.0, t - (1.0 - ARROW_DIP)) / ARROW_DIP
	return from.lerp(flat, t) + Vector3.DOWN * drop * u * u


## The way a spent arrow heads [param t] along its arc (arc_at's slope).
static func arc_heading(from: Vector3, flat: Vector3, drop: float, t: float) -> Vector3:
	var u := maxf(0.0, t - (1.0 - ARROW_DIP)) / ARROW_DIP
	return (flat - from) + Vector3.DOWN * drop * 2.0 * u / ARROW_DIP


## The bow's loose on [param puppet] (decision 462): the release and the
## recovery, then idle; a flat shot's (_on_shot) and a lob's (_on_lobbed).
func _bow_loosed(puppet: Node3D) -> void:
	if puppet.has_meta("rig") and str(puppet.get_meta("bow_state", "")) in ["draw", "hold"]:
		var clip := str((puppet.get_meta("moves", {}) as Dictionary).get("bow_shoot", ""))
		var rig := puppet.get_meta("rig") as AnimRig
		rig.upper(clip, 1.0, true)
		puppet.set_meta("bow_state", "loose")
		puppet.set_meta("bow_until", Time.get_ticks_msec() + int(rig.length(clip) * 1000.0))


## The way an arrow lobbed [param from] [param to] heads [param t] of its
## flight (World.lob_point's slope; decision 677).
static func lob_heading(from: Vector3, to: Vector3, t: float, apex := 0.25) -> Vector3:
	var flat := Vector2(to.x - from.x, to.z - from.z).length()
	return (to - from) + Vector3.UP * 4.0 * apex * flat * (1.0 - 2.0 * t)


## A lob (World.try_lob, decision 677) loosed by the body [param id] to come
## down round [param to] (677 amended (2), ui's side; Jeff: "the arrow
## goes up, gives a small telegraph circle and 3 arrows randomly hit within
## that"; "it just appears to go up, fade, then a arrow rains down"): the
## bow's twang, its arrow shot up fast at LOB_PITCH that fades out high
## (_loose_up); the circle [param radius] round [param to] on the ground
## (_volley_ring) till the last fall; and each of [param falls] (cell
## points) rains down steeply onto its point at tick [param ticks] + i
## (_volley_fall), standing in the ground nose first with its thud (a body
## struck there is heard by its hurt; into water it's gone). The falling
## whistle LOB_WARN_SECONDS before the first, from the centre.
func _on_lobbed(to: Vector2i, ticks: int, radius: float, falls: PackedVector2Array, id: int) -> void:
	var puppet: Node3D = _puppets.get(id)
	if puppet == null or puppet.get_parent() == null:
		return
	_combat_at[id] = Time.get_ticks_msec()
	_bow_loosed(puppet)
	var shooter := instance_from_id(id) as GridEntity
	var from := _bow_tip(puppet)
	var ground := _tile_position(to)
	_stop_creak(puppet)
	sfx.play("sfx.bow_loose", from)
	sfx.play("sfx.arrow_lob_rise", from)  # Up it goes.
	var flight := maxf(0.05, float(ticks) / World.TICK_RATE)
	# Its last LOB_WARN_SECONDS a falling whistle from where it will land, so a
	# body there hears it coming and can step out (decision 677).
	_play_later("sfx.arrow_lob_fall", ground, maxf(flight - LOB_WARN_SECONDS, 0.0))
	var way := Vector2(ground.x - from.x, ground.z - from.z)
	way = way.normalized() if way.length() > 0.01 else Vector2(0.0, 1.0)
	_loose_up(shooter, puppet.get_parent(), from, way, flight)
	if falls.is_empty():
		falls = PackedVector2Array([Vector2(to)])
	var last := flight + float(falls.size() - 1) / World.TICK_RATE
	_volley_ring(to, radius, last)
	for i in falls.size():
		_volley_fall(shooter, falls[i], way, flight + float(i) / World.TICK_RATE)


## The lob's arrow loosed (677 amended (2)): from [param from] up at
## LOB_PITCH along [param way] (grid x, y), VOLLEY_RISE metres in
## VOLLEY_RISE_SECONDS (less for a short [param flight]), fading out over
## its second half; under [param parent].
func _loose_up(shooter: GridEntity, parent: Node, from: Vector3, way: Vector2, flight: float) -> void:
	var arrow := _flying_arrow(shooter)
	arrow.name = "LobArrow"
	parent.add_child(arrow, true)
	_fly_arrow(arrow)
	var pitch := deg_to_rad(LOB_PITCH)
	var up := Vector3(way.x * cos(pitch), sin(pitch), way.y * cos(pitch))
	var seconds := minf(VOLLEY_RISE_SECONDS, flight * 0.6)
	_head_arrow(arrow, from, up)
	var tween := create_tween()
	tween.tween_method(func(t: float) -> void:
		_head_arrow(arrow, from + up * VOLLEY_RISE * t, up)
		if is_instance_valid(arrow):
			_set_transparency(arrow, clampf(t * 2.0 - 1.0, 0.0, 1.0)), 0.0, 1.0, seconds)
	tween.tween_callback(func() -> void:
		if is_instance_valid(arrow):
			arrow.queue_free())


## The volley's circle (677 amended (2)): [param radius] (VOLLEY_RING_MIN at
## least) round [param cell] on the ground in the alarm colour, from now
## till [param seconds] on, when the last arrow is down.
func _volley_ring(cell: Vector2i, radius: float, seconds: float) -> void:
	var base := _height_in(cell, Vector2(cell))
	var ring := _make_flat(_ground_arc_mesh(Vector2(cell), maxf(radius, LOB_RING_MIN), AIM_LINE, 0.0, PI, base),
		Color(UiTheme.color("alarm"), 0.85))
	ring.name = "VolleyRing"
	ring.position = Vector3(cell.x, base + ON_FLOOR * 2.0, cell.y)
	add_child(ring, true)
	var ids_ring := ring.get_instance_id()
	get_tree().create_timer(seconds + VOLLEY_RING_AFTER).timeout.connect(func() -> void:
		var fired_ring := instance_from_id(ids_ring) as Node
		if is_instance_valid(fired_ring):
			fired_ring.queue_free())


## One of the volley's arrows (677 amended (2)): it rains down steeply
## (LOB_PITCH, from the archer's side, [param way]) onto [param point]
## (cell units) over VOLLEY_FALL_SECONDS, landing [param at] seconds from
## now, and stands there nose first with its thud (none on a body: its hurt
## is heard), or splashes into water and is gone.
func _volley_fall(shooter: GridEntity, point: Vector2, way: Vector2, at: float) -> void:
	var ground := Vector3(point.x, _ground_height(point), point.y)
	var pitch := deg_to_rad(LOB_PITCH)
	var down := Vector3(way.x * cos(pitch), -sin(pitch), way.y * cos(pitch))
	var top := ground - down * (VOLLEY_FALL_HEIGHT / sin(pitch))
	var cell := Vector2i(point.round())
	var water := World.is_water(cell)
	var arrow := _flying_arrow(shooter)
	arrow.name = "VolleyArrow"
	arrow.visible = false
	add_child(arrow, true)
	_fly_arrow(arrow)
	_head_arrow(arrow, top, down)
	var tween := create_tween()
	tween.tween_interval(maxf(at - VOLLEY_FALL_SECONDS, 0.0))
	tween.tween_callback(func() -> void:
		if is_instance_valid(arrow):
			arrow.visible = true)
	tween.tween_method(func(t: float) -> void: _head_arrow(arrow, top.lerp(ground, t), down), 0.0, 1.0, minf(VOLLEY_FALL_SECONDS, at))
	tween.tween_callback(func() -> void:
		_rest_arrow(arrow)
		if is_instance_valid(sfx) and sfx.is_inside_tree() and World.get_entity_at(cell) == null:
			sfx.play("sfx.arrow_water" if water else "sfx.arrow_land", ground))
	if not water:
		tween.tween_callback(func() -> void: _head_arrow(arrow, ground + down.normalized() * ARROW_BURY, down))
		tween.tween_interval(SHOT_STUCK_SECONDS)
	tween.tween_callback(func() -> void:
		if is_instance_valid(arrow):
			arrow.queue_free())


## The lob's aim shown (decision 677; Main, each frame while lobbing): the
## brass arc from [param from] (the nocked arrow, puppet space) to
## [param cell]'s ground on World.lob_point's [param apex], the ring there
## [param radius] cells across its middle; red where it cannot come down
## ([param open] false). Hidden when not [param show].
func lob_aim(from: Vector3, cell: Vector2i, radius: float, open: bool, apex: float, show: bool) -> void:
	if _lob_arc == null:
		if not show:
			return
		_lob_arc = _make_flat(ArrayMesh.new(), Color(UiTheme.color("brass_bright"), 0.85))
		_lob_ring = _make_flat(ArrayMesh.new(), Color(UiTheme.color("brass_bright"), 0.9))
		add_child(_lob_arc)
		add_child(_lob_ring)
	_lob_arc.visible = show
	_lob_ring.visible = show
	if not show:
		_lob_key = []
		return
	var colour: Color = UiTheme.color("brass_bright") if open else LOB_CLOSED
	for flat: MeshInstance3D in [_lob_arc, _lob_ring]:
		(flat.material_override as StandardMaterial3D).albedo_color = Color(colour, 0.85)
	var ground := _tile_position(cell) + Vector3.UP * ON_FLOOR * 2.0
	var key := [from.snapped(Vector3.ONE * 0.01), cell, snappedf(radius, 0.01), apex]
	if key == _lob_key:
		return
	_lob_key = key
	_lob_arc.mesh = lob_arc_mesh(from, ground, apex)
	var base := _height_in(cell, Vector2(cell))
	_lob_ring.mesh = _ground_arc_mesh(Vector2(cell), maxf(radius, LOB_RING_MIN), AIM_LINE, 0.0, PI, base)
	_lob_ring.position = Vector3(cell.x, base + ON_FLOOR * 2.0, cell.y)


## The lob's arc as two crossed ribbons LOB_LINE wide (one lying, one
## standing, so it reads from any camera), LOB_PIECES pieces along
## World.lob_point from [param from] to [param to].
static func lob_arc_mesh(from: Vector3, to: Vector3, apex: float) -> ArrayMesh:
	var surface := SurfaceTool.new()
	surface.begin(Mesh.PRIMITIVE_TRIANGLES)
	for i in LOB_PIECES:
		var a := World.lob_point(from, to, float(i) / LOB_PIECES, apex)
		var b := World.lob_point(from, to, float(i + 1) / LOB_PIECES, apex)
		var along := (b - a).normalized()
		var flat := along.cross(Vector3.UP)
		if flat.is_zero_approx():
			flat = Vector3.RIGHT
		flat = flat.normalized() * LOB_LINE * 0.5
		var up := along.cross(flat).normalized() * LOB_LINE * 0.5
		for across: Vector3 in [flat, up]:
			var quad: Array[Vector3] = [a - across, b - across, b + across, a + across]
			for j: int in [0, 1, 2, 0, 2, 3]:
				surface.set_normal(Vector3.UP)
				surface.add_vertex(quad[j])
	return surface.commit()


## An arrow flying [param from] to [param end] over [param flight] seconds
## whistles where it passes nearest the listener, as it passes; not for the
## archer (the loose has its own), whose arrow starts within a cell of them.
func _whistle(from: Vector3, end: Vector3, flight: float) -> void:
	if sfx.listener == null:
		return
	var ear := _tile_position(sfx.listener)
	var line := Vector2(end.x - from.x, end.z - from.z)
	var along := clampf(Vector2(ear.x - from.x, ear.z - from.z).dot(line) / maxf(line.length_squared(), 0.0001), 0.0, 1.0)
	if Vector2(ear.x - from.x, ear.z - from.z).length() < 1.5 or along >= 1.0:
		return
	var by := from.lerp(end, along)
	get_tree().create_timer(maxf(along * flight, 0.01)).timeout.connect(func() -> void:
		if is_instance_valid(sfx) and sfx.is_inside_tree():
			sfx.play("sfx.arrow_flight", by))


## Where a shot leaves [param puppet]'s bow: the arrow on its string if it is
## still drawn, else the bow in its hand, else chest high; in the puppets'
## parent's frame.
func _bow_tip(puppet: Node3D) -> Vector3:
	var sockets: Dictionary = puppet.get_meta("sockets", {})
	var bow := (sockets["hand_l"] as Node3D).get_node_or_null("Held") as Node3D if sockets.has("hand_l") else null
	var nocked := bow.find_child("Nocked", true, false) as Node3D if bow != null else null
	var at := nocked if nocked != null else bow
	if at == null or not at.is_inside_tree() or puppet.get_parent() == null:
		return puppet.position + Vector3.UP * 1.1
	return (puppet.get_parent() as Node3D).to_local(at.global_position)


## The arrow in flight: art-kit's fx.arrow, its shooter's arrows' variant;
## a pale stick where this build lacks it.
static func _flying_arrow(shooter: GridEntity) -> Node3D:
	if ArtKit.has("fx.arrow"):
		var ids := held_ids(shooter) if shooter != null else ["", ""]
		return ArtKit.instance("fx.arrow", int(ARROW_VARIANTS.get(str(ids[0]), 1)))
	var stick := MeshInstance3D.new()
	var mesh := BoxMesh.new()
	mesh.size = Vector3(0.03, 0.7, 0.03)
	stick.mesh = mesh
	var paint := StandardMaterial3D.new()
	paint.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	paint.albedo_color = Color(0.85, 0.8, 0.65)
	stick.material_override = paint
	return stick


## [param arrow] at [param at], its head (its +y, as art-kit draws it) along
## [param heading]; its girth (x and z) its meta "girth" times, 1 at rest.
static func _head_arrow(arrow: Node3D, at: Vector3, heading: Vector3) -> void:
	if not is_instance_valid(arrow):
		return
	var y := heading.normalized() if not heading.is_zero_approx() else Vector3.FORWARD
	var x := y.cross(Vector3.UP) if absf(y.dot(Vector3.UP)) < 0.99 else Vector3.RIGHT
	x = x.normalized()
	var girth := float(arrow.get_meta("girth")) if arrow.has_meta("girth") else 1.0
	arrow.transform = Transform3D(Basis(x * girth, y, x.cross(y) * girth), at)


## [param arrow] dressed for its flight: ARROW_FLIGHT_GIRTH thick, and a pale
## trail tapering back from its tail (a cone, ARROW_TRAIL long; it marks the
## line, it isn't a comet), unlit and casting no shadow.
static func _fly_arrow(arrow: Node3D) -> void:
	arrow.set_meta("girth", ARROW_FLIGHT_GIRTH)
	var tail := 0.0
	for mesh: MeshInstance3D in ([arrow] if arrow is MeshInstance3D else []) + arrow.find_children("*", "MeshInstance3D", true, false):
		var box := mesh.get_aabb()
		tail = minf(tail, (arrow.global_transform.affine_inverse() * mesh.global_transform * box.position).y if mesh.is_inside_tree() else box.position.y)
	var trail := MeshInstance3D.new()
	trail.name = "Trail"
	var cone := CylinderMesh.new()
	cone.height = ARROW_TRAIL
	cone.top_radius = 0.008
	cone.bottom_radius = 0.0
	cone.radial_segments = 6
	cone.rings = 1
	trail.mesh = cone
	var paint := StandardMaterial3D.new()
	paint.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	paint.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	paint.albedo_color = Color(1.0, 0.97, 0.88, ARROW_TRAIL_ALPHA)
	trail.material_override = paint
	trail.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	trail.position = Vector3(0.0, tail - ARROW_TRAIL * 0.5, 0.0)
	arrow.add_child(trail)


## [param arrow] come to rest (struck, stuck, glanced, or down past its
## range): its true girth, its trail gone.
static func _rest_arrow(arrow: Node3D) -> void:
	if not is_instance_valid(arrow):
		return
	arrow.remove_meta("girth")
	arrow.transform.basis = arrow.transform.basis.orthonormalized()
	var trail := arrow.get_node_or_null("Trail")
	if trail != null:
		arrow.remove_child(trail)
		trail.queue_free()


## A blow wound up over [param ticks]: the heavy swing, timed to connect
## as it lands.
## A monster cried out (Monster.cried: a call to its pack, a rout): its
## kind's slot for it, pitched by its size, from where it is drawn.
func _on_cried(cry: StringName, id: int) -> void:
	var puppet: Node3D = _puppets.get(id)
	var monster := instance_from_id(id) as Monster
	if puppet == null or monster == null:
		return
	puppet.set_meta("cried_at", Time.get_ticks_msec())
	var creature := str(monster.spawn_spec.get("kind", ""))
	if puppet.has_meta("creature_view"):
		var view := puppet.get_meta("creature_view") as CreatureView
		if cry == &"charge":
			view.charge()
		elif cry == &"rout":
			view.bolt()
		elif cry == &"roar":
			view.roar()
		elif cry == &"skid":
			view.skid()
		elif cry == &"snort":
			view.paw()
		elif cry == &"pounce":
			view.pounce()
		elif cry == &"howl":
			view.roar("howl")  # The old grey calling his pack in.
		elif cry == &"pant":
			var pant: Variant = monster.get("pant")  # The old grey's opening (OldWolf.pant's ticks).
			view.pant(int((pant as Dictionary).get("ticks", 20) if pant is Dictionary else 20) * World.TICK_DT)
		elif cry == &"call":
			view.snarl()
		elif cry == &"steady":
			view.steady()
		elif cry == &"steady_over":
			view.steady_over()
	elif cry == &"steady":
		_steady(puppet)
	elif cry == &"steady_over":
		_steady_over(puppet)
	if cry == &"steady" or cry == &"steady_over":
		# Steadied (843): a boss or apex out of a stagger heard setting
		# himself by his kind (SoundKit.steady_slot), the blows on him dull
		# till it is over (_heard_steadied); never a cry slot of its own.
		if cry == &"steady_over" or not (monster.boss or Monster.is_apex(creature)):
			_steadied.erase(id)
			return
		_steadied[id] = AnimRig.now_msec() + STEADY_HEARD_MS
		var set_slot := SoundKit.steady_slot(creature)
		if set_slot != "":
			sfx.play(set_slot, puppet.position + Vector3.UP * 0.8)
		return
	var slot := SoundKit.cry(creature, String(cry))
	if slot != "":
		sfx.play(slot, puppet.position + Vector3.UP * 0.8, float(SoundKit.CREATURE_PITCH.get(creature, 1.0)))
	if cry == &"rout" and not monster is Animal and music != null and sfx.listener != null 			and _cells_apart(monster.tile, sfx.listener) <= Music.TENSION_NEAR:
		music.sting("victory")


## A creature at peace now and then makes its idle sounds (795; SoundKit.idle:
## a boar's grunt and its rooting snuffle), checked once a second: each body
## heard by the listener rolls each slot's chance, IDLE_AT_ONCE sounding in
## any IDLE_SPAN_MS at most so a sounder murmurs, not chatters. A body that
## fought or cried in the last IDLE_QUIET_MS, or is down, is silent; so is
## one sitting or knocked down (Monster.pose, 795 amended (3)), and a slot
## heard within its SoundKit.IDLE_APART_MS (a wolf's growl) waits.
## [param roll] in place of randf (tests).
func _idle_voices(now: int, roll := -1.0) -> void:
	if now < _idle_next or sfx == null or sfx.listener == null:
		return
	_idle_next = now + IDLE_EVERY_MS
	var recent: Array[int] = []
	for at: int in _idle_heard:
		if now - at < IDLE_SPAN_MS:
			recent.append(at)
	_idle_heard = recent
	for id: int in _puppets:
		if _idle_heard.size() >= IDLE_AT_ONCE:
			return
		var creature := instance_from_id(id) as Monster
		if creature == null or creature.hp <= 0 or creature.pose != Monster.Pose.STAND:
			continue
		var kind := str(creature.spawn_spec.get("kind", ""))
		var sounds := SoundKit.idle(kind)
		var puppet: Node3D = _puppets[id]
		if sounds.is_empty() or now - int(_combat_at.get(id, -IDLE_QUIET_MS)) < IDLE_QUIET_MS 				or now - int(puppet.get_meta("cried_at", -IDLE_QUIET_MS)) < IDLE_QUIET_MS:
			continue
		for slot: String in sounds:
			if _cells_apart(creature.tile, sfx.listener) > SoundKit.reach(slot) \
					or now - int(_idle_slot_at.get(slot, -(1 << 40))) < int(SoundKit.IDLE_APART_MS.get(slot, 0)):
				continue
			if (randf() if roll < 0.0 else roll) < IDLE_EVERY_MS / 1000.0 / float(sounds[slot]):
				sfx.play(slot, puppet.position + Vector3.UP * 0.5, float(SoundKit.CREATURE_PITCH.get(kind, 1.0)))
				_idle_heard.append(now)
				_idle_slot_at[slot] = now
				break


func _on_winding(_direction: Vector2i, ticks: int, id: int) -> void:
	var puppet: Node3D = _puppets.get(id)
	if puppet == null:
		return
	if ticks <= 0:
		# Given up (decision 392): the wind-up stops; the gait or rest takes over.
		puppet.set_meta("wound_until", 0)
		if puppet.has_meta("creature_view"):
			(puppet.get_meta("creature_view") as CreatureView).unwind()
		elif puppet.has_meta("rig"):
			(puppet.get_meta("rig") as AnimRig).cancel_strike()
			puppet.set_meta("busy_until", 0)
			puppet.set_meta("strike_token", int(puppet.get_meta("strike_token", 0)) + 1)  # A held one too.
		return
	_combat_at[id] = Time.get_ticks_msec()
	var swinger := instance_from_id(id) as GridEntity
	# The blow lands as the drawn body's does: a body drawn behind the sim (any but the local
	# player's own) that far later ("blows you can see" 2ii).
	var own := swinger is Player and (swinger as Player).owner_peer == Net.local_id
	var seconds := ticks * World.TICK_DT + (0.0 if own else STRIKE_LANDS_IN)
	if swinger != null:
		swinger.settle_for_blow()  # Still drawn coming: it slows into the cell it strikes from.
	if puppet.has_meta("creature_view"):
		# A creature's wound-up blow: its attack, timed to land with the drawn body's.
		# A plain blow's lead (338 amended (4)) coils it too.
		(puppet.get_meta("creature_view") as CreatureView).wind(seconds, is_lead(swinger, ticks))
		puppet.set_meta("wound_until", Time.get_ticks_msec() + int(seconds * 1000.0) + 400)
		return
	var weapon := World.wielded(swinger) if swinger != null else ""
	var strikes: Dictionary = (puppet.get_meta("moves", {}) as Dictionary).get("strikes", {})
	# Its own strike over the lead: a person's for its weapon (WOUND_STRIKES), a monster's
	# (a robber's, a bandit's, a goblin's) whatever it holds, its bare hands' if no strike is
	# made for it; the heavy swing only for a person's heavy wind-up of another weapon.
	var mine := strikes.has(weapon) or (not (swinger is Player or swinger is Companion) and strikes.has(""))
	if (weapon in WOUND_STRIKES or swinger is Monster) and mine and _strike(puppet, swinger, weapon, seconds, is_lead(swinger, ticks)):
		puppet.set_meta("wound_until", Time.get_ticks_msec() + int(seconds * 1000.0) + 400)
		return
	if not puppet.has_meta("rig") or not (puppet.get_meta("rig") as AnimRig).has(CLIP_HEAVY):
		return
	var rig := puppet.get_meta("rig") as AnimRig
	puppet.set_meta("fidgeting", false)
	# Its contact as the wound-up blow lands, the rest at the same pace.
	var contact := ArtKit.feel("client3d.clip_heavy_contact", CLIP_HEAVY_CONTACT)
	var after := (rig.length(CLIP_HEAVY) - contact) * seconds / contact
	var now := Time.get_ticks_msec()
	puppet.set_meta("busy_until", now + int(rig.strike(CLIP_HEAVY, contact, seconds, after) * 1000.0))
	puppet.set_meta("wound_until", now + int(seconds * 1000.0) + 400)


func _pick_shape(shape_name: String, mesh: Mesh) -> Shape3D:
	match shape_name:
		"capsule":
			var capsule := CapsuleShape3D.new()
			capsule.radius = (mesh as CapsuleMesh).radius
			capsule.height = (mesh as CapsuleMesh).height
			return capsule
		"sphere":
			var sphere := SphereShape3D.new()
			sphere.radius = (mesh as SphereMesh).radius
			return sphere
		"barrel":
			var cylinder := CylinderShape3D.new()
			cylinder.radius = (mesh as CylinderMesh).top_radius
			cylinder.height = (mesh as CylinderMesh).height
			return cylinder
		_:
			var box := BoxShape3D.new()
			box.size = (mesh as BoxMesh).size
			return box


func _label(name_: String, text: String, color: Color, height: float) -> Label3D:
	var label := Label3D.new()
	label.name = name_
	label.text = text
	label.visible = not text.is_empty()
	label.pixel_size = LABEL_SIZE
	label.font_size = LABEL_FONT_SIZE
	label.modulate = color
	label.billboard = BaseMaterial3D.BILLBOARD_ENABLED
	label.no_depth_test = true
	label.outline_size = 12
	label.position.y = height
	return label


## The state_<name> nodes door edge [param key]'s Door shows: those in its
## leaf, and if it has the frame's (_door_hinges), those in no leaf.
func _states_of(key: Vector3i) -> Array:
	var hinge: Node3D = _door_hinges[key][0]
	var piece := _doorways[key].get_node(^"Door")
	var leaves := piece.get_children().filter(func(node: Node) -> bool: return str(node.name).begins_with("leaf"))
	return piece.find_children("state_*", "Node3D", true, false).filter(func(node: Node) -> bool:
		if hinge.is_ancestor_of(node):
			return true
		return _door_hinges[key][2] and not leaves.any(func(leaf: Node) -> bool: return leaf.is_ancestor_of(node)))


func _on_door_shown(door: Door) -> void:
	_doors_due[door.key] = true


## The leaf of each door follows its Door node's open state: the doors
## that changed, till their leaves are still (a big map's two thousand
## doors, each looked at every frame, took 5 ms of it).
func _sync_doors() -> void:
	for key: Vector3i in _doors_due.keys():
		var door := World.door_on(key)
		# The hidden niche (608): cracked while shut, open once found; no
		# leaf to swing, no wood to sound.
		if _hidden_niches.has(key):
			if door != null:
				_show_hidden_niche(key, door.is_open())
			_doors_due.erase(key)
			continue
		if _vaults.has(key):
			if door != null:
				_show_vault(key, door.is_open())
			_doors_due.erase(key)
			continue
		var doorway: Node3D = _doorways.get(key)
		if door == null or doorway == null:
			_doors_due.erase(key)
			continue
		var hinge: Node3D = _door_hinges[key][0]
		var same_door: bool = _door_node.get(door.key, 0) == door.get_instance_id()
		var at := doorway.position + Vector3.UP
		if same_door and _door_open.has(door.key) and _door_open[door.key] != door.is_open() and not door.is_broken():
			if door.is_open() and door.lock != "":
				sfx.play("sfx.door_wood_unlock", at)  # A key turned first.
			sfx.play("sfx.door_wood_open" if door.is_open() else "sfx.door_wood_close", at)
			if not door.is_open() and door.lock != "":
				_play_later("sfx.door_wood_lock", at, 0.4)  # And locked again behind.
		if same_door and _door_hp.has(door.key) and door.hp < _door_hp[door.key]:
			sfx.play("sfx.door_wood_break" if door.is_broken() else "sfx.door_wood_struck", at)
		_door_hp[door.key] = door.hp
		_door_open[door.key] = door.is_open()
		_door_node[door.key] = door.get_instance_id()
		# The art's "state_<name>" nodes (art_style.md) show in that state
		# alone; a broken door whose art has state_broken keeps its leaf,
		# open and splintered, else the leaf goes. A double door's leaf's
		# own follow its edge's Door, the frame's the first edge's.
		if not _door_states.has(key):
			_door_states[key] = _states_of(key)
		var shown := "state_" + door.state()
		var broken_art := false
		for node: Node3D in _door_states[key]:
			node.visible = str(node.name) == shown
			broken_art = broken_art or str(node.name) == "state_broken"
		hinge.visible = not door.is_broken() or broken_art
		var target: float = float(_door_hinges[key][1]) if door.is_open() else 0.0
		hinge.rotation.y = move_toward(hinge.rotation.y, target, get_process_delta_time() / Door.SWING_SECONDS * PI * 0.5)
		if is_equal_approx(hinge.rotation.y, target):  # (A float32 angle: never == PI / 2.)
			_doors_due.erase(key)
