		"carvings": [
			{
				"cut": "Edmund Varrow, who built the first mill. His sons laid him here.",
				"fact": "The Varrows were one of Umbrage's first wealthy families; Edmund built its first mill."
			},
			{
				"cut": "Maud Corwen kept the town's purse forty years. She gave to the temple and owed no one.",
				"fact": "Maud Corwen kept Umbrage's purse for forty years and gave to the temple."
			},
			{
				"cut": "The children of the house of Hale. Three winters took them.",
				"fact": "The Hale family lost three children to hard winters."
			},
			{
				"cut": "Osric Hale, who paid for this tomb and the two beside it.",
				"fact": "Osric Hale paid for his family's tombs; the Hales were rich."
			},
			{
				"cut": "Who opens this tomb answers to those below.",
				"fact": "The town's dead are said to answer anyone who breaks their tombs."
			},
			{
				"cut": "Faithful to Theus all her days. Let her rest.",
				"fact": "The wealthy of Umbrage are laid here as followers of Theus.",
				"chapel": true
			}
