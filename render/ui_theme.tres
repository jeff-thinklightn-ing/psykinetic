[gd_resource type="Theme" load_steps=25 format=3]

; The shared look of every screen (docs/ui_style.md): the project theme
; (project.godot gui/theme/custom), read by code through UiTheme. Every
; colour is a swatch of art/kit/palette.png; sizes are canvas units (3840 x
; 2160). A panel sets none of its own: it uses the types and variations here.

[ext_resource type="FontFile" path="res://art/fonts/AlegreyaSans-Regular.ttf" id="sans"]
[ext_resource type="FontFile" path="res://art/fonts/AlegreyaSans-Bold.ttf" id="sans_bold"]
[ext_resource type="FontFile" path="res://art/fonts/Alegreya[wght].ttf" id="serif_file"]

[sub_resource type="FontVariation" id="serif"]
base_font = ExtResource("serif_file")

[sub_resource type="FontVariation" id="serif_bold"]
base_font = ExtResource("serif_file")
variation_opentype = {
2003265652: 700.0
}

; backing #2c2418 at 0.86, edge leather #7a6e58: a panel.
