# Godot 4+ specific ignores
/android/
.godot/
export/
build/
*.tmp
# The Kenney Castle Kit ships three copies of its models; Godot reads the
# GLB ones (the others carry .gdignore too).
art/kenney-castle/Models/FBX format/
art/kenney-castle/Models/OBJ format/
art/kenney-castle/Previews/
# A player's client settings and updater log, never the repo's.
settings.cfg
update.log# Kenney's audio packs as downloaded: never committed or exported (each has
# a .gdignore). The game's sounds are the copies in art/audio/sfx/.
art/audio/kenney_rpg-audio/
art/audio/kenney_impact-sounds/
