# Psykinetic dedicated server. Install with:
#   sudo cp server/psykinetic.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now psykinetic
# See docs/server.md.

[Unit]
Description=Psykinetic dedicated server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=psykinetic
Group=psykinetic
WorkingDirectory=/opt/psykinetic
# PSYKINETIC_TOKEN lives here, root-owned, mode 600. See server/env.example.
# The server reads the token from the environment; it is never on the command
# line, where any local process could read it (decision 690).
EnvironmentFile=/etc/psykinetic/env
# 717: the token and the game port's DTLS key and certificate, made once by
# server/install_dtls.sh (sudo), handed over as systemd credentials: the
# service reads them from $CREDENTIALS_DIRECTORY, never from /etc/psykinetic
# (the hardening drop-in hides it). A missing file fails the start, so this
# unit goes in only after install_dtls.sh has run. The token credential wins
# over env's PSYKINETIC_TOKEN; a server from before 717 ignores all three.
LoadCredential=token:/etc/psykinetic/token
LoadCredential=dtls.key:/etc/psykinetic/dtls.key
LoadCredential=dtls.crt:/etc/psykinetic/dtls.crt
# The Dedicated Server export strips visuals but is not headless by itself.
# --admin-port is the console: server/admin.sh talks to it on localhost.
# --status-port answers clients' status queries over UDP (decision 431): the
# game port + 2, where clients ask (7778 is the console's, TCP).
# --regenerate lays the shifting levels again when due (decision 542; off, a marked
# level such as the barrow stays its bare template).
# --lawspeaker picks the model for the towns' rulings (decision 448; Jeff,
# 2026-10-18: haiku); its key is ANTHROPIC_API_KEY in the env file.
# --builder-max-cost stops a builder request at $1.00 of the API key (Jeff,
# 2026-10-26; decision 690).
ExecStart=/opt/psykinetic/psykinetic-server --headless --server --port=7777 --state=/var/lib/psykinetic/world.json --admin-port=7778 --status-port=7779 --regenerate --lawspeaker=haiku --builder-max-cost=1.00
# Creates /var/lib/psykinetic owned by the service user.
StateDirectory=psykinetic
# Godot keeps its own user data under $HOME; give it somewhere writable.
Environment=HOME=/var/lib/psykinetic
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
