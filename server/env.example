# Copy to /etc/psykinetic/env, owned by root, mode 600, and set a real token.
# The service passes it to the server as --token. Clients must send the same
# token to be given a player. Never commit the real file.
PSYKINETIC_TOKEN=change-me
# Optional: a language model for companion minds, through Ollama. Name a
# model to turn it on; leave it unset and companions use the scripted mind.
#PSYKINETIC_LLM_MODEL=qwen3
# Where Ollama is. This is the default (its native chat endpoint). A URL
# ending in /chat/completions is spoken to as an OpenAI-compatible endpoint.
#PSYKINETIC_LLM_URL=http://127.0.0.1:11434/api/chat
