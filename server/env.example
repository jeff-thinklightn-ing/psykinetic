# Copy to /etc/psykinetic/env, owned by root, mode 600, and set a real token.
# systemd puts it in the server's environment; the server reads PSYKINETIC_TOKEN
# itself (never --token on the command line, where any local process could read
# it). Clients must send the same token to be given a player. Never commit the
# real file.
PSYKINETIC_TOKEN=change-me
# Optional: a language model for companion minds, through Ollama. Name a
# model to turn it on; leave it unset and companions use the scripted mind.
#PSYKINETIC_LLM_MODEL=qwen3
# Where Ollama is. This is the default (its native chat endpoint). A URL
# ending in /chat/completions is spoken to as an OpenAI-compatible endpoint.
#PSYKINETIC_LLM_URL=http://127.0.0.1:11434/api/chat
# Optional: builder mode (B in the game) asks Claude with this key. Set a
# spending limit on it in the Claude Console. Without it, builder mode is
# off (or answers from a script with --builder-stub).
#ANTHROPIC_API_KEY=sk-ant-...
# Only for a key not scoped to a workspace: the workspace to bill.
#ANTHROPIC_WORKSPACE_ID=wrkspc_...
# The player ids (from each player's settings.cfg) allowed to use builder
# mode, comma-separated.
#PSYKINETIC_BUILDERS=
